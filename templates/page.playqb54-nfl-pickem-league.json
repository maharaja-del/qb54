    "faq": {
      "type": "faq",
      "name": "FAQ",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "title": "Is the QB54 Pick'em League really free?",
            "text": "<p>Yes — it's 100% free to join and play all season long. No purchase necessary to enter or win.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "title": "How do I make my picks?",
            "text": "<p>After you join for free through Top Dog, simply pick the winning team for each NFL game before that week's games kick off.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "title": "How does scoring work?",
            "text": "<p>You earn 1 point for every game you pick correctly. Your points add up across all 17 weeks of the NFL season.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "title": "What if I join during the testing week?",
            "text": "<p>Week 1 is a trial run to make sure everything runs smoothly. The official contest — and the points that count toward prizes — start in Week 2, so testers get a head start.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "title": "What can I win?",
            "text": "<p>Each week, the player with the most points wins a prize package from the QB54 store. At the end of the season, the top 3 overall scorers split our grand prize vault.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "title": "Who runs the contest?",
            "text": "<p>The league is hosted by Top Dog, QB54's official Pick'em partner. QB54 supplies and ships every prize.</p>"
          }
        }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5", "q6"],
