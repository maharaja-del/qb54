{%- capture direction -%}{% render 'direction' %}{%- endcapture -%}
<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ direction }}">
  <head>
    <!-- Begin: Northbeam metadata info -->
  <script>
    localStorage.setItem('nb__region_code', "{{ localization.country.iso_code }}");
    localStorage.setItem('nb__currency_code', "{{ localization.country.currency.iso_code }}");
  </script>
<!-- End: Northbeam metadata info -->
    <!-- Begin: Northbeam pixel -->
