    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Padding Top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Add a short description for this step."
        }
      ]
    },
    {
      "type": "scoring_item",
      "name": "Scoring Item",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "score_number",
          "label": "Score Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "score_description",
          "label": "Score Description",
          "default": "Points description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to Play",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Set Up",
            "description": "Unfold the two QB54 chairs and place them 40 feet apart."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Throw",
            "description": "Toss the football and try to land it in the opposing chair's bucket."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Score Points",
            "description": "Hit the bucket for points. Higher points for tougher shots!"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "First to 54 Wins!",
            "description": "The first player or team to reach 54 points wins the game."
          }
        },
        {
          "type": "scoring_item",
          "settings": {
            "score_number": "1",
            "score_description": "Point - Hit the chair"
          }
        },
        {
          "type": "scoring_item",
          "settings": {
            "score_number": "3",
            "score_description": "Points - Ball stays in bucket"
          }
        },
        {
          "type": "scoring_item",
          "settings": {
            "score_number": "6",
            "score_description": "Points - Ball goes through bucket"
          }
        }
      ]
    }
  ]
}
{% endschema %}