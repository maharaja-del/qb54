{% comment %}
  ============================================================
  QB54 — Video Promo Banner (Overtime Sale / Reusable Sale Hero)
  ------------------------------------------------------------
  • Background video from Shopify media library (CDN + poster)
  • External MP4 fallback + custom poster override
  • Navy gradient / solid overlay + vignette
  • Glass card, two-tone heading, discount shimmer
  • Tap-to-copy promo code chip (ticket style)
  • Countdown timer w/ label (navy pills, auto-hide on expiry)
  • QB54 yellow pill CTA + optional secondary button
  • Staggered entrance animations (IntersectionObserver)
  • Fully responsive, prefers-reduced-motion safe, zero deps
  ============================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign vid = section.settings.video
  assign ext_url = section.settings.external_video_url
  assign poster = section.settings.poster_image
  assign align = section.settings.content_align

  assign overlay_rgb = section.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign overlay_op = section.settings.overlay_opacity | divided_by: 100.0

  # ---- OVERTIME CAMPAIGN AUTO-UPGRADE ----
  # Shopify keeps old saved values on existing sections, so stale
  # July 4th copy/dates are detected here and swapped for the
  # extended-sale versions automatically. Values already edited to
  # something new pass through untouched. Delete this block after
  # the campaign ends.
  assign badge_text = section.settings.badge_text
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign hl = section.settings.heading_highlight | strip
  assign subheading = section.settings.subheading
  assign button_text = section.settings.button_text
  assign cd_end = section.settings.countdown_end
  assign cd_label = section.settings.countdown_label | default: 'Overtime ends in'

  if cd_end contains '-07-04' or cd_end contains '-07-05'
    assign cd_end = '2026-07-11T23:59:59-04:00'
  endif
  if badge_text contains 'Best Seller'
    assign badge_text = '★ Sale Extended ★'
  endif
  assign eyebrow_down = eyebrow | downcase
  if eyebrow_down contains 'ends july 4' or eyebrow_down contains 'limited time'
    assign eyebrow = "🇺🇸 You showed up big — so we're not done"
  endif
  assign heading_down = heading | downcase
  if heading_down contains 'game on' or heading_down contains 'july 4th sale'
    assign heading = "The 4th Was a Hit. Now It's Overtime."
    assign hl = 'Overtime.'
  endif
  assign sub_down = subheading | downcase
  if sub_down contains 'through the 4th'
    assign subheading = 'Our July 4th sale broke records — thanks to you. So we are keeping 20% off everything on the field for one more week, through July 11.'
  endif
  assign btn_down = button_text | downcase
  if btn_down contains 'shop 20% off'
    assign button_text = 'Shop the Overtime Sale'
  endif
  # ---- END AUTO-UPGRADE ----

  if hl != blank and heading contains hl
    assign hl_esc = hl | escape
    assign hl_span = '<span class="qbvp__hl">' | append: hl_esc | append: '</span>'
    assign heading_html = heading | escape | replace: hl_esc, hl_span
  else
    assign heading_html = heading | escape
  endif
-%}

<section
  id="qbvp-{{ sid }}"
  class="qbvp qbvp--align-{{ align }} qbvp--h-{{ section.settings.height_preset }}{% if section.settings.enable_animations %} qbvp--animate{% endif %}"
  data-qbvp
  data-animate="{{ section.settings.enable_animations }}"
  aria-label="{{ heading | escape }}"
>
  {%- comment -%} ---------- VIDEO LAYER ---------- {%- endcomment -%}
  <div class="qbvp__media{% if section.settings.enable_kenburns %} qbvp__media--kenburns{% endif %}" aria-hidden="true">
    {%- if vid != blank -%}
      <video
        class="qbvp__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if poster != blank %}
          poster="{{ poster | image_url: width: 1920 }}"
        {% elsif vid.preview_image != blank %}
          poster="{{ vid.preview_image | image_url: width: 1920 }}"
        {% endif %}
      >
        {%- for source in vid.sources -%}
          {%- if source.format == 'mp4' -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endif -%}
        {%- endfor -%}
      </video>
    {%- elsif ext_url != blank -%}
      <video
        class="qbvp__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if poster != blank %}poster="{{ poster | image_url: width: 1920 }}"{% endif %}
      >
        <source src="{{ ext_url }}" type="video/mp4">
      </video>
    {%- elsif poster != blank -%}
      {{ poster | image_url: width: 1920 | image_tag: class: 'qbvp__video', loading: 'lazy', alt: '' }}
    {%- else -%}
      <div class="qbvp__placeholder">
        {%- if request.design_mode -%}
          <span>Select a background video in the section settings →</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- OVERLAY ---------- {%- endcomment -%}
  <div class="qbvp__overlay qbvp__overlay--{{ section.settings.overlay_style }}" aria-hidden="true"></div>
  {%- if section.settings.enable_vignette -%}
    <div class="qbvp__vignette" aria-hidden="true"></div>
  {%- endif -%}

  {%- comment -%} ---------- CONTENT ---------- {%- endcomment -%}
  <div class="qbvp__inner page-width">
    <div class="qbvp__card{% if section.settings.enable_glass %} qbvp__card--glass{% endif %}{% if section.settings.glass_accent_border %} qbvp__card--accent{% endif %}">

      {%- if badge_text != blank -%}
        <span class="qbvp__badge qbvp__badge--{{ section.settings.badge_style }} qbvp__stagger" style="--qbvp-d: 0;">
          {{ badge_text | escape }}
        </span>
      {%- endif -%}

      {%- if eyebrow != blank -%}
        <p class="qbvp__eyebrow qbvp__stagger" style="--qbvp-d: 1;">{{ eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.discount_text != blank -%}
        <p class="qbvp__discount qbvp__stagger" style="--qbvp-d: 2;">{{ section.settings.discount_text | escape }}</p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="qbvp__heading qbvp__stagger" style="--qbvp-d: 3;">{{ heading_html }}</h2>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <span class="qbvp__divider qbvp__stagger" style="--qbvp-d: 4;" aria-hidden="true"></span>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="qbvp__sub qbvp__stagger{% if section.settings.hide_sub_mobile %} qbvp__sub--hide-sm{% endif %}" style="--qbvp-d: 5;">
          {{ subheading | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.promo_code != blank -%}
        <div class="qbvp__code-wrap qbvp__stagger" style="--qbvp-d: 6;">
          <button
            type="button"
            class="qbvp__code"
            data-qbvp-copy
            data-code="{{ section.settings.promo_code | escape }}"
            aria-label="Copy discount code {{ section.settings.promo_code | escape }}"
          >
            <span class="qbvp__code-label">Code</span>
            <span class="qbvp__code-value">{{ section.settings.promo_code | escape }}</span>
            <span class="qbvp__code-copied" data-qbvp-copied aria-hidden="true">✓ Copied!</span>
          </button>
          {%- if section.settings.code_helper != blank -%}
            <p class="qbvp__code-helper">{{ section.settings.code_helper | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.enable_countdown and cd_end != blank -%}
        <div
          class="qbvp__cd-group qbvp__stagger"
          style="--qbvp-d: 7;"
          data-qbvp-countdown
          data-end="{{ cd_end | escape }}"
          data-hide-expired="{{ section.settings.countdown_hide_expired }}"
          role="timer"
          aria-label="Sale countdown"
        >
          {%- if cd_label != blank -%}
            <p class="qbvp__cd-label">{{ cd_label | escape }}</p>
          {%- endif -%}
          <div class="qbvp__countdown">
            <div class="qbvp__cd-pill"><span data-cd="d">--</span><small>Days</small></div>
            <div class="qbvp__cd-pill"><span data-cd="h">--</span><small>Hrs</small></div>
            <div class="qbvp__cd-pill"><span data-cd="m">--</span><small>Min</small></div>
            <div class="qbvp__cd-pill"><span data-cd="s">--</span><small>Sec</small></div>
          </div>
        </div>
      {%- endif -%}

      {%- if button_text != blank or section.settings.button2_text != blank -%}
        <div class="qbvp__actions qbvp__stagger" style="--qbvp-d: 8;">
          {%- if button_text != blank -%}
            <a
              href="{{ section.settings.button_url | default: '#' }}"
              class="qbvp__btn qbvp__btn--primary{% if section.settings.button_shimmer %} qbvp__btn--shimmer{% endif %}"
            >
              <span>{{ button_text | escape }}</span>
              <span class="qbvp__btn-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.button2_text != blank -%}
            <a href="{{ section.settings.button2_url | default: '#' }}" class="qbvp__btn qbvp__btn--ghost">
              <span>{{ section.settings.button2_text | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{%- comment -%} ============ STYLES (scoped to this section) ============ {%- endcomment -%}
{% style %}
  #qbvp-{{ sid }} {
    --qbvp-accent: {{ section.settings.accent_color }};
    --qbvp-navy: {{ section.settings.brand_navy }};
    --qbvp-text: {{ section.settings.text_color }};
    --qbvp-btn-bg: {{ section.settings.button_bg }};
    --qbvp-btn-text: {{ section.settings.button_text_color }};
    --qbvp-overlay: rgba({{ overlay_rgb }}, {{ overlay_op }});
    --qbvp-overlay-solid: rgba({{ overlay_rgb }}, 1);
    --qbvp-blur: {{ section.settings.glass_blur }}px;
    --qbvp-mob-h: {{ section.settings.mobile_min_height }}px;

    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    color: var(--qbvp-text);
  }

  /* ---------- Height presets (desktop) ---------- */
  #qbvp-{{ sid }}.qbvp--h-small  { min-height: 45vh; }
  #qbvp-{{ sid }}.qbvp--h-medium { min-height: 65vh; }
  #qbvp-{{ sid }}.qbvp--h-large  { min-height: 85vh; }
  #qbvp-{{ sid }}.qbvp--h-full   { min-height: 100vh; min-height: 100svh; }
  {% if section.settings.desktop_min_height > 0 %}
  @media (min-width: 769px) {
    #qbvp-{{ sid }} { min-height: {{ section.settings.desktop_min_height }}px; }
  }
  {% endif %}

  /* ---------- Video layer ---------- */
  #qbvp-{{ sid }} .qbvp__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #qbvp-{{ sid }} .qbvp__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  #qbvp-{{ sid }} .qbvp__media--kenburns .qbvp__video {
    animation: qbvp-kenburns-{{ sid }} 22s ease-in-out infinite alternate;
  }
  @keyframes qbvp-kenburns-{{ sid }} {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }
  #qbvp-{{ sid }} .qbvp__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(45deg, var(--qbvp-navy), var(--qbvp-navy) 24px, #232a52 24px, #232a52 48px);
    color: #fff;
    font-size: 1.4rem;
    letter-spacing: .04em;
  }

  /* ---------- Overlay ---------- */
  #qbvp-{{ sid }} .qbvp__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  #qbvp-{{ sid }} .qbvp__overlay--solid { background: var(--qbvp-overlay); }
  #qbvp-{{ sid }} .qbvp__overlay--gradient-up {
    background: linear-gradient(to top, var(--qbvp-overlay-solid) 0%, var(--qbvp-overlay) 45%, rgba({{ overlay_rgb }}, 0.05) 100%);
    opacity: {{ overlay_op | at_least: 0.15 }};
  }
  #qbvp-{{ sid }} .qbvp__overlay--gradient-down {
    background: linear-gradient(to bottom, var(--qbvp-overlay-solid) 0%, var(--qbvp-overlay) 45%, rgba({{ overlay_rgb }}, 0.05) 100%);
    opacity: {{ overlay_op | at_least: 0.15 }};
  }
  #qbvp-{{ sid }} .qbvp__overlay--radial {
    background: radial-gradient(ellipse at center, rgba({{ overlay_rgb }}, 0.1) 0%, var(--qbvp-overlay) 75%);
  }
  #qbvp-{{ sid }} .qbvp__vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    box-shadow: inset 0 0 140px 40px rgba(0, 0, 0, 0.55);
  }

  /* ---------- Layout / alignment ---------- */
  #qbvp-{{ sid }} .qbvp__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem);
    display: flex;
  }
  #qbvp-{{ sid }}.qbvp--align-left   .qbvp__inner { justify-content: flex-start; }
  #qbvp-{{ sid }}.qbvp--align-center .qbvp__inner { justify-content: center; }
  #qbvp-{{ sid }}.qbvp--align-right  .qbvp__inner { justify-content: flex-end; }

  #qbvp-{{ sid }} .qbvp__card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 640px;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 20px;
  }
  #qbvp-{{ sid }}.qbvp--align-left   .qbvp__card { align-items: flex-start; text-align: left; }
  #qbvp-{{ sid }}.qbvp--align-center .qbvp__card { align-items: center; text-align: center; }
  #qbvp-{{ sid }}.qbvp--align-right  .qbvp__card { align-items: flex-end; text-align: right; }

  /* ---------- Glass card ---------- */
  #qbvp-{{ sid }} .qbvp__card--glass {
    background: rgba(30, 36, 71, 0.55); /* fallback for older browsers */
    background: color-mix(in srgb, var(--qbvp-navy) 55%, transparent);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    #qbvp-{{ sid }} .qbvp__card--glass {
      background: rgba(30, 36, 71, 0.34);
      background: color-mix(in srgb, var(--qbvp-navy) 34%, transparent);
      -webkit-backdrop-filter: blur(var(--qbvp-blur)) saturate(1.15);
      backdrop-filter: blur(var(--qbvp-blur)) saturate(1.15);
    }
  }
  #qbvp-{{ sid }} .qbvp__card--accent { border-top: 3px solid var(--qbvp-accent); }

  /* ---------- Badge pill ---------- */
  #qbvp-{{ sid }} .qbvp__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.45em 1.1em;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  #qbvp-{{ sid }} .qbvp__badge--navy   { background: var(--qbvp-navy); color: #fff; border: 1px solid rgba(255,255,255,0.25); }
  #qbvp-{{ sid }} .qbvp__badge--yellow { background: var(--qbvp-accent); color: var(--qbvp-navy); }

  /* ---------- Eyebrow ---------- */
  #qbvp-{{ sid }} .qbvp__eyebrow {
    margin: 0;
    font-size: clamp(0.72rem, 1.4vw, 0.85rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  /* ---------- Discount shimmer ---------- */
  #qbvp-{{ sid }} .qbvp__discount {
    margin: 0;
    font-weight: 800;
    line-height: 1;
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    letter-spacing: 0.01em;
    background: linear-gradient(
      100deg,
      var(--qbvp-accent) 20%,
      #fff2c4 40%,
      var(--qbvp-accent) 60%
    );
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--qbvp-accent); /* fallback */
    animation: qbvp-shimmer-{{ sid }} 4.2s linear infinite;
    filter: drop-shadow(0 3px 14px rgba(0, 0, 0, 0.35));
  }
  @keyframes qbvp-shimmer-{{ sid }} {
    to { background-position: -220% center; }
  }

  /* ---------- Heading (inherits theme heading font via h2) ---------- */
  #qbvp-{{ sid }} .qbvp__heading {
    margin: 0;
    font-size: clamp(1.9rem, 5.5vw, 3.6rem);
    line-height: 1.08;
    color: var(--qbvp-text);
    text-shadow: 0 3px 18px rgba(0, 0, 0, 0.4);
  }
  #qbvp-{{ sid }} .qbvp__hl { color: var(--qbvp-accent); }

  /* ---------- Divider ---------- */
  #qbvp-{{ sid }} .qbvp__divider {
    width: 64px;
    height: 3px;
    border-radius: 3px;
    background: var(--qbvp-accent);
  }

  /* ---------- Subheading ---------- */
  #qbvp-{{ sid }} .qbvp__sub {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(0.95rem, 2vw, 1.12rem);
    line-height: 1.55;
    opacity: 0.94;
  }

  /* ---------- Promo code chip (coupon / ticket) ---------- */
  #qbvp-{{ sid }} .qbvp__code-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  #qbvp-{{ sid }}.qbvp--align-center .qbvp__code-wrap { align-items: center; }
  #qbvp-{{ sid }}.qbvp--align-right  .qbvp__code-wrap { align-items: flex-end; }
  #qbvp-{{ sid }} .qbvp__code {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 48px;
    padding: 0.65rem 1.5rem;
    border: 2px dashed var(--qbvp-accent);
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.28);
    color: var(--qbvp-text);
    font-size: 1.05rem;
    cursor: pointer;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    -webkit-mask:
      radial-gradient(9px at left center, transparent 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(9px at right center, transparent 97%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(9px at left center, transparent 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(9px at right center, transparent 97%, #000) right / 51% 100% no-repeat;
  }
  #qbvp-{{ sid }} .qbvp__code:hover,
  #qbvp-{{ sid }} .qbvp__code:focus-visible {
    box-shadow: 0 0 0 3px rgba(253, 196, 57, 0.25), 0 0 26px rgba(253, 196, 57, 0.45);
    transform: translateY(-2px);
    outline: none;
  }
  #qbvp-{{ sid }} .qbvp__code-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  #qbvp-{{ sid }} .qbvp__code-value {
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--qbvp-accent);
    font-size: 1.25rem;
  }
  #qbvp-{{ sid }} .qbvp__code-copied {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--qbvp-accent);
    color: var(--qbvp-navy);
    font-weight: 800;
    letter-spacing: 0.06em;
    opacity: 0;
    transform: scale(0.92);
    transition: opacity 0.22s ease, transform 0.22s ease;
    pointer-events: none;
  }
  #qbvp-{{ sid }} .qbvp__code.is-copied .qbvp__code-copied {
    opacity: 1;
    transform: scale(1);
  }
  #qbvp-{{ sid }} .qbvp__code-helper {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  /* ---------- Countdown (label + navy pills) ---------- */
  #qbvp-{{ sid }} .qbvp__cd-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  #qbvp-{{ sid }}.qbvp--align-left   .qbvp__cd-group { align-items: flex-start; }
  #qbvp-{{ sid }}.qbvp--align-center .qbvp__cd-group { align-items: center; }
  #qbvp-{{ sid }}.qbvp--align-right  .qbvp__cd-group { align-items: flex-end; }
  #qbvp-{{ sid }} .qbvp__cd-label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--qbvp-accent);
  }
  #qbvp-{{ sid }} .qbvp__countdown {
    display: flex;
    gap: 0.6rem;
    flex-wrap: nowrap;
  }
  #qbvp-{{ sid }} .qbvp__cd-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    padding: 0.55rem 0.7rem;
    border-radius: 14px;
    background: var(--qbvp-navy);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
  }
  #qbvp-{{ sid }} .qbvp__cd-pill span {
    font-size: clamp(1.25rem, 3.4vw, 1.7rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  #qbvp-{{ sid }} .qbvp__cd-pill small {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--qbvp-accent);
  }
  #qbvp-{{ sid }} .qbvp__cd-group.is-expired { display: none; }

  /* ---------- Buttons (QB54 yellow pill + ghost) ---------- */
  #qbvp-{{ sid }} .qbvp__actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.35rem;
  }
  #qbvp-{{ sid }}.qbvp--align-center .qbvp__actions { justify-content: center; }
  #qbvp-{{ sid }}.qbvp--align-right  .qbvp__actions { justify-content: flex-end; }
  #qbvp-{{ sid }} .qbvp__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.85rem 2rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  #qbvp-{{ sid }} .qbvp__btn--primary {
    background: var(--qbvp-btn-bg);
    color: var(--qbvp-btn-text);
  }
  #qbvp-{{ sid }} .qbvp__btn--ghost {
    background: transparent;
    color: var(--qbvp-text);
    border: 2px solid rgba(255, 255, 255, 0.55);
  }
  #qbvp-{{ sid }} .qbvp__btn:hover,
  #qbvp-{{ sid }} .qbvp__btn:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
  }
  #qbvp-{{ sid }} .qbvp__btn-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  #qbvp-{{ sid }} .qbvp__btn:hover .qbvp__btn-arrow { transform: translateX(5px); }
  #qbvp-{{ sid }} .qbvp__btn--shimmer::after {
    content: "";
    position: absolute;
    top: 0;
    left: -80%;
    width: 55%;
    height: 100%;
    background: linear-gradient(105deg, transparent 0%, rgba(255, 255, 255, 0.55) 50%, transparent 100%);
    transform: skewX(-18deg);
    animation: qbvp-sweep-{{ sid }} 4.6s ease-in-out infinite;
  }
  @keyframes qbvp-sweep-{{ sid }} {
    0%, 62%  { left: -80%; }
    82%, 100% { left: 130%; }
  }

  /* ---------- Entrance animations ---------- */
  #qbvp-{{ sid }}.qbvp--animate .qbvp__stagger {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: calc(var(--qbvp-d, 0) * 100ms);
  }
  #qbvp-{{ sid }}.qbvp--animate.is-visible .qbvp__stagger {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 768px) {
    #qbvp-{{ sid }} { min-height: var(--qbvp-mob-h); }
    #qbvp-{{ sid }} .qbvp__card { max-width: 100%; width: 100%; }
    #qbvp-{{ sid }} .qbvp__actions { width: 100%; }
    #qbvp-{{ sid }} .qbvp__btn { width: 100%; }
    #qbvp-{{ sid }} .qbvp__cd-pill { min-width: 56px; }
  }
  @media (max-width: 480px) {
    #qbvp-{{ sid }} .qbvp__inner { padding-left: 1rem; padding-right: 1rem; }
    #qbvp-{{ sid }} .qbvp__cd-pill { min-width: 0; flex: 1; padding: 0.5rem 0.4rem; }
    #qbvp-{{ sid }} .qbvp__countdown,
    #qbvp-{{ sid }} .qbvp__cd-group { width: 100%; }
    {% if section.settings.hide_sub_mobile %}
    #qbvp-{{ sid }} .qbvp__sub--hide-sm { display: none; }
    {% endif %}
  }

  /* ---------- Reduced motion: kill all movement ---------- */
  @media (prefers-reduced-motion: reduce) {
    #qbvp-{{ sid }} .qbvp__video,
    #qbvp-{{ sid }} .qbvp__discount,
    #qbvp-{{ sid }} .qbvp__btn--shimmer::after {
      animation: none !important;
    }
    #qbvp-{{ sid }}.qbvp--animate .qbvp__stagger {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #qbvp-{{ sid }} .qbvp__btn,
    #qbvp-{{ sid }} .qbvp__code {
      transition: none;
    }
  }
{% endstyle %}

{%- comment -%} ============ JS: copy-to-clipboard + countdown + reveal ============ {%- endcomment -%}
<script>
  (function () {
    function initQBVP(root) {
      if (!root || root.dataset.qbvpInit === '1') return;
      root.dataset.qbvpInit = '1';

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Pause video for reduced-motion users (poster stays visible) */
      var video = root.querySelector('.qbvp__video');
      if (reduceMotion && video && video.tagName === 'VIDEO') {
        video.removeAttribute('autoplay');
        video.pause();
      }

      /* ---- Tap-to-copy promo code ---- */
      var copyBtn = root.querySelector('[data-qbvp-copy]');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var code = copyBtn.getAttribute('data-code') || '';
          function done() {
            copyBtn.classList.add('is-copied');
            setTimeout(function () { copyBtn.classList.remove('is-copied'); }, 1600);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(done).catch(function () { fallback(); });
          } else {
            fallback();
          }
          function fallback() {
            var ta = document.createElement('textarea');
            ta.value = code;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
            done();
          }
        });
      }

      /* ---- Countdown ---- */
      var cd = root.querySelector('[data-qbvp-countdown]');
      if (cd) {
        var end = new Date(cd.getAttribute('data-end')).getTime();
        var hideExpired = cd.getAttribute('data-hide-expired') === 'true';

        if (isNaN(end)) {
          /* Invalid date: hide the whole group, never start the interval */
          cd.classList.add('is-expired');
        } else {
          var els = {
            d: cd.querySelector('[data-cd="d"]'),
            h: cd.querySelector('[data-cd="h"]'),
            m: cd.querySelector('[data-cd="m"]'),
            s: cd.querySelector('[data-cd="s"]')
          };
          var timer;
          function pad(n) { return n < 10 ? '0' + n : '' + n; }
          function tick() {
            var diff = end - Date.now();
            if (diff <= 0) {
              if (hideExpired) { cd.classList.add('is-expired'); }
              else { els.d.textContent = els.h.textContent = els.m.textContent = els.s.textContent = '00'; }
              if (timer) clearInterval(timer);
              return;
            }
            els.d.textContent = pad(Math.floor(diff / 86400000));
            els.h.textContent = pad(Math.floor(diff / 3600000) % 24);
            els.m.textContent = pad(Math.floor(diff / 60000) % 60);
            els.s.textContent = pad(Math.floor(diff / 1000) % 60);
          }
          tick();
          timer = setInterval(tick, 1000);
        }
      }

      /* ---- Staggered entrance reveal ---- */
      if (root.dataset.animate === 'true' && !reduceMotion && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              root.classList.add('is-visible');
              io.disconnect();
            }
          });
        }, { threshold: 0.2 });
        io.observe(root);
      } else {
        root.classList.add('is-visible');
      }
    }

    function boot() {
      document.querySelectorAll('[data-qbvp]').forEach(initQBVP);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
    /* Re-init when edited in the Shopify theme editor */
    document.addEventListener('shopify:section:load', function (e) {
      var el = e.target.querySelector('[data-qbvp]');
      if (el) initQBVP(el);
    });
  })();
</script>

