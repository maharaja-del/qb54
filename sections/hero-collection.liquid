<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
    {%- if section.settings.image != blank and section.settings.image_height == 'adapt' %}
      --ratio-percent: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
    {% endif -%}
  }
</style>

{%- liquid
  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif

  assign image_mobile = section.settings.image_mobile | default: section.settings.image
-%}

{%- if image_mobile != blank and section.settings.image_height_mobile == 'adapt' %}
  <style>
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        --ratio-percent: {{ 1 | divided_by: image_mobile.aspect_ratio | times: 100 }}%;
      }
    }
  </style>
{% endif -%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}"{% if section.settings.transparent_header %} allow-transparent-header{% endif %}>
  <div class="{% unless section.settings.full_width %}page-width {% endunless %}relative">
    <div class="banner media--{{ section.settings.image_height }} mobile:media--{{ section.settings.image_height_mobile }} relative">
      <media-element class="banner__media block w-full h-full overflow-hidden"{% if section.settings.enable_parallax and has_video == false %} data-parallax="0.3" data-parallax-dir="{{ section.settings.parallax_direction }}"{% endif %}>
        {%- capture sizes -%}{% if section.settings.full_width %}100vw{% else %}min({{ settings.page_width }}px, 100vw){% endif %}{%- endcapture -%}

        {%- if has_video -%}
          {%- render 'video',
            sizes: sizes,
            video: section.settings.video,
            video_url: section.settings.video_url,
            muted: section.settings.enable_video_autoplay,
            autoplay: section.settings.enable_video_autoplay,
            loop: section.settings.enable_video_looping,
            description: section.settings.video_description,
            cover_image: section.settings.image,
            show_play_button: false,
            class: 'banner__image w-full h-full relative overflow-hidden pointer-events-none'
          -%}
        {%- else -%}
          <picture class="media media--height block w-full h-full relative overflow-hidden">
            {%- if section.settings.image != blank -%}
              {%- if section.settings.image_mobile -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ section.settings.image_mobile | image_url: width: '400x' }} 400w, {{ section.settings.image_mobile | image_url: width: '600x' }} 600w, {{ section.settings.image_mobile | image_url: width: '800x' }} 800w, {{ section.settings.image_mobile | image_url: width: '1000x' }} 1000w"
                  width="{{ section.settings.image_mobile.width }}"
                  height="{{ section.settings.image_mobile.height }}"
                >
              {%- endif -%}

              {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'eager', fetchpriority: 'high', sizes: sizes, widths: '300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', class: 'banner__image' -}}
            {%- else -%}
              {{- 'lifestyle-1' | placeholder_svg_tag: 'banner__image banner__overlay placeholder' -}}
            {%- endif -%}
          </picture>
        {%- endif -%}
      </media-element>

      {%- if section.blocks.size > 0 -%}
        <span class="banner__overlay absolute top-0 left-0 w-full h-full pointer-events-none"></span>
        <div class="banner__content overflow-hidden absolute z-1 top-0 left-0 w-full h-full">
          <div class="page-width w-full h-full flex {{ section.settings.content_position }} {{ section.settings.content_position_mobile }}">
            <div class="banner__box banner__box--{{ section.settings.content_width }} md:text-{{ section.settings.text_alignment }} text-{{ section.settings.text_alignment_mobile }} grid gap-4">
              {%- liquid
                assign with_gradient = false
                if section.settings.gradient_highlight != blank and section.settings.gradient_highlight != 'rgba(0,0,0,0)'
                  assign with_gradient = true
                endif

                assign delay = 0
              -%}
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {%- render block -%}

                  {%- when 'spacing' -%}
                    <empty-element class="block spacing-section{% if block.settings.height_mobile == 0 %} hidden lg:block{% endif %}{% if block.settings.height == 0 %} lg:hidden{% endif %}" style="--spacing-height-desktop: {{ block.settings.height }}px;--spacing-height-mobile: {{ block.settings.height_mobile }}px;" {{ block.shopify_attributes }}></empty-element>

                  {%- when 'badge' -%}
                    {%- if block.settings.text != blank -%}
                      <p class="badge uppercase tracking-widest" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
                    {%- endif -%}

                  {%- when 'subheading' -%}
                    {%- if block.settings.subheading != blank -%}
                      <p class="banner__subheading heading uppercase leading-none tracking-widest {{ block.settings.subheading_size }}{% if block.settings.secondary_color %} banner__text--colored{% endif %}" {{ block.shopify_attributes }}>
                        {{- block.settings.subheading -}}
                      </p>
                    {%- endif -%}

                  {%- when 'heading' -%}
                    {%- if block.settings.heading != blank -%}
                      {%- assign delay = delay | plus: 1 -%}
                      <{{ block.settings.heading_tag }} class="banner__title heading leading-none {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                        {%- render 'heading-content', content: block.settings.heading, style: block.settings.highlighted_text, scribble: block.settings.highlighted_scribble, reveal: block.settings.highlighted_reveal, gradient: with_gradient, delay: delay -%}
                      </{{ block.settings.heading_tag }}>
                    {%- endif -%}

                  {%- when 'text' -%}
                    {%- if block.settings.text != blank -%}
                      <div class="rte {{ block.settings.text_font }} {{ block.settings.text_size }}{% if block.settings.text_font == 'subtitle' %} uppercase leading-tight tracking-widest{% else %} leading-normal{% endif %}{% if block.settings.secondary_color %} text-opacity{% endif %}" {{ block.shopify_attributes }}>
                        {%- render 'highlighted-text', content: block.settings.text, style: block.settings.highlighted_text, scribble: block.settings.highlighted_scribble, gradient: with_gradient -%}
                      </div>
                    {%- endif -%}

                  {%- when 'button' -%}
                    {%- if block.settings.button_label != blank -%}
                      {%- render 'button',
                        label: block.settings.button_label,
                        link: block.settings.button_link,
                        size: block.settings.button_size,
                        style: block.settings.button_style,
                        external: block.settings.button_external,
                        show_icon: block.settings.button_icon,
                        classes: 'button--fixed',
                        shopify_attributes: block.shopify_attributes
                      -%}
                    {%- endif -%}

                  {%- when 'link' -%}
                    {%- if block.settings.label != blank -%}
                      <a class="link inline-block"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% if block.settings.external %} target="_blank" rel="noopener"{% endif %}{% else %} role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
                        {{- block.settings.label -}}
                      </a>
                    {%- endif -%}

                  {%- when 'image' -%}
                    {%- if block.settings.image != blank -%}
                      <div class="leading-none" {{ block.shopify_attributes }}>
                        <figure class="media media--transparent relative inline-block">
                          {%- assign sizes = 'min(100vw, var(--page-width))' -%}
                          {%- assign widths = '50,75,100,150,200,300,400,500,750,1000,1250,1500,1750,2000,2250,2500,2750,3000,3200' -%}
                          {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, is: 'lazy-image', class: 'image-fit' -}}
                        </figure>
                      </div>
                    {%- endif -%}

                  {%- when 'liquid' -%}
                    {%- if block.settings.liquid != blank -%}
                      <div class="rte" {{ block.shopify_attributes }}>
                        {{- block.settings.liquid -}}
                      </div>
                    {%- endif -%}

                  {%- when 'timer' -%}
                    <animate-element data-animate="zoom-out" class="block" {{ block.shopify_attributes }}>
                      {%- capture expiration_date -%}{{ block.settings.year }}-{{ block.settings.month }}-{{ block.settings.day }} {{ block.settings.hour }}:{{ block.settings.minute }}:00{%- endcapture -%}
                      <countdown-timer
                        class="countdown__timer {{ block.settings.text_font }} {{ block.settings.text_size }}{% if block.settings.text_font == 'subtitle' %} uppercase tracking-widest{% endif %} inline-flex text-center"
                        data-expires="{{ expiration_date | date: '%FT%T%:z' | escape }}"
                      >
                        <div class="countdown__item">
                          <p>--</p><span>{{ 'general.date.days' | t }}</span>
                        </div>
                        <div class="countdown__item">
                          <p>--</p><span>{{ 'general.date.hours' | t }}</span>
                        </div>
                        <div class="countdown__item">
                          <p>--</p><span>{{ 'general.date.minutes' | t }}</span>
                        </div>
                        <div class="countdown__item">
                          <p>--</p><span>{{ 'general.date.seconds' | t }}</span>
                        </div>
                      </countdown-timer>
                      {%- if block.settings.message != blank -%}
                        <div class="countdown__message rte subtext-md">
                          {{- block.settings.message -}}
                        </div>
                      {%- endif -%}
                    </animate-element>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero (Collection Launch)",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "t:sections.global.settings.transparent_header.label",
      "info": "t:sections.global.settings.transparent_header.info",
      "default": false
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.global.settings.image.label",
      "info": "Also used as the video poster/cover image when a video is set below."
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        { "label": "t:sections.global.settings.image_height.options__1.label", "value": "adapt" },
        { "label": "t:sections.global.settings.image_height.options__2.label", "value": "400px" },
        { "label": "t:sections.global.settings.image_height.options__3.label", "value": "450px" },
        { "label": "t:sections.global.settings.image_height.options__4.label", "value": "500px" },
        { "label": "t:sections.global.settings.image_height.options__5.label", "value": "550px" },
        { "label": "t:sections.global.settings.image_height.options__6.label", "value": "600px" },
        { "label": "t:sections.global.settings.image_height.options__7.label", "value": "650px" },
        { "label": "t:sections.global.settings.image_height.options__8.label", "value": "700px" },
        { "label": "t:sections.global.settings.image_height.options__9.label", "value": "750px" },
        { "label": "t:sections.global.settings.image_height.options__10.label", "value": "800px" },
        { "label": "t:sections.global.settings.image_height.options__11.label", "value": "850px" },
        { "label": "t:sections.global.settings.image_height.options__12.label", "value": "900px" },
        { "label": "t:sections.global.settings.image_height.options__13.label", "value": "100vh" }
      ],
      "default": "800px",
      "label": "t:sections.global.settings.image_height.label"
    },
    {
      "type": "header",
      "content": "Video (optional)",
      "info": "Overrides the image above when set."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL",
      "info": "Used only if no video is uploaded above."
    },
    {
      "type": "text",
      "id": "video_description",
      "label": "Video accessibility description"
    },
    {
      "type": "checkbox",
      "id": "enable_video_autoplay",
      "label": "t:sections.video.settings.enable_video_autoplay.label",
      "info": "t:sections.video.settings.enable_video_autoplay.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__mobile.content"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.global.settings.image_mobile.label"
    },
    {
      "type": "select",
      "id": "image_height_mobile",
      "options": [
        { "label": "t:sections.global.settings.image_height_mobile.options__1.label", "value": "auto" },
        { "label": "t:sections.global.settings.image_height_mobile.options__2.label", "value": "200px" },
        { "label": "t:sections.global.settings.image_height_mobile.options__3.label", "value": "250px" },
        { "label": "t:sections.global.settings.image_height_mobile.options__4.label", "value": "300px" },
        { "label": "t:sections.global.settings.image_height_mobile.options__5.label", "value": "400px" },
        { "label": "t:sections.global.settings.image_height_mobile.options__6.label", "value": "500px" },
        { "label": "t:sections.global.settings.image_height_mobile.options__7.label", "value": "600px" },
        { "label": "t:sections.global.settings.image_height_mobile.options__8.label", "value": "100vh" },
        { "label": "t:sections.global.settings.image_height_mobile.options__9.label", "value": "adapt" }
      ],
      "default": "500px",
      "label": "t:sections.global.settings.image_height_mobile.label"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "options": [
        { "value": "items-start justify-start", "label": "t:sections.global.settings.content_position.options__1.label" },
        { "value": "items-start justify-center", "label": "t:sections.global.settings.content_position.options__2.label" },
        { "value": "items-start justify-end", "label": "t:sections.global.settings.content_position.options__3.label" },
        { "value": "items-center justify-start", "label": "t:sections.global.settings.content_position.options__4.label" },
        { "value": "items-center justify-center", "label": "t:sections.global.settings.content_position.options__5.label" },
        { "value": "items-center justify-end", "label": "t:sections.global.settings.content_position.options__6.label" },
        { "value": "items-end justify-start", "label": "t:sections.global.settings.content_position.options__7.label" },
        { "value": "items-end justify-center", "label": "t:sections.global.settings.content_position.options__8.label" },
        { "value": "items-end justify-end", "label": "t:sections.global.settings.content_position.options__9.label" }
      ],
      "default": "items-end justify-center",
      "label": "t:sections.global.settings.content_position_mobile.label"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment_mobile",
      "default": "center",
      "label": "t:sections.global.settings.text_alignment_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "select",
      "id": "content_width",
      "options": [
        { "value": "small", "label": "t:sections.global.settings.content_width.options__1.label" },
        { "value": "medium", "label": "t:sections.global.settings.content_width.options__2.label" },
        { "value": "large", "label": "t:sections.global.settings.content_width.options__3.label" }
      ],
      "default": "medium",
      "label": "t:sections.global.settings.content_width.label"
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        { "value": "md:items-start md:justify-start", "label": "t:sections.global.settings.content_position.options__1.label" },
        { "value": "md:items-start md:justify-center", "label": "t:sections.global.settings.content_position.options__2.label" },
        { "value": "md:items-start md:justify-end", "label": "t:sections.global.settings.content_position.options__3.label" },
        { "value": "md:items-center md:justify-start", "label": "t:sections.global.settings.content_position.options__4.label" },
        { "value": "md:items-center md:justify-center", "label": "t:sections.global.settings.content_position.options__5.label" },
        { "value": "md:items-center md:justify-end", "label": "t:sections.global.settings.content_position.options__6.label" },
        { "value": "md:items-end md:justify-start", "label": "t:sections.global.settings.content_position.options__7.label" },
        { "value": "md:items-end md:justify-center", "label": "t:sections.global.settings.content_position.options__8.label" },
        { "value": "md:items-end md:justify-end", "label": "t:sections.global.settings.content_position.options__9.label" }
      ],
      "default": "md:items-end md:justify-center",
      "label": "t:sections.global.settings.content_position.label"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "default": "center",
      "label": "t:sections.global.settings.text_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label",
      "default": "#0a0a0a"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "t:sections.global.settings.color_highlight.label",
      "default": "#a3e635"
    },
    {
      "type": "color_background",
      "id": "gradient_highlight",
      "label": "t:sections.global.settings.gradient_highlight.label"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "t:sections.global.settings.color_button_text.label",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "color_button_background",
      "label": "t:sections.global.settings.color_button_background.label",
      "default": "#a3e635"
    },
    {
      "type": "color_background",
      "id": "color_button_gradient",
      "label": "t:sections.global.settings.color_button_gradient.label"
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "t:sections.global.settings.color_overlay.label",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:sections.global.settings.overlay_opacity.label",
      "default": 55
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.global.settings.enable_parallax.label",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.enable_parallax == true }}",
      "type": "select",
      "id": "parallax_direction",
      "label": "t:sections.global.settings.parallax_direction.label",
      "default": "vertical",
      "options": [
        { "value": "vertical", "label": "t:sections.global.settings.parallax_direction.options__1.label" },
        { "value": "horizontal", "label": "t:sections.global.settings.parallax_direction.options__2.label" },
        { "value": "zoom", "label": "t:sections.global.settings.parallax_direction.options__3.label" }
      ]
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "18 Teams Available"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.global.blocks.heading.name",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Football Fandom, Made Personal", "label": "t:sections.global.settings.heading.label" },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "title-sm", "label": "t:sections.global.settings.heading_size.options__1.label" },
            { "value": "title-md", "label": "t:sections.global.settings.heading_size.options__2.label" },
            { "value": "title-lg tracking-heading", "label": "t:sections.global.settings.heading_size.options__3.label" },
            { "value": "title-xl tracking-heading", "label": "t:sections.global.settings.heading_size.options__4.label" }
          ],
          "default": "title-xl tracking-heading",
          "label": "t:sections.global.settings.heading_size.label"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "options": [
            { "value": "h1", "label": "t:sections.global.settings.heading_tag.options__1.label" },
            { "value": "h2", "label": "t:sections.global.settings.heading_tag.options__2.label" },
            { "value": "h3", "label": "t:sections.global.settings.heading_tag.options__3.label" },
            { "value": "div", "label": "t:sections.global.settings.heading_tag.options__7.label" }
          ],
          "default": "h1",
          "label": "t:sections.global.settings.heading_tag.label",
          "info": "t:sections.global.settings.heading_tag.info"
        },
        { "type": "header", "content": "t:sections.global.settings.header__highlight.content", "info": "t:sections.global.settings.header__highlight.info" },
        {
          "type": "select",
          "id": "highlighted_text",
          "options": [
            { "value": "none", "label": "t:sections.global.settings.highlighted_text.options__1.label" },
            { "value": "text", "label": "t:sections.global.settings.highlighted_text.options__2.label" },
