{% liquid
  assign id = section.id
%}

<section class="hero-foldable-{{ id }}">
  <div class="hero-inner page-width">
    <div class="hero-grid">
      <div class="hero-content">
        {% if section.settings.badge_text != blank %}
          <div class="hero-badge">
            {{ section.settings.badge_text }}
          </div>
        {% endif %}

        <h1 class="hero-heading">
          {{ section.settings.heading }}
        </h1>

        {% if section.settings.subheading != blank %}
          <p class="hero-subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

        <div class="hero-buttons">
          {% if section.settings.primary_button_text != blank %}
            <div class="hero-primary-button-wrap">
              <a href="{{ section.settings.primary_button_url }}" class="btn btn-primary">
                {{ section.settings.primary_button_text }}
              </a>

              {% if section.settings.below_primary_text != blank %}
                <div class="hero-below-primary-text">
                  {{ section.settings.below_primary_text }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.secondary_button_text != blank %}
            <a href="{{ section.settings.secondary_button_url }}" class="btn btn-secondary">
              {{ section.settings.secondary_button_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="hero-media">
        {% if section.settings.image_desktop != blank %}
          <picture>
            {% if section.settings.image_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
            {% endif %}
            <img
              src="{{ section.settings.image_desktop | image_url: width: 1200 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="eager"
              width="1200"
              height="1200">
          </picture>
        {% endif %}
      </div>
    </div>
  </div>

  <style>
    .hero-foldable-{{ id }} {
      background: {{ section.settings.background }};
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .hero-foldable-{{ id }} .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: center;
    }

    .hero-foldable-{{ id }} .hero-badge {
      display: inline-block;
      background: {{ section.settings.badge_bg }};
      color: {{ section.settings.badge_color }};
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 14px;
      margin-bottom: 20px;
    }

    .hero-foldable-{{ id }} .hero-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: 1.1;
      margin-bottom: 16px;
      color: {{ section.settings.heading_color }};
    }

    .hero-foldable-{{ id }} .hero-subheading {
      font-size: {{ section.settings.subheading_size_mobile }}px;
      color: {{ section.settings.subheading_color }};
      margin-bottom: 28px;
    }

    .hero-foldable-{{ id }} .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: flex-start;
    }

    .hero-foldable-{{ id }} .hero-primary-button-wrap {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .hero-foldable-{{ id }} .hero-below-primary-text {
      font-size: {{ section.settings.below_primary_text_size_mobile }}px;
      color: {{ section.settings.below_primary_text_color }};
    }

    .hero-foldable-{{ id }} .btn {
      padding: 14px 28px;
      font-size: 16px;
      border-radius: {{ section.settings.button_radius }}px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
    }

    .hero-foldable-{{ id }} .btn-primary {
      background: {{ section.settings.primary_button_bg }};
      color: {{ section.settings.primary_button_color }};
    }

    .hero-foldable-{{ id }} .btn-secondary {
      background: {{ section.settings.secondary_button_bg }};
      color: {{ section.settings.secondary_button_color }};
      border: 1px solid {{ section.settings.secondary_button_border }};
    }

    .hero-foldable-{{ id }} .hero-media img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: {{ section.settings.image_radius }}px;
    }

    @media (min-width: 750px) {
      .hero-foldable-{{ id }} {
        padding-top: {{ section.settings.padding_top_desktop }}px;
        padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      }

      .hero-foldable-{{ id }} .hero-grid {
        grid-template-columns: 1fr 1fr;
        gap: 60px;
      }

      .hero-foldable-{{ id }} .hero-heading {
        font-size: {{ section.settings.heading_size_desktop }}px;
      }

      .hero-foldable-{{ id }} .hero-subheading {
        font-size: {{ section.settings.subheading_size_desktop }}px;
      }

      .hero-foldable-{{ id }} .hero-below-primary-text {
        font-size: {{ section.settings.below_primary_text_size_desktop }}px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Hero – Foldable Chairs",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "⭐️⭐️⭐️⭐️⭐️ 5-Star Rated Game" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Full Football Game Built Into Two Foldable Chairs" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Portable • Dual-Purpose • Family-Friendly • Safe • Screen-Free Fun" },

    { "type": "text", "id": "below_primary_text", "label": "Text below primary button", "default": "Free shipping • 30-day returns" },
    { "type": "color", "id": "below_primary_text_color", "label": "Below button text color", "default": "#6b7f72" },
    { "type": "range", "id": "below_primary_text_size_mobile", "label": "Below button text size mobile", "min": 12, "max": 18, "step": 1, "default": 14 },
    { "type": "range", "id": "below_primary_text_size_desktop", "label": "Below button text size desktop", "min": 12, "max": 20, "step": 1, "default": 14 },

    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "primary_button_text", "label": "Primary button text", "default": "Shop Now" },
    { "type": "url", "id": "primary_button_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_text", "label": "Secondary button text", "default": "▶ How to Play" },
    { "type": "url", "id": "secondary_button_url", "label": "Secondary button link" },

    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6ef" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1b2a1f" },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#6b7f72" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#ffffff" },
    { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#1b2a1f" },
    { "type": "color", "id": "primary_button_bg", "label": "Primary button background", "default": "#2f5f3f" },
    { "type": "color", "id": "primary_button_color", "label": "Primary button text", "default": "#ffffff" },
    { "type": "color", "id": "secondary_button_bg", "label": "Secondary button background", "default": "#ffffff" },
    { "type": "color", "id": "secondary_button_color", "label": "Secondary button text", "default": "#2f5f3f" },
    { "type": "color", "id": "secondary_button_border", "label": "Secondary button border", "default": "#d4d4c8" },

    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 40, "step": 2, "default": 16 },
    { "type": "range", "id": "image_radius", "label": "Image radius", "min": 0, "max": 40, "step": 2, "default": 12 },

    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 28, "max": 56, "step": 2, "default": 40 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 36, "max": 80, "step": 2, "default": 64 },
    { "type": "range", "id": "subheading_size_mobile", "label": "Subheading size mobile", "min": 14, "max": 22, "step": 1, "default": 16 },
    { "type": "range", "id": "subheading_size_desktop", "label": "Subheading size desktop", "min": 16, "max": 28, "step": 1, "default": 18 },

    { "type": "range", "id": "padding_top_mobile", "label": "Padding top mobile", "min": 20, "max": 120, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "min": 20, "max": 120, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_top_desktop", "label": "Padding top desktop", "min": 40, "max": 200, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Padding bottom desktop", "min": 40, "max": 200, "step": 4, "default": 80 }
  ],
  "presets": [
    { "name": "Hero – Foldable Chairs" }
  ]
}
{% endschema %}
