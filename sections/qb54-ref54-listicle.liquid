    {{ scope }} .qb54-rl-rail { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(5, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding-inline: 0; }
    {{ scope }} .qb54-rl-story:nth-child(even) { transform: translateY(28px); }
    {{ scope }} .qb54-rl-cards { max-width: 980px; margin-inline: auto; gap: 26px; }
    {{ scope }} .qb54-rl-card { padding: 28px; }
    {{ scope }} .qb54-rl-faq__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 72px; align-items: start; }
    {{ scope }} .qb54-rl-faq__aside { position: sticky; top: 100px; }
  }
  @media screen and (max-width: 599px) {
    {{ scope }} .qb54-rl-ctas .qb54-rl-btn { width: 100%; }
    {{ scope }} .qb54-rl-ctas .qb54-rl-buy { width: 100%; }
    {{ scope }} .qb54-rl-bar .qb54-rl-btn small { display: none; }
    {{ scope }} .qb54-rl-price { width: 92px; height: 92px; right: -8px; }
    {{ scope }} .qb54-rl-price strong { font-size: 26px; }
    {{ scope }} .qb54-rl-fly--y { left: -24px; width: 48px; }
    {{ scope }} .qb54-rl-fly--r { right: -20px; width: 52px; }
    {{ scope }} .qb54-rl-fly--b { left: -22px; width: 88px; }
    {{ scope }} .qb54-rl-inset { width: 46%; right: -4px; }
    {{ scope }} .qb54-rl-reason--flip .qb54-rl-inset { left: -4px; }
    {{ scope }} .qb54-rl-pricerow strong { font-size: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { animation: none !important; transition: none !important; }
    {{ scope }}.qb54-rl--js [data-qb54-rl-reveal] { opacity: 1; transform: none; }
  }
  body.qb54-rl-bar-on { padding-bottom: calc(72px + env(safe-area-inset-bottom)); }
  @media screen and (min-width: 750px) { body.qb54-rl-bar-on { padding-bottom: 0; } }
</style>

{%- capture i_cart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h3l2.4 12h11l2.1-8H6.4"/></svg>{%- endcapture -%}
{%- capture i_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture i_arrow_down -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>{%- endcapture -%}
{%- capture i_tv -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="m8 2 4 4 4-4"/></svg>{%- endcapture -%}
{%- capture i_star -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}
{%- capture i_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v12H1zM15 9h4l4 4v3h-8z"/><circle cx="6" cy="18.5" r="2"/><circle cx="18" cy="18.5" r="2"/></svg>{%- endcapture -%}
{%- capture i_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture i_bolt -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.4 2 4.6 13.4h6.1L9.8 22l8.6-11.4h-6.1L13.4 2z"/></svg>{%- endcapture -%}
{%- capture flag_yellow -%}<img src="{{ 'qb54-ref54-sticker-yellow.webp' | asset_url }}" alt="" width="129" height="360" loading="lazy">{%- endcapture -%}
{%- capture flag_red -%}<img src="{{ 'qb54-ref54-sticker-red.webp' | asset_url }}" alt="" width="153" height="360" loading="lazy">{%- endcapture -%}
{%- capture bean_bag -%}<img src="{{ 'qb54-ref54-sticker-bag.webp' | asset_url }}" alt="" width="335" height="189" loading="lazy">{%- endcapture -%}

{%- capture add_button -%}
  {%- if can_buy -%}
    <button type="button" class="qb54-rl-btn qb54-rl-btn--gold" data-qb54-rl-add data-variants="{{ v.id }}" data-title="{{ section.settings.bar_text | default: p.title | escape }}" data-label="{{ section.settings.add_label | escape }}"><span data-qb54-rl-icon>{{ i_cart }}</span><span data-qb54-rl-label>{{ section.settings.add_label | escape }}</span></button>
    <p class="qb54-rl-err" data-qb54-rl-err role="alert" hidden></p>
  {%- else -%}
    <button type="button" class="qb54-rl-btn" disabled>Sold Out</button>
  {%- endif -%}
{%- endcapture -%}

<div id="qb54-rl-{{ section.id }}" class="qb54-rl" data-free="{{ free_ship }}">
  <header class="qb54-rl-bar">
    <div class="qb54-rl-wrap qb54-rl-bar__in">
      <a class="qb54-rl-bar__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{- section.settings.logo | image_url: width: 240 | image_tag: loading: 'eager', alt: shop.name, widths: '120,240', sizes: '120px' -}}
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if p != blank -%}<p class="qb54-rl-bar__mid"><strong>{{ section.settings.bar_text | escape }}</strong> · {{ v.price | money }}</p>{%- endif -%}
      <div class="qb54-rl-bar__end">
        <a class="qb54-rl-cart" href="{{ routes.cart_url }}" aria-label="Cart">{{ i_cart }}<span class="qb54-rl-cart__n" data-qb54-rl-count hidden>0</span></a>
        {%- if can_buy -%}
          <div class="qb54-rl-buy"><button type="button" class="qb54-rl-btn qb54-rl-btn--gold" data-qb54-rl-add data-variants="{{ v.id }}" data-title="{{ section.settings.bar_text | default: p.title | escape }}" data-label="{{ section.settings.bar_cta | escape }}"><span data-qb54-rl-icon>{{ i_cart }}</span><span data-qb54-rl-label>{{ section.settings.bar_cta | escape }}</span></button><p class="qb54-rl-err" data-qb54-rl-err role="alert" hidden></p></div>
        {%- endif -%}
      </div>
    </div>
    <span class="qb54-rl-progress" aria-hidden="true"><i data-qb54-rl-progress></i></span>
  </header>

  <section class="qb54-rl-hero" data-qb54-rl-hero aria-labelledby="qb54-rl-h1-{{ section.id }}">
    <div class="qb54-rl-wrap qb54-rl-hero__grid">
      <div>
        <p class="qb54-rl-kicker"><b>{{ section.settings.kicker_badge | escape }}</b>{{ section.settings.kicker | escape }}</p>
        <h1 class="qb54-rl-title" id="qb54-rl-h1-{{ section.id }}">{{ section.settings.title }}</h1>
        {%- if section.settings.deck != blank -%}<p class="qb54-rl-lede">{{ section.settings.deck | escape }}</p>{%- endif -%}
        <div class="qb54-rl-byline">
          <span class="qb54-rl-byline__av">{%- if section.settings.logo != blank -%}{{- section.settings.logo | image_url: width: 80 | image_tag: loading: 'eager', alt: '' -}}{%- endif -%}</span>
          <span><strong>{{ section.settings.byline | escape }}</strong></span>
          <i aria-hidden="true"></i>
          <span>{{ section.settings.read_time | escape }}</span>
        </div>
        <div class="qb54-rl-ctas">
          {%- if can_buy -%}
            <div class="qb54-rl-buy"><button type="button" class="qb54-rl-btn qb54-rl-btn--gold qb54-rl-btn--shine" data-qb54-rl-add data-variants="{{ v.id }}" data-title="{{ section.settings.bar_text | default: p.title | escape }}" data-label="{{ section.settings.hero_cta | escape }}"><span data-qb54-rl-icon>{{ i_cart }}</span><span data-qb54-rl-label>{{ section.settings.hero_cta | escape }}</span> <small>{{ v.price | money }}</small></button><p class="qb54-rl-err" data-qb54-rl-err role="alert" hidden></p></div>
          {%- endif -%}
          <a class="qb54-rl-btn qb54-rl-btn--ghost" href="#qb54-rl-list-{{ section.id }}">{{ section.settings.hero_cta_2 | escape }}{{ i_arrow_down }}</a>
        </div>
        <ul class="qb54-rl-proof">
          {%- if section.settings.proof_1 != blank -%}<li>{{ i_tv }}{{ section.settings.proof_1 | escape }}</li>{%- endif -%}
          <li>{{ i_star }}
            {%- if set_rating != blank and set_count != blank -%}QB54 rated {{ set_rating.rating | round: 1 }} · {{ set_count }} reviews{%- else -%}{{ section.settings.rating_fallback | escape }}{%- endif -%}
          </li>
          {%- if section.settings.proof_3 != blank -%}<li>{{ i_truck }}{{ section.settings.proof_3 | escape }}</li>{%- endif -%}
        </ul>
      </div>
      <div class="qb54-rl-stage" aria-hidden="true">
        <span class="qb54-rl-fly qb54-rl-fly--y"><img src="{{ 'qb54-ref54-sticker-yellow.webp' | asset_url }}" alt="" width="129" height="360" loading="eager"></span>
        <span class="qb54-rl-fly qb54-rl-fly--r"><img src="{{ 'qb54-ref54-sticker-red.webp' | asset_url }}" alt="" width="153" height="360" loading="eager"></span>
        <span class="qb54-rl-fly qb54-rl-fly--b"><img src="{{ 'qb54-ref54-sticker-bag.webp' | asset_url }}" alt="" width="335" height="189" loading="eager"></span>
        <div class="qb54-rl-phone"><div class="qb54-rl-phone__screen">
          {%- render 'qb54-rl-img', image: section.settings.hero_image, asset: section.settings.hero_asset, alt: '', sizes: '(min-width: 990px) 380px, 78vw', max_width: 760, loading: 'eager', priority: true -%}
        </div></div>
        {%- if p != blank -%}<span class="qb54-rl-price"><span><span>Only</span><strong>{{ v.price | money_without_trailing_zeros }}</strong></span></span>{%- endif -%}
      </div>
    </div>
  </section>


  <section class="qb54-rl-list" id="qb54-rl-list-{{ section.id }}" aria-label="{{ reason_total }} reasons">
    {%- if reason_total > 0 -%}
      <nav class="qb54-rl-toc" aria-label="{{ section.settings.toc_label | escape }}">
        <div class="qb54-rl-wrap">
          <p class="qb54-rl-toc__l">{{ section.settings.toc_label | escape }}</p>
          <ol>
            {%- for block in reason_blocks -%}
              <li><a href="#qb54-rl-r-{{ block.id }}" data-qb54-rl-toc="{{ block.id }}"><span>{{ forloop.index }}</span>{{ block.settings.toc_label | default: block.settings.title | escape }}</a></li>
            {%- endfor -%}
          </ol>
        </div>
      </nav>
    {%- endif -%}
    <div class="qb54-rl-wrap qb54-rl-list__body">
      {%- for block in reason_blocks -%}
        {%- liquid
          assign n = forloop.index
          assign flip = false
          assign n_mod = n | modulo: 2
          if n_mod == 0
            assign flip = true
          endif
          assign n_label = n
          if n < 10
            assign n_label = '0' | append: n
          endif
          assign chips = block.settings.chips | default: '' | split: '|'
        -%}
        <article class="qb54-rl-reason{% if flip %} qb54-rl-reason--flip{% endif %}" id="qb54-rl-r-{{ block.id }}" data-qb54-rl-reason="{{ block.id }}" {{ block.shopify_attributes }}>
          <header class="qb54-rl-reason__head" data-qb54-rl-reveal>
            <p class="qb54-rl-num"><b>{{ n_label }}</b><span>Reason {{ n }} of {{ reason_total }}</span></p>
            <h2>{{ block.settings.title | escape }}{%- if block.settings.accent != blank -%} <em>{{ block.settings.accent | escape }}</em>{%- endif -%}</h2>
          </header>
          <div class="qb54-rl-reason__media{% if block.settings.inset_image != blank or block.settings.inset_asset != blank %} qb54-rl-reason__media--inset{% endif %}" data-qb54-rl-reveal>
            <div class="qb54-rl-frame qb54-rl-frame--{{ block.settings.focal }}"><div class="qb54-rl-frame__in">
              {%- render 'qb54-rl-img', image: block.settings.image, asset: block.settings.asset, alt: block.settings.image_alt, sizes: '(min-width: 990px) 520px, 92vw', max_width: 1080 -%}
            </div></div>
            {%- if block.settings.inset_image != blank or block.settings.inset_asset != blank -%}
              <div class="qb54-rl-inset">
                <div class="qb54-rl-inset__img">
                  {%- render 'qb54-rl-img', image: block.settings.inset_image, asset: block.settings.inset_asset, alt: block.settings.inset_label, sizes: '(min-width: 990px) 240px, 42vw', max_width: 600 -%}
                </div>
                {%- if block.settings.inset_label != blank -%}<span class="qb54-rl-inset__l">{{ block.settings.inset_label | escape }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
          <div class="qb54-rl-reason__body" data-qb54-rl-reveal>
            {{ block.settings.text }}
            {%- if chips.size > 0 -%}
              <ul class="qb54-rl-chips">
                {%- for chip in chips -%}
                  {%- assign chip_lower = chip | downcase -%}
                  <li>
                    {%- if chip_lower contains 'yellow' -%}{{ flag_yellow }}{%- elsif chip_lower contains 'red' -%}{{ flag_red }}{%- elsif chip_lower contains 'bag' -%}{{ bean_bag }}{%- endif -%}
                    {{ chip | strip | escape }}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </article>
        {%- if block.settings.cta_after and p != blank -%}
          <aside class="qb54-rl-strip" aria-label="Buy {{ p.title | escape }}" data-qb54-rl-reveal>
            <span class="qb54-rl-strip__img">{%- if p.featured_image != blank -%}{{- p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' -}}{%- endif -%}</span>
            <span class="qb54-rl-strip__t"><strong>{{ section.settings.strip_title | escape }} · {{ v.price | money }}</strong><span>{{ section.settings.strip_text | escape }}</span></span>
            <div class="qb54-rl-buy">{{ add_button }}</div>
          </aside>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- if p != blank -%}
    <section class="qb54-rl-bag qb54-rl-light" aria-labelledby="qb54-rl-bag-h-{{ section.id }}">
      <div class="qb54-rl-wrap qb54-rl-bag__grid">
        <div class="qb54-rl-bag__img" data-qb54-rl-reveal>
          {%- if p.featured_image != blank -%}
            {{- p.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', sizes: '(min-width: 990px) 560px, 92vw', alt: p.featured_image.alt | default: p.title -}}
          {%- endif -%}
          <span class="qb54-rl-bag__tag">{{ section.settings.bag_tag | escape }}</span>
        </div>
        <div data-qb54-rl-reveal>
          <p class="qb54-rl-eyebrow">{{ section.settings.bag_eyebrow | escape }}</p>
          <h2 class="qb54-rl-h2" id="qb54-rl-bag-h-{{ section.id }}">{{ section.settings.bag_heading }}</h2>
          {%- if section.settings.bag_text != blank -%}<p class="qb54-rl-lede">{{ section.settings.bag_text | escape }}</p>{%- endif -%}
          <ul class="qb54-rl-team">
            {%- for item in bag_items -%}
              {%- assign item_lower = item | downcase -%}
              <li>
                {%- if item_lower contains 'yellow' -%}{{ flag_yellow }}{%- elsif item_lower contains 'red' -%}{{ flag_red }}{%- elsif item_lower contains 'bag' -%}{{ bean_bag }}{%- endif -%}
                {{ item | strip | escape }}<small>{{ section.settings.bag_per | escape }}</small>
              </li>
            {%- endfor -%}
          </ul>
          {%- if section.settings.bag_note != blank -%}<p class="qb54-rl-bag__note">{{ section.settings.bag_note | escape }}</p>{%- endif -%}
          <div class="qb54-rl-pricerow">
            <strong>{{ v.price | money }}</strong>
            {%- if can_buy -%}<span class="qb54-rl-stock">{{ section.settings.stock_note | escape }}</span>{%- endif -%}
          </div>
          <div class="qb54-rl-buy">{{ add_button }}</div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if step_blocks.size > 0 -%}
    <section class="qb54-rl-how qb54-rl-light" aria-labelledby="qb54-rl-how-h-{{ section.id }}">
      <div class="qb54-rl-wrap qb54-rl-how__grid">
        <div class="qb54-rl-how__img" data-qb54-rl-reveal>
          {%- render 'qb54-rl-img', image: section.settings.how_image, asset: section.settings.how_asset, alt: section.settings.how_image_alt, sizes: '(min-width: 990px) 600px, 92vw', max_width: 1200 -%}
        </div>
        <div data-qb54-rl-reveal>
          <p class="qb54-rl-eyebrow">{{ section.settings.how_eyebrow | escape }}</p>
          <h2 class="qb54-rl-h2 qb54-rl-head" id="qb54-rl-how-h-{{ section.id }}">{{ section.settings.how_heading }}</h2>
          <ol class="qb54-rl-steps">
            {%- for block in step_blocks -%}
              <li class="qb54-rl-step" {{ block.shopify_attributes }}>
                <span class="qb54-rl-step__n" aria-hidden="true">{{ forloop.index }}</span>
                <h3>{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if story_blocks.size > 0 -%}
    <section class="qb54-rl-feed" aria-labelledby="qb54-rl-feed-h-{{ section.id }}">
      <div class="qb54-rl-wrap">
        <header class="qb54-rl-head qb54-rl-center" data-qb54-rl-reveal>
          <p class="qb54-rl-eyebrow">{{ section.settings.feed_eyebrow | escape }}</p>
          <h2 class="qb54-rl-h2" id="qb54-rl-feed-h-{{ section.id }}">{{ section.settings.feed_heading }}</h2>
          {%- if section.settings.feed_text != blank -%}<p class="qb54-rl-lede">{{ section.settings.feed_text | escape }}</p>{%- endif -%}
        </header>
        <div class="qb54-rl-rail">
          {%- for block in story_blocks -%}
            <figure class="qb54-rl-story" {{ block.shopify_attributes }}>
              <div class="qb54-rl-story__img">
                {%- render 'qb54-rl-img', image: block.settings.image, asset: block.settings.asset, alt: block.settings.alt, sizes: '(min-width: 990px) 230px, 66vw', max_width: 540 -%}
              </div>
              {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if p != blank -%}
    <section class="qb54-rl-offer" id="qb54-rl-offer-{{ section.id }}" aria-labelledby="qb54-rl-offer-h-{{ section.id }}">
      <div class="qb54-rl-wrap">
        <header class="qb54-rl-head qb54-rl-center" data-qb54-rl-reveal>
          <p class="qb54-rl-eyebrow">{{ section.settings.offer_eyebrow | escape }}</p>
          <h2 class="qb54-rl-h2" id="qb54-rl-offer-h-{{ section.id }}">{{ section.settings.offer_heading }}</h2>
          {%- if section.settings.offer_text != blank -%}<p class="qb54-rl-lede">{{ section.settings.offer_text | escape }}</p>{%- endif -%}
        </header>
        <div class="qb54-rl-cards">
          <article class="qb54-rl-card" data-qb54-rl-reveal>
            <span class="qb54-rl-card__tag">{{ section.settings.card1_tag | escape }}</span>
            <div class="qb54-rl-card__imgs"><div class="qb54-rl-card__img">{%- if p.featured_image != blank -%}{{- p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,700', sizes: '(min-width: 990px) 420px, 88vw', alt: p.title -}}{%- endif -%}</div></div>
            <h3>{{ section.settings.card1_title | escape }}</h3>
            <p class="qb54-rl-card__sub">{{ section.settings.card1_text | escape }}</p>
            <ul class="qb54-rl-lines">
              {%- for item in bag_items -%}<li><span>{{ item | strip | escape }}</span><span>{{ section.settings.bag_per | escape }}</span></li>{%- endfor -%}
            </ul>
            <div class="qb54-rl-card__total"><span>Total</span><strong>{{ v.price | money }}</strong></div>
            <div class="qb54-rl-buy">{{ add_button }}</div>
          </article>

          {%- if combo_ok -%}
            <article class="qb54-rl-card qb54-rl-card--hero" data-qb54-rl-reveal>
              {%- if free_ship > 0 and combo_total >= free_ship -%}<span class="qb54-rl-card__badge">{{ section.settings.card2_badge | escape }}</span>{%- endif -%}
              <span class="qb54-rl-card__tag">{{ section.settings.card2_tag | escape }}</span>
              <div class="qb54-rl-card__imgs">
                <div class="qb54-rl-card__img">{%- if set_p.featured_image != blank -%}{{- set_p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,500', sizes: '(min-width: 990px) 200px, 40vw', alt: set_p.title -}}{%- endif -%}</div>
                <span class="qb54-rl-card__plus" aria-hidden="true">+</span>
                <div class="qb54-rl-card__img">{%- if p.featured_image != blank -%}{{- p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,500', sizes: '(min-width: 990px) 200px, 40vw', alt: p.title -}}{%- endif -%}</div>
              </div>
              <h3>{{ section.settings.card2_title | escape }}</h3>
              <p class="qb54-rl-card__sub">{{ section.settings.card2_text | escape }}</p>
              <ul class="qb54-rl-lines">
                <li><span>{{ section.settings.card2_set_label | default: set_p.title | escape }}</span><span>{{ set_v.price | money }}</span></li>
                <li><span>{{ section.settings.card2_ref_label | default: p.title | escape }}</span><span>{{ v.price | money }}</span></li>
              </ul>
              {%- if free_ship > 0 and combo_total >= free_ship -%}<span class="qb54-rl-ship">{{ i_truck }}Free shipping (orders {{ free_ship | money_without_trailing_zeros }}+)</span>{%- endif -%}
              <div class="qb54-rl-card__total"><span>Total</span><strong>{{ combo_total | money }}</strong></div>
              <div class="qb54-rl-buy">
                <button type="button" class="qb54-rl-btn qb54-rl-btn--gold qb54-rl-btn--shine" data-qb54-rl-add data-variants="{{ set_v.id }},{{ v.id }}" data-title="{{ section.settings.card2_set_label | default: set_p.title | escape }} + {{ section.settings.bar_text | default: p.title | escape }}" data-label="{{ section.settings.card2_cta | escape }}"><span data-qb54-rl-icon>{{ i_cart }}</span><span data-qb54-rl-label>{{ section.settings.card2_cta | escape }}</span></button>
                <p class="qb54-rl-err" data-qb54-rl-err role="alert" hidden></p>
              </div>
              {%- if section.settings.card2_alt_label != blank -%}<p class="qb54-rl-card__alt"><a href="{{ shop_url }}">{{ section.settings.card2_alt_label | escape }}</a></p>{%- endif -%}
            </article>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if faq_blocks.size > 0 -%}
    <section class="qb54-rl-faq qb54-rl-light" aria-labelledby="qb54-rl-faq-h-{{ section.id }}">
      <div class="qb54-rl-wrap qb54-rl-faq__grid">
        <div class="qb54-rl-faq__aside" data-qb54-rl-reveal>
          <p class="qb54-rl-eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
          <h2 class="qb54-rl-h2" id="qb54-rl-faq-h-{{ section.id }}">{{ section.settings.faq_heading }}</h2>
        </div>
        <div>
          {%- for block in faq_blocks -%}
            <details class="qb54-rl-qa"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}<span class="qb54-rl-plus" aria-hidden="true"></span></summary>
              <div class="qb54-rl-qa__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="qb54-rl-final" data-qb54-rl-final aria-labelledby="qb54-rl-final-h-{{ section.id }}">
    <div class="qb54-rl-final__bg" aria-hidden="true">
      {%- render 'qb54-rl-img', image: section.settings.final_image, asset: section.settings.final_asset, alt: '', sizes: '100vw', max_width: 1600 -%}
    </div>
    <div class="qb54-rl-wrap" data-qb54-rl-reveal>
      <h2 id="qb54-rl-final-h-{{ section.id }}">{{ section.settings.final_heading | escape }} <em>{{ section.settings.final_accent | escape }}</em></h2>
      {%- if section.settings.final_text != blank -%}<p class="qb54-rl-lede">{{ section.settings.final_text | escape }}</p>{%- endif -%}
      <div class="qb54-rl-ctas">
        {%- if can_buy -%}
          <div class="qb54-rl-buy"><button type="button" class="qb54-rl-btn qb54-rl-btn--gold qb54-rl-btn--shine" data-qb54-rl-add data-variants="{{ v.id }}" data-title="{{ section.settings.bar_text | default: p.title | escape }}" data-label="{{ section.settings.final_cta | escape }}"><span data-qb54-rl-icon>{{ i_cart }}</span><span data-qb54-rl-label>{{ section.settings.final_cta | escape }}</span> <small>{{ v.price | money }}</small></button><p class="qb54-rl-err" data-qb54-rl-err role="alert" hidden></p></div>
        {%- endif -%}
      </div>
      <ul class="qb54-rl-trust">
        {%- if section.settings.proof_3 != blank -%}<li>{{ i_truck }}{{ section.settings.proof_3 | escape }}</li>{%- endif -%}
        {%- if section.settings.stock_note != blank -%}<li>{{ i_bolt }}{{ section.settings.stock_note | escape }}</li>{%- endif -%}
        {%- if section.settings.returns_note != blank -%}<li>{{ i_shield }}{{ section.settings.returns_note | escape }}</li>{%- endif -%}
      </ul>
    </div>
  </section>

  {%- if can_buy and section.settings.show_sticky_bar -%}
    <div class="qb54-rl-sticky" data-qb54-rl-sticky aria-hidden="true">
      <span class="qb54-rl-sticky__img">{%- if p.featured_image != blank -%}{{- p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' -}}{%- endif -%}</span>
      <span class="qb54-rl-sticky__t"><strong>{{ section.settings.bar_text | escape }}</strong><span>{{ v.price | money }}</span></span>
      <div class="qb54-rl-buy"><button type="button" class="qb54-rl-btn qb54-rl-btn--gold" tabindex="-1" data-qb54-rl-add data-variants="{{ v.id }}" data-title="{{ section.settings.bar_text | default: p.title | escape }}" data-label="{{ section.settings.sticky_cta | escape }}"><span data-qb54-rl-icon>{{ i_cart }}</span><span data-qb54-rl-label>{{ section.settings.sticky_cta | escape }}</span></button><p class="qb54-rl-err" data-qb54-rl-err role="alert" hidden></p></div>
    </div>
  {%- endif -%}

  <div class="qb54-rl-toast" data-qb54-rl-toast role="status" aria-live="polite" hidden>
    <span class="qb54-rl-toast__ok" aria-hidden="true">{{ i_check }}</span>
    <div class="qb54-rl-toast__t"><strong>Added to cart</strong><span data-qb54-rl-toast-meta></span></div>
    {%- if free_ship > 0 -%}
      <div class="qb54-rl-meter" data-qb54-rl-meter>
        <span class="qb54-rl-meter__bar"><i data-qb54-rl-meter-fill></i></span>
        <span class="qb54-rl-meter__t" data-qb54-rl-meter-text></span>
      </div>
    {%- endif -%}
    <div class="qb54-rl-toast__a">
      <a class="qb54-rl-btn qb54-rl-btn--gold" href="{{ routes.root_url | append: '/checkout' | replace: '//', '/' }}">Checkout</a>
      <a class="qb54-rl-toast__cart" href="{{ routes.cart_url }}">View cart</a>
    </div>
    <button type="button" class="qb54-rl-toast__x" data-qb54-rl-toast-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
</div>

<script>
  (function () {
    var id = '{{ section.id }}';
    var root = document.getElementById('qb54-rl-' + id);
    if (!root) return;
    window.__qb54Rl = window.__qb54Rl || {};
    if (window.__qb54Rl[id]) window.__qb54Rl[id].destroy();

    var cleanups = [];
    var shopRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var freeShip = parseInt(root.getAttribute('data-free'), 10) || 0;
    var moneyFormat = {{ shop.money_format | json }};
    root.classList.add('qb54-rl--js');
    function $all(sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); }

    function formatMoney(cents) {
      var value = (cents / 100).toFixed(2);
      var withCommas = value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return String(moneyFormat || '${{ "{{" }}amount}}').replace(/\{\{\s*(\w+)\s*\}\}/, function (m, kind) {
        if (kind === 'amount_no_decimals') return Math.round(cents / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        if (kind === 'amount_with_comma_separator') return value.replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        return withCommas;
      });
    }

    /* ---- Cart count, toast with free-shipping progress ---- */
    var countEls = $all('[data-qb54-rl-count]');
    var toast = root.querySelector('[data-qb54-rl-toast]');
    var toastMeta = root.querySelector('[data-qb54-rl-toast-meta]');
    var meter = root.querySelector('[data-qb54-rl-meter]');
    var toastTimer = 0;
    function updateCount(cart, bump) {
      var count = (cart && cart.item_count) || 0;
      countEls.forEach(function (el) {
        el.textContent = count;
        el.hidden = count === 0;
        if (bump && !reduce) { el.classList.remove('is-bump'); void el.offsetWidth; el.classList.add('is-bump'); }
      });
    }
    function setMeter(total) {
      if (!meter || !freeShip) return;
      var fill = meter.querySelector('[data-qb54-rl-meter-fill]');
      var text = meter.querySelector('[data-qb54-rl-meter-text]');
      var left = freeShip - total;
      var goal = formatMoney(freeShip).replace(/[.,]00(?=\D*$)/, '');
      meter.classList.toggle('is-done', left <= 0);
      if (fill) fill.style.width = Math.min(100, Math.round(total / freeShip * 100)) + '%';
      if (!text) return;
      text.textContent = '';
      var strong = document.createElement('strong');
      if (left <= 0) {
        strong.textContent = 'Free shipping unlocked.';
        text.appendChild(strong);
        text.appendChild(document.createTextNode(' Your order is ' + goal + ' or more.'));
      } else {
        text.appendChild(document.createTextNode('Add '));
        strong.textContent = formatMoney(left);
        text.appendChild(strong);
        text.appendChild(document.createTextNode(' more for free shipping (' + goal + '+).'));
      }
    }
    function hideToast() { clearTimeout(toastTimer); if (toast) toast.hidden = true; }
    function showToast(title, cart) {
      if (!toast) return;
      var count = (cart && cart.item_count) || 0;
      if (toastMeta) toastMeta.textContent = (title ? title + ' · ' : '') + count + (count === 1 ? ' item' : ' items') + ' in your cart';
      setMeter((cart && cart.total_price) || 0);
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(hideToast, 9000);
    }
    cleanups.push(function () { clearTimeout(toastTimer); });
    fetch(shopRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); }).then(function (cart) { updateCount(cart, false); }).catch(function () {});

    /* ---- Add to cart (one or several variants in one request) ---- */
    var cartIcon = '{{ i_cart | strip_newlines }}';
    var checkIcon = '{{ i_check | strip_newlines }}';
    function setButton(btn, mode, message) {
      var label = btn.querySelector('[data-qb54-rl-label]');
      var icon = btn.querySelector('[data-qb54-rl-icon]');
      var err = btn.parentNode.querySelector('[data-qb54-rl-err]');
      btn.classList.remove('is-added', 'is-error');
      btn.removeAttribute('aria-busy');
      if (err) { err.hidden = true; err.textContent = ''; }
      if (mode === 'loading') {
        btn.setAttribute('aria-busy', 'true');
        if (icon) icon.innerHTML = '<span class="qb54-rl-spin"></span>';
        if (label) label.textContent = 'Adding…';
      } else if (mode === 'added') {
        btn.classList.add('is-added');
        if (icon) icon.innerHTML = checkIcon;
        if (label) label.textContent = 'Added';
        setTimeout(function () { setButton(btn, 'idle'); }, 2200);
      } else if (mode === 'error') {
        btn.classList.add('is-error');
        if (icon) icon.innerHTML = cartIcon;
        if (label) label.textContent = 'Try again';
        if (err && message) { err.textContent = message; err.hidden = false; }
      } else {
        if (icon) icon.innerHTML = cartIcon;
        if (label) label.textContent = btn.getAttribute('data-label') || 'Add to cart';
      }
    }
    function addToCart(btn) {
      if (btn.getAttribute('aria-busy') === 'true') return;
      var items = (btn.getAttribute('data-variants') || '').split(',').filter(Boolean).map(function (variantId) { return { id: Number(variantId), quantity: 1 }; });
      if (!items.length) return;
      setButton(btn, 'loading');
      var bundled = [];
      document.documentElement.dispatchEvent(new CustomEvent('cart:bundled-sections', { bubbles: true, detail: { sections: bundled } }));
      var body = { items: items };
      if (bundled.length) { body.sections = bundled.join(','); body.sections_url = window.location.pathname; }
      fetch(shopRoot + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(body)
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, json: j }; }); })
        .then(function (res) {
          if (!res.ok || res.json.status) throw res.json;
          if (window.theme && theme.settings && theme.settings.cartType === 'page') { window.location.href = shopRoot + 'cart'; return; }
          var drawer = document.querySelector('cart-drawer');
          var hasDrawer = !!(drawer && typeof drawer.show === 'function');
          if (hasDrawer) drawer.show(btn);
          return fetch(shopRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (cart) {
              cart.sections = res.json.sections;
              if (window.theme && theme.pubsub && theme.pubsub.publish) theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, { source: 'qb54-ref54', productVariantId: String(items[0].id), cart: cart });
              updateCount(cart, true);
              if (!hasDrawer) showToast(btn.getAttribute('data-title'), cart);
              setButton(btn, 'added');
            });
        })
        .catch(function (error) {
          var message = error && (error.description || error.message);
          setButton(btn, 'error', typeof message === 'string' ? message : 'Something went wrong. Please try again.');
        });
    }
    function onClick(event) {
      if (event.target.closest('[data-qb54-rl-toast-close]')) { hideToast(); return; }
      var btn = event.target.closest('[data-qb54-rl-add]');
      if (btn) { event.preventDefault(); addToCart(btn); }
    }
    root.addEventListener('click', onClick);
    cleanups.push(function () { root.removeEventListener('click', onClick); });

    /* ---- Reading progress ---- */
    var progress = root.querySelector('[data-qb54-rl-progress]');
    var ticking = false;
    function paintProgress() {
      ticking = false;
      if (!progress) return;
      var rect = root.getBoundingClientRect();
      var total = rect.height - window.innerHeight;
      var p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      progress.style.transform = 'scaleX(' + p.toFixed(4) + ')';
    }
    function onScroll() { if (!ticking) { ticking = true; window.requestAnimationFrame(paintProgress); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    cleanups.push(function () { window.removeEventListener('scroll', onScroll); window.removeEventListener('resize', onScroll); });
    paintProgress();

    /* ---- Article nav: highlight the reason being read ---- */
    var tocLinks = $all('[data-qb54-rl-toc]');
    if (tocLinks.length && 'IntersectionObserver' in window) {
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var current = e.target.getAttribute('data-qb54-rl-reason');
          tocLinks.forEach(function (a) { a.setAttribute('aria-current', a.getAttribute('data-qb54-rl-toc') === current ? 'true' : 'false'); });
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      $all('[data-qb54-rl-reason]').forEach(function (el) { spy.observe(el); });
      cleanups.push(function () { spy.disconnect(); });
    }

    /* ---- Mobile sticky bar: after the hero, hidden over the final CTA ---- */
    var sticky = root.querySelector('[data-qb54-rl-sticky]');
    var hero = root.querySelector('[data-qb54-rl-hero]');
    var finalSection = root.querySelector('[data-qb54-rl-final]');
    var heroVisible = true, finalVisible = false;
    function updateSticky() {
      if (!sticky) return;
      var show = !heroVisible && !finalVisible;
      sticky.classList.toggle('is-visible', show);
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
      $all('[data-qb54-rl-sticky] button').forEach(function (b) { b.tabIndex = show ? 0 : -1; });
      document.body.classList.toggle('qb54-rl-bar-on', show);
    }
    if (sticky && 'IntersectionObserver' in window) {
      var stickyIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.target === hero) heroVisible = e.isIntersecting;
          if (e.target === finalSection) finalVisible = e.isIntersecting;
        });
        updateSticky();
      });
      if (hero) stickyIo.observe(hero);
      if (finalSection) stickyIo.observe(finalSection);
      cleanups.push(function () { stickyIo.disconnect(); document.body.classList.remove('qb54-rl-bar-on'); });
    }

    /* ---- Reveal on scroll ---- */
    var reveals = $all('[data-qb54-rl-reveal]');
    if (!reduce && 'IntersectionObserver' in window) {
      var revealIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); revealIo.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      reveals.forEach(function (el) { revealIo.observe(el); });
      cleanups.push(function () { revealIo.disconnect(); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-in'); });
    }

    function onUnload(event) { if (event.detail && event.detail.sectionId === id) destroy(); }
    document.addEventListener('shopify:section:unload', onUnload);
    cleanups.push(function () { document.removeEventListener('shopify:section:unload', onUnload); });
    function destroy() {
      while (cleanups.length) { try { cleanups.pop()(); } catch (e) {} }
      delete window.__qb54Rl[id];
    }
    window.__qb54Rl[id] = { destroy: destroy };
  })();
</script>

{% schema %}
{
  "name": "QB54 REF54 Listicle",
  "tag": "section",
  "class": "qb54-rl-section",
  "settings": [
    { "type": "header", "content": "Products" },
    { "type": "product", "id": "product", "label": "Main product (REF54)" },
    { "type": "product", "id": "set_product", "label": "Game set for the combo card" },
    { "type": "url", "id": "shop_url", "label": "Link to choose another set color" },
    { "type": "range", "id": "free_ship_threshold", "label": "Free shipping threshold", "info": "Shows progress in the cart popup and the combo card badge. 0 turns it off.", "min": 0, "max": 500, "step": 5, "unit": "$", "default": 225 },
    { "type": "header", "content": "Top bar" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "bar_text", "label": "Product name", "default": "REF54" },
    { "type": "text", "id": "bar_cta", "label": "Button", "default": "Add to cart" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "kicker_badge", "label": "Badge", "default": "New" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The flag toss game" },
    { "type": "inline_richtext", "id": "title", "label": "Headline", "default": "5 reasons QB54 owners are adding <em>REF54</em> to game day" },
    { "type": "textarea", "id": "deck", "label": "Intro" },
    { "type": "text", "id": "byline", "label": "Byline", "default": "By the QB54 Team" },
    { "type": "text", "id": "read_time", "label": "Read time", "default": "3 min read" },
    { "type": "image_picker", "id": "hero_image", "label": "Phone image", "info": "Optional. Uses the bundled REF54 story image when empty." },
    { "type": "text", "id": "hero_asset", "label": "Bundled phone image file", "default": "qb54-ref54-story-2.webp" },
    { "type": "text", "id": "hero_cta", "label": "Button", "default": "Add REF54 to cart" },
    { "type": "text", "id": "hero_cta_2", "label": "Second button", "default": "Read the 5 reasons" },
    { "type": "text", "id": "proof_1", "label": "Proof 1", "default": "As seen on Shark Tank" },
    { "type": "text", "id": "rating_fallback", "label": "Proof 2 when no review data", "default": "Hundreds of 5-star reviews" },
    { "type": "text", "id": "proof_3", "label": "Proof 3", "default": "Free shipping on orders $225+" },
    { "type": "header", "content": "The list" },
    { "type": "text", "id": "toc_label", "label": "Article nav label", "default": "In this article" },
    { "type": "text", "id": "strip_title", "label": "Buy strip title", "default": "REF54" },
    { "type": "text", "id": "strip_text", "label": "Buy strip text", "default": "The flag toss game for your QB54 chairs" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "header", "content": "What's in the bag" },
    { "type": "text", "id": "bag_eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "inline_richtext", "id": "bag_heading", "label": "Heading", "default": "Everything for <em>two teams</em>" },
    { "type": "textarea", "id": "bag_text", "label": "Text", "default": "Each team gets its own set to throw." },
    { "type": "text", "id": "bag_items", "label": "Items", "info": "Separate with |", "default": "1 yellow flag|1 red flag|1 blue bean bag" },
    { "type": "text", "id": "bag_per", "label": "Item suffix", "default": "Per team" },
    { "type": "text", "id": "bag_note", "label": "Note", "default": "Pictured: the complete REF54 kit." },
    { "type": "text", "id": "bag_tag", "label": "Image tag", "default": "The REF54 kit" },
    { "type": "text", "id": "stock_note", "label": "Stock note", "default": "In stock, ships within 1 business day" },
    { "type": "text", "id": "returns_note", "label": "Returns note", "default": "30-day returns" },
    { "type": "header", "content": "How to play" },
    { "type": "text", "id": "how_eyebrow", "label": "Eyebrow", "default": "How to play" },
    { "type": "inline_richtext", "id": "how_heading", "label": "Heading", "default": "Game on in <em>3 steps</em>" },
    { "type": "image_picker", "id": "how_image", "label": "Image" },
    { "type": "text", "id": "how_asset", "label": "Bundled image file", "default": "qb54-ref54-target-chair.webp" },
    { "type": "text", "id": "how_image_alt", "label": "Image description", "default": "A QB54 chair set up as the REF54 target" },
    { "type": "header", "content": "Seen in your feed" },
    { "type": "text", "id": "feed_eyebrow", "label": "Eyebrow", "default": "As seen in your feed" },
    { "type": "inline_richtext", "id": "feed_heading", "label": "Heading", "default": "New game. <em>Same QB54 chairs.</em>" },
    { "type": "textarea", "id": "feed_text", "label": "Text" },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "offer_eyebrow", "label": "Eyebrow", "default": "Pick your play" },
    { "type": "inline_richtext", "id": "offer_heading", "label": "Heading", "default": "Add REF54 to <em>game day</em>" },
    { "type": "textarea", "id": "offer_text", "label": "Text" },
