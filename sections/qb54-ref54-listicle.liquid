{%- liquid
  assign scope = '#qb54-rl-' | append: section.id
  assign p = section.settings.product
  assign v = p.selected_or_first_available_variant
  assign set_p = section.settings.set_product
  assign set_v = set_p.selected_or_first_available_variant
  assign free_ship = section.settings.free_ship_threshold | times: 100
  assign shop_url = section.settings.shop_url | default: routes.all_products_collection_url

  assign reason_blocks = section.blocks | where: 'type', 'reason'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign story_blocks = section.blocks | where: 'type', 'story'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign reason_total = reason_blocks.size

  assign can_buy = false
  if p != blank and v.available
    assign can_buy = true
  endif
  assign combo_ok = false
  if can_buy and set_p != blank and set_v.available
    assign combo_ok = true
    assign combo_total = set_v.price | plus: v.price
  endif

  assign set_rating = set_p.metafields.reviews.rating.value
  assign set_count = set_p.metafields.reviews.rating_count.value
  assign bag_items = section.settings.bag_items | split: '|'
-%}

<style>
  {{ scope }} {
    --gold: {{ section.settings.color_gold }};
    --gold-deep: color-mix(in srgb, var(--gold) 80%, #000000);
    --gold-soft: color-mix(in srgb, var(--gold) 18%, transparent);
    --on-gold: #1a1c3a;
    --navy: {{ section.settings.color_navy }};
    --night: {{ section.settings.color_night }};
    --cream: {{ section.settings.color_cream }};
    --paper: #ffffff;
    --ink: #171717;
    --ink-2: #4a4c57;
    --muted: #6b6d78;
    --line: #e6e2d3;
    --line-dark: rgba(255, 255, 255, 0.14);
    --flag-y: #f7c824;
    --flag-r: #d42a3c;
    --bag: #2563eb;
    --turf: #3fae49;
    --ok: #15803d;
    --fh: var(--font-heading-family);
    --fb: var(--font-body-family);
    --pad-y: clamp(64px, 8vw, 116px);
    --max: 1240px;
    --gutter: clamp(16px, 4vw, 40px);
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --ease-emph: cubic-bezier(0.05, 0.7, 0.1, 1);
    --shadow-lg: 0 2px 6px rgba(9, 10, 26, 0.12), 0 40px 80px -36px rgba(9, 10, 26, 0.75);
    position: relative;
    background: var(--night);
    color: #ffffff;
    font-family: var(--fb);
    -webkit-font-smoothing: antialiased;
    /* position + clip: absolutely positioned bits can never widen the page */
    overflow-x: clip;
  }
  {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { box-sizing: border-box; }
  {{ scope }} a { color: inherit; text-decoration: none; }
  {{ scope }} ul, {{ scope }} ol { list-style: none; margin: 0; padding: 0; }
  {{ scope }} p, {{ scope }} blockquote { text-wrap: pretty; }
  {{ scope }} [hidden] { display: none !important; }
  {{ scope }} :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 6px; }
  {{ scope }} img { display: block; max-width: 100%; }
  {{ scope }} .qb54-rl-wrap { width: min(var(--max), 100% - var(--gutter) * 2); margin-inline: auto; }
  {{ scope }} .qb54-rl-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* ---------- Type ---------- */
  {{ scope }} .qb54-rl-h2 { margin: 0; font-family: var(--fh); font-weight: 700; font-size: clamp(36px, 5vw, 66px); line-height: 0.95; letter-spacing: -0.005em; text-transform: uppercase; text-wrap: balance; color: inherit; }
  {{ scope }} .qb54-rl-h2 em { font-style: normal; color: var(--gold); }
  {{ scope }} .qb54-rl-light .qb54-rl-h2 { color: var(--ink); }
  {{ scope }} .qb54-rl-light .qb54-rl-h2 em { color: var(--navy); }
  {{ scope }} .qb54-rl-eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); }
  {{ scope }} .qb54-rl-eyebrow::before { content: ''; width: 28px; height: 3px; border-radius: 3px; background: currentColor; }
  {{ scope }} .qb54-rl-light .qb54-rl-eyebrow { color: var(--navy); }
  {{ scope }} .qb54-rl-center { text-align: center; }
  {{ scope }} .qb54-rl-center .qb54-rl-eyebrow { justify-content: center; }
  {{ scope }} .qb54-rl-center .qb54-rl-eyebrow::after { content: ''; width: 28px; height: 3px; border-radius: 3px; background: currentColor; }
  {{ scope }} .qb54-rl-lede { margin: 18px 0 0; max-width: 60ch; font-size: clamp(16px, 1.3vw, 18.5px); line-height: 1.65; }
  {{ scope }} .qb54-rl-center .qb54-rl-lede { margin-inline: auto; }
  {{ scope }} .qb54-rl-head { margin-bottom: clamp(32px, 4vw, 56px); }

  /* ---------- Buttons ---------- */
  {{ scope }} .qb54-rl-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 26px;
    border: 0;
    border-radius: 10px;
    font-family: var(--fh);
    font-weight: 700;
    font-size: 17px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition: transform 160ms var(--ease), box-shadow 160ms var(--ease), background-color 160ms var(--ease);
  }
  {{ scope }} .qb54-rl-btn svg { width: 18px; height: 18px; flex: none; }
  {{ scope }} .qb54-rl-btn [data-qb54-rl-icon] { display: inline-flex; }
  {{ scope }} .qb54-rl-btn--gold { background: var(--gold); color: var(--on-gold); box-shadow: 0 14px 30px -14px color-mix(in srgb, var(--gold) 70%, transparent); }
  {{ scope }} .qb54-rl-btn--gold:hover { background: color-mix(in srgb, var(--gold) 86%, #ffffff); transform: translateY(-2px); }
  {{ scope }} .qb54-rl-btn--shine::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.7) 48%, transparent 66%); transform: translateX(-120%); animation: qb54-rl-shine 4.2s var(--ease) infinite 1.2s; }
  {{ scope }} .qb54-rl-btn--ghost { background: rgba(255, 255, 255, 0.07); color: #ffffff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.4); }
  {{ scope }} .qb54-rl-btn--ghost:hover { background: rgba(255, 255, 255, 0.14); transform: translateY(-2px); }
  {{ scope }} .qb54-rl-btn--navy { background: var(--navy); color: #ffffff; }
  {{ scope }} .qb54-rl-btn--navy:hover { background: color-mix(in srgb, var(--navy) 85%, #ffffff); transform: translateY(-2px); }
  {{ scope }} .qb54-rl-btn[aria-busy='true'] { pointer-events: none; opacity: 0.85; }
  {{ scope }} .qb54-rl-btn.is-added { background: var(--ok); color: #ffffff; box-shadow: none; }
  {{ scope }} .qb54-rl-btn.is-error { background: #b91c1c; color: #ffffff; box-shadow: none; }
  {{ scope }} .qb54-rl-btn[disabled] { background: #e7e5dd; color: var(--muted); box-shadow: none; cursor: not-allowed; }
  {{ scope }} .qb54-rl-btn small { font-family: var(--fb); font-size: 13px; font-weight: 700; letter-spacing: 0; text-transform: none; opacity: 0.8; }
  {{ scope }} .qb54-rl-spin { width: 18px; height: 18px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: qb54-rl-rot 700ms linear infinite; }
  {{ scope }} .qb54-rl-err { margin: 8px 0 0; font-size: 13px; color: #fca5a5; }
  {{ scope }} .qb54-rl-light .qb54-rl-err { color: #b91c1c; }
  @keyframes qb54-rl-shine { 0% { transform: translateX(-120%); } 55%, 100% { transform: translateX(120%); } }
  @keyframes qb54-rl-rot { to { transform: rotate(360deg); } }

  /* ---------- Sticky top bar + reading progress ---------- */
  {{ scope }} .qb54-rl-bar { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--night) 88%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line-dark); }
  {{ scope }} .qb54-rl-bar__in { display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 68px; }
  {{ scope }} .qb54-rl-bar__logo img { width: auto; height: 40px; }
  {{ scope }} .qb54-rl-bar__logo span { font-family: var(--fh); font-weight: 700; font-size: 24px; }
  {{ scope }} .qb54-rl-bar__mid { display: none; align-items: center; gap: 10px; font-size: 13px; color: rgba(255, 255, 255, 0.72); }
  {{ scope }} .qb54-rl-bar__mid strong { color: #ffffff; }
  {{ scope }} .qb54-rl-bar__end { display: flex; align-items: center; gap: 10px; }
  {{ scope }} .qb54-rl-bar .qb54-rl-btn { min-height: 44px; padding: 0 16px; font-size: 15px; }
  {{ scope }} .qb54-rl-cart { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-dark); color: #ffffff; }
  {{ scope }} .qb54-rl-cart:hover { background: rgba(255, 255, 255, 0.08); }
  {{ scope }} .qb54-rl-cart svg { width: 21px; height: 21px; }
  {{ scope }} .qb54-rl-cart__n { position: absolute; top: -3px; right: -3px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--gold); color: var(--on-gold); font-size: 11px; font-weight: 700; line-height: 20px; text-align: center; }
  {{ scope }} .qb54-rl-cart__n.is-bump { animation: qb54-rl-bump 420ms var(--ease-emph); }
  @keyframes qb54-rl-bump { 0% { transform: scale(0.4); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
  {{ scope }} .qb54-rl-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; overflow: hidden; }
  {{ scope }} .qb54-rl-progress i { display: block; height: 100%; background: linear-gradient(90deg, var(--gold), #ffe08a); transform: scaleX(0); transform-origin: left center; will-change: transform; }

  /* ---------- Hero ---------- */
  {{ scope }} .qb54-rl-hero { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(44px, 6vw, 96px) clamp(56px, 7vw, 110px); background: radial-gradient(900px 620px at 82% 18%, color-mix(in srgb, var(--gold) 20%, transparent), transparent 62%), radial-gradient(900px 520px at 6% 110%, color-mix(in srgb, var(--turf) 26%, transparent), transparent 62%), linear-gradient(180deg, var(--night), color-mix(in srgb, var(--navy) 55%, var(--night))); }
  {{ scope }} .qb54-rl-hero::before {
    content: '';
    position: absolute;
    left: -20%;
    right: -20%;
    bottom: -8%;
    z-index: -1;
    height: 58%;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.07) 0 2px, transparent 2px 9%), linear-gradient(0deg, color-mix(in srgb, var(--turf) 22%, transparent), transparent);
    transform: perspective(640px) rotateX(62deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(0deg, #000 30%, transparent 100%);
    mask-image: linear-gradient(0deg, #000 30%, transparent 100%);
    pointer-events: none;
  }
  {{ scope }} .qb54-rl-hero__grid { display: grid; gap: clamp(36px, 5vw, 72px); align-items: center; }
  {{ scope }} .qb54-rl-kicker { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 7px 14px 7px 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.08); box-shadow: inset 0 0 0 1px var(--line-dark); font-size: 12.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #ffffff; }
  {{ scope }} .qb54-rl-kicker b { padding: 4px 9px; border-radius: 999px; background: var(--gold); color: var(--on-gold); letter-spacing: 0.08em; }
  {{ scope }} .qb54-rl-title { margin: 0; font-family: var(--fh); font-weight: 700; font-size: clamp(42px, 6.2vw, 88px); line-height: 0.92; letter-spacing: -0.01em; text-transform: uppercase; text-wrap: balance; color: #ffffff; }
  {{ scope }} .qb54-rl-title em { font-style: normal; background: linear-gradient(180deg, #fff3c4, var(--gold) 55%, var(--gold-deep)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; padding-right: 0.04em; }
  {{ scope }} .qb54-rl-hero .qb54-rl-lede { color: rgba(255, 255, 255, 0.84); font-size: clamp(17px, 1.4vw, 20px); }
  {{ scope }} .qb54-rl-byline { display: flex; align-items: center; gap: 12px; margin-top: 22px; font-size: 13.5px; color: rgba(255, 255, 255, 0.7); }
  {{ scope }} .qb54-rl-byline__av { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--navy); box-shadow: inset 0 0 0 2px var(--gold); overflow: hidden; }
  {{ scope }} .qb54-rl-byline__av img { width: 30px; height: auto; }
  {{ scope }} .qb54-rl-byline strong { color: #ffffff; font-weight: 700; }
  {{ scope }} .qb54-rl-byline i { width: 4px; height: 4px; border-radius: 50%; background: rgba(255, 255, 255, 0.4); }
  {{ scope }} .qb54-rl-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  {{ scope }} .qb54-rl-hero .qb54-rl-ctas .qb54-rl-btn { min-height: 60px; padding: 0 30px; font-size: 18px; }
  {{ scope }} .qb54-rl-proof { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line-dark); }
  {{ scope }} .qb54-rl-proof li { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 500; color: rgba(255, 255, 255, 0.85); }
  {{ scope }} .qb54-rl-proof svg { width: 17px; height: 17px; color: var(--gold); flex: none; }

  {{ scope }} .qb54-rl-stage { position: relative; justify-self: center; width: min(78vw, 380px); margin-block: 10px 24px; }
  {{ scope }} .qb54-rl-phone { position: relative; z-index: 2; aspect-ratio: 9 / 16; border-radius: 34px; padding: 6px; background: linear-gradient(160deg, var(--gold), var(--gold-deep) 45%, var(--gold)); box-shadow: var(--shadow-lg), 0 0 0 10px rgba(255, 255, 255, 0.04); transform: rotate(-3deg); animation: qb54-rl-tilt 9s ease-in-out infinite; }
  {{ scope }} .qb54-rl-phone__screen { position: relative; width: 100%; height: 100%; border-radius: 28px; overflow: hidden; background: var(--navy); }
  {{ scope }} .qb54-rl-phone__screen img { width: 100%; height: 100%; object-fit: cover; }
  {{ scope }} .qb54-rl-price { position: absolute; z-index: 3; right: -14px; bottom: 16%; display: grid; place-items: center; width: 108px; height: 108px; border-radius: 50%; background: var(--gold); color: var(--on-gold); text-align: center; box-shadow: 0 18px 30px -16px rgba(0, 0, 0, 0.7); transform: rotate(10deg); }
  {{ scope }} .qb54-rl-price span { display: block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  {{ scope }} .qb54-rl-price strong { display: block; font-family: var(--fh); font-weight: 700; font-size: 30px; line-height: 1; }
  {{ scope }} .qb54-rl-fly { position: absolute; z-index: 3; filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.55)) drop-shadow(0 16px 20px rgba(0, 0, 0, 0.5)); animation: qb54-rl-float 6s ease-in-out infinite; pointer-events: none; }
  {{ scope }} .qb54-rl-fly img { width: 100%; height: auto; }
  {{ scope }} .qb54-rl-fly--y { left: -52px; top: 4%; width: 66px; transform: rotate(-24deg); }
  {{ scope }} .qb54-rl-fly--r { right: -44px; top: -4%; width: 72px; animation-delay: -2s; transform: rotate(26deg); }
  {{ scope }} .qb54-rl-fly--b { left: -58px; bottom: 9%; width: 122px; animation-delay: -4s; transform: rotate(-12deg); }
  @keyframes qb54-rl-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -14px; } }
  @keyframes qb54-rl-tilt { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(-1.5deg) translateY(-6px); } }

  /* ---------- Article nav (TOC) ---------- */
  {{ scope }} .qb54-rl-toc { position: relative; z-index: 20; padding-block: 18px; background: var(--night); border-bottom: 1px solid var(--line-dark); }
  {{ scope }} .qb54-rl-toc__l { margin: 0 0 10px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  {{ scope }} .qb54-rl-toc ol { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 calc(var(--gutter) * -1); padding: 2px var(--gutter); scroll-padding-inline: var(--gutter); }
  {{ scope }} .qb54-rl-toc ol::-webkit-scrollbar { display: none; }
  {{ scope }} .qb54-rl-toc a { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 1px var(--line-dark); white-space: nowrap; font-size: 14px; font-weight: 700; color: rgba(255, 255, 255, 0.86); transition: background-color 200ms var(--ease), color 200ms var(--ease), box-shadow 200ms var(--ease); }
  {{ scope }} .qb54-rl-toc a span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); font-family: var(--fh); font-size: 14px; color: var(--gold); }
  {{ scope }} .qb54-rl-toc a:hover { background: rgba(255, 255, 255, 0.12); }
  {{ scope }} .qb54-rl-toc a[aria-current='true'] { background: var(--gold); color: var(--on-gold); box-shadow: none; }
  {{ scope }} .qb54-rl-toc a[aria-current='true'] span { background: var(--on-gold); color: var(--gold); }

  /* ---------- The list ---------- */
  {{ scope }} .qb54-rl-list__body { padding-top: clamp(48px, 6vw, 96px); }
  {{ scope }} .qb54-rl-list { position: relative; padding-block: 0 clamp(48px, 6vw, 96px); background: linear-gradient(180deg, var(--night), color-mix(in srgb, var(--navy) 70%, var(--night)) 40%, var(--night)); }
  {{ scope }} .qb54-rl-reason { display: grid; gap: 22px; grid-template-areas: 'head' 'media' 'body'; align-items: center; scroll-margin-top: 150px; }
  {{ scope }} .qb54-rl-reason + .qb54-rl-reason, {{ scope }} .qb54-rl-strip + .qb54-rl-reason { margin-top: clamp(72px, 9vw, 140px); }
  {{ scope }} .qb54-rl-reason__head { grid-area: head; }
  {{ scope }} .qb54-rl-reason__media { grid-area: media; position: relative; }
  {{ scope }} .qb54-rl-reason__body { grid-area: body; }
  {{ scope }} .qb54-rl-reason__media--inset { margin-bottom: 40px; }
  {{ scope }} .qb54-rl-num { display: flex; align-items: flex-end; gap: 14px; margin: 0 0 14px; }
  {{ scope }} .qb54-rl-num b { font-family: var(--fh); font-weight: 700; font-size: clamp(76px, 9vw, 140px); line-height: 0.78; letter-spacing: -0.03em; background: linear-gradient(180deg, #fff3c4, var(--gold) 50%, var(--gold-deep)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; padding-bottom: 0.04em; }
  {{ scope }} .qb54-rl-num span { margin-bottom: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  {{ scope }} .qb54-rl-reason h2 { margin: 0; font-family: var(--fh); font-weight: 700; font-size: clamp(34px, 4.4vw, 60px); line-height: 0.95; letter-spacing: -0.005em; text-transform: uppercase; text-wrap: balance; color: #ffffff; }
  {{ scope }} .qb54-rl-reason h2 em { display: block; font-style: normal; color: var(--gold); }
  {{ scope }} .qb54-rl-reason__body { font-size: clamp(16.5px, 1.3vw, 18.5px); line-height: 1.7; color: rgba(255, 255, 255, 0.84); }
  {{ scope }} .qb54-rl-reason__body p { margin: 0 0 14px; max-width: 58ch; }
  {{ scope }} .qb54-rl-reason__body p:last-child { margin-bottom: 0; }
  {{ scope }} .qb54-rl-reason__body strong { color: #ffffff; }

  {{ scope }} .qb54-rl-frame { position: relative; aspect-ratio: 4 / 5; border-radius: 28px; padding: 4px; background: linear-gradient(160deg, var(--gold), var(--gold-deep) 50%, var(--gold)); box-shadow: var(--shadow-lg); }
  {{ scope }} .qb54-rl-frame__in { position: relative; width: 100%; height: 100%; border-radius: 24px; overflow: hidden; background: var(--navy); }
  {{ scope }} .qb54-rl-frame__in img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease); }
  @media (hover: hover) { {{ scope }} .qb54-rl-reason:hover .qb54-rl-frame__in img { transform: scale(1.035); } }
  {{ scope }} .qb54-rl-frame--top .qb54-rl-frame__in img { object-position: center 20%; }
  {{ scope }} .qb54-rl-frame--bottom .qb54-rl-frame__in img { object-position: center 80%; }
  {{ scope }} .qb54-rl-inset { position: absolute; z-index: 2; right: -10px; bottom: -26px; width: 44%; transform: rotate(4deg); }
  {{ scope }} .qb54-rl-reason--flip .qb54-rl-inset { right: auto; left: -10px; transform: rotate(-4deg); }
  {{ scope }} .qb54-rl-inset__img { aspect-ratio: 5 / 4; border-radius: 18px; padding: 3px; background: var(--gold); box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.75); }
  {{ scope }} .qb54-rl-inset__img img { width: 100%; height: 100%; object-fit: cover; border-radius: 15px; background: #ffffff; }
  {{ scope }} .qb54-rl-inset__l { position: absolute; left: 12px; bottom: -12px; padding: 6px 11px; border-radius: 999px; background: var(--night); box-shadow: inset 0 0 0 1px var(--gold); font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); white-space: nowrap; }

  {{ scope }} .qb54-rl-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  {{ scope }} .qb54-rl-chips li { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.07); box-shadow: inset 0 0 0 1px var(--line-dark); font-size: 14px; font-weight: 700; color: #ffffff; }
  {{ scope }} .qb54-rl-chips img { width: 30px; height: 30px; padding: 4px; border-radius: 50%; background: #ffffff; object-fit: contain; }

  /* Inline buy strip */
