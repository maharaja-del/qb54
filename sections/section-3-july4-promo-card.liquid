{% comment %}
  QB54 — 4th of July Promo Card (Section 3)
  Compact split-layout promotional card with live countdown,
  coupon chip, and flag visuals. Perfect for product and
  collection pages — sits above/below product grids.

  sections/qb54-july4-promo-card.liquid
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Anton&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
  #qb54-promocard-{{ section.id }} {
    --pc-bg:    {{ section.settings.color_bg }};
    --pc-text:  {{ section.settings.color_text }};
    --pc-red:   {{ section.settings.color_red }};
    --pc-blue:  {{ section.settings.color_blue }};
    --pc-gold:  {{ section.settings.color_gold }};
    --pc-muted: color-mix(in srgb, {{ section.settings.color_text }} 55%, transparent);
    --pc-line:  color-mix(in srgb, {{ section.settings.color_text }} 12%, transparent);

    position: relative;
    margin: {{ section.settings.margin_top }}px auto {{ section.settings.margin_bottom }}px;
    max-width: {{ section.settings.max_width }}px;
    padding: 0 clamp(16px, 3vw, 40px);
    font-family: 'Sora', sans-serif;
    -webkit-font-smoothing: antialiased;
    isolation: isolate;
  }

  /* ── CARD SHELL ── */
  #qb54-promocard-{{ section.id }} .pc-card {
    position: relative;
    background: var(--pc-bg);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--pc-text) 10%, transparent);
    box-shadow: 0 24px 80px rgba(0,0,0,0.45);
  }

  /* ── STRIPE BACKGROUND ── */
  #qb54-promocard-{{ section.id }} .pc-stripes {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      -12deg,
      color-mix(in srgb, var(--pc-red) 18%, transparent) 0px,
      color-mix(in srgb, var(--pc-red) 18%, transparent) 32px,
      transparent 32px,
      transparent 64px
    );
    mask-image: radial-gradient(ellipse 75% 90% at 90% 55%, #000 10%, transparent 68%);
    animation: pc-wave 8s ease-in-out infinite;
  }
  @keyframes pc-wave {
    0%, 100% { transform: translateX(0); }
    50%       { transform: translateX(-20px); }
  }

  /* ── GLOW ORBS ── */
  #qb54-promocard-{{ section.id }} .pc-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
    z-index: 0;
  }
  #qb54-promocard-{{ section.id }} .pc-orb-1 {
    width: 280px; height: 280px;
    bottom: -100px; right: -60px;
    background: var(--pc-red);
    opacity: 0.18;
  }
  #qb54-promocard-{{ section.id }} .pc-orb-2 {
    width: 320px; height: 320px;
    top: -120px; left: -80px;
    background: var(--pc-blue);
    opacity: 0.3;
  }

  /* ── STAR FIELD ── */
  #qb54-promocard-{{ section.id }} .pc-stars {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 6% 20%, rgba(255,255,255,0.9), transparent),
      radial-gradient(1.2px 1.2px at 14% 58%, rgba(255,255,255,0.7), transparent),
      radial-gradient(1.8px 1.8px at 22% 12%, rgba(255,255,255,0.85), transparent),
      radial-gradient(1.3px 1.3px at 8%  72%, rgba(255,255,255,0.6), transparent),
      radial-gradient(1.6px 1.6px at 18% 38%, var(--pc-gold), transparent),
      radial-gradient(1.2px 1.2px at 4%  48%, rgba(255,255,255,0.75), transparent);
    mask-image: linear-gradient(to right, #000 0%, #000 28%, transparent 48%);
    animation: pc-twinkle 3.5s ease-in-out infinite;
  }
  @keyframes pc-twinkle { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

  /* ── CANTON (navy left strip with stars) ── */
  #qb54-promocard-{{ section.id }} .pc-canton {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 7px;
    background: var(--pc-blue);
    z-index: 2;
  }

  /* ── FIREWORK SPARKS ── */
  #qb54-promocard-{{ section.id }} .pc-spark {
    position: absolute; z-index: 2; pointer-events: none;
    width: 4px; height: 4px; border-radius: 50%; opacity: 0;
  }
  #qb54-promocard-{{ section.id }} .pc-spark::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    box-shadow:
      0 -22px 0 -1.5px currentColor, 0 22px 0 -1.5px currentColor,
      22px 0 0 -1.5px currentColor, -22px 0 0 -1.5px currentColor,
      16px -16px 0 -2px currentColor, -16px 16px 0 -2px currentColor,
      16px 16px 0 -2px currentColor, -16px -16px 0 -2px currentColor;
  }
  #qb54-promocard-{{ section.id }} .pc-spark-1 { top: 22%; right: 32%; color: var(--pc-gold); animation: pc-spark-go 4s ease-out infinite; }
  #qb54-promocard-{{ section.id }} .pc-spark-2 { top: 55%; right: 18%; color: var(--pc-red);  animation: pc-spark-go 4s ease-out 1.6s infinite; }
  #qb54-promocard-{{ section.id }} .pc-spark-3 { top: 15%; right: 50%; color: #fff;           animation: pc-spark-go 4s ease-out 2.8s infinite; }
  @keyframes pc-spark-go {
    0%   { opacity:0; transform:scale(0.1); }
    10%  { opacity:1; }
    50%  { opacity:0.8; transform:scale(1); }
    75%  { opacity:0; }
    100% { opacity:0; }
  }

  /* ── INNER LAYOUT ── */
  #qb54-promocard-{{ section.id }} .pc-inner {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 60px);
    padding: clamp(28px, 4vw, 44px) clamp(28px, 4vw, 52px);
  }

  /* ── LEFT: FLAG ICON + SALE ── */
  #qb54-promocard-{{ section.id }} .pc-flag-col {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  #qb54-promocard-{{ section.id }} .pc-flag-icon {
    font-size: clamp(48px, 7vw, 76px);
    line-height: 1;
    filter: drop-shadow(0 4px 16px rgba(0,0,0,0.5));
  }
  #qb54-promocard-{{ section.id }} .pc-discount-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--pc-red);
    color: #fff;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.3);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--pc-red) 45%, transparent);
    white-space: nowrap;
  }

  /* ── CENTER: TEXT ── */
  #qb54-promocard-{{ section.id }} .pc-text-col {
    flex: 1;
    min-width: 0;
  }
  #qb54-promocard-{{ section.id }} .pc-eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pc-gold);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #qb54-promocard-{{ section.id }} .pc-eyebrow::before {
    content: '';
    width: 18px; height: 1px;
    background: var(--pc-gold);
    opacity: 0.6;
  }
  #qb54-promocard-{{ section.id }} .pc-headline {
    font-family: 'Anton', sans-serif;
    font-size: clamp(26px, 3.6vw, 44px);
    line-height: 0.88;
    text-transform: uppercase;
    color: var(--pc-text);
    margin-bottom: 14px;
  }
  #qb54-promocard-{{ section.id }} .pc-headline em {
    font-style: normal;
    background: repeating-linear-gradient(180deg, var(--pc-red) 0, var(--pc-red) 50%, #fff 50%, #fff 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #qb54-promocard-{{ section.id }} .pc-sub {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.6;
    color: var(--pc-muted);
    margin-bottom: 18px;
    font-weight: 400;
    max-width: 420px;
  }

  /* ── MINI COUNTDOWN ── */
  #qb54-promocard-{{ section.id }} .pc-countdown {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  #qb54-promocard-{{ section.id }} .pc-cd-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pc-muted);
    flex-shrink: 0;
  }
  #qb54-promocard-{{ section.id }} .pc-cd-cells {
    display: flex;
    gap: 5px;
    align-items: center;
  }
  #qb54-promocard-{{ section.id }} .pc-cd-cell {
    background: color-mix(in srgb, #000 35%, var(--pc-bg));
    border: 1px solid color-mix(in srgb, var(--pc-gold) 25%, var(--pc-line));
    border-radius: 7px;
    padding: 6px 10px;
    text-align: center;
    min-width: 46px;
    transition: transform 0.2s;
  }
  #qb54-promocard-{{ section.id }} .pc-cd-cell.pulse .pc-cd-num { animation: pc-tick 0.5s ease-out; }
  @keyframes pc-tick { 0%{transform:scale(1);color:#fff;} 50%{transform:scale(1.14);} 100%{transform:scale(1);color:var(--pc-gold);} }
  #qb54-promocard-{{ section.id }} .pc-cd-num {
    font-family: 'Anton', sans-serif;
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1;
    color: var(--pc-gold);
    display: block;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 14px color-mix(in srgb, var(--pc-gold) 50%, transparent);
  }
  #qb54-promocard-{{ section.id }} .pc-cd-unit {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pc-muted);
    display: block;
    margin-top: 3px;
  }
  #qb54-promocard-{{ section.id }} .pc-cd-colon {
    font-family: 'Anton', sans-serif;
    font-size: 20px;
    color: var(--pc-gold);
    opacity: 0.5;
    margin: 0 -1px;
    padding-bottom: 8px;
  }

  /* ── COUPON ROW ── */
  #qb54-promocard-{{ section.id }} .pc-coupon-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  #qb54-promocard-{{ section.id }} .pc-coupon {
    display: inline-flex;
    align-items: center;
    gap: 0;
    border: 1.5px dashed color-mix(in srgb, var(--pc-gold) 60%, transparent);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: rgba(0,0,0,0.22);
    position: relative;
    transition: border-color 0.2s, transform 0.2s;
  }
  #qb54-promocard-{{ section.id }} .pc-coupon:hover {
    border-color: var(--pc-gold);
    transform: translateY(-1px);
  }
  #qb54-promocard-{{ section.id }} .pc-coupon::before,
  #qb54-promocard-{{ section.id }} .pc-coupon::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 10px; height: 10px;
    background: var(--pc-bg);
    border-radius: 50%;
    transform: translateY(-50%);
    z-index: 1;
  }
  #qb54-promocard-{{ section.id }} .pc-coupon::before { left: -5px; }
  #qb54-promocard-{{ section.id }} .pc-coupon::after  { right: -5px; }
  #qb54-promocard-{{ section.id }} .pc-coupon-tag {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pc-gold);
    padding: 7px 10px;
    border-right: 1px dashed color-mix(in srgb, var(--pc-gold) 30%, transparent);
    white-space: nowrap;
  }
  #qb54-promocard-{{ section.id }} .pc-coupon-code {
    font-family: 'Anton', sans-serif;
    font-size: clamp(14px, 1.8vw, 18px);
    letter-spacing: 0.12em;
    color: var(--pc-text);
    padding: 7px 11px;
    white-space: nowrap;
  }
  #qb54-promocard-{{ section.id }} .pc-coupon-copy {
    padding: 7px 10px;
    color: var(--pc-muted);
    display: flex; align-items: center;
    transition: color 0.2s;
  }
  #qb54-promocard-{{ section.id }} .pc-coupon:hover .pc-coupon-copy { color: var(--pc-gold); }
  #qb54-promocard-{{ section.id }} .pc-coupon-copy svg { width:13px; height:13px; }
  #qb54-promocard-{{ section.id }} .pc-coupon-feedback {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--pc-gold); color: #061a06;
    font-size: 10px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase;
    opacity: 0; transition: opacity 0.2s; pointer-events: none;
  }
  #qb54-promocard-{{ section.id }} .pc-coupon.copied .pc-coupon-feedback { opacity: 1; }

  /* ── CTA BUTTON ── */
  #qb54-promocard-{{ section.id }} .pc-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--pc-gold);
    color: #061a06;
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 13px 26px;
    border-radius: 999px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--pc-gold) 40%, transparent);
    transition: transform 0.2s, box-shadow 0.2s, gap 0.2s;
  }
  #qb54-promocard-{{ section.id }} .pc-cta:hover {
    transform: translateY(-2px);
    gap: 13px;
    box-shadow: 0 18px 44px color-mix(in srgb, var(--pc-gold) 50%, transparent);
  }

  /* ── BOTTOM STRIPES BAR ── */
  #qb54-promocard-{{ section.id }} .pc-bottom-bar {
    height: 8px;
    background: repeating-linear-gradient(90deg,
      var(--pc-red) 0 33.33%,
      #fff 33.33% 66.66%,
      var(--pc-blue) 66.66% 100%);
    opacity: 0.85;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 820px) {
    #qb54-promocard-{{ section.id }} .pc-inner {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 20px;
    }
    #qb54-promocard-{{ section.id }} .pc-flag-col {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }
  }
  @media (max-width: 600px) {
    #qb54-promocard-{{ section.id }} .pc-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px 22px;
    }
    #qb54-promocard-{{ section.id }} .pc-flag-col {
      flex-direction: row;
      gap: 12px;
      width: 100%;
    }
    #qb54-promocard-{{ section.id }} .pc-flag-icon { font-size: 40px; }
    #qb54-promocard-{{ section.id }} .pc-headline  { font-size: clamp(22px, 8vw, 36px); }
    #qb54-promocard-{{ section.id }} .pc-sub       { font-size: 13px; }
    #qb54-promocard-{{ section.id }} .pc-countdown { gap: 6px; }
    #qb54-promocard-{{ section.id }} .pc-cd-cell   { min-width: 40px; padding: 5px 8px; }
    #qb54-promocard-{{ section.id }} .pc-coupon-row { flex-direction: column; align-items: flex-start; gap: 8px; }
    #qb54-promocard-{{ section.id }} .pc-cta { width: 100%; justify-content: center; }
    #qb54-promocard-{{ section.id }} .pc-spark { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #qb54-promocard-{{ section.id }} .pc-stripes,
    #qb54-promocard-{{ section.id }} .pc-stars,
    #qb54-promocard-{{ section.id }} .pc-spark { animation: none !important; }
    #qb54-promocard-{{ section.id }} .pc-spark { opacity: 0.2; }
  }
</style>

<div id="qb54-promocard-{{ section.id }}">
  <div class="pc-card">
    <div class="pc-stripes"></div>
    <div class="pc-orb pc-orb-1"></div>
    <div class="pc-orb pc-orb-2"></div>
    <div class="pc-stars"></div>
    <div class="pc-canton"></div>
    <span class="pc-spark pc-spark-1"></span>
    <span class="pc-spark pc-spark-2"></span>
    <span class="pc-spark pc-spark-3"></span>

    <div class="pc-inner">

      <!-- FLAG + DISCOUNT PILL -->
      <div class="pc-flag-col">
        <div class="pc-flag-icon">{{ section.settings.flag_emoji }}</div>
        {% if section.settings.discount_label != blank %}
          <div class="pc-discount-pill">★ {{ section.settings.discount_label }}</div>
        {% endif %}
      </div>

      <!-- TEXT + COUNTDOWN + COUPON -->
      <div class="pc-text-col">

        {% if section.settings.eyebrow != blank %}
          <div class="pc-eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        <h2 class="pc-headline">
          {%- if section.settings.heading_striped != blank -%}
            <em>{{ section.settings.heading_striped }}</em><br>
          {%- endif -%}
          {{ section.settings.heading_plain }}
        </h2>

        {% if section.settings.subtitle != blank %}
          <p class="pc-sub">{{ section.settings.subtitle }}</p>
        {% endif %}

        {% if section.settings.show_countdown %}
          <div class="pc-countdown">
            <span class="pc-cd-label">{{ section.settings.countdown_label }}</span>
            <div class="pc-cd-cells" id="pc-cd-{{ section.id }}">
              <div class="pc-cd-cell"><span class="pc-cd-num" data-unit="days">--</span><span class="pc-cd-unit">D</span></div>
              <span class="pc-cd-colon">:</span>
              <div class="pc-cd-cell"><span class="pc-cd-num" data-unit="hours">--</span><span class="pc-cd-unit">H</span></div>
              <span class="pc-cd-colon">:</span>
              <div class="pc-cd-cell"><span class="pc-cd-num" data-unit="minutes">--</span><span class="pc-cd-unit">M</span></div>
              <span class="pc-cd-colon">:</span>
              <div class="pc-cd-cell"><span class="pc-cd-num" data-unit="seconds">--</span><span class="pc-cd-unit">S</span></div>
            </div>
          </div>
        {% endif %}

        <div class="pc-coupon-row">
          {% if section.settings.show_coupon and section.settings.coupon_code != blank %}
            <button type="button" class="pc-coupon" id="pc-coupon-{{ section.id }}" data-code="{{ section.settings.coupon_code | escape }}" aria-label="Copy coupon {{ section.settings.coupon_code | escape }}">
              <span class="pc-coupon-tag">Code</span>
              <span class="pc-coupon-code">{{ section.settings.coupon_code }}</span>
              <span class="pc-coupon-copy" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
              </span>
              <span class="pc-coupon-feedback">✓ Copied!</span>
            </button>
          {% endif %}
          {% if section.settings.cta_label != blank %}
            <a href="{{ section.settings.cta_url | default: '#' }}" class="pc-cta">{{ section.settings.cta_label }} →</a>
          {% endif %}
        </div>

      </div>
    </div>

    <div class="pc-bottom-bar"></div>
  </div>
</div>

<script>
(function(){
  var sid = '{{ section.id }}';
  var targetIso = '{{ section.settings.target_date }}T{{ section.settings.target_time }}:00{{ section.settings.timezone_offset }}';
  var target = new Date(targetIso);
  if (isNaN(target.getTime())) {
    var now = new Date();
    target = new Date(now.getFullYear(), 6, 4, 23, 59, 0);
    if (target < now) target = new Date(now.getFullYear() + 1, 6, 4, 23, 59, 0);
  }

  var cd = document.getElementById('pc-cd-' + sid);
  if (cd) {
    var cells = {
      days:    cd.querySelector('[data-unit="days"]'),
      hours:   cd.querySelector('[data-unit="hours"]'),
      minutes: cd.querySelector('[data-unit="minutes"]'),
      seconds: cd.querySelector('[data-unit="seconds"]')
    };
    var last = { days: null, hours: null, minutes: null, seconds: null };
    function pad(n){ return n < 10 ? '0' + n : '' + n; }
    function tick(){
      var diff = target - Date.now();
      if (diff <= 0) { cd.closest('.pc-countdown') && (cd.closest('.pc-countdown').style.display = 'none'); return; }
      var v = {
        days:    Math.floor(diff / 86400000),
        hours:   Math.floor((diff % 86400000) / 3600000),
        minutes: Math.floor((diff % 3600000) / 60000),
        seconds: Math.floor((diff % 60000) / 1000)
      };
      for (var k in cells) {
        if (cells[k] && v[k] !== last[k]) {
          cells[k].textContent = pad(v[k]);
          if (last[k] !== null) {
            var cell = cells[k].parentElement;
            cell.classList.remove('pulse'); void cell.offsetWidth; cell.classList.add('pulse');
          }
          last[k] = v[k];
        }
      }
    }
    tick(); setInterval(tick, 1000);
  }

  /* Coupon copy */
  var btn = document.getElementById('pc-coupon-' + sid);
  if (btn) {
    var t;
    function show(){ btn.classList.add('copied'); clearTimeout(t); t = setTimeout(function(){ btn.classList.remove('copied'); }, 1700); }
    btn.addEventListener('click', function(){
      var code = btn.dataset.code;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(show).catch(function(){ fb(code); show(); });
      } else { fb(code); show(); }
      function fb(c){ var ta = document.createElement('textarea'); ta.value=c; ta.style.cssText='position:absolute;left:-9999px'; document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');}catch(e){} document.body.removeChild(ta); }
    });
  }
})();
</script>

{% schema %}
{
  "name": "🎇 4th July Promo Card",
  "tag": "div",
  "class": "qb54-promocard-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
