{%- liquid
  assign collection_blocks = section.blocks | where: 'type', 'collection'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --sbc-ink: {{ section.settings.color_text }};
    --sbc-paper: {{ section.settings.color_background }};
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .sbc {
    background: var(--sbc-paper);
    color: var(--sbc-ink);
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .sbc-shell {
    width: min(1280px, 100% - 48px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .sbc-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .sbc-eyebrow {
    display: block;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #363a66;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .sbc-title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    font-size: clamp(28px, 3.4vw, 44px);
    margin: 0;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .sbc-link {
    flex: 0 0 auto;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sbc-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }

  #shopify-section-{{ section.id }} .sbc-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .sbc-card {
    position: relative;
    grid-column: span 2;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 8px;
    padding: 22px;
    color: #ffffff;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 10px 26px rgb(23 23 23 / 0.12);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }
  #shopify-section-{{ section.id }} .sbc-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px rgb(23 23 23 / 0.18);
  }

  #shopify-section-{{ section.id }} .sbc-card.is-featured {
    grid-column: span 3;
    grid-row: span 2;
    min-height: 420px;
    padding: 32px;
  }

  #shopify-section-{{ section.id }} .sbc-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .sbc-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .sbc-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(190deg, rgba(23,23,23,0) 30%, rgba(23,23,23,0.78) 100%);
  }

  #shopify-section-{{ section.id }} .sbc-card.tone-navy .sbc-card__media { background: linear-gradient(155deg, #262a4c, #363a66); }
  #shopify-section-{{ section.id }} .sbc-card.tone-navy-deep .sbc-card__media { background: linear-gradient(155deg, #1c1f38, #2a2e56); }
  #shopify-section-{{ section.id }} .sbc-card.tone-ink .sbc-card__media { background: linear-gradient(155deg, #232323, #171717); }
  #shopify-section-{{ section.id }} .sbc-card.tone-gold .sbc-card__media { background: linear-gradient(155deg, #a3781c, #fdc439); }
  #shopify-section-{{ section.id }} .sbc-card.tone-gold { color: #363a66; }
  #shopify-section-{{ section.id }} .sbc-card.tone-gold .sbc-card__media::after { background: linear-gradient(190deg, rgba(38,42,76,0) 30%, rgba(38,42,76,0.62) 100%); }

  #shopify-section-{{ section.id }} .sbc-card__body {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .sbc-card__count {
    display: block;
    font-family: var(--font-body-family);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.82;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .sbc-card__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    line-height: 1.05;
    font-size: 19px;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sbc-card.is-featured .sbc-card__title { font-size: clamp(26px, 2.6vw, 34px); }

  #shopify-section-{{ section.id }} .sbc-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .sbc-card__cta svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform 180ms ease;
  }
  #shopify-section-{{ section.id }} .sbc-card:hover .sbc-card__cta svg { transform: translateX(3px); }

  #shopify-section-{{ section.id }} .sbc-empty {
    padding: 44px 24px;
    text-align: center;
    color: rgb(var(--color-foreground) / 0.6);
    background: rgb(var(--color-foreground) / 0.04);
    border-radius: 8px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sbc-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #shopify-section-{{ section.id }} .sbc-card { grid-column: span 2; }
    #shopify-section-{{ section.id }} .sbc-card.is-featured { grid-column: span 4; grid-row: span 1; min-height: 300px; }
  }

  @media screen and (max-width: 640px) {
    #shopify-section-{{ section.id }} .sbc-head { flex-direction: column; align-items: flex-start; gap: 12px; }
    #shopify-section-{{ section.id }} .sbc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    #shopify-section-{{ section.id }} .sbc-card { grid-column: span 1; min-height: 168px; padding: 16px; }
    #shopify-section-{{ section.id }} .sbc-card.is-featured { grid-column: span 2; min-height: 240px; padding: 22px; }
    #shopify-section-{{ section.id }} .sbc-card__title { font-size: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .sbc-card,
    #shopify-section-{{ section.id }} .sbc-card__cta svg { transition: none; }
  }
</style>

<div class="sbc">
  <div class="sbc-shell">
    <div class="sbc-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="sbc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="sbc-title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.view_all_link != blank -%}
        <a class="sbc-link" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if collection_blocks.size > 0 -%}
      <div class="sbc-grid">
        {%- for block in collection_blocks -%}
          {%- assign coll = block.settings.collection -%}
          <a
            class="sbc-card{% if forloop.first %} is-featured{% endif %} tone-{% cycle 'navy', 'ink', 'gold', 'navy-deep' %}"
            href="{{ coll.url | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <span class="sbc-card__media">
              {%- if coll.featured_image != blank -%}
                {{- coll.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '360,540,720,900',
                    sizes: '(max-width: 640px) 92vw, (max-width: 989px) 46vw, 32vw',
                    alt: coll.featured_image.alt | default: coll.title
                -}}
              {%- endif -%}
            </span>
            <span class="sbc-card__body">
              {%- if coll.products_count -%}
                <span class="sbc-card__count">{{ coll.products_count }} {% if coll.products_count == 1 %}Product{% else %}Products{% endif %}</span>
              {%- endif -%}
              <span class="sbc-card__title">{{ coll.title | escape }}</span>
              <span class="sbc-card__cta">
                Shop Now
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
              </span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="sbc-empty">Add collection blocks to populate this showcase.</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Category (Bento)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the lineup"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for every part of game day."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" link label",
      "default": "All Collections"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View all\" link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#f4f2e8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 8,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category (Bento)",
      "category": "Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  }
}
{% endschema %}
