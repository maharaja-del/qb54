{%- style -%}
  /* GLOBAL SAFETY */
  .game-set-hero, .game-set-hero * { box-sizing: border-box; }
  
  .game-set-hero {
    background: {{ section.settings.section_bg }};
    overflow: hidden;
    width: 100%;
    position: relative;
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
  }
  
  .game-set-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  
  .game-set-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .game-set-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba({{ section.settings.overlay_color | color_extract: 'red' }}, {{ section.settings.overlay_color | color_extract: 'green' }}, {{ section.settings.overlay_color | color_extract: 'blue' }}, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }
  
  .game-set-hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ section.settings.content_padding_y }}px {{ section.settings.content_padding_x }}px;
    text-align: center;
  }
  
  .game-set-hero-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};
    padding: {{ section.settings.badge_padding_y }}px {{ section.settings.badge_padding_x }}px;
    border-radius: {{ section.settings.badge_radius }}px;
    font-size: {{ section.settings.badge_font_size }}px;
    font-weight: {{ section.settings.badge_font_weight }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: {{ section.settings.badge_margin_bottom }}px;
  }
  
  .game-set-hero-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    max-width: {{ section.settings.heading_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .game-set-hero-text {
    font-size: {{ section.settings.text_font_size }}px;
    color: {{ section.settings.text_color }};
    line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    margin: 0 0 {{ section.settings.text_margin_bottom }}px 0;
    max-width: {{ section.settings.text_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .game-set-hero-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.button_gap }}px;
    flex-wrap: wrap;
  }
  
  .game-set-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    white-space: nowrap;
  }
  
  .game-set-hero-btn--primary {
    background: {{ section.settings.primary_btn_bg }};
    color: {{ section.settings.primary_btn_text_color }};
    border: 2px solid {{ section.settings.primary_btn_bg }};
  }
  
  .game-set-hero-btn--primary:hover {
    background: {{ section.settings.primary_btn_hover_bg }};
    border-color: {{ section.settings.primary_btn_hover_bg }};
    transform: translateY(-2px);
  }
  
  .game-set-hero-btn--secondary {
    background: {{ section.settings.secondary_btn_bg }};
    color: {{ section.settings.secondary_btn_text_color }};
    border: 2px solid {{ section.settings.secondary_btn_border }};
  }
  
  .game-set-hero-btn--secondary:hover {
    background: {{ section.settings.secondary_btn_hover_bg }};
    color: {{ section.settings.secondary_btn_hover_text }};
    border-color: {{ section.settings.secondary_btn_hover_border }};
    transform: translateY(-2px);
  }
  
  .game-set-hero-btn-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  
  .game-set-hero-btn-icon svg {
    width: 100%;
    height: 100%;
  }
  
  /* MOBILE IMAGE */
  .game-set-hero-mobile-bg {
    display: none;
  }
  
  @media (max-width: 768px) {
    .game-set-hero {
      min-height: {{ section.settings.mobile_section_height }}px;
    }
    
    .game-set-hero-bg {
      display: none;
    }
    
    .game-set-hero-mobile-bg {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    
    .game-set-hero-mobile-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    
    .game-set-hero-content {
      padding: {{ section.settings.mobile_content_padding_y }}px {{ section.settings.mobile_content_padding_x }}px;
    }
    
    .game-set-hero-badge {
      font-size: {{ section.settings.mobile_badge_font_size }}px;
      padding: {{ section.settings.mobile_badge_padding_y }}px {{ section.settings.mobile_badge_padding_x }}px;
      margin-bottom: {{ section.settings.mobile_badge_margin_bottom }}px;
    }
    
    .game-set-hero-heading {
      font-size: {{ section.settings.mobile_heading_font_size }}px;
      margin-bottom: {{ section.settings.mobile_heading_margin_bottom }}px;
      max-width: 100%;
    }
    
    .game-set-hero-text {
      font-size: {{ section.settings.mobile_text_font_size }}px;
      margin-bottom: {{ section.settings.mobile_text_margin_bottom }}px;
      max-width: 100%;
    }
    
    .game-set-hero-buttons {
      flex-direction: column;
      gap: {{ section.settings.mobile_button_gap }}px;
    }
    
    .game-set-hero-btn {
      width: 100%;
      max-width: 300px;
      padding: {{ section.settings.mobile_button_padding_y }}px {{ section.settings.mobile_button_padding_x }}px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }
  }
  
  @media (max-width: 480px) {
    .game-set-hero {
      min-height: {{ section.settings.mobile_section_height | times: 0.8 | round }}px;
    }
    
    .game-set-hero-content {
      padding: {{ section.settings.mobile_content_padding_y | times: 0.8 | round }}px {{ section.settings.mobile_content_padding_x | times: 0.8 | round }}px;
    }
    
    .game-set-hero-heading {
      font-size: {{ section.settings.mobile_heading_font_size | times: 0.9 | round }}px;
    }
    
    .game-set-hero-text {
      font-size: {{ section.settings.mobile_text_font_size | times: 0.9 | round }}px;
    }
  }
{%- endstyle -%}

<section class="game-set-hero">
  <!-- Desktop Background -->
  <div class="game-set-hero-bg">
    {% if section.settings.desktop_bg_image != blank %}
      {{ section.settings.desktop_bg_image | image_url: width: 1920 | image_tag: loading: 'lazy' }}
    {% endif %}
  </div>
  
  <!-- Mobile Background -->
  <div class="game-set-hero-mobile-bg">
    {% if section.settings.mobile_bg_image != blank %}
      {{ section.settings.mobile_bg_image | image_url: width: 768 | image_tag: loading: 'lazy' }}
    {% endif %}
  </div>
  
  <!-- Overlay -->
  {% if section.settings.show_overlay %}
    <div class="game-set-hero-overlay"></div>
  {% endif %}
  
  <!-- Content -->
  <div class="game-set-hero-content">
    {% if section.settings.badge_text != blank %}
      <div class="game-set-hero-badge">
        {{ section.settings.badge_text }}
      </div>
    {% endif %}
    
    {% if section.settings.heading != blank %}
      <h1 class="game-set-hero-heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}
    
    {% if section.settings.text != blank %}
      <p class="game-set-hero-text">
        {{ section.settings.text }}
      </p>
    {% endif %}
    
    <div class="game-set-hero-buttons">
      {% if section.settings.primary_btn_text != blank %}
        <a href="{{ section.settings.primary_btn_link }}" class="game-set-hero-btn game-set-hero-btn--primary">
          {{ section.settings.primary_btn_text }}
          {% if section.settings.show_primary_btn_icon %}
            <span class="game-set-hero-btn-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </span>
          {% endif %}
        </a>
      {% endif %}
      
      {% if section.settings.secondary_btn_text != blank %}
        <a href="{{ section.settings.secondary_btn_link }}" class="game-set-hero-btn game-set-hero-btn--secondary">
          {{ section.settings.secondary_btn_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const btn = document.querySelector('a.game-set-hero-btn.game-set-hero-btn--secondary');
  const target = document.querySelector('#scrolltoHere');

  if (btn && target) {
    btn.addEventListener('click', function(e){
      e.preventDefault();
      target.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    });
  }
});
</script>
