{%- style -%}
  /* GLOBAL SAFETY */
  .game-rules-steps, .game-rules-steps * { box-sizing: border-box; }
  
  .game-rules-steps {
    background: {{ section.settings.section_bg }};
    overflow-x: hidden;
    width: 100%;
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  }
  
  .game-rules-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }
  
  /* HEADER SECTION */
  .game-rules-header {
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }
  
  .game-rules-badge {
    display: inline-block;
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_font_size }}px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  
  .game-rules-title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
  }
  
  .game-rules-subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_font_size }}px;
    line-height: 1.6;
    margin: 0;
    max-width: 600px;
    margin: 0 auto;
  }
  
  /* STEPS SECTION */
  .game-rules-steps-wrapper {
    margin-top: {{ section.settings.steps_margin_top }}px;
  }
  
  .game-rules-steps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
    position: relative;
  }
  
  /* CONNECTING LINES */
  .game-rules-steps-grid::before {
    content: '';
    position: absolute;
    top: 50px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: {{ section.settings.line_color }};
    z-index: 1;
  }
  
  .game-rules-step {
    position: relative;
    z-index: 2;
  }
  
  .game-rules-step-circle {
    width: {{ section.settings.circle_size }}px;
    height: {{ section.settings.circle_size }}px;
    border: {{ section.settings.circle_border_width }}px solid {{ section.settings.circle_border_color }};
    border-radius: 50%;
    background: {{ section.settings.circle_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    position: relative;
    z-index: 3;
  }
  
  .game-rules-step-number {
    color: {{ section.settings.step_number_color }};
    font-size: {{ section.settings.step_number_font_size }}px;
    font-weight: 800;
    line-height: 1;
  }
  
  .game-rules-step-title {
    color: {{ section.settings.step_title_color }};
    font-size: {{ section.settings.step_title_font_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  
  .game-rules-step-description {
    color: {{ section.settings.step_description_color }};
    font-size: {{ section.settings.step_description_font_size }}px;
    line-height: 1.5;
    margin: 0;
  }
  
  /* CTA BUTTON SECTION */
  .game-rules-cta-wrapper {
    margin-top: {{ section.settings.button_margin_top }}px;
    text-align: center;
  }
  
  .game-rules-cta-button {
    display: inline-block;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    transition: all 0.3s ease;
    letter-spacing: {{ section.settings.button_letter_spacing | times: 0.01 }}em;
    text-transform: {% if section.settings.button_uppercase %}uppercase{% else %}none{% endif %};
    cursor: pointer;
  }
  
  .game-rules-cta-button:hover {
    background: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_border_color }};
    transform: translateY({{ section.settings.button_hover_transform }}px);
  }
  
  /* RESPONSIVE DESIGN */
  @media (max-width: 768px) {
    .game-rules-steps {
      padding: {{ section.settings.mobile_section_padding_top }}px 0 {{ section.settings.mobile_section_padding_bottom }}px;
    }
    
    .game-rules-container {
      padding: 0 16px;
    }
    
    .game-rules-header {
      margin-bottom: {{ section.settings.mobile_header_margin_bottom }}px;
    }
    
    .game-rules-badge {
      font-size: {{ section.settings.mobile_badge_font_size }}px;
    }
    
    .game-rules-title {
      font-size: {{ section.settings.mobile_title_font_size }}px;
    }
    
    .game-rules-subtitle {
      font-size: {{ section.settings.mobile_subtitle_font_size }}px;
    }
    
    .game-rules-steps-wrapper {
      margin-top: {{ section.settings.mobile_steps_margin_top }}px;
    }
    
    .game-rules-steps-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    
    /* HIDE CONNECTING LINE ON MOBILE */
    .game-rules-steps-grid::before {
      display: none;
    }
    
    .game-rules-step-circle {
      width: {{ section.settings.mobile_circle_size }}px;
      height: {{ section.settings.mobile_circle_size }}px;
      margin-bottom: 20px;
    }
    
    .game-rules-step-number {
      font-size: {{ section.settings.mobile_step_number_font_size }}px;
    }
    
    .game-rules-step-title {
      font-size: {{ section.settings.mobile_step_title_font_size }}px;
    }
    
    .game-rules-step-description {
      font-size: {{ section.settings.mobile_step_description_font_size }}px;
    }
    
    /* MOBILE BUTTON */
    .game-rules-cta-wrapper {
      margin-top: {{ section.settings.mobile_button_margin_top }}px;
    }
    
    .game-rules-cta-button {
      padding: {{ section.settings.mobile_button_padding_y }}px {{ section.settings.mobile_button_padding_x }}px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }
  }
{%- endstyle -%}

<section class="game-rules-steps">
  <div class="game-rules-container">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'header' %}
          <div class="game-rules-header" {{ block.shopify_attributes }}>
            {% if block.settings.badge_text != blank %}
              <div class="game-rules-badge">{{ block.settings.badge_text }}</div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h2 class="game-rules-title">{{ block.settings.title }}</h2>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="game-rules-subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}
          </div>
        
        {% when 'steps_container' %}
          <div class="game-rules-steps-wrapper" {{ block.shopify_attributes }}>
            <div class="game-rules-steps-grid">
              {% for step_block in section.blocks %}
                {% if step_block.type == 'step' %}
                  <div class="game-rules-step" {{ step_block.shopify_attributes }}>
                    <div class="game-rules-step-circle">
                      <span class="game-rules-step-number">{{ step_block.settings.step_number }}</span>
                    </div>
                    {% if step_block.settings.step_title != blank %}
                      <h3 class="game-rules-step-title">{{ step_block.settings.step_title }}</h3>
                    {% endif %}
                    {% if step_block.settings.step_description != blank %}
                      <p class="game-rules-step-description">{{ step_block.settings.step_description }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        
        {% when 'cta_button' %}
          {% if block.settings.button_text != blank %}
            <div class="game-rules-cta-wrapper" {{ block.shopify_attributes }}>
              {% if block.settings.button_link != blank %}
                <a href="{{ block.settings.button_link }}" class="game-rules-cta-button">
                  {{ block.settings.button_text }}
                </a>
              {% else %}
                <span class="game-rules-cta-button">
                  {{ block.settings.button_text }}
                </span>
              {% endif %}
            </div>
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
</section>

