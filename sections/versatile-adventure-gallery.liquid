{%- style -%}
  /* GLOBAL SAFETY */
  .adventure-gallery, .adventure-gallery * { box-sizing: border-box; }
  
  .adventure-gallery {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.section_padding }}px 0;
    overflow: hidden;
    width: 100%;
  }
  
  .adventure-gallery-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  /* HEADER STYLES */
  .adventure-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_bottom_spacing }}px;
  }
  
  .adventure-badge {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.badge_color }};
    margin-bottom: 16px;
    display: block;
  }
  
  .adventure-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.1;
    color: {{ section.settings.title_color }};
    margin-bottom: 24px;
  }
  
  .adventure-title-highlight {
    color: {{ section.settings.title_highlight_color }};
    font-style: italic;
  }
  
  .adventure-description {
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
    color: {{ section.settings.description_color }};
    max-width: 700px;
    margin: 0 auto;
  }
  
  /* GRID LAYOUT */
  .adventure-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: {{ section.settings.grid_gap }}px;
    margin-top: {{ section.settings.grid_top_spacing }}px;
  }
  
  .adventure-card {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    min-height: {{ section.settings.card_height }}px;
    cursor: pointer;
    transition: transform 0.3s ease;
  }
  
  .adventure-card:hover {
    transform: scale(1.02);
  }
  
  .adventure-card--large {
    grid-row: span 2;
    min-height: {{ section.settings.large_card_height }}px;
  }
  
  .adventure-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .adventure-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%, transparent 60%);
    z-index: 1;
  }
  
  .adventure-card-content {
    position: absolute;
    bottom: {{ section.settings.card_content_padding }}px;
    left: {{ section.settings.card_content_padding }}px;
    right: {{ section.settings.card_content_padding }}px;
    z-index: 2;
    color: #ffffff;
  }
  
  .adventure-card-title {
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  
  .adventure-card-text {
    font-size: {{ section.settings.card_text_size }}px;
    line-height: 1.4;
    opacity: 0.9;
  }
  
  /* MOBILE RESPONSIVENESS */
  @media (max-width: 768px) {
    .adventure-gallery {
      padding: {{ section.settings.mobile_section_padding }}px 0;
    }
    
    .adventure-gallery-inner {
      padding: 0 16px;
    }
    
    .adventure-header {
      margin-bottom: {{ section.settings.mobile_header_spacing }}px;
    }
    
    .adventure-badge {
      font-size: 12px;
      margin-bottom: 12px;
    }
    
    .adventure-title {
      font-size: {{ section.settings.mobile_title_size }}px;
      margin-bottom: 20px;
    }
    
    .adventure-description {
      font-size: {{ section.settings.mobile_description_size }}px;
    }
    
    .adventure-grid {
      display: block;
      gap: {{ section.settings.mobile_grid_gap }}px;
      margin-top: {{ section.settings.mobile_grid_top_spacing }}px;
    }
    
    .adventure-card {
      margin-bottom: {{ section.settings.mobile_grid_gap }}px;
      min-height: {{ section.settings.mobile_card_height }}px;
    }
    
    .adventure-card--large {
      grid-row: unset;
      min-height: {{ section.settings.mobile_card_height }}px;
    }
    
    .adventure-card-title {
      font-size: {{ section.settings.mobile_card_title_size }}px;
    }
    
    .adventure-card-text {
      font-size: {{ section.settings.mobile_card_text_size }}px;
    }
    
    .adventure-card-content {
      bottom: {{ section.settings.mobile_card_padding }}px;
      left: {{ section.settings.mobile_card_padding }}px;
      right: {{ section.settings.mobile_card_padding }}px;
    }
  }
  
  @media (max-width: 480px) {
    .adventure-title {
      font-size: {{ section.settings.mobile_title_size | minus: 8 }}px;
    }
    
    .adventure-card {
      min-height: {{ section.settings.mobile_card_height | minus: 50 }}px;
    }
  }
{%- endstyle -%}

<section class="adventure-gallery">
  <div class="adventure-gallery-inner">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'header' %}
          <div class="adventure-header" {{ block.shopify_attributes }}>
            {% if block.settings.badge_text != blank %}
              <span class="adventure-badge">{{ block.settings.badge_text }}</span>
            {% endif %}
            {% if block.settings.title_part_1 != blank or block.settings.title_part_2 != blank %}
              <h2 class="adventure-title">
                {{ block.settings.title_part_1 }}
                {% if block.settings.title_part_2 != blank %}
                  <span class="adventure-title-highlight">{{ block.settings.title_part_2 }}</span>
                {% endif %}
              </h2>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="adventure-description">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        
        {% when 'gallery_start' %}
          <div class="adventure-grid" {{ block.shopify_attributes }}>
        
        {% when 'gallery_card' %}
          <div class="adventure-card{% if block.settings.is_large %} adventure-card--large{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'adventure-card-image', loading: 'lazy' }}
            {% endif %}
            <div class="adventure-card-overlay"></div>
            <div class="adventure-card-content">
              {% if block.settings.card_title != blank %}
                <h3 class="adventure-card-title">{{ block.settings.card_title }}</h3>
              {% endif %}
              {% if block.settings.card_text != blank %}
                <p class="adventure-card-text">{{ block.settings.card_text }}</p>
              {% endif %}
            </div>
          </div>
        
        {% when 'gallery_end' %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

