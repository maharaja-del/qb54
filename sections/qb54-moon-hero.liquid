{% comment %} QB54 × Moon Media — Hero Section {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@300;400;600;700;800&display=swap" rel="stylesheet">

<style>
  #qb-hero-{{ section.id }} {
    --qb: {{ section.settings.color_qb }};
    --moon: {{ section.settings.color_moon }};
    --bg: {{ section.settings.color_bg }};

    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 100px 48px 80px;
    background: var(--bg);
    font-family: 'Sora', sans-serif;
  }

  #qb-hero-{{ section.id }} .hero-bg-overlay {
    position: absolute; inset: 0; z-index: 0;
    background:
      linear-gradient(to bottom, rgba(7,13,7,.75) 0%, rgba(7,13,7,.45) 40%, rgba(7,13,7,.9) 100%),
      radial-gradient(ellipse at 20% 80%, rgba(185,249,0,.12) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 20%, rgba(255,45,85,.07) 0%, transparent 50%);
  }

  /* Floating phones */
  #qb-hero-{{ section.id }} .hero-vids {
    position: absolute; inset: 0; z-index: 1; pointer-events: none; overflow: hidden;
  }
  #qb-hero-{{ section.id }} .hero-vids::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 60% at 50% 50%,
      rgba(7,13,7,.97) 0%, rgba(7,13,7,.88) 38%,
      rgba(7,13,7,.72) 60%, rgba(7,13,7,.6) 80%, rgba(7,13,7,.5) 100%);
    z-index: 10; pointer-events: none;
  }
  @media(max-width:900px){ #qb-hero-{{ section.id }} .hero-vids { display: none; } }

  #qb-hero-{{ section.id }} .fv { position: absolute; width: 105px; }
  #qb-hero-{{ section.id }} .fv-phone {
    width: 100%; aspect-ratio: 9/16; border-radius: 16px; overflow: hidden;
    border: 1.5px solid rgba(255,255,255,.1); background: #0a0a0a;
    box-shadow: 0 12px 40px rgba(0,0,0,.6); position: relative;
  }
  #qb-hero-{{ section.id }} .fv-phone img {
    width: 100%; height: 100%; object-fit: cover; opacity: .78; display: block;
  }
  #qb-hero-{{ section.id }} .fv-phone::after {
    content: ''; position: absolute; inset: 0; background: rgba(0,0,0,.15);
  }

  @keyframes qb-fl-a { 0%,100%{transform:translateY(0) rotate(-2deg)} 50%{transform:translateY(-14px) rotate(1.5deg)} }
  @keyframes qb-fl-b { 0%,100%{transform:translateY(0) rotate(3deg)} 50%{transform:translateY(-12px) rotate(-1deg)} }
  @keyframes qb-fl-c { 0%,100%{transform:translateY(-7px) rotate(0deg)} 50%{transform:translateY(11px) rotate(2deg)} }
  @keyframes qb-fl-d { 0%,100%{transform:translateY(3px) rotate(-1.5deg)} 50%{transform:translateY(-13px) rotate(2.5deg)} }
  @keyframes qb-fl-e { 0%,100%{transform:translateY(-10px) rotate(2deg)} 50%{transform:translateY(9px) rotate(-2deg)} }

  /* Hero inner */
  #qb-hero-{{ section.id }} .hero-inner {
    position: relative; z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: 0;
  }
  #qb-hero-{{ section.id }} .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(185,249,0,.06); border: 1px solid rgba(185,249,0,.25);
    border-radius: 4px; padding: 7px 20px;
    font-size: .6rem; letter-spacing: .25em; text-transform: uppercase; color: #fff;
    margin-bottom: 40px;
    animation: qb-fade-up .8s .2s cubic-bezier(0.22,0.61,0.36,1) both;
  }
  #qb-hero-{{ section.id }} .logos-row {
    display: flex; align-items: center; justify-content: center; gap: 24px;
    margin-bottom: 40px;
    animation: qb-fade-up .8s .35s cubic-bezier(0.22,0.61,0.36,1) both;
  }
  #qb-hero-{{ section.id }} .logo-box {
    padding: 18px 26px; border-radius: 8px; backdrop-filter: blur(12px);
  }
  #qb-hero-{{ section.id }} .logo-box img { height: 48px; width: auto; object-fit: contain; display: block; }
  #qb-hero-{{ section.id }} .logo-box.qb {
    background: linear-gradient(135deg,rgba(185,249,0,.15),rgba(185,249,0,.06));
    border: 1px solid rgba(185,249,0,.3);
  }
  #qb-hero-{{ section.id }} .logo-box.mm {
    background: linear-gradient(135deg,rgba(255,45,85,.15),rgba(255,45,85,.06));
    border: 1px solid rgba(255,45,85,.3);
  }
  #qb-hero-{{ section.id }} .logo-box.mm img { filter: brightness(1.3) saturate(.6); }
  #qb-hero-{{ section.id }} .x-sep {
    font-family: 'Bebas Neue', sans-serif; font-size: 3rem; line-height: 1;
    -webkit-text-fill-color: transparent;
    background: linear-gradient(90deg, var(--qb), var(--moon));
    -webkit-background-clip: text; background-clip: text;
  }
  #qb-hero-{{ section.id }} .hero-h {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(56px,14vw,180px); line-height: .88; letter-spacing: .01em;
    margin-bottom: 24px;
    animation: qb-fade-up .8s .5s cubic-bezier(0.22,0.61,0.36,1) both;
  }
  #qb-hero-{{ section.id }} .hero-h .l1 { display: block; color: #fff; }
  #qb-hero-{{ section.id }} .hero-h .l2 {
    display: block; -webkit-text-fill-color: transparent;
    background: linear-gradient(90deg, var(--qb) 0%, var(--moon) 100%);
    -webkit-background-clip: text; background-clip: text;
  }
  #qb-hero-{{ section.id }} .hero-sub {
    font-size: .95rem; font-weight: 300; color: #fff;
    max-width: 500px; line-height: 1.8; margin-bottom: 40px;
    animation: qb-fade-up .8s .65s cubic-bezier(0.22,0.61,0.36,1) both;
  }
  #qb-hero-{{ section.id }} .hero-sub b { color: var(--qb); font-weight: 700; }
  #qb-hero-{{ section.id }} .hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--qb); color: #000;
    font-family: 'Sora', sans-serif; font-weight: 800; font-size: .75rem;
    letter-spacing: .14em; text-transform: uppercase; text-decoration: none;
    padding: 16px 36px; border-radius: 4px;
    animation: qb-fade-up .8s .8s cubic-bezier(0.22,0.61,0.36,1) both;
    transition: transform .2s, box-shadow .3s;
  }
  #qb-hero-{{ section.id }} .hero-cta:hover {
    transform: translateY(-2px); box-shadow: 0 8px 32px rgba(185,249,0,.3);
  }

  @keyframes qb-fade-up { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }

  /* Tablet */
  @media(max-width:900px){
    #qb-hero-{{ section.id }} {
      min-height: auto;
      padding: 64px 32px 56px;
    }
    #qb-hero-{{ section.id }} .hero-h { margin-bottom: 18px; }
    #qb-hero-{{ section.id }} .hero-badge,
    #qb-hero-{{ section.id }} .logos-row { margin-bottom: 28px; }
    #qb-hero-{{ section.id }} .hero-sub { margin-bottom: 28px; }
  }

  /* Mobile */
  @media(max-width:640px){
    #qb-hero-{{ section.id }} {
      min-height: auto;
      padding: 40px 20px 44px;
      justify-content: flex-start;
    }
    #qb-hero-{{ section.id }} .hero-badge {
      font-size: .55rem; padding: 6px 14px; margin-bottom: 20px;
    }
    #qb-hero-{{ section.id }} .logos-row { gap: 14px; margin-bottom: 22px; }
    #qb-hero-{{ section.id }} .logo-box { padding: 12px 16px; }
    #qb-hero-{{ section.id }} .logo-box img { height: 36px; }
    #qb-hero-{{ section.id }} .x-sep { font-size: 2rem; }
    #qb-hero-{{ section.id }} .hero-h { margin-bottom: 14px; line-height: .92; }
    #qb-hero-{{ section.id }} .hero-sub {
      font-size: .85rem; line-height: 1.6; max-width: 100%; margin-bottom: 24px;
    }
    #qb-hero-{{ section.id }} .hero-cta { font-size: .7rem; padding: 14px 28px; width: 100%; justify-content: center; }
  }

  /* Very small phones */
  @media(max-width:380px){
    #qb-hero-{{ section.id }} { padding: 32px 16px 36px; }
    #qb-hero-{{ section.id }} .hero-h { font-size: 52px; }
  }
</style>

<section id="qb-hero-{{ section.id }}">
  <div class="hero-bg-overlay"></div>

  {%- if section.settings.show_videos -%}
  <div class="hero-vids">
    <div class="fv" style="left:2%;top:10%;animation:qb-fl-a 18s ease-in-out 0s infinite;opacity:.7"><div class="fv-phone"><img src="https://img.youtube.com/vi/R3i6MPSVHk0/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="left:9%;top:55%;animation:qb-fl-c 22s ease-in-out 1.2s infinite;opacity:.55"><div class="fv-phone"><img src="https://img.youtube.com/vi/woCO8TrFx5I/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="left:15%;top:22%;animation:qb-fl-b 20s ease-in-out 0.5s infinite;opacity:.45"><div class="fv-phone"><img src="https://img.youtube.com/vi/gULZNBK4O_o/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="left:5%;top:80%;animation:qb-fl-d 24s ease-in-out 2s infinite;opacity:.42"><div class="fv-phone"><img src="https://img.youtube.com/vi/7dBwUeCWd5U/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="left:20%;top:70%;animation:qb-fl-e 19s ease-in-out 3s infinite;opacity:.38"><div class="fv-phone"><img src="https://img.youtube.com/vi/AmHWVseshzg/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="right:2%;top:8%;animation:qb-fl-b 21s ease-in-out 0.8s infinite;opacity:.7"><div class="fv-phone"><img src="https://img.youtube.com/vi/hSaZ5zfzoSQ/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="right:10%;top:52%;animation:qb-fl-a 23s ease-in-out 1.8s infinite;opacity:.55"><div class="fv-phone"><img src="https://img.youtube.com/vi/XTUYbyh_1vQ/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="right:15%;top:20%;animation:qb-fl-c 18s ease-in-out 0.3s infinite;opacity:.45"><div class="fv-phone"><img src="https://img.youtube.com/vi/J1hkDusg8dU/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="right:3%;top:76%;animation:qb-fl-e 26s ease-in-out 2.5s infinite;opacity:.42"><div class="fv-phone"><img src="https://img.youtube.com/vi/8oK0MF2lXqc/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="right:20%;top:72%;animation:qb-fl-d 20s ease-in-out 4s infinite;opacity:.38"><div class="fv-phone"><img src="https://img.youtube.com/vi/ihWrY4zRvIo/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="left:25%;top:6%;animation:qb-fl-e 22s ease-in-out 1.5s infinite;opacity:.32"><div class="fv-phone"><img src="https://img.youtube.com/vi/bv5BQY-xDL0/hqdefault.jpg" alt="" loading="lazy"></div></div>
    <div class="fv" style="right:25%;top:8%;animation:qb-fl-d 24s ease-in-out 0.7s infinite;opacity:.32"><div class="fv-phone"><img src="https://img.youtube.com/vi/aAsDsKWK2Ps/hqdefault.jpg" alt="" loading="lazy"></div></div>
  </div>
  {%- endif -%}

  <div class="hero-inner">
    <div class="hero-badge">{{ section.settings.badge_text }}</div>

    <div class="logos-row">
      <div class="logo-box qb">
        {%- if section.settings.qb_logo != blank -%}
          <img src="{{ section.settings.qb_logo | image_url: width: 200 }}" alt="QB54" width="120" height="48">
        {%- else -%}
          <img src="https://playqb54.com/cdn/shop/files/logo.png" alt="QB54" width="120" height="48">
        {%- endif -%}
      </div>
      <div class="x-sep">×</div>
      <div class="logo-box mm">
        {%- if section.settings.mm_logo != blank -%}
          <img src="{{ section.settings.mm_logo | image_url: width: 200 }}" alt="Moon Media" width="160" height="48">
        {%- else -%}
          <img src="https://images.squarespace-cdn.com/content/v1/6111d9dc96344d4b722b4481/36343cc8-77de-44d0-a2a6-0d1123a10288/Moon-Media-Logo-Web.png" alt="Moon Media" width="160" height="48">
        {%- endif -%}
      </div>
    </div>

    <h1 class="hero-h">
      <span class="l1">{{ section.settings.heading_line1 }}</span>
      <span class="l2">{{ section.settings.heading_line2 }}</span>
    </h1>
    <p class="hero-sub">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.cta_url }}" class="hero-cta">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "QB54 Hero",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Badge" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Official Collaboration — 2025" },
    { "type": "header", "content": "Logos" },
    { "type": "image_picker", "id": "qb_logo", "label": "QB54 logo" },
    { "type": "image_picker", "id": "mm_logo", "label": "Moon Media logo" },
    { "type": "header", "content": "Headline" },
    { "type": "text", "id": "heading_line1", "label": "Line 1 (white)", "default": "Game On." },
    { "type": "text", "id": "heading_line2", "label": "Line 2 (gradient)", "default": "Lights On." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>The <b>#1 viral backyard football game</b> teams up with the agency behind <b>292M+ organic views</b> — to make QB54 the game the whole internet plays.</p>" },
    { "type": "header", "content": "CTA Button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "🏈 Shop QB54 — 40% Off" },
    { "type": "url", "id": "cta_url", "label": "Button URL" },
    {
      "type": "header",
      "content": "Background Videos"
    },
    {
      "type": "checkbox",
      "id": "show_videos",
      "label": "Show floating Moon Media videos",
      "default": true,
      "info": "Toggles the 12 floating phone thumbnails behind the headline. Auto-hidden on tablet/mobile regardless. Disabling skips loading the YouTube thumbnails entirely."
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#070d07" },
    { "type": "color", "id": "color_qb", "label": "QB54 green", "default": "#b9f900" },
    { "type": "color", "id": "color_moon", "label": "Moon Media pink", "default": "#ff2d55" }
  ],
  "presets": [{ "name": "QB54 Hero" }]
}
{% endschema %}
