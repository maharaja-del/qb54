{%- liquid
  assign scope = '#qb54-pa-' | append: section.id
  assign code = section.settings.code | strip | upcase
  assign pct = section.settings.discount_percent
  assign keep = 100 | minus: pct
  assign free_ship = section.settings.free_ship_threshold | times: 100
  assign shop_url = section.settings.shop_url | default: routes.all_products_collection_url
  assign sets = section.settings.sets
  assign fan_products = section.settings.fan_products
  assign reel_blocks = section.blocks | where: 'type', 'reel'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign partner = section.settings.partner_name

  # Products that show the price after the code: the code collection, or every set when none is chosen.
  assign eligible = '|'
  if section.settings.code_collection != blank
    for p in section.settings.code_collection.products limit: 50
      assign eligible = eligible | append: p.id | append: '|'
    endfor
  else
    for p in sets
      assign eligible = eligible | append: p.id | append: '|'
    endfor
  endif

  # Hero buy card: the first three single-option sets in stock.
  assign hero_count = 0
  for p in sets
    if p.has_only_default_variant and p.available and hero_count < 3
      assign hero_count = hero_count | plus: 1
    endif
  endfor

  assign lead = sets.first
  assign lead_rating = lead.metafields.reviews.rating.value
  assign lead_count = lead.metafields.reviews.rating_count.value
  assign checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/'
-%}

<style>
  {{ scope }} {
    --gold: {{ section.settings.color_gold }};
    --gold-deep: color-mix(in srgb, var(--gold) 80%, #000000);
    --gold-soft: color-mix(in srgb, var(--gold) 18%, transparent);
    --on-gold: #1a1c3a;
    --navy: {{ section.settings.color_navy }};
    --night: {{ section.settings.color_night }};
    --cream: {{ section.settings.color_cream }};
    --live: #e11d48;
    --paper: #ffffff;
    --ink: #171717;
    --ink-2: #4a4c57;
    --muted: #6b6d78;
    --line: #e6e2d3;
    --line-dark: rgba(255, 255, 255, 0.14);
    --ok: #15803d;
    --sale: #e11d48;
    --fh: var(--font-heading-family);
    --fb: var(--font-body-family);
    --pad-y: clamp(64px, 8vw, 112px);
    --max: 1280px;
    --gutter: clamp(16px, 4vw, 40px);
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --ease-emph: cubic-bezier(0.05, 0.7, 0.1, 1);
    --shadow: 0 1px 2px rgba(17, 18, 40, 0.06), 0 16px 36px -22px rgba(17, 18, 40, 0.4);
    --shadow-lg: 0 2px 6px rgba(9, 10, 26, 0.12), 0 40px 80px -36px rgba(9, 10, 26, 0.75);
    position: relative;
    background: var(--night);
    color: #ffffff;
    font-family: var(--fb);
    -webkit-font-smoothing: antialiased;
    /* position + clip: absolutely positioned bits can never widen the page */
    overflow-x: clip;
  }
  {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { box-sizing: border-box; }
  {{ scope }} a { color: inherit; text-decoration: none; }
  {{ scope }} ul, {{ scope }} ol { list-style: none; margin: 0; padding: 0; }
  {{ scope }} p, {{ scope }} blockquote { text-wrap: pretty; }
  {{ scope }} img { display: block; max-width: 100%; }
  {{ scope }} [hidden] { display: none !important; }
  {{ scope }} :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 6px; }
  {{ scope }} .qb54-pa-wrap { width: min(var(--max), 100% - var(--gutter) * 2); margin-inline: auto; }
  {{ scope }} .qb54-pa-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* ---------- Type ---------- */
  {{ scope }} .qb54-pa-h2 { margin: 0; font-family: var(--fh); font-weight: 700; font-size: clamp(36px, 5vw, 64px); line-height: 0.95; letter-spacing: -0.005em; text-transform: uppercase; text-wrap: balance; color: inherit; }
  {{ scope }} .qb54-pa-h2 em { font-style: normal; color: var(--gold); }
  {{ scope }} .qb54-pa-light .qb54-pa-h2 { color: var(--ink); }
  {{ scope }} .qb54-pa-light .qb54-pa-h2 em { color: var(--navy); }
  {{ scope }} .qb54-pa-eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); }
  {{ scope }} .qb54-pa-eyebrow::before { content: ''; width: 28px; height: 3px; border-radius: 3px; background: currentColor; }
  {{ scope }} .qb54-pa-light .qb54-pa-eyebrow { color: var(--navy); }
  {{ scope }} .qb54-pa-center { text-align: center; }
  {{ scope }} .qb54-pa-center .qb54-pa-eyebrow { justify-content: center; }
  {{ scope }} .qb54-pa-center .qb54-pa-eyebrow::after { content: ''; width: 28px; height: 3px; border-radius: 3px; background: currentColor; }
  {{ scope }} .qb54-pa-lede { margin: 18px 0 0; max-width: 60ch; font-size: clamp(16px, 1.3vw, 18.5px); line-height: 1.65; }
  {{ scope }} .qb54-pa-center .qb54-pa-lede { margin-inline: auto; }
  {{ scope }} .qb54-pa-light .qb54-pa-lede { color: var(--ink-2); }
  {{ scope }} .qb54-pa-head { margin-bottom: clamp(32px, 4vw, 52px); }
  {{ scope }} .qb54-pa-head--split { display: grid; gap: 18px; }
  {{ scope }} .qb54-pa-link { font-weight: 700; font-size: 15px; text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  /* ---------- Buttons ---------- */
  {{ scope }} .qb54-pa-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 0 26px; border: 0; border-radius: 10px; font-family: var(--fh); font-weight: 700; font-size: 17px; line-height: 1; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; cursor: pointer; overflow: hidden; isolation: isolate; transition: transform 160ms var(--ease), background-color 160ms var(--ease), box-shadow 160ms var(--ease); }
  {{ scope }} .qb54-pa-btn svg { width: 18px; height: 18px; flex: none; }
  {{ scope }} .qb54-pa-btn [data-qb54-pa-icon] { display: inline-flex; }
  {{ scope }} .qb54-pa-btn--gold { background: var(--gold); color: var(--on-gold); box-shadow: 0 14px 30px -14px color-mix(in srgb, var(--gold) 70%, transparent); }
  {{ scope }} .qb54-pa-btn--gold:hover { background: color-mix(in srgb, var(--gold) 86%, #ffffff); transform: translateY(-2px); }
  {{ scope }} .qb54-pa-btn--shine::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.7) 48%, transparent 66%); transform: translateX(-120%); animation: qb54-pa-shine 4.2s var(--ease) infinite 1.2s; }
  {{ scope }} .qb54-pa-btn--ghost { background: rgba(255, 255, 255, 0.07); color: #ffffff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.4); }
  {{ scope }} .qb54-pa-btn--ghost:hover { background: rgba(255, 255, 255, 0.14); transform: translateY(-2px); }
  {{ scope }} .qb54-pa-btn--navy { background: var(--navy); color: #ffffff; }
  {{ scope }} .qb54-pa-btn--navy:hover { background: color-mix(in srgb, var(--navy) 85%, #ffffff); transform: translateY(-2px); }
  {{ scope }} .qb54-pa-btn--white { background: #ffffff; color: var(--on-gold); box-shadow: 0 16px 34px -16px rgba(17, 18, 40, 0.55); }
  {{ scope }} .qb54-pa-btn--white:hover { transform: translateY(-2px); }
  {{ scope }} .qb54-pa-btn[aria-busy='true'] { pointer-events: none; opacity: 0.85; }
  {{ scope }} .qb54-pa-btn.is-added { background: var(--ok); color: #ffffff; box-shadow: none; }
  {{ scope }} .qb54-pa-btn.is-error { background: #b91c1c; color: #ffffff; box-shadow: none; }
  {{ scope }} .qb54-pa-btn[disabled] { background: #e7e5dd; color: var(--muted); box-shadow: none; cursor: not-allowed; }
  {{ scope }} .qb54-pa-spin { width: 18px; height: 18px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: qb54-pa-rot 700ms linear infinite; }
  {{ scope }} .qb54-pa-err { margin: 8px 0 0; font-size: 13px; color: #b91c1c; }
  @keyframes qb54-pa-shine { 0% { transform: translateX(-120%); } 55%, 100% { transform: translateX(120%); } }
  @keyframes qb54-pa-rot { to { transform: rotate(360deg); } }

  /* ---------- Top bar ---------- */
  {{ scope }} .qb54-pa-bar { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--night) 88%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line-dark); }
  {{ scope }} .qb54-pa-bar__in { display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 68px; }
  {{ scope }} .qb54-pa-bar__brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
  {{ scope }} .qb54-pa-bar__brand img { width: auto; height: 40px; }
  {{ scope }} .qb54-pa-bar__x { display: none; align-items: center; gap: 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.8); white-space: nowrap; }
  {{ scope }} .qb54-pa-bar__x b { font-family: var(--fh); font-size: 18px; color: var(--gold); }
  {{ scope }} .qb54-pa-bar__end { display: flex; align-items: center; gap: 10px; }
  {{ scope }} .qb54-pa-bar__code { display: none; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.07); box-shadow: inset 0 0 0 1px var(--line-dark); font-size: 13px; color: rgba(255, 255, 255, 0.85); }
  {{ scope }} .qb54-pa-bar__code strong { padding: 3px 8px; border-radius: 6px; background: var(--gold); color: var(--on-gold); letter-spacing: 0.1em; }
  {{ scope }} .qb54-pa-bar .qb54-pa-btn { min-height: 44px; padding: 0 16px; font-size: 15px; }
  {{ scope }} .qb54-pa-cart { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-dark); }
  {{ scope }} .qb54-pa-cart:hover { background: rgba(255, 255, 255, 0.08); }
  {{ scope }} .qb54-pa-cart svg { width: 21px; height: 21px; }
  {{ scope }} .qb54-pa-cart__n { position: absolute; top: -3px; right: -3px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--gold); color: var(--on-gold); font-size: 11px; font-weight: 700; line-height: 20px; text-align: center; }
  {{ scope }} .qb54-pa-cart__n.is-bump { animation: qb54-pa-bump 420ms var(--ease-emph); }
  @keyframes qb54-pa-bump { 0% { transform: scale(0.4); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }

  /* ---------- Hero ---------- */
  {{ scope }} .qb54-pa-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center; min-height: min(880px, calc(100svh - 68px)); padding-block: clamp(44px, 6vw, 96px); }
  {{ scope }} .qb54-pa-hero__bg { position: absolute; inset: 0; z-index: -3; }
  {{ scope }} .qb54-pa-hero__bg img { width: 100%; height: 100%; object-fit: cover; object-position: {{ section.settings.hero_focal }}; }
  {{ scope }} .qb54-pa-hero::before { content: ''; position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, color-mix(in srgb, var(--night) 95%, transparent) 0%, color-mix(in srgb, var(--night) 84%, transparent) 40%, color-mix(in srgb, var(--night) 40%, transparent) 75%, color-mix(in srgb, var(--night) 60%, transparent) 100%), linear-gradient(0deg, var(--night) 0%, transparent 35%); }
  {{ scope }} .qb54-pa-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(640px 420px at 16% 72%, color-mix(in srgb, var(--gold) 16%, transparent), transparent 70%); pointer-events: none; }
  {{ scope }} .qb54-pa-hero__grid { display: grid; gap: clamp(40px, 5vw, 72px); align-items: center; }
  {{ scope }} .qb54-pa-onair { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 7px 14px 7px 10px; border-radius: 999px; background: rgba(9, 10, 26, 0.55); box-shadow: inset 0 0 0 1px var(--line-dark); backdrop-filter: blur(8px); font-size: 12.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #ffffff; }
  {{ scope }} .qb54-pa-onair i { position: relative; width: 10px; height: 10px; border-radius: 50%; background: var(--live); }
  {{ scope }} .qb54-pa-onair i::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid var(--live); opacity: 0; animation: qb54-pa-pulse 1.8s var(--ease) infinite; }
  {{ scope }} .qb54-pa-onair b { color: var(--gold); }
  @keyframes qb54-pa-pulse { 0% { transform: scale(0.6); opacity: 0.9; } 100% { transform: scale(1.6); opacity: 0; } }
  {{ scope }} .qb54-pa-title { margin: 0; font-family: var(--fh); font-weight: 700; text-transform: uppercase; color: #ffffff; line-height: 0.9; }
  {{ scope }} .qb54-pa-title__offer { display: block; white-space: nowrap; font-size: min(24vw, 200px); line-height: 0.84; letter-spacing: -0.025em; padding-bottom: 0.04em; background: linear-gradient(180deg, #fff3c4 0%, var(--gold) 48%, var(--gold-deep) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; filter: drop-shadow(0 12px 40px color-mix(in srgb, var(--gold) 28%, transparent)); }
  {{ scope }} .qb54-pa-title__line { display: block; margin-top: 10px; font-size: clamp(34px, 4.4vw, 64px); line-height: 0.95; text-wrap: balance; }
  {{ scope }} .qb54-pa-hero .qb54-pa-lede { color: rgba(255, 255, 255, 0.86); }

  /* Score-bug code ticket */
  {{ scope }} .qb54-pa-bug { display: inline-flex; align-items: stretch; margin-top: 28px; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.12); }
  {{ scope }} .qb54-pa-bug > * { display: grid; align-content: center; padding: 10px 16px; }
  {{ scope }} .qb54-pa-bug__team { background: var(--navy); font-family: var(--fh); font-weight: 700; font-size: 20px; letter-spacing: 0.04em; color: #ffffff; }
  {{ scope }} .qb54-pa-bug__code { gap: 2px; background: #ffffff; color: var(--on-gold); }
  {{ scope }} .qb54-pa-bug__code span { font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  {{ scope }} .qb54-pa-bug__code strong { font-family: var(--fh); font-weight: 700; font-size: 32px; line-height: 0.95; letter-spacing: 0.08em; }
  {{ scope }} .qb54-pa-bug__off { background: var(--gold); color: var(--on-gold); font-family: var(--fh); font-weight: 700; font-size: 24px; line-height: 1; text-align: center; }
  {{ scope }} .qb54-pa-bug__off small { display: block; font-size: 11px; letter-spacing: 0.14em; }
  {{ scope }} .qb54-pa-bug__copy { grid-auto-flow: column; gap: 6px; border: 0; background: var(--night); color: #ffffff; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; }
  {{ scope }} .qb54-pa-bug__copy:hover { background: color-mix(in srgb, var(--night) 70%, var(--navy)); }
  {{ scope }} .qb54-pa-bug__copy svg { width: 16px; height: 16px; }
  {{ scope }} .qb54-pa-applied { display: flex; align-items: center; gap: 8px; margin: 12px 0 0; font-size: 13.5px; color: rgba(255, 255, 255, 0.82); }
  {{ scope }} .qb54-pa-applied svg { width: 18px; height: 18px; padding: 3px; border-radius: 50%; background: var(--ok); color: #ffffff; flex: none; }
  {{ scope }} .qb54-pa-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  {{ scope }} .qb54-pa-hero .qb54-pa-ctas .qb54-pa-btn { min-height: 60px; padding: 0 30px; font-size: 18px; }
  {{ scope }} .qb54-pa-proof { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line-dark); }
  {{ scope }} .qb54-pa-proof li { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 500; color: rgba(255, 255, 255, 0.86); }
  {{ scope }} .qb54-pa-proof svg { width: 17px; height: 17px; color: var(--gold); flex: none; }

  /* Hero buy card */
  {{ scope }} .qb54-pa-buycard { position: relative; justify-self: center; width: min(100%, 430px); border-radius: 20px; background: var(--paper); color: var(--ink); box-shadow: var(--shadow-lg); }
  {{ scope }} .qb54-pa-buycard__ribbon { position: absolute; z-index: 3; top: -14px; left: 18px; display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 8px; background: var(--night); color: #ffffff; font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; box-shadow: 0 10px 20px -12px rgba(0, 0, 0, 0.7); }
  {{ scope }} .qb54-pa-buycard__ribbon i { width: 8px; height: 8px; border-radius: 50%; background: var(--live); }
  {{ scope }} .qb54-pa-buycard__media { position: relative; aspect-ratio: 1 / 0.84; border-radius: 20px 20px 0 0; overflow: hidden; background: #ffffff; }
  {{ scope }} .qb54-pa-buycard__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 7% 6% 3%; }
  {{ scope }} .qb54-pa-buycard__off { position: absolute; top: 16px; right: 16px; padding: 7px 12px; border-radius: 999px; background: var(--gold); color: var(--on-gold); font-family: var(--fh); font-weight: 700; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; }
  {{ scope }} .qb54-pa-buycard__body { display: grid; gap: 10px; padding: 20px 22px 22px; border-top: 1px solid var(--line); }
  {{ scope }} .qb54-pa-buycard__title { margin: 0; font-family: var(--fh); font-weight: 700; font-size: 23px; line-height: 1.08; letter-spacing: 0; text-transform: uppercase; color: var(--ink); }
  {{ scope }} .qb54-pa-rating { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--ink-2); }
  {{ scope }} .qb54-pa-rating b { color: var(--ink); }
  {{ scope }} .qb54-pa-stars { display: inline-flex; gap: 2px; color: var(--gold); }
  {{ scope }} .qb54-pa-stars svg { width: 15px; height: 15px; }
  {{ scope }} .qb54-pa-price { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  {{ scope }} .qb54-pa-now { font-family: var(--fh); font-weight: 700; line-height: 1; color: var(--navy); font-variant-numeric: tabular-nums; }
  {{ scope }} .qb54-pa-now small { margin-right: 2px; font-family: var(--fb); font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
  {{ scope }} .qb54-pa-was { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1.5px; font-variant-numeric: tabular-nums; }
  {{ scope }} .qb54-pa-save { padding: 5px 10px; border-radius: 6px; background: var(--sale); color: #ffffff; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  {{ scope }} .qb54-pa-buycard .qb54-pa-now { font-size: 40px; }
  {{ scope }} .qb54-pa-buycard .qb54-pa-was { font-size: 16px; }
  {{ scope }} .qb54-pa-codenote { margin: 0; font-size: 13px; color: var(--ink-2); }
  {{ scope }} .qb54-pa-codenote strong { color: var(--ink); letter-spacing: 0.06em; }
  {{ scope }} .qb54-pa-swatches { display: flex; align-items: center; gap: 10px; }
  {{ scope }} .qb54-pa-swatches span { margin-right: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  {{ scope }} .qb54-pa-sw { width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--sw); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.6), 0 0 0 1px var(--line); cursor: pointer; transition: transform 160ms var(--ease), box-shadow 160ms var(--ease); }
  {{ scope }} .qb54-pa-sw:hover { transform: scale(1.08); }
  {{ scope }} .qb54-pa-sw[aria-pressed='true'] { box-shadow: inset 0 0 0 2px #ffffff, 0 0 0 2.5px var(--gold); }
  {{ scope }} .qb54-pa-buycard .qb54-pa-btn { width: 100%; min-height: 56px; }
  {{ scope }} .qb54-pa-instock { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); }
  {{ scope }} .qb54-pa-instock::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18); }

  /* ---------- Ticker ---------- */
  {{ scope }} .qb54-pa-ticker { overflow: hidden; background: var(--gold); color: var(--on-gold); }
  {{ scope }} .qb54-pa-ticker__track { display: flex; width: max-content; animation: qb54-pa-marquee 40s linear infinite; }
  {{ scope }} .qb54-pa-ticker:hover .qb54-pa-ticker__track { animation-play-state: paused; }
  {{ scope }} .qb54-pa-ticker__g { display: flex; flex: none; }
  {{ scope }} .qb54-pa-ticker__i { display: inline-flex; align-items: center; gap: 24px; padding: 16px 0 16px 24px; font-family: var(--fh); font-weight: 700; font-size: 19px; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  {{ scope }} .qb54-pa-ticker__i svg { width: 16px; height: 16px; }
  @keyframes qb54-pa-marquee { to { transform: translateX(-50%); } }

  /* ---------- Partner welcome (lower third) ---------- */
  {{ scope }} .qb54-pa-partner { padding-block: clamp(48px, 6vw, 80px); background: var(--night); }
  {{ scope }} .qb54-pa-l3 { position: relative; display: grid; gap: 18px; align-items: center; padding: 20px; border-radius: 22px; background: linear-gradient(100deg, var(--navy), color-mix(in srgb, var(--navy) 60%, var(--night))); box-shadow: inset 0 0 0 1px var(--line-dark), var(--shadow-lg); overflow: hidden; }
  {{ scope }} .qb54-pa-l3::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--gold); }
  {{ scope }} .qb54-pa-l3__who { display: flex; align-items: center; gap: 16px; }
