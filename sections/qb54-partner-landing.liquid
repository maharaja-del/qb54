    {{ scope }} .qb54-pa-hero { min-height: 0; }
    {{ scope }} .qb54-pa-ctas .qb54-pa-btn, {{ scope }} .qb54-pa-ctas .qb54-pa-buy { width: 100%; }
    {{ scope }} .qb54-pa-bug { display: flex; width: 100%; }
    {{ scope }} .qb54-pa-bug > * { padding: 10px 12px; }
    {{ scope }} .qb54-pa-bug__team { display: none; }
    {{ scope }} .qb54-pa-bug__code { flex: 1; }
    {{ scope }} .qb54-pa-bar .qb54-pa-btn { padding: 0 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { animation: none !important; transition: none !important; }
    {{ scope }}.qb54-pa--js [data-qb54-pa-reveal] { opacity: 1; transform: none; }
  }
  body.qb54-pa-bar-on { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
  @media screen and (min-width: 750px) { body.qb54-pa-bar-on { padding-bottom: 0; } }
</style>

{%- capture i_cart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h3l2.4 12h11l2.1-8H6.4"/></svg>{%- endcapture -%}
{%- capture i_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture i_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture i_copy -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>{%- endcapture -%}
{%- capture i_star -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}
{%- capture i_tv -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="m8 2 4 4 4-4"/></svg>{%- endcapture -%}
{%- capture i_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v12H1zM15 9h4l4 4v3h-8z"/><circle cx="6" cy="18.5" r="2"/><circle cx="18" cy="18.5" r="2"/></svg>{%- endcapture -%}
{%- capture i_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture i_bolt -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.4 2 4.6 13.4h6.1L9.8 22l8.6-11.4h-6.1L13.4 2z"/></svg>{%- endcapture -%}
{%- capture i_mic -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v5M8 22h8"/></svg>{%- endcapture -%}
{%- capture i_play -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>{%- endcapture -%}
{%- capture i_yt -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15.1V8.9L15.2 12z"/></svg>{%- endcapture -%}
{%- capture i_mute -%}<svg class="is-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="m23 9-6 6M17 9l6 6"/></svg><svg class="is-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>{%- endcapture -%}
{%- capture stars_5 -%}<span class="qb54-pa-stars">{{ i_star }}{{ i_star }}{{ i_star }}{{ i_star }}{{ i_star }}</span>{%- endcapture -%}

{%- capture score_bug -%}
  <div class="qb54-pa-bug">
    <span class="qb54-pa-bug__team">QB54</span>
    <span class="qb54-pa-bug__code"><span>Promo code</span><strong>{{ code }}</strong></span>
    <span class="qb54-pa-bug__off">{{ pct }}%<small>OFF</small></span>
    <button type="button" class="qb54-pa-bug__copy" data-qb54-pa-copy="{{ code | escape }}">{{ i_copy }}<span data-qb54-pa-copy-label aria-live="polite">Copy</span></button>
  </div>
{%- endcapture -%}

<div id="qb54-pa-{{ section.id }}" class="qb54-pa" data-code="{{ code | escape }}" data-auto-apply="{{ section.settings.auto_apply_code }}" data-free="{{ free_ship }}">
  <header class="qb54-pa-bar">
    <div class="qb54-pa-wrap qb54-pa-bar__in">
      <a class="qb54-pa-bar__brand" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{- section.settings.logo | image_url: width: 240 | image_tag: loading: 'eager', alt: shop.name, widths: '120,240', sizes: '120px' -}}
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
        <span class="qb54-pa-bar__x"><b>×</b>{{ partner | escape }}</span>
      </a>
      <div class="qb54-pa-bar__end">
        {%- if code != blank -%}<span class="qb54-pa-bar__code">{{ pct }}% off with <strong>{{ code }}</strong></span>{%- endif -%}
        <a class="qb54-pa-cart" href="{{ routes.cart_url }}" aria-label="Cart">{{ i_cart }}<span class="qb54-pa-cart__n" data-qb54-pa-count hidden>0</span></a>
        <a class="qb54-pa-btn qb54-pa-btn--gold" href="#qb54-pa-sets-{{ section.id }}">{{ section.settings.bar_cta | escape }}</a>
      </div>
    </div>
  </header>

  <section class="qb54-pa-hero" data-qb54-pa-hero aria-labelledby="qb54-pa-h1-{{ section.id }}">
    {%- if section.settings.hero_image != blank -%}
      <div class="qb54-pa-hero__bg">{{- section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800,1200,1600,2000,2400', sizes: '100vw', alt: '' -}}</div>
    {%- endif -%}
    <div class="qb54-pa-wrap qb54-pa-hero__grid">
      <div>
        <p class="qb54-pa-onair"><i aria-hidden="true"></i>{{ section.settings.onair_label | escape }} <b>{{ partner | escape }}</b></p>
        <h1 class="qb54-pa-title" id="qb54-pa-h1-{{ section.id }}">
          <span class="qb54-pa-title__offer">{{ pct }}% Off</span>
          <span class="qb54-pa-title__line">{{ section.settings.hero_line | escape }}</span>
        </h1>
        {%- if section.settings.hero_text != blank -%}<p class="qb54-pa-lede">{{ section.settings.hero_text | escape }}</p>{%- endif -%}
        {%- if code != blank -%}
          {{ score_bug }}
          {%- if section.settings.auto_apply_code -%}<p class="qb54-pa-applied">{{ i_check }}{{ section.settings.applied_note | escape }}</p>{%- endif -%}
        {%- endif -%}
        <div class="qb54-pa-ctas">
          <a class="qb54-pa-btn qb54-pa-btn--gold qb54-pa-btn--shine" href="#qb54-pa-sets-{{ section.id }}">{{ section.settings.hero_cta | escape }}{{ i_arrow }}</a>
          {%- if reel_blocks.size > 0 and section.settings.hero_cta_2 != blank -%}<a class="qb54-pa-btn qb54-pa-btn--ghost" href="#qb54-pa-reels-{{ section.id }}">{{ section.settings.hero_cta_2 | escape }}</a>{%- endif -%}
        </div>
        <ul class="qb54-pa-proof">
          {%- if section.settings.proof_1 != blank -%}<li>{{ i_tv }}{{ section.settings.proof_1 | escape }}</li>{%- endif -%}
          <li>{{ i_star }}
            {%- if lead_rating != blank and lead_count != blank -%}Rated {{ lead_rating.rating | round: 1 }} · {{ lead_count }} reviews{%- else -%}{{ section.settings.rating_fallback | escape }}{%- endif -%}
          </li>
          {%- if section.settings.proof_3 != blank -%}<li>{{ i_truck }}{{ section.settings.proof_3 | escape }}</li>{%- endif -%}
        </ul>
      </div>

      {%- if hero_count > 0 -%}
        <aside class="qb54-pa-buycard" aria-label="Featured deal" data-qb54-pa-switch>
          <span class="qb54-pa-buycard__ribbon"><i aria-hidden="true"></i>{{ section.settings.card_ribbon | escape }}</span>
          {%- assign hero_i = 0 -%}
          {%- for p in sets -%}
            {%- unless p.has_only_default_variant and p.available -%}{%- continue -%}{%- endunless -%}
            {%- if hero_i >= 3 -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign hero_i = hero_i | plus: 1
              assign v = p.selected_or_first_available_variant
              assign sale = v.price | times: keep | divided_by: 100
              assign save = v.price | minus: sale
              assign r = p.metafields.reviews.rating.value
              assign rc = p.metafields.reviews.rating_count.value
            -%}
            <div data-qb54-pa-panel="{{ hero_i }}"{% if hero_i > 1 %} hidden{% endif %}>
              <div class="qb54-pa-buycard__media">
                {%- if p.featured_image != blank -%}{{- p.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '450,700,900', sizes: '(min-width: 990px) 430px, 92vw', alt: p.title -}}{%- endif -%}
                <span class="qb54-pa-buycard__off">{{ pct }}% off</span>
              </div>
              <div class="qb54-pa-buycard__body">
                <span class="qb54-pa-rating">{{ stars_5 }}
                  {%- if r != blank and rc != blank -%}<span><b>{{ r.rating | round: 1 }}</b> · {{ rc }} reviews</span>{%- else -%}<span>{{ section.settings.rating_card_fallback | escape }}</span>{%- endif -%}
                </span>
                <h2 class="qb54-pa-buycard__title">{{ p.title | escape }}</h2>
                <div class="qb54-pa-price">
                  <span class="qb54-pa-now">{{ sale | money }}</span>
                  <s class="qb54-pa-was"><span class="qb54-pa-sr">Regular price </span>{{ v.price | money }}</s>
                  <span class="qb54-pa-save">Save {{ save | money }}</span>
                </div>
                <p class="qb54-pa-codenote">With code <strong>{{ code }}</strong> at checkout</p>
                {%- if hero_count > 1 -%}
                  <div class="qb54-pa-swatches" role="group" aria-label="Choose a color">
                    <span>Color</span>
                    {%- assign sw_i = 0 -%}
                    {%- for sp in sets -%}
                      {%- unless sp.has_only_default_variant and sp.available -%}{%- continue -%}{%- endunless -%}
                      {%- if sw_i >= 3 -%}{%- break -%}{%- endif -%}
                      {%- liquid
                        assign sw_i = sw_i | plus: 1
                        assign sw_color = section.settings.color_gold
                        assign sw_name = sp.title
                        if sp.handle contains 'black'
                          assign sw_color = '#171717'
                          assign sw_name = 'Black'
                        elsif sp.handle contains 'navy'
                          assign sw_color = '#2a3163'
                          assign sw_name = 'Navy'
                        elsif sp.handle contains 'red'
                          assign sw_color = '#c8102e'
                          assign sw_name = 'Red'
                        endif
                      -%}
                      <button type="button" class="qb54-pa-sw" style="--sw: {{ sw_color }};" data-qb54-pa-to="{{ sw_i }}" aria-pressed="{% if sw_i == hero_i %}true{% else %}false{% endif %}" aria-label="{{ sw_name | escape }}"></button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="qb54-pa-buy">
                  <button type="button" class="qb54-pa-btn qb54-pa-btn--gold" data-qb54-pa-add data-variants="{{ v.id }}" data-title="{{ p.title | escape }}" data-label="Add to Cart"><span data-qb54-pa-icon>{{ i_cart }}</span><span data-qb54-pa-label>Add to Cart</span></button>
                  <p class="qb54-pa-err" data-qb54-pa-err role="alert" hidden></p>
                </div>
                <span class="qb54-pa-instock">{{ section.settings.stock_note | escape }}</span>
              </div>
            </div>
          {%- endfor -%}
        </aside>
      {%- endif -%}
    </div>
  </section>

  {%- assign ticker = section.settings.ticker_items | default: '' | split: '|' -%}
  {%- if ticker.size > 0 -%}
    <div class="qb54-pa-ticker">
      <div class="qb54-pa-ticker__track">
        {%- for pass in (1..2) -%}
          <div class="qb54-pa-ticker__g"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- for rep in (1..2) -%}{%- for item in ticker -%}<span class="qb54-pa-ticker__i">{{ item | strip | escape }}{{ i_bolt }}</span>{%- endfor -%}{%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <section class="qb54-pa-partner" aria-label="{{ partner | escape }}">
    <div class="qb54-pa-wrap">
      <div class="qb54-pa-l3" data-qb54-pa-reveal>
        <div class="qb54-pa-l3__who">
          <span class="qb54-pa-avatar">
            {%- if section.settings.partner_image != blank -%}
              {{- section.settings.partner_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: partner -}}
            {%- else -%}
              {{ i_mic }}
            {%- endif -%}
          </span>
          <span class="qb54-pa-l3__name"><span>{{ section.settings.welcome_kicker | escape }}</span><strong>{{ partner | escape }}</strong></span>
        </div>
        <p>{{ section.settings.welcome_text | escape }} <strong>{{ code }}</strong></p>
        {%- if section.settings.partner_url != blank -%}<a class="qb54-pa-l3__watch" href="{{ section.settings.partner_url }}" target="_blank" rel="noopener">{{ i_yt }}{{ section.settings.partner_url_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </section>

  {%- if sets.size > 0 -%}
    <section class="qb54-pa-sets qb54-pa-light" id="qb54-pa-sets-{{ section.id }}" aria-labelledby="qb54-pa-sets-h-{{ section.id }}">
      <div class="qb54-pa-wrap">
        <header class="qb54-pa-head qb54-pa-head--split" data-qb54-pa-reveal>
          <div>
            <p class="qb54-pa-eyebrow">{{ section.settings.sets_eyebrow | escape }}</p>
            <h2 class="qb54-pa-h2" id="qb54-pa-sets-h-{{ section.id }}">{{ section.settings.sets_heading }}</h2>
            {%- if section.settings.sets_text != blank -%}<p class="qb54-pa-lede">{{ section.settings.sets_text | escape }}</p>{%- endif -%}
          </div>
          {%- if section.settings.sets_link_label != blank -%}<a class="qb54-pa-link" href="{{ shop_url }}">{{ section.settings.sets_link_label | escape }}</a>{%- endif -%}
        </header>
        <div class="qb54-pa-grid">
          {%- for p in sets -%}
            {%- liquid
              assign tag = ''
              if forloop.first
                assign tag = section.settings.first_tag
              elsif p.has_only_default_variant == false
                assign tag = section.settings.custom_tag
              endif
              assign token = '|' | append: p.id | append: '|'
              assign set_code = false
              if eligible contains token
                assign set_code = true
              endif
            -%}
            {%- render 'qb54-pa-card', product: p, keep: keep, code: code, code_ok: set_code, tag: tag, sizes: '(min-width: 990px) 300px, (min-width: 600px) 44vw, 72vw' -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if reel_blocks.size > 0 -%}
    <section class="qb54-pa-reels" id="qb54-pa-reels-{{ section.id }}" aria-labelledby="qb54-pa-reels-h-{{ section.id }}">
      <div class="qb54-pa-wrap">
        <header class="qb54-pa-head" data-qb54-pa-reveal>
          <p class="qb54-pa-eyebrow">{{ section.settings.reels_eyebrow | escape }}</p>
          <h2 class="qb54-pa-h2" id="qb54-pa-reels-h-{{ section.id }}">{{ section.settings.reels_heading }}</h2>
          {%- if section.settings.reels_text != blank -%}<p class="qb54-pa-lede">{{ section.settings.reels_text | escape }}</p>{%- endif -%}
        </header>
        <div class="qb54-pa-rail">
          {%- for block in reel_blocks -%}
            <figure class="qb54-pa-reel" data-qb54-pa-reel {{ block.shopify_attributes }}>
              {%- comment %}theme-check-disable RemoteAsset{% endcomment -%}
              {%- if block.settings.poster_url != blank -%}<img src="{{ block.settings.poster_url }}" alt="" loading="lazy" width="540" height="960">{%- endif -%}
              {%- comment %}theme-check-enable RemoteAsset{% endcomment -%}
              <video muted loop playsinline preload="none" data-src="{{ block.settings.video_url | escape }}"{% if block.settings.poster_url != blank %} poster="{{ block.settings.poster_url }}"{% endif %} aria-label="{{ block.settings.caption | escape }}"></video>
              <button type="button" class="qb54-pa-reel__snd" data-qb54-pa-sound aria-label="Turn sound on">{{ i_mute }}</button>
              <span class="qb54-pa-reel__play" aria-hidden="true">{{ i_play }}</span>
              {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if fan_products.size > 0 -%}
    <section class="qb54-pa-fans qb54-pa-light" aria-labelledby="qb54-pa-fans-h-{{ section.id }}">
      <div class="qb54-pa-wrap">
        <header class="qb54-pa-head qb54-pa-head--split" data-qb54-pa-reveal>
          <div>
            <p class="qb54-pa-eyebrow">{{ section.settings.fans_eyebrow | escape }}</p>
            <h2 class="qb54-pa-h2" id="qb54-pa-fans-h-{{ section.id }}">{{ section.settings.fans_heading }}</h2>
            {%- if section.settings.fans_text != blank -%}<p class="qb54-pa-lede">{{ section.settings.fans_text | escape }}</p>{%- endif -%}
          </div>
        </header>
        <div class="qb54-pa-grid">
          {%- for p in fan_products -%}
            {%- unless p.available -%}{%- continue -%}{%- endunless -%}
            {%- assign token = '|' | append: p.id | append: '|' -%}
            {%- assign fan_code = false -%}
            {%- if eligible contains token -%}{%- assign fan_code = true -%}{%- endif -%}
            {%- render 'qb54-pa-card', product: p, keep: keep, code: code, code_ok: fan_code, sizes: '(min-width: 990px) 400px, (min-width: 600px) 44vw, 72vw' -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.fans_note != blank -%}<p class="qb54-pa-note">{{ section.settings.fans_note | escape }}</p>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if step_blocks.size > 0 -%}
    <section class="qb54-pa-steps" aria-labelledby="qb54-pa-steps-h-{{ section.id }}">
      <div class="qb54-pa-wrap">
        <div class="qb54-pa-center" data-qb54-pa-reveal>
          <p class="qb54-pa-eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
          <h2 class="qb54-pa-h2" id="qb54-pa-steps-h-{{ section.id }}">{{ section.settings.steps_heading | escape }}</h2>
        </div>
        <ol class="qb54-pa-steps__list">
          {%- for block in step_blocks -%}
            {%- liquid
              assign step_text = block.settings.text | escape
              if code != blank
                assign marked = '<mark>' | append: code | append: '</mark>'
                assign step_text = step_text | replace: code, marked
              endif
            -%}
            <li class="qb54-pa-step" data-qb54-pa-reveal {{ block.shopify_attributes }}>
              <span class="qb54-pa-step__n" aria-hidden="true">0{{ forloop.index }}</span>
              <span class="qb54-pa-step__i" aria-hidden="true">{{ forloop.index }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ step_text }}</p>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  {%- if review_blocks.size > 0 -%}
    <section class="qb54-pa-reviews qb54-pa-light" aria-labelledby="qb54-pa-rev-h-{{ section.id }}">
      <div class="qb54-pa-wrap">
        <header class="qb54-pa-head qb54-pa-center" data-qb54-pa-reveal>
          <p class="qb54-pa-eyebrow">{{ section.settings.reviews_eyebrow | escape }}</p>
          <h2 class="qb54-pa-h2" id="qb54-pa-rev-h-{{ section.id }}">{{ section.settings.reviews_heading }}</h2>
          <p class="qb54-pa-score">{{ stars_5 }}
            {%- if lead_rating != blank and lead_count != blank -%}<span><b>{{ lead_rating.rating | round: 1 }}</b> average · {{ lead_count }} reviews</span>{%- else -%}<span>{{ section.settings.rating_fallback | escape }}</span>{%- endif -%}
          </p>
        </header>
        <div class="qb54-pa-revrail" tabindex="0" aria-label="Customer reviews">
          {%- for block in review_blocks -%}
            <figure class="qb54-pa-review" {{ block.shopify_attributes }}>
              {{ stars_5 }}
              <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
              <footer>
                <span class="qb54-pa-av" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
                <span><cite>{{ block.settings.name | escape }}</cite><span class="qb54-pa-verified">{{ i_check }}Verified Buyer</span></span>
              </footer>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if faq_blocks.size > 0 -%}
    <section class="qb54-pa-faq qb54-pa-light" aria-labelledby="qb54-pa-faq-h-{{ section.id }}">
      <div class="qb54-pa-wrap qb54-pa-faq__grid">
        <div class="qb54-pa-faq__aside" data-qb54-pa-reveal>
          <p class="qb54-pa-eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
          <h2 class="qb54-pa-h2" id="qb54-pa-faq-h-{{ section.id }}">{{ section.settings.faq_heading }}</h2>
        </div>
        <div>
          {%- for block in faq_blocks -%}
            <details class="qb54-pa-qa"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}<span class="qb54-pa-plus" aria-hidden="true"></span></summary>
              <div class="qb54-pa-qa__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="qb54-pa-final" data-qb54-pa-final aria-labelledby="qb54-pa-final-h-{{ section.id }}">
    {%- if section.settings.final_image != blank -%}
      <div class="qb54-pa-final__bg" aria-hidden="true">{{- section.settings.final_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000', sizes: '100vw', alt: '' -}}</div>
    {%- endif -%}
    <div class="qb54-pa-wrap" data-qb54-pa-reveal>
      <h2 id="qb54-pa-final-h-{{ section.id }}">{{ section.settings.final_heading | escape }} <em>{{ section.settings.final_accent | escape }}</em></h2>
      {%- if section.settings.final_text != blank -%}<p class="qb54-pa-lede" style="margin-inline: auto;">{{ section.settings.final_text | escape }}</p>{%- endif -%}
      {%- if code != blank -%}{{ score_bug }}{%- endif -%}
      <div class="qb54-pa-ctas">
        <a class="qb54-pa-btn qb54-pa-btn--gold qb54-pa-btn--shine" href="#qb54-pa-sets-{{ section.id }}">{{ section.settings.final_cta | escape }}{{ i_arrow }}</a>
      </div>
      <ul class="qb54-pa-trust">
        {%- if section.settings.proof_3 != blank -%}<li>{{ i_truck }}{{ section.settings.proof_3 | escape }}</li>{%- endif -%}
        {%- if section.settings.stock_note != blank -%}<li>{{ i_bolt }}{{ section.settings.stock_note | escape }}</li>{%- endif -%}
        {%- if section.settings.returns_note != blank -%}<li>{{ i_shield }}{{ section.settings.returns_note | escape }}</li>{%- endif -%}
      </ul>
    </div>
  </section>

  {%- if section.settings.show_sticky_bar -%}
    <div class="qb54-pa-sticky" data-qb54-pa-sticky aria-hidden="true">
      <div class="qb54-pa-sticky__t"><strong>{{ pct }}% off · {{ code }}</strong><span>{{ section.settings.sticky_text | escape }}</span></div>
      <a class="qb54-pa-btn qb54-pa-btn--gold" href="#qb54-pa-sets-{{ section.id }}" tabindex="-1">{{ section.settings.sticky_cta | escape }}</a>
    </div>
  {%- endif -%}

  <div class="qb54-pa-toast" data-qb54-pa-toast role="status" aria-live="polite" hidden>
    <span class="qb54-pa-toast__ok" aria-hidden="true">{{ i_check }}</span>
    <div class="qb54-pa-toast__t"><strong>Added to cart</strong><span data-qb54-pa-toast-meta></span></div>
    {%- if free_ship > 0 -%}
      <div class="qb54-pa-meter" data-qb54-pa-meter>
        <span class="qb54-pa-meter__bar"><i data-qb54-pa-meter-fill></i></span>
        <span class="qb54-pa-meter__t" data-qb54-pa-meter-text></span>
      </div>
    {%- endif -%}
    <div class="qb54-pa-toast__a">
      <a class="qb54-pa-btn qb54-pa-btn--gold" href="{{ checkout_url }}{% if code != blank %}?discount={{ code | url_encode }}{% endif %}">Checkout</a>
      <a class="qb54-pa-toast__cart" href="{{ routes.cart_url }}">View cart</a>
    </div>
    <button type="button" class="qb54-pa-toast__x" data-qb54-pa-toast-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
</div>

<script>
  (function () {
    var id = '{{ section.id }}';
    var root = document.getElementById('qb54-pa-' + id);
    if (!root) return;
    window.__qb54Pa = window.__qb54Pa || {};
    if (window.__qb54Pa[id]) window.__qb54Pa[id].destroy();

    var cleanups = [];
    var shopRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var code = root.getAttribute('data-code');
    var freeShip = parseInt(root.getAttribute('data-free'), 10) || 0;
    var moneyFormat = {{ shop.money_format | json }};
    root.classList.add('qb54-pa--js');
    function $all(sel, ctx) { return Array.prototype.slice.call((ctx || root).querySelectorAll(sel)); }

    function formatMoney(cents) {
      var value = (cents / 100).toFixed(2);
      var withCommas = value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return String(moneyFormat || '${{ "{{" }}amount}}').replace(/\{\{\s*(\w+)\s*\}\}/, function (m, kind) {
        if (kind === 'amount_no_decimals') return Math.round(cents / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        if (kind === 'amount_with_comma_separator') return value.replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        return withCommas;
      });
    }

    /* ---- Apply the partner code to the cart (once per session) ---- */
    if (code && root.getAttribute('data-auto-apply') === 'true' && !(window.Shopify && window.Shopify.designMode)) {
      var key = 'qb54_pa_code_' + code;
      var done = false;
      try { done = !!sessionStorage.getItem(key); } catch (e) {}
      if (!done) {
        fetch(shopRoot + 'discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(shopRoot + 'cart.js'), { credentials: 'same-origin' })
          .then(function () { try { sessionStorage.setItem(key, '1'); } catch (e) {} })
          .catch(function () {});
      }
    }

    /* ---- Hero card color switcher ---- */
    $all('[data-qb54-pa-switch]').forEach(function (card) {
      card.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-qb54-pa-to]');
        if (!btn) return;
        var to = btn.getAttribute('data-qb54-pa-to');
        $all('[data-qb54-pa-panel]', card).forEach(function (panel) { panel.hidden = panel.getAttribute('data-qb54-pa-panel') !== to; });
        $all('[data-qb54-pa-to]', card).forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-qb54-pa-to') === to ? 'true' : 'false'); });
        // The clicked swatch is now in a hidden panel; keep focus on its twin.
        var twin = $all('[data-qb54-pa-to="' + to + '"]', card).filter(function (b) { return b.offsetParent !== null; })[0];
        if (twin) twin.focus();
      });
    });

    /* ---- Copy code ---- */
    function onCopy(btn) {
      var value = btn.getAttribute('data-qb54-pa-copy');
      var label = btn.querySelector('[data-qb54-pa-copy-label]');
      var ok = function () { if (label) { label.textContent = 'Copied!'; setTimeout(function () { label.textContent = 'Copy'; }, 1800); } };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(value).then(ok, ok);
      else ok();
    }

    /* ---- Cart: count, toast with free-shipping progress, add ---- */
    var countEls = $all('[data-qb54-pa-count]');
    var toast = root.querySelector('[data-qb54-pa-toast]');
    var toastMeta = root.querySelector('[data-qb54-pa-toast-meta]');
    var meter = root.querySelector('[data-qb54-pa-meter]');
    var toastTimer = 0;
    function updateCount(cart, bump) {
      var count = (cart && cart.item_count) || 0;
      countEls.forEach(function (el) {
        el.textContent = count;
        el.hidden = count === 0;
        if (bump && !reduce) { el.classList.remove('is-bump'); void el.offsetWidth; el.classList.add('is-bump'); }
      });
    }
    function setMeter(total) {
      if (!meter || !freeShip) return;
      var fill = meter.querySelector('[data-qb54-pa-meter-fill]');
      var text = meter.querySelector('[data-qb54-pa-meter-text]');
      var left = freeShip - total;
      var goal = formatMoney(freeShip).replace(/[.,]00(?=\D*$)/, '');
      meter.classList.toggle('is-done', left <= 0);
      if (fill) fill.style.width = Math.min(100, Math.round(total / freeShip * 100)) + '%';
      if (!text) return;
      text.textContent = '';
      var strong = document.createElement('strong');
      if (left <= 0) {
        strong.textContent = 'Free shipping unlocked.';
        text.appendChild(strong);
        text.appendChild(document.createTextNode(' Your order is ' + goal + ' or more.'));
      } else {
        text.appendChild(document.createTextNode('Add '));
        strong.textContent = formatMoney(left);
        text.appendChild(strong);
        text.appendChild(document.createTextNode(' more for free shipping (' + goal + '+).'));
      }
    }
    function hideToast() { clearTimeout(toastTimer); if (toast) toast.hidden = true; }
    function showToast(title, cart) {
      if (!toast) return;
      var count = (cart && cart.item_count) || 0;
      if (toastMeta) toastMeta.textContent = (title ? title + ' · ' : '') + count + (count === 1 ? ' item' : ' items') + ' in your cart';
      setMeter((cart && cart.total_price) || 0);
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(hideToast, 9000);
    }
    cleanups.push(function () { clearTimeout(toastTimer); });
    fetch(shopRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); }).then(function (cart) { updateCount(cart, false); }).catch(function () {});

    var cartIcon = '{{ i_cart | strip_newlines }}';
    var checkIcon = '{{ i_check | strip_newlines }}';
    function setButton(btn, mode, message) {
      var label = btn.querySelector('[data-qb54-pa-label]');
      var icon = btn.querySelector('[data-qb54-pa-icon]');
      var err = btn.parentNode.querySelector('[data-qb54-pa-err]');
      btn.classList.remove('is-added', 'is-error');
      btn.removeAttribute('aria-busy');
      if (err) { err.hidden = true; err.textContent = ''; }
      if (mode === 'loading') {
        btn.setAttribute('aria-busy', 'true');
        if (icon) icon.innerHTML = '<span class="qb54-pa-spin"></span>';
        if (label) label.textContent = 'Adding…';
      } else if (mode === 'added') {
        btn.classList.add('is-added');
        if (icon) icon.innerHTML = checkIcon;
        if (label) label.textContent = 'Added';
        setTimeout(function () { setButton(btn, 'idle'); }, 2200);
      } else if (mode === 'error') {
        btn.classList.add('is-error');
        if (icon) icon.innerHTML = cartIcon;
        if (label) label.textContent = 'Try Again';
        if (err && message) { err.textContent = message; err.hidden = false; }
      } else {
        if (icon) icon.innerHTML = cartIcon;
        if (label) label.textContent = btn.getAttribute('data-label') || 'Add to Cart';
      }
    }
    function addToCart(btn) {
      if (btn.getAttribute('aria-busy') === 'true') return;
      var items = (btn.getAttribute('data-variants') || '').split(',').filter(Boolean).map(function (v) { return { id: Number(v), quantity: 1 }; });
      if (!items.length) return;
      setButton(btn, 'loading');
      var bundled = [];
      document.documentElement.dispatchEvent(new CustomEvent('cart:bundled-sections', { bubbles: true, detail: { sections: bundled } }));
      var body = { items: items };
      if (bundled.length) { body.sections = bundled.join(','); body.sections_url = window.location.pathname; }
      fetch(shopRoot + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(body)
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, json: j }; }); })
        .then(function (res) {
          if (!res.ok || res.json.status) throw res.json;
          if (window.theme && theme.settings && theme.settings.cartType === 'page') { window.location.href = shopRoot + 'cart'; return; }
          var drawer = document.querySelector('cart-drawer');
          var hasDrawer = !!(drawer && typeof drawer.show === 'function');
          if (hasDrawer) drawer.show(btn);
          return fetch(shopRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (cart) {
              cart.sections = res.json.sections;
              if (window.theme && theme.pubsub && theme.pubsub.publish) theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, { source: 'qb54-partner', productVariantId: String(items[0].id), cart: cart });
              updateCount(cart, true);
              if (!hasDrawer) showToast(btn.getAttribute('data-title'), cart);
              setButton(btn, 'added');
            });
        })
        .catch(function (error) {
          var message = error && (error.description || error.message);
          setButton(btn, 'error', typeof message === 'string' ? message : 'Something went wrong. Please try again.');
        });
    }
    function onClick(event) {
      if (event.target.closest('[data-qb54-pa-toast-close]')) { hideToast(); return; }
      var copy = event.target.closest('[data-qb54-pa-copy]');
      if (copy) { onCopy(copy); return; }
      var btn = event.target.closest('[data-qb54-pa-add]');
      if (btn) { event.preventDefault(); addToCart(btn); }
    }
    root.addEventListener('click', onClick);
    cleanups.push(function () { root.removeEventListener('click', onClick); });

    /* ---- Reels: one plays at a time (first in view, or hovered), tap for sound ---- */
    var reels = $all('[data-qb54-pa-reel]');
    var ratios = [];
    var active = null;
    function load(fig) {
      var video = fig.querySelector('video');
      if (video && !video.getAttribute('src') && video.getAttribute('data-src')) { video.setAttribute('src', video.getAttribute('data-src')); video.preload = 'metadata'; }
      return video;
    }
    function play(fig) {
      var video = load(fig);
      if (!video) return;
      var p = video.play();
      if (p && p.then) p.then(function () { fig.classList.add('is-playing'); }).catch(function () {});
    }
    function pause(fig) { var video = fig.querySelector('video'); if (video && !video.paused) video.pause(); fig.classList.remove('is-playing'); }
    function activate(fig) { if (fig === active) return; if (active) pause(active); active = fig; if (fig) play(fig); }
    if (reels.length && 'IntersectionObserver' in window) {
      var reelIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { ratios[reels.indexOf(e.target)] = e.isIntersecting ? e.intersectionRatio : 0; });
        if (reduce) return;
        if (active && (ratios[reels.indexOf(active)] || 0) >= 0.6) return;
        var next = null;
        reels.forEach(function (r, i) { if (!next && (ratios[i] || 0) >= 0.6) next = r; });
        activate(next);
      }, { threshold: [0, 0.6, 1] });
      reels.forEach(function (r) { reelIo.observe(r); });
      cleanups.push(function () { reelIo.disconnect(); });
    }
    reels.forEach(function (fig) {
      fig.addEventListener('mouseenter', function () { if (!reduce) activate(fig); });
      fig.addEventListener('click', function (event) {
        var video = load(fig);
        if (!video) return;
        var soundBtn = event.target.closest('[data-qb54-pa-sound]');
        if (video.paused) { if (active === fig) active = null; activate(fig); if (!soundBtn) return; }
        var unmute = video.muted;
        reels.forEach(function (other) {
          var ov = other.querySelector('video');
          if (ov) ov.muted = true;
          other.classList.remove('is-unmuted');
          var b = other.querySelector('[data-qb54-pa-sound]');
          if (b) b.setAttribute('aria-label', 'Turn sound on');
        });
        video.muted = !unmute;
        fig.classList.toggle('is-unmuted', unmute);
        var sb = fig.querySelector('[data-qb54-pa-sound]');
        if (sb) sb.setAttribute('aria-label', unmute ? 'Turn sound off' : 'Turn sound on');
      });
    });

    /* ---- Mobile sticky bar: after the hero, hidden over the final CTA ---- */
    var sticky = root.querySelector('[data-qb54-pa-sticky]');
    var hero = root.querySelector('[data-qb54-pa-hero]');
    var finalSection = root.querySelector('[data-qb54-pa-final]');
    var heroVisible = true, finalVisible = false;
    function updateSticky() {
      if (!sticky) return;
      var show = !heroVisible && !finalVisible;
      sticky.classList.toggle('is-visible', show);
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
      $all('a', sticky).forEach(function (a) { a.tabIndex = show ? 0 : -1; });
      document.body.classList.toggle('qb54-pa-bar-on', show);
    }
    if (sticky && 'IntersectionObserver' in window) {
      var stickyIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.target === hero) heroVisible = e.isIntersecting; if (e.target === finalSection) finalVisible = e.isIntersecting; });
        updateSticky();
      });
      if (hero) stickyIo.observe(hero);
      if (finalSection) stickyIo.observe(finalSection);
      cleanups.push(function () { stickyIo.disconnect(); document.body.classList.remove('qb54-pa-bar-on'); });
    }

    /* ---- Reveal on scroll ---- */
    var reveals = $all('[data-qb54-pa-reveal]');
    if (!reduce && 'IntersectionObserver' in window) {
      var revealIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); revealIo.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      reveals.forEach(function (el) { revealIo.observe(el); });
      cleanups.push(function () { revealIo.disconnect(); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-in'); });
    }

    function onUnload(event) { if (event.detail && event.detail.sectionId === id) destroy(); }
    document.addEventListener('shopify:section:unload', onUnload);
    cleanups.push(function () { document.removeEventListener('shopify:section:unload', onUnload); });
    function destroy() {
      reels.forEach(pause);
      while (cleanups.length) { try { cleanups.pop()(); } catch (e) {} }
      delete window.__qb54Pa[id];
    }
    window.__qb54Pa[id] = { destroy: destroy };
  })();
</script>

{% schema %}
{
  "name": "QB54 Partner Landing",
  "tag": "section",
  "class": "qb54-pa-section",
  "settings": [
    { "type": "header", "content": "Partner" },
    { "type": "text", "id": "partner_name", "label": "Partner or show name", "default": "The Jake Asman Show" },
    { "type": "image_picker", "id": "partner_image", "label": "Partner photo or logo", "info": "Square works best. A microphone icon shows when empty." },
    { "type": "url", "id": "partner_url", "label": "Partner channel link" },
    { "type": "text", "id": "partner_url_label", "label": "Channel link label", "default": "Watch the show" },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "code", "label": "Discount code", "info": "Must exist in Shopify Admin > Discounts.", "default": "ASMAN" },
    { "type": "range", "id": "discount_percent", "label": "Discount percent", "min": 5, "max": 50, "step": 5, "unit": "%", "default": 15 },
    { "type": "checkbox", "id": "auto_apply_code", "label": "Apply the code automatically for visitors", "default": true },
    { "type": "text", "id": "applied_note", "label": "Auto-apply note", "default": "Code applied automatically when you shop this page" },
    { "type": "collection", "id": "code_collection", "label": "Products the code applies to", "info": "These show the price after the code. Leave empty to treat every game set below as eligible." },
    { "type": "range", "id": "free_ship_threshold", "label": "Free shipping threshold", "min": 0, "max": 500, "step": 5, "unit": "$", "default": 225 },
    { "type": "url", "id": "shop_url", "label": "Shop all link" },
    { "type": "header", "content": "Top bar" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "bar_cta", "label": "Button", "default": "Shop the deal" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Background photo" },
    {
      "type": "select", "id": "hero_focal", "label": "Photo position",
      "options": [ { "value": "center center", "label": "Center" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }, { "value": "70% center", "label": "Right" }, { "value": "30% center", "label": "Left" } ],
      "default": "center center"
    },
    { "type": "text", "id": "onair_label", "label": "Badge label", "default": "As heard on" },
    { "type": "text", "id": "hero_line", "label": "Line under the offer", "default": "QB54 for every listener" },
    { "type": "textarea", "id": "hero_text", "label": "Text" },
    { "type": "text", "id": "hero_cta", "label": "Button", "default": "Shop the deal" },
    { "type": "text", "id": "hero_cta_2", "label": "Second button", "default": "Watch it in action" },
    { "type": "text", "id": "proof_1", "label": "Proof 1", "default": "As seen on Shark Tank" },
    { "type": "text", "id": "rating_fallback", "label": "Rating text when no review data", "default": "Hundreds of 5-star reviews" },
    { "type": "text", "id": "proof_3", "label": "Proof 3", "default": "Free shipping on orders $225+" },
    { "type": "text", "id": "card_ribbon", "label": "Product card ribbon", "default": "Listener deal" },
    { "type": "text", "id": "rating_card_fallback", "label": "Product card rating text when no review data", "default": "5-star rated" },
    { "type": "text", "id": "stock_note", "label": "Stock note", "default": "In stock, ships within 1 business day" },
    { "type": "text", "id": "returns_note", "label": "Returns note", "default": "30-day returns" },
    { "type": "text", "id": "ticker_items", "label": "Ticker", "info": "Separate with |" },
    { "type": "header", "content": "Welcome card" },
    { "type": "text", "id": "welcome_kicker", "label": "Kicker", "default": "Welcome, listeners of" },
    { "type": "textarea", "id": "welcome_text", "label": "Text (the code is added at the end)", "default": "You heard it on the show. Now bring the game home. Your listener discount is waiting:" },
    { "type": "header", "content": "Game sets" },
    { "type": "product_list", "id": "sets", "label": "Game sets", "info": "The first three single-color sets also power the hero card.", "limit": 8 },
    { "type": "text", "id": "sets_eyebrow", "label": "Eyebrow", "default": "The deals" },
    { "type": "inline_richtext", "id": "sets_heading", "label": "Heading", "default": "Pick your set. <em>Save 15%.</em>" },
