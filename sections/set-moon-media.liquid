{% comment %}
  MEM-Classic-Set — Collection Showcase
  sections/mem-classic-set.liquid
  All product data auto-fetched from product picker.
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
.mcs-wrap *, .mcs-wrap *::before, .mcs-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }

.mcs-wrap {
  font-family: 'Poppins', sans-serif;
  --o:    {{ section.settings.color_accent }};
  --od:   #C94F10;
  --dk:   {{ section.settings.bg_color }};
  --card: {{ section.settings.card_bg_color }};
  --ink:  #0F0F0F;
  --sub:  #6B6B6B;
  --bdr:  rgba(0,0,0,.08);
}

/* ── Section ── */
.mcs-sec {
  background: var(--dk);
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  position: relative; overflow: clip;
}
.mcs-sec::before {
  content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(0,0,0,.04) 1px, transparent 1px);
  background-size: 28px 28px; opacity: .5;
}
.mcs-inner {
  position: relative; z-index: 1;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto; padding: 0 32px;
}

/* ── Header ── */
.mcs-hdr { text-align: center; margin-bottom: 48px; }
.mcs-hdr-ey {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 11px; font-weight: 700; letter-spacing: 4px;
  text-transform: uppercase; color: var(--o); margin-bottom: 14px;
}
.mcs-hdr-ey::before, .mcs-hdr-ey::after { content: ''; width: 22px; height: 2px; background: var(--o); flex-shrink: 0; }
.mcs-hdr-title {
  font-size: clamp(30px,4.5vw,52px); font-weight: 900;
  text-transform: uppercase; color: white;
  letter-spacing: -1.5px; line-height: 1; margin-bottom: 16px;
  overflow-wrap: anywhere; word-break: break-word;
}
.mcs-hdr-sub { font-size: 16px; color: var(--sub); line-height: 1.65; max-width: 560px; margin: 0 auto; overflow-wrap: break-word; }

/* ── Grid ── */
.mcs-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  align-items: start; /* cards grow independently — alignment done inside */
}

/* ── Card ── */
.mcs-card {
  background: var(--card);
  border: 2px solid transparent;
  border-radius: 4px;
  overflow: hidden;
  display: flex; flex-direction: column;
  position: relative;
  transition: box-shadow .3s, transform .3s;
  min-width: 0;
  width: 100%;
}
.mcs-card:hover { box-shadow: 0 16px 60px rgba(0,0,0,.1); transform: translateY(-3px); }
.mcs-card.mcs-featured { border-color: var(--o); box-shadow: 0 8px 40px rgba(242,101,34,.12); }
.mcs-card.mcs-featured:hover { box-shadow: 0 20px 70px rgba(242,101,34,.2); }

/* ── Ribbon — always rendered, invisible when not featured ── */
.mcs-ribbon {
  height: 36px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 800; letter-spacing: 2.5px; text-transform: uppercase;
  flex-shrink: 0;
  visibility: hidden; /* hidden but keeps height */
}
.mcs-card.mcs-featured .mcs-ribbon {
  background: var(--o); color: #fff;
  visibility: visible;
}

/* ── Image / Video wrap ── */
.mcs-img-wrap {
  position: relative; overflow: hidden;
  background: #F5F2EE; aspect-ratio: 1/1; flex-shrink: 0;
  width: 100%;
}
.mcs-slide {
  position: absolute; inset: 0;
  width: 100%; height: 100%; display: none;
}
.mcs-slide.mcs-on { display: block; }
.mcs-slide img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform .5s cubic-bezier(.16,1,.3,1);
}
.mcs-card:hover .mcs-slide.mcs-on img { transform: scale(1.04); }
.mcs-slide video, .mcs-slide iframe {
  width: 100%; height: 100%; object-fit: cover; display: block; border: none;
}
.mcs-thumb { position: relative; }
.mcs-thumb-play {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.38); pointer-events: none; font-size: 15px; color: #fff;
}

.mcs-img-badge {
  position: absolute; top: 12px; left: 12px; z-index: 3;
  background: var(--o); color: #fff; font-weight: 700;
  font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
  padding: 5px 12px; border-radius: 2px;
  box-shadow: 0 4px 16px rgba(242,101,34,.3);
  max-width: calc(100% - 24px);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ── Slide arrows ── */
.mcs-arrow {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 4;
  width: 34px; height: 34px;
  background: rgba(0,0,0,.38); backdrop-filter: blur(4px);
  border: none; border-radius: 50%; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s;
}
.mcs-arrow:hover { background: rgba(255,255,255,.95); }
.mcs-arrow svg { width: 16px; height: 16px; stroke: #fff; stroke-width: 3; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.mcs-arrow:hover svg { stroke: #111; }
.mcs-arrow-prev { left: 10px; }
.mcs-arrow-next { right: 10px; }
.mcs-arrow[data-hidden] { display: none; }
.mcs-thumbs {
  height: 66px; /* fixed — same on every card whether or not it has thumbs */
  display: flex; align-items: center; gap: 5px; padding: 0 10px;
  background: rgba(255,255,255,.95);
  border-top: 1px solid var(--bdr);
  overflow-x: auto; scrollbar-width: none; flex-shrink: 0;
  width: 100%;
}
.mcs-thumbs::-webkit-scrollbar { display: none; }
.mcs-thumb {
  width: 48px; height: 48px; flex-shrink: 0;
  border: 2px solid transparent; border-radius: 3px;
  overflow: hidden; cursor: pointer; background: #eee;
  transition: border-color .2s;
}
.mcs-thumb:hover  { border-color: rgba(0,0,0,.2); }
.mcs-thumb.mcs-on { border-color: var(--o); }
.mcs-thumb img    { width: 100%; height: 100%; object-fit: cover; display: block; }

/* ── Body ── */
.mcs-body { padding: 22px 22px 0; flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }

.mcs-ey { font-size: 10px; font-weight: 700; letter-spacing: 3.5px; text-transform: uppercase; color: var(--o); margin-bottom: 6px; min-height: 18px; overflow-wrap: anywhere; }

.mcs-name { font-weight: 900; font-size: clamp(20px,2vw,26px); text-transform: uppercase; color: white; line-height: 1.05; letter-spacing: -.5px; margin-bottom: 12px; overflow-wrap: anywhere; word-break: break-word; hyphens: auto; }

.mcs-prices { display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
.mcs-price   { font-weight: 900; font-size: 28px; color: var(--o); line-height: 1; }
.mcs-compare { font-size: 16px; color: #bbb; text-decoration: line-through; font-weight: 500; }
.mcs-save    { background: #eaf5ea; color: #2e7d32; font-weight: 700; font-size: 11px; letter-spacing: 1px; padding: 3px 9px; border-radius: 20px; border: 1px solid #c3e6cb; white-space: nowrap; }

.mcs-desc { font-size: 13px; color: var(--sub); line-height: 1.7; margin-bottom: 16px; overflow-wrap: break-word; }

.mcs-feats { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--bdr); }
.mcs-feat  { display: flex; align-items: center; gap: 9px; font-size: 13px; color: #333; font-weight: 500; overflow-wrap: break-word; min-width: 0; }
.mcs-feat-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--o); flex-shrink: 0; }

.mcs-code { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; padding: 10px 14px; background: #FFF8F5; border: 1px dashed rgba(242,101,34,.35); border-radius: 4px; flex-wrap: wrap; }
.mcs-code-lbl { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #aaa; }
.mcs-code-val { font-weight: 900; font-size: 16px; letter-spacing: 3px; color: var(--o); overflow-wrap: anywhere; }
.mcs-code-pct { margin-left: auto; font-size: 12px; font-weight: 600; color: #555; white-space: nowrap; }

/* ── Footer ── */
.mcs-foot { padding: 0 22px 22px; margin-top: auto; display: flex; flex-direction: column; gap: 10px; min-width: 0; }

.mcs-actions { display: flex; gap: 8px; align-items: stretch; min-width: 0; }

.mcs-qty { display: flex; align-items: stretch; border: 2px solid #e0e0e0; border-radius: 3px; overflow: hidden; flex-shrink: 0; }
.mcs-qty-btn { width: 38px; background: transparent; border: none; font-size: 18px; cursor: pointer; color: #7bd321; transition: background .15s; display: flex; align-items: center; justify-content: center; }
.mcs-qty-btn:hover { background: #f5f5f5; }
.mcs-qty-num { width: 42px; text-align: center; border: none; border-left: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; font-family: 'Poppins',sans-serif; font-weight: 700; font-size: 14px; color: white; background: transparent; -moz-appearance: textfield; }
.mcs-qty-num::-webkit-inner-spin-button, .mcs-qty-num::-webkit-outer-spin-button { -webkit-appearance: none; }

.mcs-atc { flex: 1; min-width: 0; height: 50px; background: var(--o); color: black; border: none; font-family: 'Poppins',sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; border-radius: 3px; cursor: pointer; transition: background .2s, box-shadow .2s; display: flex; align-items: center; justify-content: center; text-decoration: none;  white-space: nowrap; padding: 0 10px; }

.mcs-atc:disabled { opacity: .6; cursor: not-allowed; box-shadow: none; }

.mcs-view-link { display: block; text-align: center; font-size: 12px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--sub); text-decoration: none; transition: color .2s; padding: 4px 0; }
.mcs-view-link:hover { color: var(--o); }

/* ── Comparison table ── */
.mcs-compare-row { margin-top: 40px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.mcs-compare-table { width: 100%; min-width: 540px; border-collapse: collapse; font-size: 13px; }
.mcs-compare-table th, .mcs-compare-table td { padding: 13px 18px; border-bottom: 1px solid var(--bdr); text-align: center; }
.mcs-compare-table th { font-weight: 800; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ink); background: #f9f6f3; }
.mcs-compare-table td:first-child, .mcs-compare-table th:first-child { text-align: left; font-weight: 700; color: #555; min-width: 160px; }
.mcs-compare-table tr:last-child td { border-bottom: none; }
.mcs-check { color: var(--o); font-size: 18px; font-weight: 900; }
.mcs-dash  { color: #ccc; font-size: 18px; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .mcs-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .mcs-grid .mcs-card:last-child { grid-column: 1/-1; max-width: 480px; margin: 0 auto; width: 100%; }
}
@media (max-width: 640px) {
  .mcs-inner    { padding: 0 16px; }
  .mcs-hdr      { margin-bottom: 32px; }
  .mcs-grid     { grid-template-columns: minmax(0, 1fr); }
  .mcs-grid .mcs-card:last-child { grid-column: auto; max-width: none; }
  .mcs-body     { padding: 18px 18px 0; }
  .mcs-foot     { padding: 0 18px 20px; }
  .mcs-name     { font-size: clamp(22px,6vw,28px); }
  .mcs-price    { font-size: 24px; }
  .mcs-actions  { gap: 8px; }
  .mcs-qty-btn  { width: 32px; font-size: 16px; }
  .mcs-qty-num  { width: 34px; font-size: 13px; }
  .mcs-atc      { height: 48px; font-size: 11px; letter-spacing: 0.8px; padding: 0 8px; }
  .mcs-arrow    { width: 30px; height: 30px; }
  .mcs-arrow svg { width: 13px; height: 13px; }
  .mcs-img-badge { font-size: 9px; padding: 4px 10px; top: 10px; left: 10px; letter-spacing: 1.5px; }
  .mcs-thumbs   { height: 60px; padding: 0 8px; }
  .mcs-thumb    { width: 44px; height: 44px; }
  .mcs-code     { padding: 9px 12px; }
  .mcs-code-pct { width: 100%; margin-left: 0; }
}
@media (max-width: 380px) {
  .mcs-body     { padding: 16px 14px 0; }
  .mcs-foot     { padding: 0 14px 16px; }
  .mcs-actions  { gap: 6px; }
  .mcs-qty-btn  { width: 28px; font-size: 15px; }
  .mcs-qty-num  { width: 30px; font-size: 12px; }
  .mcs-atc      { font-size: 10px; letter-spacing: 0.5px; padding: 0 6px; height: 46px; }
}
</style>

<div id="yourock" class="mcs-wrap">
  <section class="mcs-sec">
    <div class="mcs-inner">

      <header class="mcs-hdr">
        {% if section.settings.eyebrow != blank %}<div class="mcs-hdr-ey">{{ section.settings.eyebrow }}</div>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="mcs-hdr-title">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p class="mcs-hdr-sub">{{ section.settings.subheading }}</p>{% endif %}
      </header>

      <div class="mcs-grid">

        {% comment %} ─── CARD 1 ─── {% endcomment %}
        {% assign fp = all_products[section.settings.product_1] %}
        {% if fp != empty %}
          {% assign c_var = fp.selected_or_first_available_variant %}
          {% assign c_name = section.settings.name_1 | default: fp.title %}
          {% assign c_desc = section.settings.desc_1 %}
          {% if c_desc == blank %}{% assign c_desc = fp.description | strip_html | truncate: 160 %}{% endif %}
          {% assign c_price = c_var.price | money %}
          {% assign c_url = fp.url %}
          {% assign c_vid = c_var.id %}
          {% assign c_media = fp.media %}
          {% assign c_feat = false %}
          {% if section.settings.featured_card == 'card_1' %}{% assign c_feat = true %}{% endif %}
          {% assign c_has_compare = false %}
          {% if c_var.compare_at_price > c_var.price %}
            {% assign c_has_compare = true %}
            {% assign c_compare = c_var.compare_at_price | money %}
            {% assign c_save_raw = c_var.compare_at_price | minus: c_var.price %}
            {% assign c_save_pct = c_save_raw | times: 100 | divided_by: c_var.compare_at_price | round %}
            {% assign c_save_label = 'Save ' | append: c_save_pct | append: '%' %}
          {% endif %}

          <div class="mcs-card{% if c_feat %} mcs-featured{% endif %}" id="mcs-card-0">

            <div class="mcs-ribbon">{% if c_feat %}{{ section.settings.featured_label }}{% endif %}</div>

            <div class="mcs-img-wrap">
              {% if section.settings.badge_1 != blank %}<div class="mcs-img-badge">{{ section.settings.badge_1 }}</div>{% endif %}
              <button class="mcs-arrow mcs-arrow-prev" type="button" onclick="mcsArrow('mcs-card-0',-1)" aria-label="Previous">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button class="mcs-arrow mcs-arrow-next" type="button" onclick="mcsArrow('mcs-card-0',1)" aria-label="Next">
                <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
              </button>
              {% assign si = 0 %}
              {% for media in c_media %}
                {% if media.media_type == 'image' %}
                  <div class="mcs-slide{% if si == 0 %} mcs-on{% endif %}" data-mcs-panel="mcs-card-0" data-mcs-slide="{{ si }}">
                    <img src="{{ media | image_url: width: 900 }}" alt="{{ media.alt | default: c_name | escape }}" loading="{% if si == 0 %}eager{% else %}lazy{% endif %}">
                  </div>
                  {% assign si = si | plus: 1 %}
                {% elsif media.media_type == 'video' %}
                  <div class="mcs-slide{% if si == 0 %} mcs-on{% endif %}" data-mcs-panel="mcs-card-0" data-mcs-slide="{{ si }}">
                    <video autoplay muted loop playsinline poster="{{ media.preview_image | image_url: width: 900 }}" style="width:100%;height:100%;object-fit:cover;display:block">
                      {% for source in media.sources %}{% if source.format == 'mp4' %}<source src="{{ source.url }}" type="video/mp4">{% endif %}{% endfor %}
                      {% for source in media.sources %}{% unless source.format == 'mp4' %}<source src="{{ source.url }}" type="video/{{ source.format }}">{% endunless %}{% endfor %}
                    </video>
                  </div>
                  {% assign si = si | plus: 1 %}
                {% elsif media.media_type == 'external_video' %}
                  <div class="mcs-slide{% if si == 0 %} mcs-on{% endif %}" data-mcs-panel="mcs-card-0" data-mcs-slide="{{ si }}">
                    {% if media.host == 'youtube' %}
                      <iframe src="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=1&mute=1&loop=1&playlist={{ media.external_id }}&controls=0&rel=0" allow="autoplay;encrypted-media" allowfullscreen></iframe>
                    {% elsif media.host == 'vimeo' %}
                      <iframe src="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1&muted=1&loop=1&controls=0" allow="autoplay;fullscreen" allowfullscreen></iframe>
                    {% endif %}
                  </div>
                  {% assign si = si | plus: 1 %}
                {% endif %}
              {% endfor %}
              {% if si == 0 and fp.featured_image %}
                <div class="mcs-slide mcs-on">
                  <img src="{{ fp.featured_image | image_url: width: 900 }}" alt="{{ c_name | escape }}" loading="eager">
                </div>
              {% endif %}
            </div>

            <div class="mcs-thumbs">
              {% if si > 1 %}
                {% assign ti = 0 %}
                {% for media in c_media %}
                  {% if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' %}
                    <div class="mcs-thumb{% if ti == 0 %} mcs-on{% endif %}" onclick="mcsThumb('mcs-card-0',{{ ti }},this)">
                      <img src="{{ media.preview_image | default: media | image_url: width: 100 }}" alt="" loading="lazy">
                    </div>
                    {% assign ti = ti | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>

            <div class="mcs-body">
              <div class="mcs-ey">{{ section.settings.eyebrow_1 }}</div>
              <h3 class="mcs-name">{{ c_name }}</h3>
              <div class="mcs-prices">
                <span class="mcs-price">{{ c_price }}</span>
                {% if c_has_compare %}<span class="mcs-compare">{{ c_compare }}</span><span class="mcs-save">{{ c_save_label }}</span>{% endif %}
              </div>
              {% if c_desc != blank %}<p class="mcs-desc">{{ c_desc }}</p>{% endif %}
              {% if section.settings.features_1 != blank %}
                <div class="mcs-feats">
                  {% assign feats = section.settings.features_1 | split: '|' %}
                  {% for f in feats %}<div class="mcs-feat"><div class="mcs-feat-dot"></div>{{ f | strip }}</div>{% endfor %}
                </div>
              {% endif %}
              {% if section.settings.promo_code != blank %}
                <div class="mcs-code">
                  <span class="mcs-code-lbl">Code</span>
                  <span class="mcs-code-val">{{ section.settings.promo_code }}</span>
                  <span class="mcs-code-pct">{{ section.settings.promo_label }}</span>
                </div>
              {% endif %}
            </div>

            <div class="mcs-foot">
              <div class="mcs-actions">
                <div class="mcs-qty">
                  <button class="mcs-qty-btn" type="button" onclick="mcsQ(this,-1)">&#8722;</button>
                  <input class="mcs-qty-num" type="number" value="1" min="1" max="99">
                  <button class="mcs-qty-btn" type="button" onclick="mcsQ(this,1)">&#43;</button>
                </div>
                {% if c_vid %}<button type="button" class="mcs-atc" data-variant="{{ c_vid }}" data-label="{{ section.settings.cta_1 }}" onclick="mcsATC(this)">{{ section.settings.cta_1 }} &#8594;</button>
                {% else %}<a href="{{ c_url }}" class="mcs-atc">{{ section.settings.cta_1 }} &#8594;</a>{% endif %}
              </div>
              <a href="{{ c_url }}" class="mcs-view-link">View full details</a>
            </div>
          </div>
        {% endif %}

        {% comment %} ─── CARD 2 ─── {% endcomment %}
        {% assign fp = all_products[section.settings.product_2] %}
        {% if fp != empty %}
          {% assign c_var = fp.selected_or_first_available_variant %}
          {% assign c_name = section.settings.name_2 | default: fp.title %}
          {% assign c_desc = section.settings.desc_2 %}
          {% if c_desc == blank %}{% assign c_desc = fp.description | strip_html | truncate: 160 %}{% endif %}
          {% assign c_price = c_var.price | money %}
          {% assign c_url = fp.url %}
          {% assign c_vid = c_var.id %}
          {% assign c_media = fp.media %}
          {% assign c_feat = false %}
          {% if section.settings.featured_card == 'card_2' %}{% assign c_feat = true %}{% endif %}
          {% assign c_has_compare = false %}
          {% if c_var.compare_at_price > c_var.price %}
            {% assign c_has_compare = true %}
            {% assign c_compare = c_var.compare_at_price | money %}
            {% assign c_save_raw = c_var.compare_at_price | minus: c_var.price %}
            {% assign c_save_pct = c_save_raw | times: 100 | divided_by: c_var.compare_at_price | round %}
            {% assign c_save_label = 'Save ' | append: c_save_pct | append: '%' %}
          {% endif %}

          <div class="mcs-card{% if c_feat %} mcs-featured{% endif %}" id="mcs-card-1">

            <div class="mcs-ribbon">{% if c_feat %}{{ section.settings.featured_label }}{% endif %}</div>

            <div class="mcs-img-wrap">
              {% if section.settings.badge_2 != blank %}<div class="mcs-img-badge">{{ section.settings.badge_2 }}</div>{% endif %}
              <button class="mcs-arrow mcs-arrow-prev" type="button" onclick="mcsArrow('mcs-card-1',-1)" aria-label="Previous">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button class="mcs-arrow mcs-arrow-next" type="button" onclick="mcsArrow('mcs-card-1',1)" aria-label="Next">
                <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
              </button>
              {% assign si = 0 %}
              {% for media in c_media %}
                {% if media.media_type == 'image' %}
                  <div class="mcs-slide{% if si == 0 %} mcs-on{% endif %}" data-mcs-panel="mcs-card-1" data-mcs-slide="{{ si }}">
