              </div>
              <a href="{{ c_url }}" class="mcs-view-link">View full details</a>
            </div>
          </div>
        {% endif %}

        {% comment %} ─── CARD 3 ─── {% endcomment %}
        {% assign fp = all_products[section.settings.product_3] %}
        {% if fp != empty %}
          {% assign c_var = fp.selected_or_first_available_variant %}
          {% assign c_name = section.settings.name_3 | default: fp.title %}
          {% assign c_desc = section.settings.desc_3 %}
          {% if c_desc == blank %}{% assign c_desc = fp.description | strip_html | truncate: 160 %}{% endif %}
          {% assign c_price = c_var.price | money %}
          {% assign c_url = fp.url %}
          {% assign c_vid = c_var.id %}
          {% assign c_media = fp.media %}
          {% assign c_feat = false %}
          {% if section.settings.featured_card == 'card_3' %}{% assign c_feat = true %}{% endif %}
          {% assign c_has_compare = false %}
          {% if c_var.compare_at_price > c_var.price %}
            {% assign c_has_compare = true %}
            {% assign c_compare = c_var.compare_at_price | money %}
            {% assign c_save_raw = c_var.compare_at_price | minus: c_var.price %}
            {% assign c_save_pct = c_save_raw | times: 100 | divided_by: c_var.compare_at_price | round %}
            {% assign c_save_label = 'Save ' | append: c_save_pct | append: '%' %}
          {% endif %}

          <div class="mcs-card{% if c_feat %} mcs-featured{% endif %}" id="mcs-card-2">

            <div class="mcs-ribbon">{% if c_feat %}{{ section.settings.featured_label }}{% endif %}</div>

            <div class="mcs-img-wrap">
              {% if section.settings.badge_3 != blank %}<div class="mcs-img-badge">{{ section.settings.badge_3 }}</div>{% endif %}
              <button class="mcs-arrow mcs-arrow-prev" type="button" onclick="mcsArrow('mcs-card-2',-1)" aria-label="Previous">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button class="mcs-arrow mcs-arrow-next" type="button" onclick="mcsArrow('mcs-card-2',1)" aria-label="Next">
                <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
              </button>
              {% assign si = 0 %}
              {% for media in c_media %}
                {% if media.media_type == 'image' %}
                  <div class="mcs-slide{% if si == 0 %} mcs-on{% endif %}" data-mcs-panel="mcs-card-2" data-mcs-slide="{{ si }}">
                    <img src="{{ media | image_url: width: 900 }}" alt="{{ media.alt | default: c_name | escape }}" loading="{% if si == 0 %}eager{% else %}lazy{% endif %}">
                  </div>
                  {% assign si = si | plus: 1 %}
                {% elsif media.media_type == 'video' %}
                  <div class="mcs-slide{% if si == 0 %} mcs-on{% endif %}" data-mcs-panel="mcs-card-2" data-mcs-slide="{{ si }}">
                    <video autoplay muted loop playsinline poster="{{ media.preview_image | image_url: width: 900 }}" style="width:100%;height:100%;object-fit:cover;display:block">
                      {% for source in media.sources %}{% if source.format == 'mp4' %}<source src="{{ source.url }}" type="video/mp4">{% endif %}{% endfor %}
                      {% for source in media.sources %}{% unless source.format == 'mp4' %}<source src="{{ source.url }}" type="video/{{ source.format }}">{% endunless %}{% endfor %}
                    </video>
                  </div>
                  {% assign si = si | plus: 1 %}
                {% elsif media.media_type == 'external_video' %}
                  <div class="mcs-slide{% if si == 0 %} mcs-on{% endif %}" data-mcs-panel="mcs-card-2" data-mcs-slide="{{ si }}">
                    {% if media.host == 'youtube' %}
                      <iframe src="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=1&mute=1&loop=1&playlist={{ media.external_id }}&controls=0&rel=0" allow="autoplay;encrypted-media" allowfullscreen></iframe>
                    {% elsif media.host == 'vimeo' %}
                      <iframe src="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1&muted=1&loop=1&controls=0" allow="autoplay;fullscreen" allowfullscreen></iframe>
                    {% endif %}
                  </div>
                  {% assign si = si | plus: 1 %}
                {% endif %}
              {% endfor %}
              {% if si == 0 and fp.featured_image %}
                <div class="mcs-slide mcs-on">
                  <img src="{{ fp.featured_image | image_url: width: 900 }}" alt="{{ c_name | escape }}" loading="eager">
                </div>
              {% endif %}
            </div>

            <div class="mcs-thumbs">
              {% if si > 1 %}
                {% assign ti = 0 %}
                {% for media in c_media %}
                  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                    <div class="mcs-thumb{% if ti == 0 %} mcs-on{% endif %}" onclick="mcsThumb('mcs-card-2',{{ ti }},this)">
                      <img src="{{ media.preview_image | image_url: width: 100 }}" alt="" loading="lazy">
                      <div class="mcs-thumb-play">&#9654;</div>
                    </div>
                    {% assign ti = ti | plus: 1 %}
                  {% endif %}
                {% endfor %}
                {% for media in c_media %}
                  {% if media.media_type == 'image' %}
                    <div class="mcs-thumb{% if ti == 0 %} mcs-on{% endif %}" onclick="mcsThumb('mcs-card-2',{{ ti }},this)">
                      <img src="{{ media | image_url: width: 100 }}" alt="" loading="lazy">
                    </div>
                    {% assign ti = ti | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>

            <div class="mcs-body">
              <div class="mcs-ey">{{ section.settings.eyebrow_3 }}</div>
              <h3 class="mcs-name">{{ c_name }}</h3>
              <div class="mcs-prices">
                <span class="mcs-price">{{ c_price }}</span>
                {% if c_has_compare %}<span class="mcs-compare">{{ c_compare }}</span><span class="mcs-save">{{ c_save_label }}</span>{% endif %}
              </div>
              {% if c_desc != blank %}<p class="mcs-desc">{{ c_desc }}</p>{% endif %}
              {% if section.settings.features_3 != blank %}
                <div class="mcs-feats">
                  {% assign feats = section.settings.features_3 | split: '|' %}
                  {% for f in feats %}<div class="mcs-feat"><div class="mcs-feat-dot"></div>{{ f | strip }}</div>{% endfor %}
                </div>
              {% endif %}
              {% if section.settings.promo_code != blank %}
                <div class="mcs-code">
                  <span class="mcs-code-lbl">Code</span>
                  <span class="mcs-code-val">{{ section.settings.promo_code }}</span>
                  <span class="mcs-code-pct">{{ section.settings.promo_label }}</span>
                </div>
              {% endif %}
            </div>

            <div class="mcs-foot">
              <div class="mcs-actions">
                <div class="mcs-qty">
                  <button class="mcs-qty-btn" type="button" onclick="mcsQ(this,-1)">&#8722;</button>
                  <input class="mcs-qty-num" type="number" value="1" min="1" max="99">
                  <button class="mcs-qty-btn" type="button" onclick="mcsQ(this,1)">&#43;</button>
                </div>
                {% if c_vid %}<button type="button" class="mcs-atc" data-variant="{{ c_vid }}" data-label="{{ section.settings.cta_3 }}" onclick="mcsATC(this)">{{ section.settings.cta_3 }} &#8594;</button>
                {% else %}<a href="{{ c_url }}" class="mcs-atc">{{ section.settings.cta_3 }} &#8594;</a>{% endif %}
              </div>
              <a href="{{ c_url }}" class="mcs-view-link">View full details</a>
            </div>
          </div>
        {% endif %}

      </div><!-- /grid -->

      {% if section.settings.show_compare_table %}
        {% assign fp1_title = all_products[section.settings.product_1].title %}
        {% assign fp2_title = all_products[section.settings.product_2].title %}
        {% assign fp3_title = all_products[section.settings.product_3].title %}
        <div class="mcs-compare-row">
          <table class="mcs-compare-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th>{{ section.settings.name_1 | default: fp1_title | default: 'Classic' }}</th>
                <th>{{ section.settings.name_2 | default: fp2_title | default: 'Complete' }}</th>
                <th>{{ section.settings.name_3 | default: fp3_title | default: 'Deluxe' }}</th>
              </tr>
            </thead>
            <tbody>
              {% assign rows = section.settings.compare_rows | split: '||' %}
              {% for row in rows %}
                {% assign cells = row | split: '|' %}
                <tr>
                  {% for cell in cells %}
                    {% assign cv = cell | strip %}
                    {% if forloop.first %}<td><strong>{{ cv }}</strong></td>
                    {% elsif cv == 'yes' or cv == 'Yes' %}<td><span class="mcs-check">&#10003;</span></td>
                    {% elsif cv == 'no' or cv == 'No' %}<td><span class="mcs-dash">&#8212;</span></td>
                    {% else %}<td>{{ cv }}</td>{% endif %}
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}

    </div>
  </section>
</div>

<script>
function mcsQ(btn, dir) {
  var n = btn.parentElement.querySelector('.mcs-qty-num');
  n.value = Math.max(1, Math.min(99, parseInt(n.value) + dir));
}
function mcsArrow(cardId, dir) {
  var slides = Array.from(document.querySelectorAll('[data-mcs-panel="' + cardId + '"]'));
  if (slides.length < 2) return;
  var cur = slides.findIndex(function(s) { return s.classList.contains('mcs-on'); });
  var next = (cur + dir + slides.length) % slides.length;
  slides[cur].classList.remove('mcs-on');
  slides[next].classList.add('mcs-on');
  var card = document.getElementById(cardId);
  if (card) {
    card.querySelectorAll('.mcs-thumb').forEach(function(t, i) { t.classList.toggle('mcs-on', i === next); });
  }
}
function mcsThumb(cardId, slideIdx, thumbEl) {
  var card = document.getElementById(cardId);
  if (!card) return;
  card.querySelectorAll('[data-mcs-panel="' + cardId + '"]').forEach(function(slide, i) {
    slide.classList.toggle('mcs-on', i === slideIdx);
  });
  thumbEl.parentElement.querySelectorAll('.mcs-thumb').forEach(function(t) { t.classList.remove('mcs-on'); });
  thumbEl.classList.add('mcs-on');
}
function mcsATC(btn) {
  var variantId = btn.dataset.variant;
  var label = btn.dataset.label;
  var card = btn.closest('.mcs-card');
  var qty = card ? parseInt(card.querySelector('.mcs-qty-num').value) || 1 : 1;
  btn.disabled = true;
  btn.textContent = 'Adding\u2026';
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ id: parseInt(variantId), quantity: qty })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.id) {
      btn.textContent = '\u2713 Added!';
      btn.style.background = '#2e7d32';
      btn.style.boxShadow = '0 4px 20px rgba(46,125,50,.3)';
      setTimeout(function() {
        window.location.href = '/checkout';
      }, 600);
    } else {
      btn.textContent = data.description || 'Error';
      btn.style.background = '#c62828';
      setTimeout(function() {
        btn.textContent = label + ' \u2192';
        btn.style.background = '';
        btn.style.boxShadow = '';
        btn.disabled = false;
      }, 2400);
    }
  })
  .catch(function() {
    btn.textContent = 'Error \u2014 try again';
    btn.style.background = '#c62828';
    setTimeout(function() {
      btn.textContent = label + ' \u2192';
      btn.style.background = '';
      btn.style.boxShadow = '';
      btn.disabled = false;
    }, 2400);
  });
}
</script>

