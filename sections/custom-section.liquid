```liquid
{% assign selected_product = section.settings.product %}

{% if selected_product != blank %}
  <section
    id="ProductCard-{{ section.id }}"
    class="product-card-section"
    data-section-id="{{ section.id }}"
  >
    <div class="product-card">

      <!-- PRODUCT IMAGE -->
      <div class="product-card__media">

        {% if selected_product.compare_at_price > selected_product.price %}
          <span class="product-card__badge">
            Sale
          </span>
        {% endif %}

        <a
          href="{{ selected_product.url }}"
          class="product-card__image-link"
          aria-label="{{ selected_product.title | escape }}"
        >
          {% if selected_product.featured_image %}
            <div class="product-card__image-wrapper">

              {{
                selected_product.featured_image
                | image_url: width: 1000
                | image_tag:
                  class: 'product-card__image product-card__image--primary',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000',
                  sizes: '(max-width: 749px) 100vw, 50vw',
                  alt: selected_product.featured_image.alt | default: selected_product.title
              }}

              {% if selected_product.images.size > 1 %}
                {{
                  selected_product.images[1]
                  | image_url: width: 1000
                  | image_tag:
                    class: 'product-card__image product-card__image--hover',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: '(max-width: 749px) 100vw, 50vw',
                    alt: selected_product.images[1].alt | default: selected_product.title
                }}
              {% endif %}

            </div>
          {% else %}
            <div class="product-card__placeholder">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </a>
      </div>

      <!-- PRODUCT CONTENT -->
      <div class="product-card__content">

        <!-- TITLE -->
        <h2 class="product-card__title">
          <a href="{{ selected_product.url }}">
            {{ selected_product.title }}
          </a>
        </h2>

        <!-- DESCRIPTION -->
        {% if section.settings.show_description and selected_product.description != blank %}
          <div class="product-card__description">
            {{ selected_product.description | strip_html | truncate: 150 }}
          </div>
        {% endif %}

        <!-- PRICE -->
        <div
          class="product-card__price"
          data-price-container
        >
          {% assign current_variant = selected_product.selected_or_first_available_variant %}

          {% if current_variant.compare_at_price > current_variant.price %}
            <span
              class="product-card__price-sale"
              data-sale-price
            >
              {{ current_variant.price | money }}
            </span>

            <span
              class="product-card__price-compare"
              data-compare-price
            >
              {{ current_variant.compare_at_price | money }}
            </span>
          {% else %}
            <span
              class="product-card__price-regular"
              data-regular-price
            >
              {{ current_variant.price | money }}
            </span>

            <span
              class="product-card__price-compare"
              data-compare-price
              hidden
            ></span>
          {% endif %}
        </div>

        <!-- PRODUCT FORM -->
        {% form 'product',
          selected_product,
          id: 'ProductForm-' | append: section.id,
          class: 'product-card__form'
        %}

          <!-- VARIANTS -->
          {% if section.settings.show_variants and selected_product.has_only_default_variant == false %}

            <div class="product-card__variants">

              {% for option in selected_product.options_with_values %}

                <div class="product-card__option">

                  <label
                    for="Option-{{ section.id }}-{{ forloop.index }}"
                    class="product-card__option-label"
                  >
                    {{ option.name }}
                  </label>

                  <select
                    id="Option-{{ section.id }}-{{ forloop.index }}"
                    class="product-card__select"
                    data-option-position="{{ option.position }}"
                  >
                    {% for value in option.values %}
                      <option
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}
                          selected
                        {% endif %}
                      >
                        {{ value }}
                      </option>
                    {% endfor %}
                  </select>

                </div>

              {% endfor %}

            </div>

          {% endif %}

          <!-- VARIANT ID -->
          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
            data-variant-id
          >

          <!-- QUANTITY -->
          {% if section.settings.show_quantity %}
            <div class="product-card__quantity-wrapper">

              <label
                for="Quantity-{{ section.id }}"
                class="product-card__quantity-label"
              >
                Quantity
              </label>

              <div class="product-card__quantity">

                <button
                  type="button"
                  class="product-card__quantity-button"
                  data-quantity-minus
                  aria-label="Decrease quantity"
                >
                  −
                </button>

                <input
                  id="Quantity-{{ section.id }}"
                  class="product-card__quantity-input"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  data-quantity-input
                >

                <button
                  type="button"
                  class="product-card__quantity-button"
                  data-quantity-plus
                  aria-label="Increase quantity"
                >
                  +
                </button>

              </div>

            </div>
          {% endif %}

          <!-- ADD TO CART -->
          {% if section.settings.show_add_to_cart %}

            <button
              type="submit"
              name="add"
              class="product-card__add-to-cart"
              {% unless current_variant.available %}
                disabled
              {% endunless %}
              data-add-to-cart
            >

              <span data-button-text>
                {% if current_variant.available %}
                  {{ section.settings.button_text }}
                {% else %}
                  Sold Out
                {% endif %}
              </span>

              <span
                class="product-card__spinner"
                data-spinner
                hidden
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <circle
                    cx="10"
                    cy="10"
                    r="8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-dasharray="40"
                    stroke-dashoffset="10"
                  >
                    <animateTransform
                      attributeName="transform"
                      type="rotate"
                      from="0 10 10"
                      to="360 10 10"
                      dur="0.8s"
                      repeatCount="indefinite"
                    />
                  </circle>
                </svg>
              </span>

            </button>

          {% endif %}

          <!-- STATUS MESSAGE -->
          <div
            class="product-card__message"
            role="status"
            aria-live="polite"
            data-message
          ></div>

        {% endform %}

      </div>
    </div>
  </section>


  <style>
    #ProductCard-{{ section.id }} {
      width: 100%;
    }

    #ProductCard-{{ section.id }} .product-card {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
      background: {{ section.settings.card_background }};
      border-radius: {{ section.settings.card_radius }}px;
      overflow: hidden;
      box-sizing: border-box;
    }

    #ProductCard-{{ section.id }} .product-card__media {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: #f5f5f5;
    }

    #ProductCard-{{ section.id }} .product-card__image-link {
      display: block;
      text-decoration: none;
    }

    #ProductCard-{{ section.id }} .product-card__image-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: {{ section.settings.image_ratio }};
      overflow: hidden;
    }

    #ProductCard-{{ section.id }} .product-card__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition:
        opacity 0.4s ease,
        transform 0.5s ease;
    }

    #ProductCard-{{ section.id }} .product-card__image--primary {
      opacity: 1;
      z-index: 1;
    }

    #ProductCard-{{ section.id }} .product-card__image--hover {
      opacity: 0;
      z-index: 2;
    }

    #ProductCard-{{ section.id }} .product-card__image-wrapper:hover
    .product-card__image--primary {
      transform: scale(1.04);
    }

    #ProductCard-{{ section.id }} .product-card__image-wrapper:hover
    .product-card__image--hover {
      opacity: 1;
      transform: scale(1.04);
    }

    #ProductCard-{{ section.id }} .product-card__badge {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 5;
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      background: {{ section.settings.sale_badge_background }};
      color: {{ section.settings.sale_badge_text_color }};
      font-size: 12px;
      font-weight: 700;
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-radius: 4px;
    }

    #ProductCard-{{ section.id }} .product-card__placeholder {
      width: 100%;
      aspect-ratio: {{ section.settings.image_ratio }};
    }

    #ProductCard-{{ section.id }} .product-card__placeholder svg {
      width: 100%;
      height: 100%;
    }

    #ProductCard-{{ section.id }} .product-card__content {
      padding: {{ section.settings.content_padding }}px;
    }

    #ProductCard-{{ section.id }} .product-card__title {
      margin: 0 0 8px;
      font-size: {{ section.settings.title_size }}px;
      line-height: 1.25;
      font-weight: 600;
    }

    #ProductCard-{{ section.id }} .product-card__title a {
      color: inherit;
      text-decoration: none;
    }

    #ProductCard-{{ section.id }} .product-card__title a:hover {
      text-decoration: underline;
    }

    #ProductCard-{{ section.id }} .product-card__description {
      margin-bottom: 14px;
      color: rgba(0, 0, 0, 0.65);
      font-size: 14px;
      line-height: 1.5;
    }

    #ProductCard-{{ section.id }} .product-card__price {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    #ProductCard-{{ section.id }} .product-card__price-sale,
    #ProductCard-{{ section.id }} .product-card__price-regular {
      font-size: 18px;
      font-weight: 700;
    }

    #ProductCard-{{ section.id }} .product-card__price-sale {
      color: {{ section.settings.sale_price_color }};
    }

    #ProductCard-{{ section.id }} .product-card__price-compare {
      color: rgba(0, 0, 0, 0.5);
      font-size: 14px;
      text-decoration: line-through;
    }

    #ProductCard-{{ section.id }} .product-card__variants {
      display: grid;
      gap: 12px;
      margin-bottom: 16px;
    }

    #ProductCard-{{ section.id }} .product-card__option {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    #ProductCard-{{ section.id }} .product-card__option-label,
    #ProductCard-{{ section.id }} .product-card__quantity-label {
      font-size: 13px;
      font-weight: 600;
    }

    #ProductCard-{{ section.id }} .product-card__select {
      width: 100%;
      min-height: 44px;
      padding: 8px 38px 8px 12px;
      border: 1px solid #d5d5d5;
      border-radius: 5px;
      background: #fff;
      color: #111;
      font-size: 14px;
      cursor: pointer;
    }

    #ProductCard-{{ section.id }} .product-card__quantity-wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    #ProductCard-{{ section.id }} .product-card__quantity {
      display: flex;
      align-items: center;
      border: 1px solid #d5d5d5;
      border-radius: 5px;
      overflow: hidden;
    }

    #ProductCard-{{ section.id }} .product-card__quantity-button {
      width: 38px;
      height: 40px;
      padding: 0;
      border: 0;
      background: #fff;
      color: #111;
      font-size: 18px;
      cursor: pointer;
    }

    #ProductCard-{{ section.id }} .product-card__quantity-button:hover {
      background: #f5f5f5;
    }

    #ProductCard-{{ section.id }} .product-card__quantity-input {
      width: 42px;
      height: 40px;
      padding: 0;
      border: 0;
      text-align: center;
      font-size: 14px;
      background: #fff;
      color: #111;
      appearance: textfield;
      -moz-appearance: textfield;
    }

    #ProductCard-{{ section.id }} .product-card__quantity-input::-webkit-inner-spin-button,
    #ProductCard-{{ section.id }} .product-card__quantity-input::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    #ProductCard-{{ section.id }} .product-card__add-to-cart {
      position: relative;
      width: 100%;
      min-height: 48px;
      padding: 12px 20px;
      border: 0;
      border-radius: {{ section.settings.button_radius }}px;
      background: {{ section.settings.button_background }};
      color: {{ section.settings.button_text_color }};
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    #ProductCard-{{ section.id }} .product-card__add-to-cart:hover:not(:disabled) {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    #ProductCard-{{ section.id }} .product-card__add-to-cart:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    #ProductCard-{{ section.id }} .product-card__spinner {
      display: inline-flex;
      vertical-align: middle;
    }

    #ProductCard-{{ section.id }} .product-card__message {
      min-height: 20px;
      margin-top: 10px;
      font-size: 13px;
      text-align: center;
    }

    #ProductCard-{{ section.id }} .product-card__message.is-success {
      color: #287a3e;
    }

    #ProductCard-{{ section.id }} .product-card__message.is-error {
      color: #c62828;
    }

    @media screen and (max-width: 749px) {
      #ProductCard-{{ section.id }} .product-card__content {
        padding: 16px;
      }

      #ProductCard-{{ section.id }} .product-card__title {
        font-size: {{ section.settings.mobile_title_size }}px;
      }

      #ProductCard-{{ section.id }} .product-card__price-sale,
      #ProductCard-{{ section.id }} .product-card__price-regular {
        font-size: 16px;
      }
    }
  </style>


  <script>
    (function() {
      const section = document.getElementById('ProductCard-{{ section.id }}');

      if (!section) return;

      const form = section.querySelector('form');
      const variantInput = section.querySelector('[data-variant-id]');
      const addButton = section.querySelector('[data-add-to-cart]');
      const buttonText = section.querySelector('[data-button-text]');
      const spinner = section.querySelector('[data-spinner]');
      const message = section.querySelector('[data-message]');
      const quantityInput = section.querySelector('[data-quantity-input]');
      const quantityMinus = section.querySelector('[data-quantity-minus]');
      const quantityPlus = section.querySelector('[data-quantity-plus]');

      const variants = {{ selected_product.variants | json }};

      const priceContainer = section.querySelector('[data-price-container]');
      const moneyFormat = {{ shop.money_format | json }};

      const money = (cents) => {
        if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
          return Shopify.formatMoney(cents, moneyFormat);
        }

        return (cents / 100).toFixed(2);
      };

      function getSelectedOptions() {
        const selects = section.querySelectorAll('[data-option-position]');

        return Array.from(selects).map(function(select) {
          return select.value;
        });
      }

      function findVariant() {
        const selectedOptions = getSelectedOptions();

        return variants.find(function(variant) {
          return variant.options.every(function(option, index) {
            return option === selectedOptions[index];
          });
        });
      }

      function updateVariant() {
        const variant = findVariant();

        if (!variant) {
          variantInput.value = '';
          addButton.disabled = true;
          buttonText.textContent = 'Unavailable';
          return;
        }

        variantInput.value = variant.id;

        const salePrice = priceContainer.querySelector('[data-sale-price]');
        const regularPrice = priceContainer.querySelector('[data-regular-price]');
        const comparePrice = priceContainer.querySelector('[data-compare-price]');

        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          if (salePrice) {
            salePrice.textContent = money(variant.price);
            salePrice.hidden = false;
          } else {
            priceContainer.innerHTML =
              '<span class="product-card__price-sale" data-sale-price>' +
              money(variant.price) +
              '</span>' +
              '<span class="product-card__price-compare" data-compare-price>' +
              money(variant.compare_at_price) +
              '</span>';
          }

          const newComparePrice = priceContainer.querySelector('[data-compare-price]');
          if (newComparePrice) {
            newComparePrice.textContent = money(variant.compare_at_price);
            newComparePrice.hidden = false;
          }

          const currentRegular = priceContainer.querySelector('[data-regular-price]');
          if (currentRegular) currentRegular.hidden = true;

        } else {
          const currentSale = priceContainer.querySelector('[data-sale-price]');
          if (currentSale) currentSale.hidden = true;

          const currentCompare = priceContainer.querySelector('[data-compare-price]');
          if (currentCompare) currentCompare.hidden = true;

          let currentRegular = priceContainer.querySelector('[data-regular-price]');

          if (!currentRegular) {
            priceContainer.innerHTML =
              '<span class="product-card__price-regular" data-regular-price></span>';

            currentRegular = priceContainer.querySelector('[data-regular-price]');
          }

          currentRegular.textContent = money(variant.price);
          currentRegular.hidden = false;
        }

        if (variant.available) {
          addButton.disabled = false;
          buttonText.textContent = {{ section.settings.button_text | json }};
        } else {
          addButton.disabled = true;
          buttonText.textContent = 'Sold Out';
        }
      }

      /* VARIANT SELECTION */

      section.querySelectorAll('[data-option-position]').forEach(function(select) {
        select.addEventListener('change', updateVariant);
      });

      /* QUANTITY */

      if (quantityMinus && quantityInput) {
        quantityMinus.addEventListener('click', function() {
          const current = parseInt(quantityInput.value, 10) || 1;

          if (current > 1) {
            quantityInput.value = current - 1;
          }
        });
      }

      if (quantityPlus && quantityInput) {
        quantityPlus.addEventListener('click', function() {
          const current = parseInt(quantityInput.value, 10) || 1;
          quantityInput.value = current + 1;
        });
      }

      /* AJAX ADD TO CART */

      if (form) {
        form.addEventListener('submit', async function(event) {
          event.preventDefault();

          if (!variantInput.value) {
            message.textContent = 'Please select an available option.';
            message.className = 'product-card__message is-error';
            return;
          }

          const variant = variants.find(function(item) {
            return String(item.id) === String(variantInput.value);
          });

          if (!variant || !variant.available) {
            message.textContent = 'This variant is currently sold out.';
            message.className = 'product-card__message is-error';
            return;
          }

          const quantity = quantityInput
            ? Math.max(1, parseInt(quantityInput.value, 10) || 1)
            : 1;

          addButton.disabled = true;

          if (buttonText) buttonText.hidden = true;
          if (spinner) spinner.hidden = false;

          message.textContent = '';
          message.className = 'product-card__message';

          try {
            const response = await fetch(
              window.Shopify.routes.root + 'cart/add.js',
              {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  items: [
                    {
                      id: Number(variantInput.value),
                      quantity: quantity
                    }
                  ]
                })
              }
            );

            const data = await response.json();

            if (!response.ok) {
              throw new Error(
                data.description || data.message || 'Unable to add product to cart.'
              );
            }

            message.textContent = 'Added to cart!';
            message.className = 'product-card__message is-success';

            /*
             * Update Shopify cart count if the theme has one.
             */
            try {
              const cartResponse = await fetch(
                window.Shopify.routes.root + 'cart.js'
              );

              const cart = await cartResponse.json();

              document.querySelectorAll(
                '[data-cart-count], .cart-count-bubble, .cart-count'
              ).forEach(function(cartCount) {
                cartCount.textContent = cart.item_count;

                if (cart.item_count > 0) {
                  cartCount.removeAttribute('hidden');
                }
              });

              /*
               * Dispatch a custom event so themes such as Dawn
               * or custom themes can listen for cart updates.
               */
              document.dispatchEvent(
                new CustomEvent('cart:updated', {
                  detail: {
                    cart: cart,
                    addedItem: data
                  }
                })
              );

            } catch (cartError) {
              console.warn('Cart count update failed:', cartError);
            }

          } catch (error) {

            console.error(error);

            message.textContent =
              error.message || 'Something went wrong. Please try again.';

            message.className =
              'product-card__message is-error';

          } finally {

            if (buttonText) buttonText.hidden = false;
            if (spinner) spinner.hidden = true;

            updateVariant();

          }
        });
      }

      updateVariant();

    })();
  </script>

{% else %}

  <div class="product-card-section__empty">
    <p>Please select a product in the section settings.</p>
  </div>

{% endif %}


{% schema %}
{
  "name": "AJAX Product Card",
  "tag": "section",
  "class": "section-ajax-product-card",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select product"
    },

    {
      "type": "header",
      "content": "Product Information"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "Show variant selectors",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to Cart button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Add to Cart text",
      "default": "Add to Cart"
    },

    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "1 / 1",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Classic portrait"
        },
        {
          "value": "16 / 9",
          "label": "Landscape"
        }
      ]
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Desktop title size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Mobile title size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
