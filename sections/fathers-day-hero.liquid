{% comment %}
  FD-Hero — Father's Day Hero with Countdown + Coupon
  Section: sections/fathers-day-hero.liquid
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@300;400;600;700;800&display=swap" rel="stylesheet">

<style>
  #fd-hero-{{ section.id }} {
    --bg:     {{ section.settings.bg_color }};
    --text:   {{ section.settings.text_color }};
    --accent: {{ section.settings.accent_color }};
    --muted:  color-mix(in srgb, {{ section.settings.text_color }} 65%, transparent);
    --line:   color-mix(in srgb, {{ section.settings.text_color }} 12%, transparent);
    --glass:  color-mix(in srgb, {{ section.settings.text_color }} 4%, transparent);

    --pad-top:    {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;
    --pad-top-m:    {{ section.settings.padding_top_mobile }}px;
    --pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;

    position: relative;
    background: #1a1a1a;
    color: var(--text);
    overflow: hidden;
    padding: var(--pad-top) 0 var(--pad-bottom);
    font-family: 'Sora', sans-serif;
    -webkit-font-smoothing: antialiased;
    isolation: isolate;
  }

  /* ── BACKGROUND EFFECTS ── */
  #fd-hero-{{ section.id }} .fd-grid {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text) 4%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text) 4%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 35%, transparent 90%);
  }
  #fd-hero-{{ section.id }} .fd-orb {
    position: absolute; border-radius: 50%; filter: blur(140px);
    pointer-events: none; z-index: 0;
    background: var(--accent);
  }
  #fd-hero-{{ section.id }} .fd-orb-1 {
    width: 540px; height: 540px;
    top: -180px; right: -160px; opacity: .14;
    animation: fd-float 14s ease-in-out infinite;
  }
  #fd-hero-{{ section.id }} .fd-orb-2 {
    width: 460px; height: 460px;
    bottom: -180px; left: -140px; opacity: .08;
    animation: fd-float 18s ease-in-out infinite reverse;
  }
  @keyframes fd-float {
    0%, 100% { transform: translate(0,0) scale(1); }
    50%      { transform: translate(40px,-30px) scale(1.08); }
  }

  /* Star particles */
  #fd-hero-{{ section.id }} .fd-stars {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 12% 18%, color-mix(in srgb, var(--text) 60%, transparent), transparent),
      radial-gradient(1px 1px at 82% 25%, color-mix(in srgb, var(--text) 50%, transparent), transparent),
      radial-gradient(1.5px 1.5px at 35% 72%, color-mix(in srgb, var(--text) 70%, transparent), transparent),
      radial-gradient(1px 1px at 65% 88%, color-mix(in srgb, var(--text) 40%, transparent), transparent),
      radial-gradient(2px 2px at 50% 12%, var(--accent), transparent),
      radial-gradient(1px 1px at 8% 55%, color-mix(in srgb, var(--text) 50%, transparent), transparent),
      radial-gradient(1.5px 1.5px at 88% 60%, var(--accent), transparent),
      radial-gradient(1px 1px at 92% 80%, color-mix(in srgb, var(--text) 40%, transparent), transparent),
      radial-gradient(1.5px 1.5px at 25% 32%, color-mix(in srgb, var(--text) 50%, transparent), transparent);
    background-size: 100% 100%;
    animation: fd-twinkle 4s ease-in-out infinite;
  }
  @keyframes fd-twinkle {
    0%, 100% { opacity: .85; }
    50%      { opacity: .35; }
  }

  /* Edge gradient fades */
  #fd-hero-{{ section.id }}::before,
  #fd-hero-{{ section.id }}::after {
    content: ''; position: absolute; left: 0; right: 0; height: 80px;
    pointer-events: none; z-index: 1;
  }
  {% comment %} #fd-hero-{{ section.id }}::before { top: 0; background: linear-gradient(to bottom, var(--bg), transparent); }
  #fd-hero-{{ section.id }}::after  { bottom: 0; background: linear-gradient(to top, var(--bg), transparent); } {% endcomment %}

  /* ── INNER LAYOUT ── */
  #fd-hero-{{ section.id }} .fd-inner {
    position: relative; z-index: 2;
    max-width: 1240px; margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
    display: grid; grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }

  /* ── EYEBROW ── */
  #fd-hero-{{ section.id }} .fd-eyebrow {
    display: inline-flex; align-items: center; gap: 14px;
    font-size: 11px; font-weight: 700; letter-spacing: .28em;
    text-transform: uppercase; color: var(--accent);
    margin-bottom: 28px;
  }
  #fd-hero-{{ section.id }} .fd-eyebrow::before {
    content: ''; width: 36px; height: 1px; background: var(--accent);
  }

  /* ── HEADLINE ── */
  #fd-hero-{{ section.id }} .fd-headline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 8vw, 112px);
    line-height: .85;
    letter-spacing: -.01em;
    margin-bottom: 22px;
    color: var(--text);
  }
  #fd-hero-{{ section.id }} .fd-headline .fd-acc {
    color: var(--text);
  }

  #fd-hero-{{ section.id }} .fd-sub {
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.7; color: var(--muted);
    max-width: 480px; margin-bottom: 36px; font-weight: 400;
  }
  #fd-hero-{{ section.id }} .fd-sub strong { color: var(--text); font-weight: 700; }

  /* ── COUNTDOWN ── */
  #fd-hero-{{ section.id }} .fd-count-label {
    font-size: 10px; font-weight: 700; letter-spacing: .3em;
    text-transform: uppercase; color: var(--muted);
    margin-bottom: 14px;
    display: flex; align-items: center; gap: 10px;
  }
  #fd-hero-{{ section.id }} .fd-count-label::before {
    content: ''; width: 20px; height: 1px; background: var(--muted);
  }
  #fd-hero-{{ section.id }} .fd-countdown {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    max-width: 480px;
    margin-bottom: 38px;
  }
  #fd-hero-{{ section.id }} .fd-cell {
    position: relative;
    background: linear-gradient(155deg, var(--glass) 0%, transparent 100%);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 8px 12px;
    text-align: center;
    overflow: hidden;
    transition: border-color .3s, transform .3s;
  }
  #fd-hero-{{ section.id }} .fd-cell::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: .5;
  }
  #fd-hero-{{ section.id }} .fd-cell:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    transform: translateY(-2px);
  }
  #fd-hero-{{ section.id }} .fd-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1; color: var(--text); letter-spacing: .02em;
    display: block; margin-bottom: 6px;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 20px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  #fd-hero-{{ section.id }} .fd-unit {
    font-size: 9px; font-weight: 700; letter-spacing: .25em;
    text-transform: uppercase; color: var(--muted);
  }
  #fd-hero-{{ section.id }} .fd-cell.fd-pulse .fd-num { animation: fd-tick .6s ease-out; }
  @keyframes fd-tick {
    0%   { transform: scale(1); color: var(--accent); }
    50%  { transform: scale(1.08); }
    100% { transform: scale(1); color: var(--text); }
  }

  #fd-hero-{{ section.id }} .fd-live {
    display: none;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 80%, white 20%));
    color: var(--bg); font-weight: 800; padding: 18px 22px; border-radius: 14px;
    text-align: center; font-size: 13px; letter-spacing: .2em;
    text-transform: uppercase; margin-bottom: 38px;
    box-shadow: 0 12px 40px color-mix(in srgb, var(--accent) 35%, transparent);
    animation: fd-live-pulse 1.6s ease-in-out infinite;
  }
  #fd-hero-{{ section.id }} .fd-countdown.fd-ended { display: none; }
  #fd-hero-{{ section.id }} .fd-live.fd-on { display: block; }
  @keyframes fd-live-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.02); }
  }

  /* ── COUPON ── */
  #fd-hero-{{ section.id }} .fd-coupon-wrap {
    max-width: 480px;
    margin-bottom: 34px;
  }
  #fd-hero-{{ section.id }} .fd-coupon-label {
    font-size: 10px; font-weight: 700; letter-spacing: .3em;
    text-transform: uppercase; color: var(--muted);
    margin-bottom: 12px;
    display: flex; align-items: center; gap: 10px;
  }
  #fd-hero-{{ section.id }} .fd-coupon-label::before {
    content: ''; width: 20px; height: 1px; background: var(--muted);
  }
  #fd-hero-{{ section.id }} .fd-coupon {
    position: relative;
    display: flex; align-items: stretch; width: 100%;
    background: linear-gradient(135deg, var(--glass) 0%, transparent 100%);
    border: 1.5px dashed color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 14px;
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    color: var(--text);
    font-family: inherit;
    transition: border-color .25s, transform .2s, box-shadow .25s, background .25s;
  }
  #fd-hero-{{ section.id }} .fd-coupon:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  /* ticket notches — match section background (#1a1a1a) */
  #fd-hero-{{ section.id }} .fd-coupon::before,
  #fd-hero-{{ section.id }} .fd-coupon::after {
    content: ''; position: absolute; top: 50%; width: 14px; height: 14px;
    background: #1a1a1a; border-radius: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  #fd-hero-{{ section.id }} .fd-coupon::before { left: -7px; }
  #fd-hero-{{ section.id }} .fd-coupon::after  { right: -7px; }

  #fd-hero-{{ section.id }} .fd-coupon-tag {
    display: flex; align-items: center; gap: 8px;
    padding: 16px 18px;
    font-size: 10px; font-weight: 700; letter-spacing: .25em;
    text-transform: uppercase;
    color: var(--accent);
    border-right: 1.5px dashed color-mix(in srgb, var(--accent) 35%, transparent);
    white-space: nowrap;
  }
  #fd-hero-{{ section.id }} .fd-coupon-tag svg {
    width: 14px; height: 14px;
  }
  #fd-hero-{{ section.id }} .fd-coupon-code {
    flex: 1;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(20px, 2.4vw, 26px);
    letter-spacing: .15em;
    color: var(--text);
    padding: 14px 16px;
    text-shadow: 0 0 20px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  #fd-hero-{{ section.id }} .fd-coupon-action {
    display: flex; align-items: center; justify-content: center;
    padding: 16px 18px;
    color: var(--muted);
    transition: color .2s;
  }
  #fd-hero-{{ section.id }} .fd-coupon:hover .fd-coupon-action { color: var(--accent); }
  #fd-hero-{{ section.id }} .fd-coupon-action svg { width: 18px; height: 18px; }

  #fd-hero-{{ section.id }} .fd-coupon-feedback {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--accent); color: var(--bg);
    font-weight: 800; font-size: 12px; letter-spacing: .22em;
    text-transform: uppercase;
    opacity: 0; transform: scale(.96); pointer-events: none;
    transition: opacity .25s, transform .25s;
    z-index: 3;
  }
  #fd-hero-{{ section.id }} .fd-coupon-feedback svg { width: 16px; height: 16px; }
  #fd-hero-{{ section.id }} .fd-coupon.fd-copied {
    border-style: solid;
    border-color: var(--accent);
  }
  #fd-hero-{{ section.id }} .fd-coupon.fd-copied .fd-coupon-feedback {
    opacity: 1; transform: scale(1);
  }
  #fd-hero-{{ section.id }} .fd-coupon-help {
    margin-top: 12px;
    font-size: 12px; color: var(--muted);
    line-height: 1.5;
  }

  /* ── CTAs ── */
  #fd-hero-{{ section.id }} .fd-ctas {
    display: flex; flex-wrap: wrap; gap: 12px;
  }
  #fd-hero-{{ section.id }} .fd-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 17px 32px;
    font-family: 'Sora', sans-serif; font-weight: 700;
    font-size: 12px; letter-spacing: .18em; text-transform: uppercase;
    border-radius: 999px; cursor: pointer; text-decoration: none;
    transition: transform .2s, box-shadow .25s, gap .2s, background .2s;
    border: none; white-space: nowrap;
  }
  #fd-hero-{{ section.id }} .fd-btn-primary {
    background: var(--accent); color: var(--bg);
    box-shadow:
      0 12px 32px color-mix(in srgb, var(--accent) 45%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--text) 15%, transparent);
  }
  #fd-hero-{{ section.id }} .fd-btn-primary:hover {
    transform: translateY(-2px); gap: 14px;
    box-shadow:
      0 20px 50px color-mix(in srgb, var(--accent) 55%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--text) 25%, transparent);
  }
  #fd-hero-{{ section.id }} .fd-btn-ghost {
    background: var(--glass);
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
  }
  #fd-hero-{{ section.id }} .fd-btn-ghost:hover {
    background: color-mix(in srgb, var(--text) 8%, transparent);
    border-color: color-mix(in srgb, var(--text) 35%, transparent);
    transform: translateY(-2px); gap: 14px;
  }

  /* ── RIGHT COLUMN: PORTRAIT IMAGE ── */
  #fd-hero-{{ section.id }} .fd-img-col {
    position: relative;
    display: flex; justify-content: center; align-items: center;
  }
  #fd-hero-{{ section.id }} .fd-img-glow {
    position: absolute; inset: -8%; z-index: 0;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent) 35%, transparent), transparent 65%);
    filter: blur(60px); opacity: .9;
    animation: fd-glow-shift 8s ease-in-out infinite;
  }
  @keyframes fd-glow-shift {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.08); }
  }
  #fd-hero-{{ section.id }} .fd-img-frame {
    position: relative; z-index: 1;
    width: 100%;
    max-width: 480px;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    box-shadow:
      0 40px 100px rgba(0,0,0,.5),
      0 0 0 1px color-mix(in srgb, var(--text) 5%, transparent);
    background: var(--glass);
  }
  #fd-hero-{{ section.id }} .fd-img-frame img {
    width: 100%; height: auto; display: block;
  }
  #fd-hero-{{ section.id }} .fd-img-placeholder {
    width: 100%; aspect-ratio: 3 / 4;
    display: flex; align-items: center; justify-content: center;
    color: color-mix(in srgb, var(--text) 25%, transparent);
    font-size: 12px; letter-spacing: .2em;
    text-transform: uppercase; font-weight: 700;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 960px) {
    #fd-hero-{{ section.id }} .fd-inner {
      grid-template-columns: 1fr;
      gap: 44px;
      text-align: center;
    }
    #fd-hero-{{ section.id }} .fd-eyebrow,
    #fd-hero-{{ section.id }} .fd-count-label,
    #fd-hero-{{ section.id }} .fd-coupon-label {
      justify-content: center;
    }
    #fd-hero-{{ section.id }} .fd-sub,
    #fd-hero-{{ section.id }} .fd-countdown,
    #fd-hero-{{ section.id }} .fd-coupon-wrap {
      margin-left: auto; margin-right: auto;
    }
    #fd-hero-{{ section.id }} .fd-coupon-help { text-align: center; }
    #fd-hero-{{ section.id }} .fd-ctas { justify-content: center; }
    #fd-hero-{{ section.id }} .fd-img-col { order: -1; }
    #fd-hero-{{ section.id }} .fd-img-frame { max-width: 380px; }
  }
  @media (max-width: 640px) {
    #fd-hero-{{ section.id }} { padding: var(--pad-top-m) 0 var(--pad-bottom-m); }
    #fd-hero-{{ section.id }} .fd-inner { gap: 36px; padding: 0 20px; }
    #fd-hero-{{ section.id }} .fd-eyebrow {
      font-size: 10px; letter-spacing: .24em; margin-bottom: 20px; gap: 10px;
    }
    #fd-hero-{{ section.id }} .fd-eyebrow::before { width: 24px; }
    #fd-hero-{{ section.id }} .fd-headline { font-size: clamp(42px, 11vw, 64px); margin-bottom: 16px; }
    #fd-hero-{{ section.id }} .fd-sub { font-size: 14px; line-height: 1.65; margin-bottom: 28px; }
    #fd-hero-{{ section.id }} .fd-cell { padding: 14px 4px 10px; border-radius: 10px; }
    #fd-hero-{{ section.id }} .fd-num { font-size: clamp(30px, 9vw, 42px); }
    #fd-hero-{{ section.id }} .fd-unit { font-size: 8px; letter-spacing: .2em; }
    #fd-hero-{{ section.id }} .fd-countdown { gap: 6px; margin-bottom: 28px; }
    #fd-hero-{{ section.id }} .fd-coupon-wrap { margin-bottom: 26px; }
    #fd-hero-{{ section.id }} .fd-coupon-tag {
      padding: 12px 12px;
      font-size: 9px; letter-spacing: .2em;
    }
    #fd-hero-{{ section.id }} .fd-coupon-tag svg { width: 12px; height: 12px; }
    #fd-hero-{{ section.id }} .fd-coupon-code {
      font-size: 18px; letter-spacing: .12em; padding: 12px 10px;
    }
    #fd-hero-{{ section.id }} .fd-coupon-action { padding: 12px 14px; }
    #fd-hero-{{ section.id }} .fd-coupon-action svg { width: 16px; height: 16px; }
    #fd-hero-{{ section.id }} .fd-img-frame { max-width: min(78vw, 340px); border-radius: 18px; }
    #fd-hero-{{ section.id }} .fd-btn { padding: 14px 22px; font-size: 11px; }
    #fd-hero-{{ section.id }} .fd-ctas { flex-direction: column; align-items: stretch; gap: 10px; }
    #fd-hero-{{ section.id }} .fd-btn { justify-content: center; }
  }
  @media (max-width: 380px) {
    #fd-hero-{{ section.id }} .fd-headline { font-size: clamp(38px, 12vw, 52px); }
    #fd-hero-{{ section.id }} .fd-img-frame { max-width: 86vw; }
  }
</style>

<section id="fd-hero-{{ section.id }}">
  <div class="fd-grid"></div>
  <div class="fd-stars"></div>
  <div class="fd-orb fd-orb-1"></div>
  <div class="fd-orb fd-orb-2"></div>

  <div class="fd-inner">

    {%- comment -%} ── LEFT: TEXT + COUNTDOWN + COUPON ── {%- endcomment -%}
    <div class="fd-left">

      {% if section.settings.eyebrow != blank %}
        <div class="fd-eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      <h1 class="fd-headline">
        {% if section.settings.heading_line1 != blank %}
          {{ section.settings.heading_line1 }}<br>
        {% endif %}
        {% if section.settings.heading_line2 != blank %}
          <span class="fd-acc">{{ section.settings.heading_line2 }}</span>
        {% endif %}
      </h1>

      {% if section.settings.subtitle != blank %}
        <p class="fd-sub">{{ section.settings.subtitle }}</p>
      {% endif %}

      {% if section.settings.show_countdown %}
        <div class="fd-count-label">{{ section.settings.countdown_label }}</div>

        <div class="fd-countdown" id="fd-cd-{{ section.id }}">
          <div class="fd-cell"><span class="fd-num" data-unit="days">--</span><span class="fd-unit">Days</span></div>
          <div class="fd-cell"><span class="fd-num" data-unit="hours">--</span><span class="fd-unit">Hours</span></div>
          <div class="fd-cell"><span class="fd-num" data-unit="minutes">--</span><span class="fd-unit">Minutes</span></div>
          <div class="fd-cell"><span class="fd-num" data-unit="seconds">--</span><span class="fd-unit">Seconds</span></div>
        </div>

        <div class="fd-live" id="fd-live-{{ section.id }}">
          {{ section.settings.live_message }}
        </div>
      {% endif %}

      {%- comment -%} ── COUPON CODE (click to copy) ── {%- endcomment -%}
      {% if section.settings.show_coupon and section.settings.coupon_code != blank %}
        <div class="fd-coupon-wrap">
          {% if section.settings.coupon_label != blank %}
            <div class="fd-coupon-label">{{ section.settings.coupon_label }}</div>
          {% endif %}

          <button
            type="button"
            class="fd-coupon"
            id="fd-coupon-{{ section.id }}"
            data-code="{{ section.settings.coupon_code | escape }}"
            aria-label="Copy coupon code {{ section.settings.coupon_code | escape }}"
          >
            <span class="fd-coupon-tag">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
              Code
            </span>

            <span class="fd-coupon-code">{{ section.settings.coupon_code }}</span>

            <span class="fd-coupon-action" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
            </span>

            <span class="fd-coupon-feedback">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {{ section.settings.coupon_copied_text | default: 'Copied!' }}
            </span>
          </button>

          {% if section.settings.coupon_help != blank %}
            <div class="fd-coupon-help">{{ section.settings.coupon_help }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div class="fd-ctas">
        {% if section.settings.cta1_label != blank %}
          <a href="{{ section.settings.cta1_url | default: '#' }}" class="fd-btn fd-btn-primary">
            {{ section.settings.cta1_label }} →
          </a>
        {% endif %}
        {% if section.settings.cta2_label != blank %}
          <a href="{{ section.settings.cta2_url | default: '#' }}" class="fd-btn fd-btn-ghost">
            {{ section.settings.cta2_label }}
          </a>
        {% endif %}
      </div>

    </div>

    {%- comment -%} ── RIGHT: PORTRAIT IMAGE (no overlays) ── {%- endcomment -%}
    <div class="fd-img-col">
      <div class="fd-img-glow"></div>

      <div class="fd-img-frame">
        {% if section.settings.hero_image != blank %}
          <img
            srcset="
              {{ section.settings.hero_image | image_url: width: 480 }} 480w,
              {{ section.settings.hero_image | image_url: width: 720 }} 720w,
              {{ section.settings.hero_image | image_url: width: 960 }} 960w,
              {{ section.settings.hero_image | image_url: width: 1200 }} 1200w
            "
            sizes="(max-width: 640px) 86vw, (max-width: 960px) 380px, 480px"
            src="{{ section.settings.hero_image | image_url: width: 960 }}"
            alt="{{ section.settings.hero_image.alt | default: section.settings.heading_line1 | escape }}"
            loading="eager"
            fetchpriority="high"
            width="{{ section.settings.hero_image.width }}"
            height="{{ section.settings.hero_image.height }}"
          >
        {% else %}
          <div class="fd-img-placeholder">Add Hero Image</div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<script>
(function(){
  var sectionId = '{{ section.id }}';

  /* ── Countdown ── */
  var targetIso = '{{ section.settings.target_date }}T{{ section.settings.target_time }}:00';
  var tzOffset  = '{{ section.settings.timezone_offset }}';

  var target;
  if (tzOffset && tzOffset.length) {
    target = new Date(targetIso + tzOffset);
  } else {
    target = new Date(targetIso);
  }

  if (isNaN(target.getTime())) {
    /* Fallback: next Father's Day (third Sunday of June) */
    var now = new Date();
    var year = now.getFullYear();
    function thirdSundayOfJune(y) {
      var d = new Date(y, 5, 1);
      var sundays = 0;
      while (true) {
        if (d.getDay() === 0) { sundays++; if (sundays === 3) return new Date(d); }
        d.setDate(d.getDate() + 1);
      }
    }
    var fd = thirdSundayOfJune(year);
    if (fd < now) fd = thirdSundayOfJune(year + 1);
    target = fd;
  }

  var cd     = document.getElementById('fd-cd-' + sectionId);
  var liveEl = document.getElementById('fd-live-' + sectionId);

  if (cd) {
    var cells = {
      days:    cd.querySelector('[data-unit="days"]'),
      hours:   cd.querySelector('[data-unit="hours"]'),
      minutes: cd.querySelector('[data-unit="minutes"]'),
      seconds: cd.querySelector('[data-unit="seconds"]')
    };
    var lastVals = { days: null, hours: null, minutes: null, seconds: null };

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var diff = target.getTime() - Date.now();

      if (diff <= 0) {
        cd.classList.add('fd-ended');
        if (liveEl) liveEl.classList.add('fd-on');
        return false;
      }

      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);

      var vals = { days: d, hours: h, minutes: m, seconds: s };

      for (var k in cells) {
        if (cells[k] && vals[k] !== lastVals[k]) {
          cells[k].textContent = pad(vals[k]);
          if (lastVals[k] !== null) {
            var cell = cells[k].parentElement;
            cell.classList.remove('fd-pulse');
            void cell.offsetWidth;
            cell.classList.add('fd-pulse');
          }
          lastVals[k] = vals[k];
        }
      }
      return true;
    }

    if (tick()) {
      setInterval(tick, 1000);
    }
  }

  /* ── Coupon click-to-copy ── */
  var couponBtn = document.getElementById('fd-coupon-' + sectionId);
  if (couponBtn) {
    var resetTimer;

    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'absolute';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
    }

    function showCopied() {
      couponBtn.classList.add('fd-copied');
      clearTimeout(resetTimer);
      resetTimer = setTimeout(function () {
        couponBtn.classList.remove('fd-copied');
      }, 1800);
    }

    couponBtn.addEventListener('click', function () {
      var code = couponBtn.getAttribute('data-code') || '';
      if (!code) return;

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(showCopied).catch(function () {
          fallbackCopy(code);
          showCopied();
        });
      } else {
        fallbackCopy(code);
        showCopied();
      }
    });
  }
})();
</script>

