{%- style -%}
  .qb54-hero, .qb54-hero * { box-sizing: border-box; }
  
  .qb54-hero {
    position: relative;
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
  }
  
  .qb54-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  
  .qb54-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .qb54-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%, 
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | times: 0.8 | divided_by: 100.0 }}) 100%);
    z-index: 1;
  }
  
  .qb54-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 1000px;
    padding: {{ section.settings.content_padding }}px 20px;
    width: 100%;
  }
  
  .qb54-hero-badge {
    display: inline-block;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  
  .qb54-hero-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 24px 0;
  }
  
  .qb54-hero-description {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    line-height: 1.6;
    margin: 0 0 40px 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .qb54-hero-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
  }
  
  .qb54-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 32px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 0;
    transition: all 0.3s ease;
    white-space: nowrap;
  }
  
  .qb54-hero-btn--primary {
    background: {{ section.settings.primary_btn_bg }};
    color: {{ section.settings.primary_btn_text_color }};
  }
  
  .qb54-hero-btn--primary:hover {
    background: {{ section.settings.primary_btn_hover }};
    transform: translateY(-1px);
  }
  
  .qb54-hero-btn--secondary {
    background: transparent;
    color: {{ section.settings.secondary_btn_text_color }};
    border: 2px solid transparent;
  }
  
  .qb54-hero-btn--secondary:hover {
    color: {{ section.settings.secondary_btn_hover }};
  }
  
  .qb54-hero-btn svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  
  .qb54-hero-bg--mobile {
    display: none;
  }
  
  @media (max-width: 768px) {
    .qb54-hero {
      min-height: {{ section.settings.mobile_section_height }}px;
    }
    
    .qb54-hero-content {
      padding: {{ section.settings.mobile_content_padding }}px 16px;
    }
    
    .qb54-hero-title {
      font-size: {{ section.settings.mobile_title_size }}px;
      margin-bottom: 16px;
    }
    
    .qb54-hero-description {
      font-size: {{ section.settings.mobile_description_size }}px;
      margin-bottom: 32px;
    }
    
    .qb54-hero-buttons {
      flex-direction: column;
      gap: 16px;
    }
    
    .qb54-hero-btn {
      width: 100%;
      max-width: 300px;
    }
    
    .qb54-hero-bg--desktop {
      display: none;
    }
    
    .qb54-hero-bg--mobile {
      display: block;
    }
  }
  
  @media (max-width: 480px) {
    .qb54-hero-title {
      font-size: {{ section.settings.mobile_title_size | times: 0.85 | round }}px;
    }
    
    .qb54-hero-description {
      font-size: {{ section.settings.mobile_description_size | minus: 1 }}px;
    }
    
    .qb54-hero-btn {
      padding: 14px 28px;
      font-size: 13px;
    }
  }
{%- endstyle -%}

<section class="qb54-hero">
  <div class="qb54-hero-bg qb54-hero-bg--desktop">
    {% if section.settings.desktop_background != blank %}
      {{ section.settings.desktop_background | image_url: width: 1920 | image_tag: loading: 'lazy' }}
    {% endif %}
  </div>
  
  <div class="qb54-hero-bg qb54-hero-bg--mobile">
    {% if section.settings.mobile_background != blank %}
      {{ section.settings.mobile_background | image_url: width: 800 | image_tag: loading: 'lazy' }}
    {% endif %}
  </div>
  
  <div class="qb54-hero-overlay"></div>
  
  <div class="qb54-hero-content">
    {% if section.settings.badge_text != blank %}
      <div class="qb54-hero-badge">{{ section.settings.badge_text }}</div>
    {% endif %}
    
    {% if section.settings.hero_title != blank %}
      <h1 class="qb54-hero-title">{{ section.settings.hero_title }}</h1>
    {% endif %}
    
    {% if section.settings.hero_description != blank %}
      <p class="qb54-hero-description">{{ section.settings.hero_description }}</p>
    {% endif %}
    
    <div class="qb54-hero-buttons">
      {% if section.settings.primary_btn_label != blank %}
        <a href="{{ section.settings.primary_btn_link }}" class="qb54-hero-btn qb54-hero-btn--primary">
          {{ section.settings.primary_btn_label }}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      {% endif %}
      
      {% if section.settings.secondary_btn_label != blank %}
        <a href="{{ section.settings.secondary_btn_link }}" class="qb54-hero-btn qb54-hero-btn--secondary">
          {{ section.settings.secondary_btn_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "QB54 Game Hero",
  "settings": [
    {
      "type": "header",
      "content": "Background Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_background",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background",
      "label": "Mobile background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 65
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Desktop section height (px)",
      "min": 400,
      "max": 800,
      "step": 20,
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_section_height",
      "label": "Mobile section height (px)",
      "min": 400,
      "max": 700,
      "step": 20,
      "default": 520
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding (px)",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_content_padding",
      "label": "Mobile content padding (px)",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "READY TO PLAY?"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#c6ff00"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Title",
      "default": "Get Your QB54 Game Set Today"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Desktop title size (px)",
      "min": 32,
      "max": 80,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Mobile title size (px)",
      "min": 24,
      "max": 48,
      "step": 2,
      "default": 36
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Description",
      "default": "Join thousands of families who have made QB54 their go-to game for every gathering. 40% off all sets — limited time only."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Desktop description size (px)",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Mobile description size (px)",
      "min": 13,
      "max": 18,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_btn_label",
      "label": "Primary button text",
      "default": "SHOP GAME SETS"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary button link"
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary button background",
      "default": "#c6ff00"
    },
    {
      "type": "color",
      "id": "primary_btn_text_color",
      "label": "Primary button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "primary_btn_hover",
      "label": "Primary button hover background",
      "default": "#b8e600"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_btn_label",
      "label": "Secondary button text",
      "default": "HOW TO PLAY"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary button link"
    },
    {
      "type": "color",
      "id": "secondary_btn_text_color",
      "label": "Secondary button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_btn_hover",
      "label": "Secondary button hover color",
      "default": "#c6ff00"
    }
  ],
  "presets": [
    {
      "name": "QB54 Game Hero"
    }
  ]
}
{% endschema %}