<style>
  #shopify-section-{{ section.id }} {
    --cd-bg: {{ section.settings.background }};
    --cd-accent: {{ section.settings.accent_color }};
    --cd-ink: {{ section.settings.text_color }};
    --cd-tile-bg: {{ section.settings.tile_background }};
  }

  #shopify-section-{{ section.id }} .cd {
    background: var(--cd-bg);
    padding-block: clamp(44px, 5.5vw, 68px);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cd-shell {
    width: min(720px, 100% - 40px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .cd-badge {
    display: inline-flex;
    align-items: center;
    background: var(--cd-accent);
    color: var(--cd-bg);
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 4px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .cd-heading {
    font-family: var(--font-heading-family);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--cd-ink);
    margin: 0 0 12px;
    font-size: clamp(28px, 4vw, 46px);
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .cd-heading em {
    font-style: normal;
    color: var(--cd-accent);
  }

  #shopify-section-{{ section.id }} .cd-sub {
    font-family: var(--font-body-family);
    font-size: 15px;
    color: var(--cd-ink);
    opacity: 0.75;
    margin: 0 0 28px;
  }

  #shopify-section-{{ section.id }} .cd-timer {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .cd-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    background: var(--cd-tile-bg);
    border: 1px solid color-mix(in srgb, var(--cd-accent) 30%, transparent);
    border-radius: 10px;
  }

  #shopify-section-{{ section.id }} .cd-tile-num {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    color: var(--cd-accent);
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .cd-tile-label {
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cd-ink);
    opacity: 0.6;
    margin-top: 4px;
  }

  #shopify-section-{{ section.id }} .cd-expired-message {
    font-family: var(--font-heading-family);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 18px;
    color: var(--cd-accent);
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .cd-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--cd-accent);
    color: var(--cd-bg);
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 15px 30px;
    min-height: 52px;
    border-radius: 4px;
    text-decoration: none;
    transition: transform 160ms ease;
  }
  #shopify-section-{{ section.id }} .cd-btn:hover { transform: translateY(-2px); }

  @media screen and (max-width: 420px) {
    #shopify-section-{{ section.id }} .cd-timer { gap: 8px; }
    #shopify-section-{{ section.id }} .cd-tile { width: 60px; height: 60px; }
    #shopify-section-{{ section.id }} .cd-tile-num { font-size: 21px; }
  }
</style>

<div class="cd">
  <div class="cd-shell">
    {%- if section.settings.badge_text != blank -%}
      <span class="cd-badge">{{ section.settings.badge_text | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="cd-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="cd-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.target_date != blank -%}
      <div
        class="cd-timer"
        id="cd-timer-{{ section.id }}"
        role="timer"
        aria-live="off"
        data-target="{{ section.settings.target_date | escape }}"
      >
        <div class="cd-tile"><span class="cd-tile-num" data-cd-days>00</span><span class="cd-tile-label">Days</span></div>
        <div class="cd-tile"><span class="cd-tile-num" data-cd-hours>00</span><span class="cd-tile-label">Hrs</span></div>
        <div class="cd-tile"><span class="cd-tile-num" data-cd-minutes>00</span><span class="cd-tile-label">Min</span></div>
        <div class="cd-tile"><span class="cd-tile-num" data-cd-seconds>00</span><span class="cd-tile-label">Sec</span></div>
      </div>
      <p class="cd-expired-message" id="cd-expired-{{ section.id }}" hidden>{{ section.settings.expired_message | default: 'Offer Has Ended' | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <a class="cd-btn" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_text | escape }}</a>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.target_date != blank -%}
<script>
  (function () {
    var timerEl = document.getElementById('cd-timer-{{ section.id }}');
    var expiredEl = document.getElementById('cd-expired-{{ section.id }}');
    if (!timerEl) return;

    var target = new Date(timerEl.getAttribute('data-target')).getTime();
    if (isNaN(target)) return;

    var daysEl = timerEl.querySelector('[data-cd-days]');
    var hoursEl = timerEl.querySelector('[data-cd-hours]');
    var minutesEl = timerEl.querySelector('[data-cd-minutes]');
    var secondsEl = timerEl.querySelector('[data-cd-seconds]');

    function pad(n) { return String(n).padStart(2, '0'); }

    function tick() {
      var diff = target - Date.now();
      if (diff <= 0) {
        timerEl.hidden = true;
        if (expiredEl) expiredEl.hidden = false;
        clearInterval(intervalId);
        return;
      }
      var days = Math.floor(diff / 86400000);
      var hours = Math.floor((diff % 86400000) / 3600000);
      var minutes = Math.floor((diff % 3600000) / 60000);
      var seconds = Math.floor((diff % 60000) / 1000);
      daysEl.textContent = pad(days);
      hoursEl.textContent = pad(hours);
      minutesEl.textContent = pad(minutes);
      secondsEl.textContent = pad(seconds);
    }

    tick();
    var intervalId = setInterval(tick, 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "QB54 Countdown Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "Black Friday - Cyber Monday Only"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (italic = accent)",
      "default": "30% Off <em>Everything</em>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Use code BFCM at checkout. Ends Cyber Monday at midnight."
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Countdown end date/time",
      "info": "Format: YYYY-MM-DDTHH:MM:SS (your store's local time). Leave blank to hide the countdown entirely.",
      "default": "2026-11-30T23:59:00"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Message shown after the countdown ends",
      "default": "Offer Has Ended"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop The Sale"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#0d0d0d"
    },
    {
      "type": "color",
      "id": "tile_background",
      "label": "Tile background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#9aff00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "QB54 Countdown Banner"
    }
  ]
}
{% endschema %}
