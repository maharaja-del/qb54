    {
      "type": "select", "id": "hero_focal", "label": "Photo position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "70% center", "label": "Right" },
        { "value": "30% center", "label": "Left" }
      ],
      "default": "center center"
    },
    { "type": "text", "id": "hero_badge", "label": "Gold badge", "default": "As seen on Shark Tank" },
    { "type": "text", "id": "rating_fallback", "label": "Rating text when no review data", "default": "Hundreds of 5-star reviews" },
    { "type": "text", "id": "hero_kicker", "label": "Kicker", "default": "Black Friday → Cyber Monday" },
    { "type": "text", "id": "hero_line", "label": "Line under the offer", "default": "Every game set." },
    { "type": "textarea", "id": "hero_text", "label": "Text", "default": "Two chairs. One football. A full stadium anywhere you unfold it." },
    { "type": "text", "id": "hero_cta", "label": "Primary button", "default": "Shop the Sale" },
