{%- liquid
  assign scope = '#qb54-pl-' | append: section.id
  assign code = section.settings.discount_code | strip | upcase
  assign pct = section.settings.discount_percent
  assign keep = 100 | minus: pct
  assign tz = section.settings.timezone
  assign start_raw = section.settings.start_datetime | strip
  assign end_raw = section.settings.end_datetime | strip
  assign start_iso = start_raw | append: tz
  assign end_iso = end_raw | append: tz
  assign start_label = start_raw | date: '%b %-d'
  assign shop_url = section.settings.shop_url | default: routes.all_products_collection_url
  assign festive = section.settings.festive
  assign checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/'

  assign product_blocks = section.blocks | where: 'type', 'product'
  assign reel_blocks = section.blocks | where: 'type', 'reel'
  assign photo_blocks = section.blocks | where: 'type', 'photo'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign store_blocks = section.blocks | where: 'type', 'collection'

  assign lead_rating = blank
  assign lead_count = blank
  for block in product_blocks
    assign rp = block.settings.product
    if rp != blank and rp.metafields.reviews.rating.value != blank
      assign lead_rating = rp.metafields.reviews.rating.value.rating | round: 1
      assign lead_count = rp.metafields.reviews.rating_count.value
      break
    endif
  endfor

  assign included = section.settings.included_items | split: '|'

  # Products that show the price after the code: the deal products plus the code collection.
  assign eligible = '|'
  for block in product_blocks
    if block.settings.product != blank
      assign eligible = eligible | append: block.settings.product.id | append: '|'
    endif
  endfor
  if section.settings.code_collection != blank
    for p in section.settings.code_collection.products limit: 50
      assign eligible = eligible | append: p.id | append: '|'
    endfor
  endif
  assign free_ship = section.settings.free_ship_threshold | times: 100
  assign low_stock = section.settings.low_stock
-%}

<style>
  {{ scope }} {
    --gold: {{ section.settings.color_primary }};
    --gold-deep: color-mix(in srgb, var(--gold) 82%, #000000);
    --gold-soft: color-mix(in srgb, var(--gold) 16%, transparent);
    --gold-glow: color-mix(in srgb, var(--gold) 42%, transparent);
    --on-gold: #1a1c3a;
    --night: {{ section.settings.color_night }};
    --navy: {{ section.settings.color_navy }};
    --navy-2: color-mix(in srgb, var(--navy) 70%, var(--night));
    --cream: {{ section.settings.color_cream }};
    --festive: {{ section.settings.color_festive }};
    --sale: #e11d48;
    --ok: #15803d;
    --paper: #ffffff;
    --ink: #171717;
    --ink-2: #4a4c57;
    --muted: #6b6d78;
    --line: #e6e2d3;
    --line-dark: rgba(255, 255, 255, 0.12);
    --fh: var(--font-heading-family);
    --fb: var(--font-body-family);
    --pad-y: clamp(64px, 8vw, 112px);
    --max: 1320px;
    --gutter: clamp(16px, 4vw, 40px);
    --r-btn: 8px;
    --r-card: 18px;
    --r-panel: 24px;
    --shadow: 0 1px 2px rgba(17, 18, 40, 0.06), 0 14px 34px -20px rgba(17, 18, 40, 0.35);
    --shadow-lg: 0 2px 6px rgba(17, 18, 40, 0.08), 0 34px 70px -30px rgba(17, 18, 40, 0.6);
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --ease-emph: cubic-bezier(0.05, 0.7, 0.1, 1);
    position: relative;
    background: var(--night);
    color: #ffffff;
    font-family: var(--fb);
    -webkit-font-smoothing: antialiased;
    /* position + clip: absolutely positioned bits (e.g. screen-reader labels in off-screen rail cards) cannot widen the page */
    overflow-x: clip;
  }
  {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { box-sizing: border-box; }
  {{ scope }} a { text-decoration: none; color: inherit; }
  {{ scope }} [hidden] { display: none !important; }
  {{ scope }} :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 6px; }
  {{ scope }} .qb54-pl-wrap { width: min(var(--max), 100% - var(--gutter) * 2); margin-inline: auto; }
  {{ scope }} .qb54-pl-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  {{ scope }} ul, {{ scope }} ol { list-style: none; margin: 0; padding: 0; }
  {{ scope }} .qb54-pl-head__aside { justify-self: start; }

  /* ---------- Type ---------- */
  {{ scope }} .qb54-pl-h2 {
    margin: 0;
    font-family: var(--fh);
    font-weight: 700;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 0.96;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: balance;
    color: inherit;
  }
  {{ scope }} .qb54-pl-h2 em { font-style: normal; color: var(--gold); }
  {{ scope }} .qb54-pl-light .qb54-pl-h2 em { color: var(--navy); }
  {{ scope }} .qb54-pl-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  {{ scope }} .qb54-pl-eyebrow::before { content: ''; width: 28px; height: 3px; border-radius: 3px; background: var(--gold); }
  {{ scope }} .qb54-pl-light .qb54-pl-eyebrow { color: var(--navy); }
  {{ scope }} .qb54-pl-center .qb54-pl-eyebrow { justify-content: center; }
  {{ scope }} .qb54-pl-center .qb54-pl-eyebrow::after { content: ''; width: 28px; height: 3px; border-radius: 3px; background: currentColor; }
  {{ scope }} .qb54-pl-center .qb54-pl-eyebrow::before { background: currentColor; }
  {{ scope }} .qb54-pl-lede { margin: 18px 0 0; font-size: clamp(16px, 1.3vw, 18.5px); line-height: 1.6; max-width: 60ch; }
  {{ scope }} p, {{ scope }} blockquote { text-wrap: pretty; }
  {{ scope }} .qb54-pl-center { text-align: center; }
  {{ scope }} .qb54-pl-center .qb54-pl-lede { margin-inline: auto; }
  {{ scope }} .qb54-pl-head { margin-bottom: clamp(32px, 4vw, 52px); }
  {{ scope }} .qb54-pl-head--split { display: grid; gap: 20px; }

  /* ---------- Buttons ---------- */
  {{ scope }} .qb54-pl-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 28px;
    border-radius: var(--r-btn);
    font-family: var(--fh);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition: transform 160ms var(--ease), box-shadow 160ms var(--ease), background-color 160ms var(--ease), color 160ms var(--ease);
  }
  {{ scope }} .qb54-pl-btn svg { width: 18px; height: 18px; flex: none; }
  {{ scope }} .qb54-pl-btn [data-qb54-btn-icon] { display: inline-flex; }
  {{ scope }} .qb54-pl-btn--gold { background: var(--gold); color: var(--on-gold); box-shadow: 0 14px 32px -14px var(--gold-glow); }
  {{ scope }} .qb54-pl-btn--gold:hover { background: color-mix(in srgb, var(--gold) 88%, #ffffff); transform: translateY(-2px); box-shadow: 0 20px 40px -16px var(--gold-glow); }
  {{ scope }} .qb54-pl-btn--shine::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.7) 48%, transparent 66%);
    transform: translateX(-120%);
    animation: qb54-pl-shine 4s var(--ease) infinite 1.4s;
  }
  {{ scope }} .qb54-pl-btn--ghost { color: #ffffff; background: rgba(255, 255, 255, 0.08); box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.45); backdrop-filter: blur(6px); }
  {{ scope }} .qb54-pl-btn--ghost:hover { background: rgba(255, 255, 255, 0.16); transform: translateY(-2px); }
  {{ scope }} .qb54-pl-btn--navy { background: var(--navy); color: #ffffff; }
  {{ scope }} .qb54-pl-btn--navy:hover { background: color-mix(in srgb, var(--navy) 85%, #ffffff); transform: translateY(-2px); }
  {{ scope }} .qb54-pl-btn--white { background: #ffffff; color: var(--on-gold); box-shadow: 0 16px 34px -16px rgba(17, 18, 40, 0.55); }
  {{ scope }} .qb54-pl-btn--white:hover { background: color-mix(in srgb, var(--navy) 8%, #ffffff); transform: translateY(-2px); }
  {{ scope }} .qb54-pl-btn[aria-busy='true'] { pointer-events: none; opacity: 0.85; }
  {{ scope }} .qb54-pl-btn.is-added { background: var(--ok); color: #ffffff; box-shadow: none; }
  {{ scope }} .qb54-pl-btn.is-error { background: #b91c1c; color: #ffffff; box-shadow: none; }
  {{ scope }} .qb54-pl-btn[disabled] { background: #e7e5dd; color: var(--muted); box-shadow: none; cursor: not-allowed; }
  {{ scope }} .qb54-pl-spin { width: 18px; height: 18px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: qb54-pl-rot 700ms linear infinite; }
  @keyframes qb54-pl-shine { 0% { transform: translateX(-120%); } 55%, 100% { transform: translateX(120%); } }
  @keyframes qb54-pl-rot { to { transform: rotate(360deg); } }

  /* ---------- Shared bits ---------- */
  {{ scope }} .qb54-pl-stars { display: inline-flex; gap: 2px; color: var(--gold); }
  {{ scope }} .qb54-pl-stars svg { width: 15px; height: 15px; }
  {{ scope }} .qb54-pl-rating { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 500; }
  {{ scope }} .qb54-pl-rating b { font-weight: 700; }
  {{ scope }} .qb54-pl-save { display: inline-flex; align-items: center; padding: 5px 10px; border-radius: 6px; background: var(--sale); color: #ffffff; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  {{ scope }} .qb54-pl-was { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1.5px; font-variant-numeric: tabular-nums; }
  {{ scope }} .qb54-pl-now { font-family: var(--fh); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; color: var(--navy); }
  {{ scope }} .qb54-pl-code-note { font-size: 13px; color: var(--ink-2); }
  {{ scope }} .qb54-pl-code-note strong { color: var(--ink); }
  {{ scope }} .qb54-pl-instock { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); }
  {{ scope }} .qb54-pl-instock::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18); }
  {{ scope }} .qb54-pl-err { margin: 8px 0 0; font-size: 13px; color: #b91c1c; }

  /* ---------- Top bar ---------- */
  {{ scope }} .qb54-pl-bar { position: relative; z-index: 5; background: var(--night); border-bottom: 1px solid var(--line-dark); }
  {{ scope }} .qb54-pl-bar__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; }
  {{ scope }} .qb54-pl-bar__logo img { width: auto; height: 42px; }
  {{ scope }} .qb54-pl-bar__logo span { font-family: var(--fh); font-weight: 700; font-size: 26px; color: #ffffff; }
  {{ scope }} .qb54-pl-bar__mid { display: none; align-items: center; gap: 12px; font-size: 13px; color: rgba(255, 255, 255, 0.72); }
  {{ scope }} .qb54-pl-bar__mid strong { color: #ffffff; font-weight: 700; font-variant-numeric: tabular-nums; }
  {{ scope }} .qb54-pl-bar__code { padding: 5px 10px; border-radius: 6px; background: var(--gold); color: var(--on-gold); font-weight: 700; letter-spacing: 0.1em; }
  {{ scope }} .qb54-pl-bar__end { display: flex; align-items: center; gap: 10px; }
  {{ scope }} .qb54-pl-bar .qb54-pl-btn { min-height: 44px; padding: 0 18px; font-size: 15px; }
  {{ scope }} .qb54-pl-cart { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: #ffffff; box-shadow: inset 0 0 0 1px var(--line-dark); }
  {{ scope }} .qb54-pl-cart:hover { background: rgba(255, 255, 255, 0.08); }
  {{ scope }} .qb54-pl-cart svg { width: 21px; height: 21px; }
  {{ scope }} .qb54-pl-cart__n { position: absolute; top: -3px; right: -3px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--gold); color: var(--on-gold); font-size: 11px; font-weight: 700; line-height: 20px; text-align: center; }
  {{ scope }} .qb54-pl-cart__n.is-bump { animation: qb54-pl-bump 420ms var(--ease-emph); }
  @keyframes qb54-pl-bump { 0% { transform: scale(0.4); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }

  /* ---------- Hero ---------- */
  {{ scope }} .qb54-pl-hero { position: relative; isolation: isolate; overflow: hidden; min-height: min(900px, 100svh); display: flex; align-items: center; padding-block: clamp(56px, 7vw, 104px); background: var(--night); }
  {{ scope }} .qb54-pl-hero__bg { position: absolute; inset: 0; z-index: -3; }
  {{ scope }} .qb54-pl-hero__bg img { width: 100%; height: 100%; object-fit: cover; object-position: {{ section.settings.hero_focal }}; }
  {{ scope }} .qb54-pl-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--night) 94%, transparent) 0%, color-mix(in srgb, var(--night) 82%, transparent) 38%, color-mix(in srgb, var(--night) 35%, transparent) 72%, color-mix(in srgb, var(--night) 55%, transparent) 100%),
      linear-gradient(0deg, var(--night) 0%, transparent 34%);
  }
  {{ scope }} .qb54-pl-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(640px 420px at 14% 70%, color-mix(in srgb, var(--gold) 16%, transparent), transparent 70%);
    pointer-events: none;
  }
  {{ scope }} .qb54-pl-hero__grid { position: relative; z-index: 2; display: grid; gap: clamp(40px, 5vw, 72px); align-items: center; }
  {{ scope }} .qb54-pl-hero__badges { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-bottom: 22px; }
  {{ scope }} .qb54-pl-chip-gold { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 999px; background: var(--gold); color: var(--on-gold); font-family: var(--fh); font-weight: 700; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; }
  {{ scope }} .qb54-pl-hero .qb54-pl-rating { color: rgba(255, 255, 255, 0.9); }
  {{ scope }} .qb54-pl-kicker { margin: 0 0 14px; font-size: 13px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.82); }
  {{ scope }} .qb54-pl-title { margin: 0; font-family: var(--fh); font-weight: 700; text-transform: uppercase; color: #ffffff; letter-spacing: -0.01em; line-height: 0.88; }
  {{ scope }} .qb54-pl-title__offer {
    display: block;
    font-size: min(23vw, 196px);
    white-space: nowrap;
    line-height: 0.86;
    padding-bottom: 0.04em;
    letter-spacing: -0.025em;
    background: linear-gradient(180deg, #fff6d6 0%, var(--gold) 46%, var(--gold-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 12px 40px color-mix(in srgb, var(--gold) 30%, transparent));
  }
  {{ scope }} .qb54-pl-title__line { display: block; margin-top: 8px; font-size: clamp(40px, 5.2vw, 78px); line-height: 0.95; }
  {{ scope }} .qb54-pl-hero .qb54-pl-lede { color: rgba(255, 255, 255, 0.86); max-width: 54ch; }

  {{ scope }} .qb54-pl-deal { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  {{ scope }} .qb54-pl-timer { display: grid; gap: 8px; padding: 12px 14px; border-radius: 16px; background: rgba(9, 10, 26, 0.5); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16); backdrop-filter: blur(10px); }
  {{ scope }} .qb54-pl-timer__label { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); }
  {{ scope }} .qb54-pl-cd { display: flex; align-items: center; gap: 6px; }
  {{ scope }} .qb54-pl-cd__u { display: grid; justify-items: center; min-width: 58px; padding: 8px 6px 7px; border-radius: 10px; background: rgba(255, 255, 255, 0.08); }
  {{ scope }} .qb54-pl-cd__n { font-family: var(--fh); font-weight: 700; font-size: 30px; line-height: 1; color: #ffffff; font-variant-numeric: tabular-nums; }
  {{ scope }} .qb54-pl-cd__n.is-tick { animation: qb54-pl-tick 360ms var(--ease-emph); }
  {{ scope }} .qb54-pl-cd__l { margin-top: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); }
  {{ scope }} .qb54-pl-cd__s { margin-top: -14px; font-family: var(--fh); font-size: 22px; font-weight: 700; color: rgba(255, 255, 255, 0.4); }
  @keyframes qb54-pl-tick { 0% { transform: translateY(-35%); opacity: 0; } 100% { transform: none; opacity: 1; } }

  {{ scope }} .qb54-pl-ticket { display: flex; align-items: stretch; border-radius: 16px; background: var(--gold); color: var(--on-gold); overflow: hidden; }
  {{ scope }} .qb54-pl-ticket__main { display: grid; gap: 3px; align-content: center; padding: 12px 18px; }
  {{ scope }} .qb54-pl-ticket__l { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.78; }
  {{ scope }} .qb54-pl-ticket__c { font-family: var(--fh); font-weight: 700; font-size: 36px; line-height: 0.95; letter-spacing: 0.06em; }
  {{ scope }} .qb54-pl-ticket__perf { width: 0; margin-block: 10px; border-left: 2px dashed color-mix(in srgb, var(--on-gold) 35%, transparent); }
  {{ scope }} .qb54-pl-ticket__copy { display: inline-flex; align-items: center; gap: 7px; padding: 0 18px; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--on-gold); cursor: pointer; }
  {{ scope }} .qb54-pl-ticket__copy:hover { background: rgba(0, 0, 0, 0.07); }
  {{ scope }} .qb54-pl-ticket__copy svg { width: 16px; height: 16px; }

  {{ scope }} .qb54-pl-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  {{ scope }} .qb54-pl-hero .qb54-pl-ctas .qb54-pl-btn { min-height: 60px; padding: 0 34px; font-size: 18px; }
  {{ scope }} .qb54-pl-before { margin: 14px 0 0; font-size: 13.5px; color: rgba(255, 255, 255, 0.82); }
  {{ scope }} .qb54-pl-before strong { color: var(--gold); }

  {{ scope }} .qb54-pl-stats { display: flex; flex-wrap: wrap; gap: 14px 34px; margin-top: 34px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.18); }
  {{ scope }} .qb54-pl-stats li { display: grid; gap: 4px; }
  {{ scope }} .qb54-pl-stats strong { font-family: var(--fh); font-weight: 700; font-size: clamp(30px, 3vw, 40px); line-height: 1; color: var(--gold); }
  {{ scope }} .qb54-pl-stats span { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.72); }

  {{ scope }} .qb54-pl-ended { padding: 26px; border-radius: var(--r-card); background: rgba(9, 10, 26, 0.6); box-shadow: inset 0 0 0 1px var(--line-dark); backdrop-filter: blur(10px); }
  {{ scope }} .qb54-pl-ended__t { margin: 0 0 10px; font-family: var(--fh); font-weight: 700; font-size: clamp(34px, 4vw, 52px); line-height: 0.95; letter-spacing: 0; text-transform: uppercase; color: #ffffff; }
  {{ scope }} .qb54-pl-ended__x { margin: 0 0 20px; color: rgba(255, 255, 255, 0.8); line-height: 1.55; }

  /* Hero buy card */
  {{ scope }} .qb54-pl-buy { position: relative; justify-self: center; width: min(100%, 440px); }
  {{ scope }} .qb54-pl-buy__card { position: relative; border-radius: var(--r-card); background: var(--paper); color: var(--ink); box-shadow: var(--shadow-lg); }
  {{ scope }} .qb54-pl-buy__media { position: relative; aspect-ratio: 1 / 0.86; border-radius: var(--r-card) var(--r-card) 0 0; background: #ffffff; overflow: hidden; }
  {{ scope }} .qb54-pl-buy__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 5% 6% 3%; }
  {{ scope }} .qb54-pl-flag { position: absolute; z-index: 2; top: 14px; left: 14px; padding: 7px 11px; border-radius: 6px; background: var(--navy); color: #ffffff; font-family: var(--fh); font-weight: 700; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
  {{ scope }} .qb54-pl-flag b { color: var(--gold); }
  {{ scope }} .qb54-pl-badge { position: absolute; z-index: 2; top: 14px; right: 14px; padding: 7px 11px; border-radius: 999px; background: var(--gold); color: var(--on-gold); font-family: var(--fh); font-weight: 700; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; box-shadow: 0 8px 18px -10px var(--gold-glow); }
  {{ scope }} .qb54-pl-buy__body { display: grid; gap: 10px; padding: 20px 22px 22px; border-top: 1px solid var(--line); }
  {{ scope }} .qb54-pl-buy__title { margin: 0; font-family: var(--fh); font-weight: 700; font-size: 23px; line-height: 1.08; text-transform: uppercase; letter-spacing: 0; color: var(--ink); }
  {{ scope }} .qb54-pl-buy .qb54-pl-rating { color: var(--ink-2); }
  {{ scope }} .qb54-pl-price { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  {{ scope }} .qb54-pl-buy .qb54-pl-now { font-size: 40px; }
  {{ scope }} .qb54-pl-buy .qb54-pl-was { font-size: 16px; }
  {{ scope }} .qb54-pl-swatches { display: flex; align-items: center; gap: 10px; }
