    { "type": "range", "id": "low_stock", "label": "Show \"Only N left\" at or below", "info": "Uses real inventory for products tracked by Shopify. 0 turns it off.", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "festive", "label": "Festive holiday decorations", "info": "String lights, snow and a gift-wrapped product card.", "default": false },
    { "type": "header", "content": "Top bar" },
