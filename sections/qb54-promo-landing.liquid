  {{ scope }} .qb54-pl-close__big { margin: 0; font-family: var(--fh); font-weight: 700; font-size: clamp(84px, 13vw, 190px); line-height: 0.84; letter-spacing: -0.025em; text-transform: uppercase; color: var(--on-gold); }
  {{ scope }} .qb54-pl-close .qb54-pl-h2 { margin-top: clamp(26px, 3vw, 40px); font-size: clamp(28px, 3.6vw, 44px); color: var(--on-gold); }
  {{ scope }} .qb54-pl-close .qb54-pl-lede { color: color-mix(in srgb, var(--on-gold) 85%, transparent); }
  {{ scope }} .qb54-pl-close__l { margin: 30px 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.75; }
  {{ scope }} .qb54-pl-close .qb54-pl-cd { justify-content: center; }
  {{ scope }} .qb54-pl-close .qb54-pl-cd__u { min-width: 78px; padding: 12px 8px 10px; background: #ffffff; box-shadow: 0 12px 24px -16px rgba(17, 18, 40, 0.6); }
  {{ scope }} .qb54-pl-close .qb54-pl-cd__n { font-size: 44px; color: var(--on-gold); }
  {{ scope }} .qb54-pl-close .qb54-pl-cd__l { color: var(--muted); }
  {{ scope }} .qb54-pl-close .qb54-pl-cd__s { color: color-mix(in srgb, var(--on-gold) 45%, transparent); }
  {{ scope }} .qb54-pl-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 28px; }
  {{ scope }} .qb54-pl-chips li { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; background: #ffffff; color: var(--on-gold); font-size: 13px; font-weight: 700; }
  {{ scope }} .qb54-pl-chips svg { width: 15px; height: 15px; color: var(--navy); }
  {{ scope }} .qb54-pl-close .qb54-pl-btn { margin-top: 30px; min-height: 62px; padding: 0 42px; font-size: 19px; }

  /* ---------- Sticky bar + toast ---------- */
  {{ scope }} .qb54-pl-sticky { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: var(--navy); color: #ffffff; box-shadow: 0 -14px 34px -14px rgba(0, 0, 0, 0.55); border-top: 3px solid var(--gold); transform: translateY(115%); transition: transform 320ms var(--ease-emph); }
  {{ scope }} .qb54-pl-sticky.is-visible { transform: translateY(0); }
  {{ scope }} .qb54-pl-sticky__t { display: grid; gap: 2px; min-width: 0; }
  {{ scope }} .qb54-pl-sticky__t strong { font-family: var(--fh); font-weight: 700; font-size: 19px; line-height: 1; text-transform: uppercase; color: var(--gold); }
  {{ scope }} .qb54-pl-sticky__t span { font-size: 12px; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, 0.82); }
  {{ scope }} .qb54-pl-sticky .qb54-pl-btn { min-height: 46px; padding: 0 20px; font-size: 16px; flex: none; }

  {{ scope }} .qb54-pl-toast { position: fixed; z-index: 40; left: 12px; right: 12px; bottom: calc(86px + env(safe-area-inset-bottom)); display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 12px 14px; padding: 14px 14px 14px 16px; border-radius: 16px; background: #ffffff; color: var(--ink); box-shadow: 0 26px 60px -18px rgba(17, 18, 40, 0.6), 0 0 0 1px rgba(17, 18, 40, 0.06); animation: qb54-pl-toast 360ms var(--ease-emph); }
  @keyframes qb54-pl-toast { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  {{ scope }} .qb54-pl-toast__ok { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #dcfce7; color: var(--ok); }
  {{ scope }} .qb54-pl-toast__ok svg { width: 20px; height: 20px; }
  {{ scope }} .qb54-pl-toast__t { display: grid; gap: 2px; min-width: 0; padding-right: 30px; }
  {{ scope }} .qb54-pl-toast__t strong { font-size: 15px; font-weight: 700; }
  {{ scope }} .qb54-pl-toast__t span { font-size: 13px; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  {{ scope }} .qb54-pl-toast__a { grid-column: 1 / -1; display: flex; align-items: center; gap: 16px; }
  {{ scope }} .qb54-pl-toast__a .qb54-pl-btn { flex: 1; min-height: 50px; }
  {{ scope }} .qb54-pl-toast__cart { font-size: 14px; font-weight: 700; color: var(--navy); text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  {{ scope }} .qb54-pl-toast__x { position: absolute; top: 10px; right: 10px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; color: var(--muted); }
  {{ scope }} .qb54-pl-toast__x:hover { background: var(--cream); color: var(--ink); }
  {{ scope }} .qb54-pl-toast__x svg { width: 16px; height: 16px; }

  /* ---------- Reveal ---------- */
  {{ scope }}.qb54-pl--js [data-qb54-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 520ms var(--ease), transform 520ms var(--ease); }
  {{ scope }}.qb54-pl--js [data-qb54-reveal].is-in { opacity: 1; transform: none; }

  /* ---------- Breakpoints ---------- */
  @media screen and (min-width: 600px) {
    {{ scope }} .qb54-pl-rail { grid-auto-columns: 240px; }
    {{ scope }} .qb54-pl-mosaic { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 200px; }
    {{ scope }} .qb54-pl-feats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    {{ scope }} .qb54-pl-steps__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    {{ scope }} .qb54-pl-revrail { grid-auto-columns: 46%; }
    {{ scope }} .qb54-pl-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    {{ scope }} .qb54-pl-shelf__grid { grid-auto-columns: 31%; }
  }
  @media screen and (min-width: 750px) {
    {{ scope }} .qb54-pl-sticky { display: none; }
    {{ scope }} .qb54-pl-toast { left: auto; right: 24px; bottom: 24px; width: 390px; }
  }
  @media screen and (min-width: 990px) {
    {{ scope }} .qb54-pl-bar__mid { display: inline-flex; }
    {{ scope }} .qb54-pl-hero__grid { grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); }
    {{ scope }} .qb54-pl-title__offer { font-size: min(13vw, 196px); }
    {{ scope }} .qb54-pl-buy { justify-self: end; }
    {{ scope }} .qb54-pl-head--split { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    {{ scope }} .qb54-pl-head__aside { justify-self: end; }
    {{ scope }} .qb54-pl-panel { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 36px; padding: 22px 36px 22px 22px; }
    {{ scope }} .qb54-pl-info { padding: 18px 0; }
    {{ scope }} .qb54-pl-rail { grid-auto-flow: row; grid-template-columns: repeat(6, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding-inline: 0; }
    {{ scope }} .qb54-pl-mosaic { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 230px; }
    {{ scope }} .qb54-pl-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
    {{ scope }} .qb54-pl-cats { flex-wrap: wrap; overflow: visible; }
    {{ scope }} .qb54-pl-shelf__grid { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; overflow: visible; margin-inline: 0; padding-inline: 0; }
    {{ scope }} .qb54-pl-bundle__card { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; padding: 28px; }
    {{ scope }} .qb54-pl-bundle__thumb { width: 76px; height: 76px; }
    {{ scope }} .qb54-pl-revrail { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding-inline: 0; }
    {{ scope }} .qb54-pl-dots { display: none; }
    {{ scope }} .qb54-pl-faq__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 72px; align-items: start; }
    {{ scope }} .qb54-pl-faq__aside { position: sticky; top: 32px; }
  }
  @media screen and (max-width: 599px) {
    {{ scope }} .qb54-pl-hero { min-height: 0; }
    {{ scope }} .qb54-pl-deal { display: grid; grid-template-columns: 1fr; }
    {{ scope }} .qb54-pl-timer { justify-items: center; }
    {{ scope }} .qb54-pl-cd__u { min-width: 0; flex: 1; }
    {{ scope }} .qb54-pl-ticket { justify-content: space-between; }
    {{ scope }} .qb54-pl-ctas .qb54-pl-btn { width: 100%; }
    {{ scope }} .qb54-pl-close .qb54-pl-cd { width: 100%; }
    {{ scope }} .qb54-pl-close .qb54-pl-cd__u { min-width: 0; padding: 10px 4px 9px; }
    {{ scope }} .qb54-pl-close .qb54-pl-cd__n { font-size: 34px; }
    {{ scope }} .qb54-pl-close .qb54-pl-btn { width: 100%; }
    {{ scope }} .qb54-pl-bar .qb54-pl-btn { padding: 0 14px; }
    {{ scope }}.qb54-pl--festive .qb54-pl-tag { right: -6px; }
    {{ scope }} .qb54-pl-press { gap: 8px 22px; }
    {{ scope }} .qb54-pl-press__l { width: 100%; text-align: center; }
    {{ scope }} .qb54-pl-press__i { font-size: 18px; }
    {{ scope }} .qb54-pl-bulb:nth-of-type(even) { display: none; }
    {{ scope }} .qb54-pl-team__box select { min-width: 0; }
    {{ scope }} .qb54-pl-card__body { padding: 10px 10px 12px; }
    {{ scope }} .qb54-pl-card__t { font-size: 13.5px; }
    {{ scope }} .qb54-pl-card__p .qb54-pl-now { font-size: 20px; }
    {{ scope }} .qb54-pl-card .qb54-pl-btn { font-size: 13.5px; padding: 0 8px; }
    {{ scope }} .qb54-pl-card__rank { min-width: 38px; height: 38px; padding-top: 7px; font-size: 21px; }
    {{ scope }} .qb54-pl-bundle__add { grid-template-columns: auto 46px minmax(0, 1fr) auto; gap: 10px; padding: 10px; }
    {{ scope }} .qb54-pl-bundle__img { width: 46px; height: 46px; }
    {{ scope }} .qb54-pl-bundle__price { font-size: 17px; }
    {{ scope }} .qb54-pl-bundle__total strong { font-size: 38px; }
    {{ scope }} .qb54-pl-bundle__thumb { width: 52px; height: 52px; }
  }
  @media screen and (max-width: 989px) {
    {{ scope }}.qb54-pl--festive .qb54-pl-snow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { animation: none !important; transition: none !important; }
    {{ scope }}.qb54-pl--js [data-qb54-reveal] { opacity: 1; transform: none; }
  }
  body.qb54-pl-bar-on { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
  @media screen and (min-width: 750px) { body.qb54-pl-bar-on { padding-bottom: 0; } }
</style>

{%- capture i_bolt -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.4 2 4.6 13.4h6.1L9.8 22l8.6-11.4h-6.1L13.4 2z"/></svg>{%- endcapture -%}
{%- capture i_star -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}
{%- capture i_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture i_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture i_copy -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>{%- endcapture -%}
{%- capture i_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{%- endcapture -%}
{%- capture i_cart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h3l2.4 12h11l2.1-8H6.4"/></svg>{%- endcapture -%}
{%- capture i_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v12H1zM15 9h4l4 4v3h-8z"/><circle cx="6" cy="18.5" r="2"/><circle cx="18" cy="18.5" r="2"/></svg>{%- endcapture -%}
{%- capture i_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture i_tag -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>{%- endcapture -%}
{%- capture i_eye -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>{%- endcapture -%}
{%- capture i_play -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>{%- endcapture -%}
{%- capture i_mute -%}<svg class="is-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="m23 9-6 6M17 9l6 6"/></svg><svg class="is-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>{%- endcapture -%}
{%- capture i_insta -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>{%- endcapture -%}

{%- capture stars_5 -%}<span class="qb54-pl-stars">{{ i_star }}{{ i_star }}{{ i_star }}{{ i_star }}{{ i_star }}</span>{%- endcapture -%}

{%- capture cd_units -%}
  <div class="qb54-pl-cd__u"><span class="qb54-pl-cd__n" data-u="d">00</span><span class="qb54-pl-cd__l">Days</span></div>
  <span class="qb54-pl-cd__s" aria-hidden="true">:</span>
  <div class="qb54-pl-cd__u"><span class="qb54-pl-cd__n" data-u="h">00</span><span class="qb54-pl-cd__l">Hrs</span></div>
  <span class="qb54-pl-cd__s" aria-hidden="true">:</span>
  <div class="qb54-pl-cd__u"><span class="qb54-pl-cd__n" data-u="m">00</span><span class="qb54-pl-cd__l">Min</span></div>
  <span class="qb54-pl-cd__s" aria-hidden="true">:</span>
  <div class="qb54-pl-cd__u"><span class="qb54-pl-cd__n" data-u="s">00</span><span class="qb54-pl-cd__l">Sec</span></div>
{%- endcapture -%}

{%- capture live_label -%}<span data-qb54-when="live">{{ section.settings.live_label | escape }}</span><span data-qb54-when="before" hidden>{{ section.settings.before_label | escape }}</span>{%- endcapture -%}

<div
  id="qb54-pl-{{ section.id }}"
  class="qb54-pl{% if festive %} qb54-pl--festive{% endif %}"
  data-state="live"
  data-start="{{ start_iso | escape }}"
  data-end="{{ end_iso | escape }}"
  data-code="{{ code | escape }}"
  data-auto-apply="{{ section.settings.auto_apply_code }}"
>
  <header class="qb54-pl-bar">
    <div class="qb54-pl-wrap qb54-pl-bar__in">
      <a class="qb54-pl-bar__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{- section.settings.logo | image_url: width: 260 | image_tag: loading: 'eager', alt: shop.name, widths: '130,260', sizes: '130px' -}}
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <p class="qb54-pl-bar__mid" data-qb54-when="before live">
        {{ live_label }} <strong data-qb54-cd-compact>0d 00:00:00</strong>
        {%- if code != blank -%}<span class="qb54-pl-bar__code">{{ code }}</span>{%- endif -%}
      </p>
      <div class="qb54-pl-bar__end">
        <a class="qb54-pl-cart" href="{{ routes.cart_url }}" aria-label="Cart">{{ i_cart }}<span class="qb54-pl-cart__n" data-qb54-cart-count hidden>0</span></a>
        <a class="qb54-pl-btn qb54-pl-btn--gold" href="#qb54-pl-deals-{{ section.id }}">{{ section.settings.bar_cta | escape }}</a>
      </div>
    </div>
  </header>

  <section class="qb54-pl-hero" data-qb54-hero aria-labelledby="qb54-pl-h1-{{ section.id }}">
    {%- if section.settings.hero_image != blank -%}
      <div class="qb54-pl-hero__bg">
        {{- section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800,1200,1600,2000,2400', sizes: '100vw', alt: '' -}}
      </div>
    {%- endif -%}
    <div class="qb54-pl-snow" aria-hidden="true"><i></i><i></i></div>
    <div class="qb54-pl-lights" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none"><path d="M0 4 Q60 34 120 4 Q180 34 240 4 Q300 34 360 4 Q420 34 480 4 Q540 34 600 4 Q660 34 720 4 Q780 34 840 4 Q900 34 960 4 Q1020 34 1080 4 Q1140 34 1200 4 Q1260 34 1320 4 Q1380 34 1440 4" fill="none" stroke="#2a2d48" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>
      {%- for i in (0..11) -%}
        {%- assign left = i | times: 120 | plus: 60 | times: 100.0 | divided_by: 1440 -%}
        {%- assign mod = i | modulo: 3 -%}
        <span class="qb54-pl-bulb" style="left: {{ left }}%; --b: {% if mod == 0 %}var(--gold){% elsif mod == 1 %}var(--festive){% else %}#f3f6ff{% endif %}; animation-delay: {{ i | times: 0.22 }}s;"></span>
      {%- endfor -%}
    </div>

    <div class="qb54-pl-wrap qb54-pl-hero__grid">
      <div class="qb54-pl-hero__copy">
        <div class="qb54-pl-hero__badges">
          {%- if section.settings.hero_badge != blank -%}<span class="qb54-pl-chip-gold">{{ section.settings.hero_badge | escape }}</span>{%- endif -%}
          <span class="qb54-pl-rating">{{ stars_5 }}
            {%- if lead_rating != blank and lead_count != blank -%}<span><b>{{ lead_rating }}</b> · {{ lead_count }} reviews</span>
            {%- else -%}<span>{{ section.settings.rating_fallback | escape }}</span>{%- endif -%}
          </span>
        </div>

        <div data-qb54-when="before live">
          <p class="qb54-pl-kicker">{{ section.settings.hero_kicker | escape }}</p>
          <h1 class="qb54-pl-title" id="qb54-pl-h1-{{ section.id }}">
            <span class="qb54-pl-title__offer">{{ pct }}% Off</span>
            <span class="qb54-pl-title__line">{{ section.settings.hero_line | escape }}</span>
          </h1>
          <p class="qb54-pl-lede">{{ section.settings.hero_text | escape }}</p>
          <div class="qb54-pl-deal">
            <div class="qb54-pl-timer">
              <span class="qb54-pl-timer__label">{{ live_label }}</span>
              <div class="qb54-pl-cd" data-qb54-cd role="timer" aria-label="Time remaining">{{ cd_units }}</div>
            </div>
            {%- if code != blank -%}
              <div class="qb54-pl-ticket">
                <div class="qb54-pl-ticket__main"><span class="qb54-pl-ticket__l">Use code</span><span class="qb54-pl-ticket__c">{{ code }}</span></div>
                <span class="qb54-pl-ticket__perf" aria-hidden="true"></span>
                <button type="button" class="qb54-pl-ticket__copy" data-qb54-copy="{{ code | escape }}">{{ i_copy }}<span data-qb54-copy-label aria-live="polite">Copy</span></button>
              </div>
            {%- endif -%}
          </div>
          <p class="qb54-pl-before" data-qb54-when="before" hidden>Code <strong>{{ code }}</strong> unlocks {{ start_label }} — bookmark this page so you're first in line.</p>
          <div class="qb54-pl-ctas">
            <a class="qb54-pl-btn qb54-pl-btn--gold qb54-pl-btn--shine" href="#qb54-pl-deals-{{ section.id }}">{{ section.settings.hero_cta | escape }}{{ i_arrow }}</a>
            {%- if section.settings.hero_cta_2 != blank -%}<a class="qb54-pl-btn qb54-pl-btn--ghost" href="#qb54-pl-reels-{{ section.id }}">{{ section.settings.hero_cta_2 | escape }}</a>{%- endif -%}
          </div>
        </div>

        <div class="qb54-pl-ended" data-qb54-when="after" hidden>
          <h2 class="qb54-pl-ended__t">{{ section.settings.after_heading | escape }}</h2>
          <p class="qb54-pl-ended__x">{{ section.settings.after_text | escape }}</p>
          <a class="qb54-pl-btn qb54-pl-btn--gold" href="{{ section.settings.after_url | default: shop_url }}">{{ section.settings.after_cta | escape }}{{ i_arrow }}</a>
        </div>

        <ul class="qb54-pl-stats">
          {%- if section.settings.stat_1_n != blank -%}<li><strong>{{ section.settings.stat_1_n | escape }}</strong><span>{{ section.settings.stat_1_l | escape }}</span></li>{%- endif -%}
          {%- if section.settings.stat_2_n != blank -%}<li><strong>{{ section.settings.stat_2_n | escape }}</strong><span>{{ section.settings.stat_2_l | escape }}</span></li>{%- endif -%}
          {%- if section.settings.stat_3_n != blank -%}<li><strong>{{ section.settings.stat_3_n | escape }}</strong><span>{{ section.settings.stat_3_l | escape }}</span></li>{%- endif -%}
        </ul>
      </div>

      {%- if product_blocks.size > 0 -%}
        <aside class="qb54-pl-buy" aria-label="Featured deal" data-qb54-switch>
          <div class="qb54-pl-buy__card">
            <span class="qb54-pl-ribbon" aria-hidden="true"></span>
            <svg class="qb54-pl-bow" viewBox="0 0 112 64" aria-hidden="true">
              <path d="M56 34 C38 6 10 2 8 22 C6 38 30 40 56 34Z" fill="var(--festive)"/>
              <path d="M56 34 C74 6 102 2 104 22 C106 38 82 40 56 34Z" fill="var(--festive)"/>
              <path d="M56 34 C44 18 22 14 20 24 C19 31 34 34 56 34Z" fill="rgba(0,0,0,.18)"/>
              <path d="M56 34 C68 18 90 14 92 24 C93 31 78 34 56 34Z" fill="rgba(0,0,0,.18)"/>
              <path d="M50 36 L38 62 L46 58 L50 64 L56 38Z" fill="var(--festive)"/>
              <path d="M62 36 L74 62 L66 58 L62 64 L56 38Z" fill="var(--festive)"/>
              <ellipse cx="56" cy="34" rx="9" ry="8" fill="color-mix(in srgb, var(--festive) 75%, #000)"/>
            </svg>
            <span class="qb54-pl-tag" aria-hidden="true"><span>{{ pct }}% Off<small>{{ section.settings.tag_label | escape }}</small></span></span>
            {%- liquid
              assign hero_count = 0
              for hb in product_blocks
                if hb.settings.product != blank and hero_count < 3
                  assign hero_count = hero_count | plus: 1
                endif
              endfor
              assign hero_i = 0
            -%}
            {%- for block in product_blocks -%}
              {%- assign p = block.settings.product -%}
              {%- if p == blank or hero_i >= 3 -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign hero_i = hero_i | plus: 1
                assign v = p.selected_or_first_available_variant
                assign multi = true
                if p.has_only_default_variant
                  assign multi = false
                endif
                assign base = v.price
                if multi
                  assign base = p.price_min
                endif
                assign sale = base | times: keep | divided_by: 100
                assign save = base | minus: sale
                assign needs_page = false
                if block.settings.needs_customization or multi
                  assign needs_page = true
                endif
                assign r = p.metafields.reviews.rating.value
                assign rc = p.metafields.reviews.rating_count.value
              -%}
              <div data-qb54-panel="{{ hero_i }}"{% if hero_i > 1 %} hidden{% endif %}>
                <div class="qb54-pl-buy__media">
                  {%- if block.settings.flag != blank -%}<span class="qb54-pl-flag">{{ block.settings.flag }}</span>{%- endif -%}
                  <span class="qb54-pl-badge" data-qb54-when="before live">{{ pct }}% Off</span>
                  {%- if p.featured_media != blank -%}
                    {{- p.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '450,700,900', sizes: '(min-width: 990px) 440px, 92vw', alt: p.featured_media.alt | default: p.title -}}
                  {%- endif -%}
                </div>
                <div class="qb54-pl-buy__body">
                  <span class="qb54-pl-rating">{{ stars_5 }}
                    {%- if r != blank and rc != blank -%}<span><b>{{ r.rating | round: 1 }}</b> · {{ rc }} reviews</span>{%- else -%}<span>{{ block.settings.rating_text | escape }}</span>{%- endif -%}
                  </span>
                  <h2 class="qb54-pl-buy__title">{{ block.settings.title_override | default: p.title | escape }}</h2>
                  <div class="qb54-pl-price" data-qb54-when="before live">
                    {%- if multi -%}<span class="qb54-pl-from">From</span>{%- endif -%}
                    <span class="qb54-pl-now">{{ sale | money }}</span>
                    <s class="qb54-pl-was"><span class="qb54-pl-sr">Regular price </span>{{ base | money }}</s>
                    <span class="qb54-pl-save">Save {{ save | money }}</span>
                  </div>
                  <p class="qb54-pl-code-note" data-qb54-when="live">With code <strong>{{ code }}</strong> at checkout</p>
                  <p class="qb54-pl-code-note" data-qb54-when="before" hidden>With code <strong>{{ code }}</strong> · starts {{ start_label }}</p>
                  <div class="qb54-pl-price" data-qb54-when="after" hidden><span class="qb54-pl-now">{{ base | money }}</span></div>
                  {%- if hero_count > 1 -%}
                    <div class="qb54-pl-swatches" role="group" aria-label="Choose a color">
                      <span class="qb54-pl-swatches__l">Color</span>
                      {%- assign sw_i = 0 -%}
                      {%- for sb in product_blocks -%}
                        {%- if sb.settings.product == blank or sw_i >= 3 -%}{%- continue -%}{%- endif -%}
                        {%- assign sw_i = sw_i | plus: 1 -%}
                        <button type="button" class="qb54-pl-sw" style="--sw: {{ sb.settings.swatch }};" data-qb54-switch-to="{{ sw_i }}" aria-pressed="{% if sw_i == hero_i %}true{% else %}false{% endif %}" aria-label="{{ sb.settings.swatch_label | default: sb.settings.product.title | escape }}"></button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- render 'qb54-pl-buy-button', product: p, variant: v, needs_page: needs_page, label: block.settings.options_label -%}
                  <span class="qb54-pl-instock">{{ block.settings.ship_note | default: section.settings.stock_note | escape }}</span>
                  <p class="qb54-pl-buy__foot">{{ section.settings.card_foot | escape }}</p>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </aside>
      {%- endif -%}
    </div>
  </section>

  {%- assign ticker = section.settings.ticker_items | split: '|' -%}
  {%- if ticker.size > 0 -%}
    <div class="qb54-pl-ticker">
      <div class="qb54-pl-ticker__track">
        {%- for pass in (1..2) -%}
          <div class="qb54-pl-ticker__g"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- for rep in (1..2) -%}{%- for item in ticker -%}<span class="qb54-pl-ticker__i">{{ item | strip | escape }}{{ i_bolt }}</span>{%- endfor -%}{%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- render 'qb54-pl-slot', position: 'after_hero', blocks: section.blocks, section_id: section.id, sets: product_blocks, keep: keep, code: code, pct: pct, eligible: eligible, free_ship: free_ship, low_stock: low_stock, start_label: start_label, live_label: live_label -%}

  {%- if reel_blocks.size > 0 -%}
    <section class="qb54-pl-reels" id="qb54-pl-reels-{{ section.id }}" aria-labelledby="qb54-pl-reels-h-{{ section.id }}">
      <div class="qb54-pl-wrap">
        <header class="qb54-pl-head qb54-pl-head--split" data-qb54-reveal>
          <div>
            <p class="qb54-pl-eyebrow">{{ section.settings.reels_eyebrow | escape }}</p>
            <h2 class="qb54-pl-h2" id="qb54-pl-reels-h-{{ section.id }}">{{ section.settings.reels_heading }}</h2>
            {%- if section.settings.reels_text != blank -%}<p class="qb54-pl-lede">{{ section.settings.reels_text | escape }}</p>{%- endif -%}
          </div>
          {%- if section.settings.instagram_url != blank -%}<a class="qb54-pl-follow qb54-pl-head__aside" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">{{ i_insta }}{{ section.settings.instagram_label | escape }}</a>{%- endif -%}
        </header>
        <div class="qb54-pl-rail" data-qb54-reel-rail>
          {%- for block in reel_blocks -%}
            {%- liquid
              assign reel_src = block.settings.video_url
              assign reel_poster = block.settings.poster_url
              if block.settings.video != blank
                for s in block.settings.video.sources
                  if s.mime_type == 'video/mp4'
                    assign reel_src = s.url
                  endif
                endfor
                assign reel_poster = block.settings.video.preview_image | image_url: width: 540
              endif
            -%}
            <figure class="qb54-pl-reel" data-qb54-reveal data-qb54-reel {{ block.shopify_attributes }}>
              {%- comment %}theme-check-disable RemoteAsset{% endcomment -%}
              {%- if reel_poster != blank -%}<img src="{{ reel_poster }}" alt="" loading="lazy" width="540" height="960">{%- endif -%}
              {%- comment %}theme-check-enable RemoteAsset{% endcomment -%}
              <video muted loop playsinline preload="none" data-src="{{ reel_src | escape }}"{% if reel_poster != blank %} poster="{{ reel_poster }}"{% endif %} aria-label="{{ block.settings.caption | escape }}"></video>
              {%- if block.settings.chip != blank -%}<span class="qb54-pl-reel__chip">{{ i_eye }}{{ block.settings.chip | escape }}</span>{%- endif -%}
              <button type="button" class="qb54-pl-reel__snd" data-qb54-reel-sound aria-label="Turn sound on">{{ i_mute }}</button>
              <span class="qb54-pl-reel__play" aria-hidden="true">{{ i_play }}</span>
              {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
        {%- assign press = section.settings.press_items | default: '' | split: '|' -%}
        {%- if press.size > 0 -%}
          <div class="qb54-pl-press" data-qb54-reveal>
            <span class="qb54-pl-press__l">{{ section.settings.press_label | escape }}</span>
            {%- for item in press -%}<span class="qb54-pl-press__i">{{ item | strip | escape }}</span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  <section class="qb54-pl-stage qb54-pl-light" id="qb54-pl-deals-{{ section.id }}" aria-labelledby="qb54-pl-deals-h-{{ section.id }}">
    <div class="qb54-pl-wrap">
      <header class="qb54-pl-head qb54-pl-head--split" data-qb54-reveal>
        <div>
          <p class="qb54-pl-eyebrow">{{ section.settings.stage_eyebrow | escape }}</p>
          <h2 class="qb54-pl-h2" id="qb54-pl-deals-h-{{ section.id }}">{{ section.settings.stage_heading }}</h2>
          {%- if section.settings.stage_text != blank -%}<p class="qb54-pl-lede">{{ section.settings.stage_text | escape }}</p>{%- endif -%}
        </div>
        <p class="qb54-pl-timerpill qb54-pl-head__aside" data-qb54-when="before live">{{ i_clock }}<span>{{ live_label }} <strong data-qb54-cd-compact>0d 00:00:00</strong></span></p>
      </header>

      <div data-qb54-switch data-qb54-reveal>
        <div class="qb54-pl-tabs" role="tablist" aria-label="{{ section.settings.stage_eyebrow | escape }}">
          {%- assign t_i = 0 -%}
          {%- for block in product_blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign t_i = t_i | plus: 1
              assign v = p.selected_or_first_available_variant
              assign base = v.price
              if p.has_only_default_variant == false
                assign base = p.price_min
              endif
              assign sale = base | times: keep | divided_by: 100
            -%}
            <button type="button" class="qb54-pl-tab" role="tab" id="qb54-pl-tab-{{ section.id }}-{{ t_i }}" aria-controls="qb54-pl-panel-{{ section.id }}-{{ t_i }}" aria-selected="{% if t_i == 1 %}true{% else %}false{% endif %}" tabindex="{% if t_i == 1 %}0{% else %}-1{% endif %}" data-qb54-switch-to="{{ t_i }}" {{ block.shopify_attributes }}>
              {%- if section.settings.tab_style == 'thumb' -%}
                <span class="qb54-pl-tab__thumb">{{- p.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' -}}</span>
              {%- else -%}
                <span class="qb54-pl-tab__dot" style="--sw: {{ block.settings.swatch }};"></span>
              {%- endif -%}
              <span class="qb54-pl-tab__t">
                <strong>{{ block.settings.tab_label | default: p.title | escape }}</strong>
                <span data-qb54-when="before live">{% if p.has_only_default_variant == false %}From {% endif %}{{ sale | money }} with {{ code }}</span>
                <span data-qb54-when="after" hidden>{{ base | money }}</span>
              </span>
            </button>
          {%- endfor -%}
        </div>

        {%- assign t_i = 0 -%}
        {%- for block in product_blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign t_i = t_i | plus: 1
            assign v = p.selected_or_first_available_variant
            assign multi = true
            if p.has_only_default_variant
              assign multi = false
            endif
            assign base = v.price
            if multi
              assign base = p.price_min
            endif
            assign sale = base | times: keep | divided_by: 100
            assign save = base | minus: sale
            assign needs_page = false
            if block.settings.needs_customization or multi
              assign needs_page = true
            endif
            assign r = p.metafields.reviews.rating.value
            assign rc = p.metafields.reviews.rating_count.value
            assign items = included
            if block.settings.included_override != blank
              assign items = block.settings.included_override | split: '|'
            endif
          -%}
          <div class="qb54-pl-panel" role="tabpanel" id="qb54-pl-panel-{{ section.id }}-{{ t_i }}" aria-labelledby="qb54-pl-tab-{{ section.id }}-{{ t_i }}" data-qb54-panel="{{ t_i }}"{% if t_i > 1 %} hidden{% endif %}>
            <div class="qb54-pl-gallery" data-qb54-gallery>
              <div class="qb54-pl-gallery__main">
                {%- if block.settings.flag != blank -%}<span class="qb54-pl-flag">{{ block.settings.flag }}</span>{%- endif -%}
                <span class="qb54-pl-badge" data-qb54-when="before live">{{ pct }}% Off</span>
                {%- if p.featured_media != blank -%}
                  {{- p.featured_media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', sizes: '(min-width: 990px) 640px, 92vw', alt: p.featured_media.alt | default: p.title -}}
                {%- endif -%}
              </div>
              {%- if p.media.size > 1 -%}
                <div class="qb54-pl-thumbs">
                  {%- for m in p.media limit: 4 -%}
                    <button type="button" class="qb54-pl-thumb" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}" data-qb54-thumb="{{ m.preview_image | image_url: width: 1200 }}">
                      {{- m.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' -}}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
            <div class="qb54-pl-info">
              {%- if block.settings.recipient != blank -%}<span class="qb54-pl-info__flag">{{ block.settings.recipient }}</span>{%- endif -%}
              <h3 class="qb54-pl-info__title">{{ block.settings.title_override | default: p.title | escape }}</h3>
              <span class="qb54-pl-rating">{{ stars_5 }}
                {%- if r != blank and rc != blank -%}<span><b>{{ r.rating | round: 1 }}</b> · {{ rc }} reviews</span>{%- else -%}<span>{{ block.settings.rating_text | escape }}</span>{%- endif -%}
              </span>
              {%- if block.settings.pitch != blank -%}<p class="qb54-pl-pitch">{{ block.settings.pitch | escape }}</p>{%- endif -%}
              <div class="qb54-pl-price" data-qb54-when="before live">
                {%- if multi -%}<span class="qb54-pl-from">From</span>{%- endif -%}
                <span class="qb54-pl-now">{{ sale | money }}</span>
                <s class="qb54-pl-was"><span class="qb54-pl-sr">Regular price </span>{{ base | money }}</s>
                <span class="qb54-pl-save">Save {{ save | money }}</span>
              </div>
              <p class="qb54-pl-code-note" data-qb54-when="live">With code <strong>{{ code }}</strong> at checkout</p>
              <p class="qb54-pl-code-note" data-qb54-when="before" hidden>With code <strong>{{ code }}</strong> · starts {{ start_label }}</p>
              <div class="qb54-pl-price" data-qb54-when="after" hidden><span class="qb54-pl-now">{{ base | money }}</span></div>
              {%- if items.size > 0 -%}
                <ul class="qb54-pl-checks">{%- for item in items -%}<li>{{ i_check }}{{ item | strip | escape }}</li>{%- endfor -%}</ul>
              {%- endif -%}
              {%- render 'qb54-pl-buy-button', product: p, variant: v, needs_page: needs_page, label: block.settings.options_label -%}
              <div class="qb54-pl-trustline">
                <span class="qb54-pl-instock">{{ block.settings.ship_note | default: section.settings.stock_note | escape }}</span>
                <span>{{ i_truck }}{{ section.settings.shipping_note | escape }}</span>
                <span>{{ i_shield }}{{ section.settings.returns_note | escape }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- render 'qb54-pl-slot', position: 'after_deals', blocks: section.blocks, section_id: section.id, sets: product_blocks, keep: keep, code: code, pct: pct, eligible: eligible, free_ship: free_ship, low_stock: low_stock, start_label: start_label, live_label: live_label -%}

  {%- if store_blocks.size > 0 -%}
    {%- assign nfl_teams = 'cardinals:Arizona Cardinals|falcons:Atlanta Falcons|ravens:Baltimore Ravens|bills:Buffalo Bills|panthers:Carolina Panthers|bears:Chicago Bears|bengals:Cincinnati Bengals|browns:Cleveland Browns|cowboys:Dallas Cowboys|broncos:Denver Broncos|lions:Detroit Lions|packers:Green Bay Packers|texans:Houston Texans|colts:Indianapolis Colts|jaguars:Jacksonville Jaguars|chiefs:Kansas City Chiefs|raiders:Las Vegas Raiders|chargers:Los Angeles Chargers|rams:Los Angeles Rams|dolphins:Miami Dolphins|vikings:Minnesota Vikings|patriots:New England Patriots|saints:New Orleans Saints|giants:New York Giants|jets:New York Jets|eagles:Philadelphia Eagles|steelers:Pittsburgh Steelers|49ers:San Francisco 49ers|seahawks:Seattle Seahawks|buccaneers:Tampa Bay Buccaneers|titans:Tennessee Titans|commanders:Washington Commanders' | split: '|' -%}
    <section class="qb54-pl-store qb54-pl-light" id="qb54-pl-store-{{ section.id }}" aria-labelledby="qb54-pl-store-h-{{ section.id }}" data-qb54-store data-initial="{{ section.settings.store_initial }}">
      <div class="qb54-pl-wrap">
        <header class="qb54-pl-head qb54-pl-head--split" data-qb54-reveal>
          <div>
            <p class="qb54-pl-eyebrow">{{ section.settings.store_eyebrow | escape }}</p>
            <h2 class="qb54-pl-h2" id="qb54-pl-store-h-{{ section.id }}">{{ section.settings.store_heading }}</h2>
            {%- if section.settings.store_text != blank -%}<p class="qb54-pl-lede">{{ section.settings.store_text | escape }}</p>{%- endif -%}
          </div>
          <div class="qb54-pl-team qb54-pl-head__aside">
            <label class="qb54-pl-team__l" for="qb54-pl-team-{{ section.id }}">{{ section.settings.store_team_label | escape }}</label>
            <div class="qb54-pl-team__box">
              <svg class="qb54-pl-team__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14.5C4 8.7 7.6 4 12.6 4c4.4 0 7.4 3.4 7.4 7.6v2.9H14l-1.6 3.5H8.2A4.2 4.2 0 0 1 4 14.5z"/><path d="M14 14.5 13 20M9.5 9.5h5.5"/></svg>
              <select id="qb54-pl-team-{{ section.id }}" data-qb54-team>
                <option value="">All NFL teams</option>
                {%- for pair in nfl_teams -%}
                  {%- assign pair_parts = pair | split: ':' -%}
                  <option value="{{ pair_parts[0] }}">{{ pair_parts[1] }}</option>
                {%- endfor -%}
              </select>
              <svg class="qb54-pl-team__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </div>
          </div>
        </header>

        {%- assign store_total = 0 -%}
        {%- capture store_chips -%}
          {%- for block in store_blocks -%}
            {%- assign c = block.settings.collection -%}
            {%- if c == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign from_price = 0
              for p in c.products limit: block.settings.limit
                if p.available
                  assign store_total = store_total | plus: 1
                  if from_price == 0 or p.price < from_price
                    assign from_price = p.price
                  endif
                endif
              endfor
              if block.settings.code_applies
                assign from_price = from_price | times: keep | divided_by: 100
              endif
            -%}
            <button type="button" class="qb54-pl-cat" aria-pressed="false" data-qb54-cat="{{ forloop.index }}" data-url="{{ c.url }}" data-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
              {{- block.settings.label | escape -}}<small>from {{ from_price | money }}</small>
            </button>
          {%- endfor -%}
        {%- endcapture -%}
        <div class="qb54-pl-cats" role="group" aria-label="Shop by category">
          <button type="button" class="qb54-pl-cat" aria-pressed="true" data-qb54-cat="all">{{ section.settings.store_all_label | escape }}<small>{{ store_total }} items</small></button>
          {{- store_chips -}}
        </div>

        <div class="qb54-pl-grid" data-qb54-grid>
          {%- for block in store_blocks -%}
            {%- assign c = block.settings.collection -%}
            {%- if c == blank -%}{%- continue -%}{%- endif -%}
            {%- assign cat_i = forloop.index -%}
            {%- assign rank = 0 -%}
            {%- for p in c.products limit: block.settings.limit -%}
              {%- unless p.available -%}{%- continue -%}{%- endunless -%}
              {%- capture card_team -%}{%- render 'qb54-pl-team-key', title: p.title -%}{%- endcapture -%}
              {%- liquid
                assign rank = rank | plus: 1
                assign card_team = card_team | strip
                assign card_attrs = 'data-qb54-card data-cat="' | append: cat_i | append: '" data-rank="' | append: rank | append: '" data-team="' | append: card_team | append: '"'
                assign token = '|' | append: p.id | append: '|'
                assign card_code = block.settings.code_applies
                if eligible contains token
                  assign card_code = true
                endif
              -%}
              {%- render 'qb54-pl-card', product: p, keep: keep, code: code, code_ok: card_code, start_label: start_label, tag: block.settings.label, attrs: card_attrs, low_stock: low_stock, sizes: '(min-width: 990px) 300px, (min-width: 600px) 31vw, 46vw' -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
        <p class="qb54-pl-store__empty" data-qb54-empty hidden></p>
        <div class="qb54-pl-store__foot">
          <p class="qb54-pl-store__count" data-qb54-count aria-live="polite"></p>
          <button type="button" class="qb54-pl-btn qb54-pl-btn--navy" data-qb54-more hidden>Show more</button>
          <a class="qb54-pl-store__all" href="{{ shop_url }}" data-qb54-viewall hidden></a>
        </div>
        {%- if section.settings.store_note != blank -%}<p class="qb54-pl-store__note">{{ section.settings.store_note | escape }}</p>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- render 'qb54-pl-slot', position: 'after_store', blocks: section.blocks, section_id: section.id, sets: product_blocks, keep: keep, code: code, pct: pct, eligible: eligible, free_ship: free_ship, low_stock: low_stock, start_label: start_label, live_label: live_label -%}

  {%- if photo_blocks.size > 0 -%}
    <section class="qb54-pl-where" aria-labelledby="qb54-pl-where-h-{{ section.id }}">
      <div class="qb54-pl-wrap">
        <header class="qb54-pl-head qb54-pl-center" data-qb54-reveal>
          <p class="qb54-pl-eyebrow">{{ section.settings.where_eyebrow | escape }}</p>
          <h2 class="qb54-pl-h2" id="qb54-pl-where-h-{{ section.id }}">{{ section.settings.where_heading }}</h2>
          {%- if section.settings.where_text != blank -%}<p class="qb54-pl-lede">{{ section.settings.where_text | escape }}</p>{%- endif -%}
        </header>
        <div class="qb54-pl-mosaic">
          {%- for block in photo_blocks -%}
            <figure class="qb54-pl-tile" data-qb54-reveal {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- if forloop.first -%}
                  {{- block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: block.settings.label -}}
                {%- else -%}
                  {{- block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.label -}}
                {%- endif -%}
              {%- endif -%}
              <figcaption><strong>{{ block.settings.label | escape }}</strong>{%- if block.settings.caption != blank -%}<span>{{ block.settings.caption | escape }}</span>{%- endif -%}</figcaption>
            </figure>
          {%- endfor -%}
        </div>
        <div class="qb54-pl-feats">
          <div class="qb54-pl-feat" data-qb54-reveal><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3v9h12V3M4 12h16v3H4zM6 15l-2 6M18 15l2 6M8 15v6M16 15v6"/></svg></i><div><strong>{{ section.settings.feat_1_t | escape }}</strong><span>{{ section.settings.feat_1_s | escape }}</span></div></div>
          <div class="qb54-pl-feat" data-qb54-reveal><i>{{ i_clock }}</i><div><strong>{{ section.settings.feat_2_t | escape }}</strong><span>{{ section.settings.feat_2_s | escape }}</span></div></div>
          <div class="qb54-pl-feat" data-qb54-reveal><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.3a3.5 3.5 0 0 1 0 7.4M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/></svg></i><div><strong>{{ section.settings.feat_3_t | escape }}</strong><span>{{ section.settings.feat_3_s | escape }}</span></div></div>
          <div class="qb54-pl-feat" data-qb54-reveal><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8zM9 8V6a3 3 0 0 1 6 0v2"/></svg></i><div><strong>{{ section.settings.feat_4_t | escape }}</strong><span>{{ section.settings.feat_4_s | escape }}</span></div></div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- render 'qb54-pl-slot', position: 'after_where', blocks: section.blocks, section_id: section.id, sets: product_blocks, keep: keep, code: code, pct: pct, eligible: eligible, free_ship: free_ship, low_stock: low_stock, start_label: start_label, live_label: live_label -%}

  {%- if step_blocks.size > 0 -%}
    <section class="qb54-pl-steps" data-qb54-when="before live" aria-labelledby="qb54-pl-steps-h-{{ section.id }}">
      <div class="qb54-pl-wrap">
        <div class="qb54-pl-center" data-qb54-reveal>
          <p class="qb54-pl-eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
          <h2 class="qb54-pl-h2" id="qb54-pl-steps-h-{{ section.id }}">{{ section.settings.steps_heading | escape }}</h2>
        </div>
        <ol class="qb54-pl-steps__list">
          {%- for block in step_blocks -%}
            {%- assign step_text = block.settings.text | escape -%}
            {%- if code != blank -%}
              {%- assign marked = '<mark>' | append: code | append: '</mark>' -%}
              {%- assign step_text = step_text | replace: code, marked -%}
            {%- endif -%}
            <li class="qb54-pl-step" data-qb54-reveal {{ block.shopify_attributes }}>
              <span class="qb54-pl-step__n" aria-hidden="true">0{{ forloop.index }}</span>
              <span class="qb54-pl-step__i" aria-hidden="true">{{ forloop.index }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ step_text }}</p>
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.auto_apply_code -%}<p class="qb54-pl-steps__note" data-qb54-when="live">{{ section.settings.auto_apply_note | escape }}</p>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if review_blocks.size > 0 -%}
    <section class="qb54-pl-reviews qb54-pl-light" aria-labelledby="qb54-pl-rev-h-{{ section.id }}">
      <div class="qb54-pl-wrap">
        <header class="qb54-pl-head qb54-pl-center" data-qb54-reveal>
          <p class="qb54-pl-eyebrow">{{ section.settings.reviews_eyebrow | escape }}</p>
          <h2 class="qb54-pl-h2" id="qb54-pl-rev-h-{{ section.id }}">{{ section.settings.reviews_heading }}</h2>
          <p class="qb54-pl-score">{{ stars_5 }}
            {%- if lead_rating != blank and lead_count != blank -%}<span><b>{{ lead_rating }}</b> average · {{ lead_count }} reviews</span>
            {%- else -%}<span>{{ section.settings.rating_fallback | escape }}</span>{%- endif -%}
          </p>
        </header>
        <div class="qb54-pl-revrail" data-qb54-rail tabindex="0" aria-label="Customer reviews">
          {%- for block in review_blocks -%}
            <figure class="qb54-pl-review" {{ block.shopify_attributes }}>
              {{ stars_5 }}
              {%- if block.settings.tag != blank -%}<span class="qb54-pl-review__tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
              <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
              <footer>
                <span class="qb54-pl-av" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
                <span><cite>{{ block.settings.name | escape }}</cite><span class="qb54-pl-verified">{{ i_check }}Verified Buyer</span></span>
              </footer>
            </figure>
          {%- endfor -%}
        </div>
        <div class="qb54-pl-dots" data-qb54-dots></div>
      </div>
    </section>
  {%- endif -%}

  {%- if faq_blocks.size > 0 -%}
    <section class="qb54-pl-faq qb54-pl-light" aria-labelledby="qb54-pl-faq-h-{{ section.id }}">
      <div class="qb54-pl-wrap qb54-pl-faq__grid">
        <div class="qb54-pl-faq__aside" data-qb54-reveal>
          <p class="qb54-pl-eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
          <h2 class="qb54-pl-h2" id="qb54-pl-faq-h-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2>
          {%- if section.settings.faq_text != blank -%}<p class="qb54-pl-lede">{{ section.settings.faq_text | escape }}</p>{%- endif -%}
        </div>
        <div>
          {%- for block in faq_blocks -%}
            <details class="qb54-pl-qa"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}<span class="qb54-pl-plus" aria-hidden="true"></span></summary>
              <div class="qb54-pl-qa__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="qb54-pl-close" data-qb54-close aria-labelledby="qb54-pl-close-h-{{ section.id }}">
    <div class="qb54-pl-wrap qb54-pl-center">
      <div data-qb54-when="before live">
        <p class="qb54-pl-eyebrow">{{ section.settings.close_eyebrow | escape }}</p>
        <p class="qb54-pl-close__big" aria-hidden="true">{{ pct }}% Off</p>
        <h2 class="qb54-pl-h2" id="qb54-pl-close-h-{{ section.id }}">{{ section.settings.close_heading | escape }}</h2>
        {%- if section.settings.close_text != blank -%}<p class="qb54-pl-lede">{{ section.settings.close_text | escape }}</p>{%- endif -%}
        <p class="qb54-pl-close__l">{{ live_label }}</p>
        <div class="qb54-pl-cd" data-qb54-cd role="timer" aria-label="Time remaining">{{ cd_units }}</div>
        <ul class="qb54-pl-chips">
          {%- if code != blank -%}<li>{{ i_tag }}Code {{ code }}</li>{%- endif -%}
          <li>{{ i_truck }}{{ section.settings.shipping_note | escape }}</li>
          <li>{{ i_shield }}{{ section.settings.returns_note | escape }}</li>
        </ul>
        <a class="qb54-pl-btn qb54-pl-btn--white" href="#qb54-pl-deals-{{ section.id }}">{{ section.settings.close_cta | escape }}{{ i_arrow }}</a>
      </div>
      <div data-qb54-when="after" hidden>
        <h2 class="qb54-pl-h2">{{ section.settings.after_heading | escape }}</h2>
        <p class="qb54-pl-lede">{{ section.settings.after_text | escape }}</p>
        <a class="qb54-pl-btn qb54-pl-btn--white" href="{{ section.settings.after_url | default: shop_url }}">{{ section.settings.after_cta | escape }}{{ i_arrow }}</a>
      </div>
    </div>
  </section>

  {%- if section.settings.show_sticky_bar -%}
    <div class="qb54-pl-sticky" data-qb54-sticky data-qb54-when="before live" aria-hidden="true">
      <div class="qb54-pl-sticky__t">
        <strong>{{ pct }}% off · {{ code }}</strong>
        <span>{{ live_label }} <span data-qb54-cd-compact>0d 00:00:00</span></span>
      </div>
      <a class="qb54-pl-btn qb54-pl-btn--gold" href="#qb54-pl-deals-{{ section.id }}" tabindex="-1" data-qb54-sticky-shop>{{ section.settings.sticky_cta | escape }}</a>
      <a class="qb54-pl-btn qb54-pl-btn--gold" href="{{ checkout_url }}" tabindex="-1" data-qb54-checkout data-qb54-sticky-checkout hidden>Checkout <span data-qb54-cart-count>0</span></a>
    </div>
  {%- endif -%}

  <div class="qb54-pl-toast" data-qb54-toast role="status" aria-live="polite" hidden>
    <span class="qb54-pl-toast__ok" aria-hidden="true">{{ i_check }}</span>
    <div class="qb54-pl-toast__t"><strong>Added to cart</strong><span data-qb54-toast-meta></span></div>
    {%- if free_ship > 0 -%}
      <div class="qb54-pl-meter" data-qb54-meter data-qb54-toast-meter>
        <span class="qb54-pl-meter__bar"><i data-qb54-meter-fill></i></span>
        <span class="qb54-pl-meter__t" data-qb54-meter-text></span>
      </div>
    {%- endif -%}
    <div class="qb54-pl-toast__a">
      <a class="qb54-pl-btn qb54-pl-btn--gold" href="{{ checkout_url }}" data-qb54-checkout>Checkout</a>
      <a class="qb54-pl-toast__cart" href="{{ routes.cart_url }}">View cart</a>
    </div>
    <button type="button" class="qb54-pl-toast__x" data-qb54-toast-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
</div>

<script>
  (function () {
    var id = '{{ section.id }}';
    var root = document.getElementById('qb54-pl-' + id);
    if (!root) return;
    window.__qb54Pl = window.__qb54Pl || {};
    if (window.__qb54Pl[id]) window.__qb54Pl[id].destroy();

    var cleanups = [];
    var shopRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var start = Date.parse(root.getAttribute('data-start'));
    var end = Date.parse(root.getAttribute('data-end'));
    var code = root.getAttribute('data-code');
    var state = null;
    var moneyFormat = {{ shop.money_format | json }};
    var freeShip = {{ free_ship | default: 0 }};
    var bundleRefreshers = [];
    root.classList.add('qb54-pl--js');

    function $all(sel, ctx) { return Array.prototype.slice.call((ctx || root).querySelectorAll(sel)); }

    /* ---- Switchers: stage tabs and hero swatches toggle their panels ---- */
    function select(container, index, focus) {
      $all('[data-qb54-switch-to]', container).forEach(function (btn) {
        var on = btn.getAttribute('data-qb54-switch-to') === String(index);
        if (btn.getAttribute('role') === 'tab') {
          btn.setAttribute('aria-selected', on ? 'true' : 'false');
          btn.tabIndex = on ? 0 : -1;
        } else {
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
      });
      $all('[data-qb54-panel]', container).forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-qb54-panel') !== String(index);
      });
      if (focus) {
        var match = $all('[data-qb54-switch-to="' + index + '"]', container).filter(function (b) { return b.offsetParent !== null; })[0];
        if (match) match.focus();
      }
    }
    $all('[data-qb54-switch]').forEach(function (container) {
      container.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-qb54-switch-to]');
        if (!btn || !container.contains(btn)) return;
        // Hero swatches live inside the panels they switch, so focus moves to the twin in the new panel.
        select(container, btn.getAttribute('data-qb54-switch-to'), btn.classList.contains('qb54-pl-sw'));
      });
      container.addEventListener('keydown', function (event) {
        var tab = event.target.closest('.qb54-pl-tab');
        if (!tab || (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft')) return;
        var tabs = $all('.qb54-pl-tab', container);
        var i = tabs.indexOf(tab) + (event.key === 'ArrowRight' ? 1 : -1);
        if (i < 0) i = tabs.length - 1;
        if (i >= tabs.length) i = 0;
        select(container, tabs[i].getAttribute('data-qb54-switch-to'), true);
        event.preventDefault();
      });
    });

    /* ---- Gallery thumbs ---- */
    root.addEventListener('click', function (event) {
      var thumb = event.target.closest('[data-qb54-thumb]');
      if (!thumb) return;
      var gallery = thumb.closest('[data-qb54-gallery]');
      var main = gallery && gallery.querySelector('.qb54-pl-gallery__main img');
      if (main) { main.removeAttribute('srcset'); main.src = thumb.getAttribute('data-qb54-thumb'); }
      $all('[data-qb54-thumb]', gallery).forEach(function (t) { t.setAttribute('aria-pressed', t === thumb ? 'true' : 'false'); });
    });

    /* ---- Sale state + countdown (one shared clock) ---- */
    var checkoutLinks = $all('[data-qb54-checkout]');
    function stateAt(now) {
      if (!isNaN(start) && now < start) return 'before';
      if (!isNaN(end) && now >= end) return 'after';
      return 'live';
    }
    function applyState(next, silent) {
      if (!next) return;
      root.setAttribute('data-state', next);
      $all('[data-qb54-when]').forEach(function (el) {
        var when = ' ' + el.getAttribute('data-qb54-when') + ' ';
        el.hidden = when.indexOf(' ' + next + ' ') === -1;
      });
      var href = shopRoot + 'checkout' + (next === 'live' && code ? '?discount=' + encodeURIComponent(code) : '');
      checkoutLinks.forEach(function (a) { a.setAttribute('href', href); });
      if (!silent) {
        if (next === 'live') maybeApplyCode();
        bundleRefreshers.forEach(function (fn) { fn(); });
        updateSticky();
      }
    }
    function pad(n) { return n < 10 ? '0' + n : String(n); }
    function setNum(el, value) {
      if (el.textContent === value) return;
      el.textContent = value;
      if (!reduce) { el.classList.remove('is-tick'); void el.offsetWidth; el.classList.add('is-tick'); }
    }
    var groups = $all('[data-qb54-cd]');
    var compacts = $all('[data-qb54-cd-compact]');
    function tick() {
      var now = Date.now();
      var next = stateAt(now);
      if (next !== state) { state = next; applyState(next); }
      if (state === 'after') return;
      var diff = Math.max(0, (state === 'before' ? start : end) - now);
      var d = Math.floor(diff / 86400000), h = Math.floor(diff % 86400000 / 3600000), m = Math.floor(diff % 3600000 / 60000), s = Math.floor(diff % 60000 / 1000);
      var parts = { d: pad(d), h: pad(h), m: pad(m), s: pad(s) };
      groups.forEach(function (g) { $all('[data-u]', g).forEach(function (n) { setNum(n, parts[n.getAttribute('data-u')]); }); });
      var compact = d + 'd ' + pad(h) + ':' + pad(m) + ':' + pad(s);
      compacts.forEach(function (c) { c.textContent = compact; });
    }
    var applied = false;
    function maybeApplyCode() {
      if (applied || !code || root.getAttribute('data-auto-apply') !== 'true') return;
      if (window.Shopify && window.Shopify.designMode) return;
      applied = true;
      var key = 'qb54_pl_code_' + code;
      try { if (sessionStorage.getItem(key)) return; } catch (e) {}
      fetch(shopRoot + 'discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(shopRoot + 'cart.js'), { credentials: 'same-origin' })
        .then(function () { try { sessionStorage.setItem(key, '1'); } catch (e) {} })
        .catch(function () {});
    }

    /* ---- Copy code ---- */
    function onCopy(event) {
      var btn = event.target.closest('[data-qb54-copy]');
      if (!btn) return;
      var value = btn.getAttribute('data-qb54-copy');
      var label = btn.querySelector('[data-qb54-copy-label]');
      var done = function () { if (label) { label.textContent = 'Copied!'; setTimeout(function () { label.textContent = 'Copy'; }, 1800); } };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(value).then(done, done);
      else {
        var ta = document.createElement('textarea');
        ta.value = value; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta); done();
      }
    }

    /* ---- Cart: count, toast, checkout path (no header or drawer on these pages) ---- */
    var countEls = $all('[data-qb54-cart-count]');
    var stickyShop = root.querySelector('[data-qb54-sticky-shop]');
    var stickyCheckout = root.querySelector('[data-qb54-sticky-checkout]');
    var toast = root.querySelector('[data-qb54-toast]');
    var toastMeta = root.querySelector('[data-qb54-toast-meta]');
    var toastTimer = 0;
    function updateCartUi(cart, bump) {
      var count = (cart && cart.item_count) || 0;
      countEls.forEach(function (el) {
        el.textContent = count;
        if (el.classList.contains('qb54-pl-cart__n')) {
          el.hidden = count === 0;
          if (bump && !reduce) { el.classList.remove('is-bump'); void el.offsetWidth; el.classList.add('is-bump'); }
        }
      });
      if (stickyShop && stickyCheckout) { stickyCheckout.hidden = count === 0; stickyShop.hidden = count > 0; }
    }
    function hideToast() { clearTimeout(toastTimer); if (toast) toast.hidden = true; }
    function showToast(title, cart) {
      if (!toast) return;
      var count = (cart && cart.item_count) || 0;
      if (toastMeta) toastMeta.textContent = (title ? title + ' · ' : '') + count + (count === 1 ? ' item' : ' items') + ' in your cart';
      var toastMeter = toast.querySelector('[data-qb54-toast-meter]');
      if (toastMeter) setMeter(toastMeter, (cart && cart.total_price) || 0, 'Your order');
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(hideToast, 9000);
    }
    cleanups.push(function () { clearTimeout(toastTimer); });
    fetch(shopRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); }).then(function (cart) { updateCartUi(cart, false); }).catch(function () {});

    var cartIconHtml = '';
    var anyIcon = root.querySelector('[data-qb54-add] [data-qb54-btn-icon]');
    if (anyIcon) cartIconHtml = anyIcon.innerHTML;
    function setButton(btn, mode, message) {
      var label = btn.querySelector('[data-qb54-btn-label]');
      var icon = btn.querySelector('[data-qb54-btn-icon]');
      var err = btn.parentNode.querySelector('[data-qb54-err]');
      btn.classList.remove('is-added', 'is-error');
      btn.removeAttribute('aria-busy');
      if (err) { err.hidden = true; err.textContent = ''; }
      if (mode === 'loading') {
        btn.setAttribute('aria-busy', 'true');
        if (icon) icon.innerHTML = '<span class="qb54-pl-spin"></span>';
        if (label) label.textContent = 'Adding…';
      } else if (mode === 'added') {
        btn.classList.add('is-added');
        if (icon) icon.innerHTML = '{{ i_check | strip_newlines }}';
        if (label) label.textContent = 'Added';
        setTimeout(function () { setButton(btn, 'idle'); }, 2200);
      } else if (mode === 'error') {
        btn.classList.add('is-error');
        if (label) label.textContent = 'Try Again';
        if (icon) icon.innerHTML = cartIconHtml;
        if (err && message) { err.textContent = message; err.hidden = false; }
      } else {
        if (label) label.textContent = btn.getAttribute('data-qb54-label') || 'Add to Cart';
        if (icon) icon.innerHTML = cartIconHtml;
      }
    }
    function formatMoney(cents) {
      var value = (cents / 100).toFixed(2);
      var withCommas = value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return String(moneyFormat || '${{ "{{" }}amount}}').replace(/\{\{\s*(\w+)\s*\}\}/, function (m, kind) {
        if (kind === 'amount_no_decimals') return Math.round(cents / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        if (kind === 'amount_with_comma_separator') return value.replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        return withCommas;
      });
    }
    // Free-shipping progress for a total in cents.
    function setMeter(meter, total, subject) {
      if (!meter || !freeShip) return;
      var fill = meter.querySelector('[data-qb54-meter-fill]');
      var text = meter.querySelector('[data-qb54-meter-text]');
      var left = freeShip - total;
      var goal = formatMoney(freeShip).replace(/[.,]00(?=\D*$)/, '');
      meter.classList.toggle('is-done', left <= 0);
      if (fill) fill.style.width = Math.min(100, Math.round(total / freeShip * 100)) + '%';
      if (!text) return;
      text.textContent = '';
      var strong = document.createElement('strong');
      if (left <= 0) {
        strong.textContent = 'Free shipping unlocked.';
        text.appendChild(strong);
        text.appendChild(document.createTextNode(' ' + subject + ' is ' + goal + ' or more.'));
      } else {
        text.appendChild(document.createTextNode('Add '));
        strong.textContent = formatMoney(left);
        text.appendChild(strong);
        text.appendChild(document.createTextNode(' more for free shipping (' + goal + '+).'));
      }
    }

    function onAdd(event) {
      var btn = event.target.closest('[data-qb54-add]');
      if (!btn) return;
      event.preventDefault();
      var variantId = btn.getAttribute('data-variant-id');
      if (!variantId) return;
      submitAdd(btn, [{ id: Number(variantId), quantity: 1 }], btn.getAttribute('data-qb54-title'));
    }
    function submitAdd(btn, items, title) {
      if (btn.getAttribute('aria-busy') === 'true' || !items.length) return;
      var variantId = String(items[0].id);
      setButton(btn, 'loading');
      var bundled = [];
      document.documentElement.dispatchEvent(new CustomEvent('cart:bundled-sections', { bubbles: true, detail: { sections: bundled } }));
      var body = { items: items };
      if (bundled.length) { body.sections = bundled.join(','); body.sections_url = window.location.pathname; }
      fetch(shopRoot + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(body)
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, json: j }; }); })
        .then(function (res) {
          if (!res.ok || res.json.status) throw res.json;
          if (window.theme && theme.settings && theme.settings.cartType === 'page') { window.location.href = shopRoot + 'cart'; return; }
          var drawer = document.querySelector('cart-drawer');
          var hasDrawer = !!(drawer && typeof drawer.show === 'function');
          if (hasDrawer) drawer.show(btn);
          return fetch(shopRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (cart) {
              cart.sections = res.json.sections;
              if (window.theme && theme.pubsub && theme.pubsub.publish) theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, { source: 'qb54-promo', productVariantId: variantId, cart: cart });
              updateCartUi(cart, true);
              if (!hasDrawer) showToast(title, cart);
              setButton(btn, 'added');
            });
        })
        .catch(function (error) {
          var message = error && (error.description || error.message);
          setButton(btn, 'error', typeof message === 'string' ? message : 'Something went wrong. Please try again.');
        });
    }
    function onClick(event) {
      if (event.target.closest('[data-qb54-toast-close]')) { hideToast(); return; }
      onCopy(event);
      onAdd(event);
    }
    root.addEventListener('click', onClick);
    cleanups.push(function () { root.removeEventListener('click', onClick); });

    /* ---- Bundles: pick a set, tick extras, live total + free-shipping meter, add all in one request ---- */
    $all('[data-qb54-bundle]').forEach(function (bundle) {
      var totalEl = bundle.querySelector('[data-qb54-bundle-total]');
      var wasEl = bundle.querySelector('[data-qb54-bundle-was]');
      var meterEl = bundle.querySelector('[data-qb54-meter]');
      var addBtn = bundle.querySelector('[data-qb54-bundle-add]');
      var heroImg = bundle.querySelector('.qb54-pl-bundle__hero img');
      function priceOf(input) { return parseInt(input.getAttribute(state === 'after' ? 'data-reg' : 'data-price'), 10) || 0; }
      function chosen() {
        var set = bundle.querySelector('input[type="radio"]:checked');
        return (set ? [set] : []).concat($all('input[type="checkbox"]:checked', bundle));
      }
      function refresh() {
        var items = chosen();
        var total = 0, regular = 0;
        items.forEach(function (input) { total += priceOf(input); regular += parseInt(input.getAttribute('data-reg'), 10) || 0; });
        if (totalEl) totalEl.textContent = formatMoney(total);
        if (wasEl) { wasEl.hidden = regular <= total; wasEl.textContent = formatMoney(regular); }
        setMeter(meterEl, total, 'This bundle');
        $all('label', bundle).forEach(function (label) {
          var input = label.querySelector('input');
          if (input) label.classList.toggle('is-on', input.checked);
        });
        $all('input[type="checkbox"]', bundle).forEach(function (box) {
          var thumb = bundle.querySelector('[data-qb54-bundle-thumb="' + box.getAttribute('data-qb54-bundle-i') + '"]');
          if (thumb) thumb.classList.toggle('is-off', !box.checked);
        });
        var set = bundle.querySelector('input[type="radio"]:checked');
        if (heroImg && set && heroImg.getAttribute('data-src-now') !== set.getAttribute('data-img')) {
          heroImg.removeAttribute('srcset');
          heroImg.src = set.getAttribute('data-img');
          heroImg.setAttribute('data-src-now', set.getAttribute('data-img'));
        }
        if (addBtn) {
          var label = 'Add ' + items.length + (items.length === 1 ? ' item' : ' items') + ' to cart';
          addBtn.setAttribute('data-qb54-label', label);
          if (addBtn.getAttribute('aria-busy') !== 'true' && !addBtn.classList.contains('is-added')) {
            var labelEl = addBtn.querySelector('[data-qb54-btn-label]');
            if (labelEl) labelEl.textContent = label;
          }
        }
      }
      bundle.addEventListener('change', refresh);
      if (addBtn) addBtn.addEventListener('click', function () {
        var items = chosen();
        var set = bundle.querySelector('input[type="radio"]:checked');
        var title = (set ? set.getAttribute('data-title') : 'Bundle') + (items.length > 1 ? ' + ' + (items.length - 1) + ' more' : '');
        submitAdd(addBtn, items.map(function (input) { return { id: Number(input.value), quantity: 1 }; }), title);
      });
      bundleRefreshers.push(refresh);
      refresh();
    });

    /* ---- Team gear store: category chips, team picker (?team=chiefs), show more ---- */
    var store = root.querySelector('[data-qb54-store]');
    if (store) {
      var grid = store.querySelector('[data-qb54-grid]');
      var storeCards = $all('[data-qb54-card]', store);
      var catChips = $all('[data-qb54-cat]', store);
      var teamSelect = store.querySelector('[data-qb54-team]');
      var moreBtn = store.querySelector('[data-qb54-more]');
      var countEl = store.querySelector('[data-qb54-count]');
      var emptyEl = store.querySelector('[data-qb54-empty]');
      var viewAll = store.querySelector('[data-qb54-viewall]');
      var pageSize = parseInt(store.getAttribute('data-initial'), 10) || 12;
      var cat = 'all';
      var team = '';
      var limit = pageSize;
      var teamKey = 'qb54_pl_team';

      // Only offer teams that have gear.
      var teamCounts = {};
      storeCards.forEach(function (c) { var t = c.getAttribute('data-team'); if (t) teamCounts[t] = (teamCounts[t] || 0) + 1; });
      if (teamSelect) $all('option', teamSelect).forEach(function (o) { if (o.value && !teamCounts[o.value]) o.parentNode.removeChild(o); });

      function num(c, attr) { return parseInt(c.getAttribute(attr), 10) || 0; }
      function chipFor(value) { return catChips.filter(function (b) { return b.getAttribute('data-qb54-cat') === value; })[0]; }
      function teamName() { return teamSelect && teamSelect.selectedIndex > 0 ? teamSelect.options[teamSelect.selectedIndex].text : ''; }

      function renderStore(focusFrom) {
        var list = storeCards.filter(function (c) {
          if (cat !== 'all' && c.getAttribute('data-cat') !== cat) return false;
          var t = c.getAttribute('data-team');
          return !team || !t || t === team;
        });
        // All gear + all teams: round-robin across categories so the first rows show a mix.
        list.sort(function (a, b) {
          if (team) {
            var na = a.getAttribute('data-team') ? 0 : 1, nb = b.getAttribute('data-team') ? 0 : 1;
            if (na !== nb) return na - nb;
          }
          if (cat === 'all' && !team) return (num(a, 'data-rank') - num(b, 'data-rank')) || (num(a, 'data-cat') - num(b, 'data-cat'));
          return (num(a, 'data-cat') - num(b, 'data-cat')) || (num(a, 'data-rank') - num(b, 'data-rank'));
        });
        storeCards.forEach(function (c) { c.hidden = true; });
        list.forEach(function (c, i) { grid.appendChild(c); c.hidden = i >= limit; });

        var shown = Math.min(limit, list.length);
        var chip = cat === 'all' ? null : chipFor(cat);
        var label = chip ? chip.getAttribute('data-label') : '';
        if (emptyEl) {
          emptyEl.hidden = list.length > 0;
          if (!list.length) {
            emptyEl.textContent = 'No ' + label + ' for the ' + teamName() + ' yet. ';
            if (chip) {
              var a = document.createElement('a');
              a.href = chip.getAttribute('data-url');
              a.textContent = 'Browse all ' + label;
              emptyEl.appendChild(a);
            }
          }
        }
        if (countEl) {
          var teamItems = list.filter(function (c) { return c.getAttribute('data-team'); }).length;
          var items = function (n) { return n + (n === 1 ? ' item' : ' items'); };
          var text = '';
          if (team && teamItems) text = items(teamItems) + ' for ' + teamName() + ' fans' + (teamItems < list.length ? ', plus gear for any fan' : '');
          else if (list.length) text = 'Showing ' + shown + ' of ' + items(list.length);
          countEl.textContent = text;
        }
        if (moreBtn) {
          moreBtn.hidden = shown >= list.length;
          moreBtn.textContent = 'Show more (' + (list.length - shown) + ')';
        }
        if (viewAll) {
          viewAll.hidden = !chip;
          if (chip) { viewAll.href = chip.getAttribute('data-url'); viewAll.textContent = 'View all ' + label; }
        }
        if (typeof focusFrom === 'number' && list[focusFrom]) {
          var link = list[focusFrom].querySelector('.qb54-pl-card__t a');
          if (link) link.focus();
        }
      }

      catChips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          cat = chip.getAttribute('data-qb54-cat');
          limit = pageSize;
          catChips.forEach(function (b) { b.setAttribute('aria-pressed', b === chip ? 'true' : 'false'); });
          renderStore();
        });
      });
      if (teamSelect) {
        teamSelect.addEventListener('change', function () {
          team = teamSelect.value;
          limit = pageSize;
          try { if (team) localStorage.setItem(teamKey, team); else localStorage.removeItem(teamKey); } catch (e) {}
          renderStore();
        });
        var preset = '';
        var match = /[?&]team=([^&#]+)/.exec(window.location.search);
        if (match) preset = decodeURIComponent(match[1]).toLowerCase();
        if (preset && teamCounts[preset]) { try { localStorage.setItem(teamKey, preset); } catch (e) {} }
        else { try { preset = localStorage.getItem(teamKey) || ''; } catch (e) {} }
        if (preset && teamCounts[preset]) { teamSelect.value = preset; team = preset; }
      }
      if (moreBtn) moreBtn.addEventListener('click', function () {
        var from = limit;
        limit += pageSize;
        renderStore(from);
      });
      renderStore();
    }

    /* ---- Viral reels: lazy load, one plays at a time (first in view, or hovered), tap for sound ---- */
    var reels = $all('[data-qb54-reel]');
    var reelRatios = [];
    var activeReel = null;
    function loadReel(fig) {
      var video = fig.querySelector('video');
      if (!video || video.getAttribute('src') || !video.getAttribute('data-src')) return video;
      video.setAttribute('src', video.getAttribute('data-src'));
      video.preload = 'metadata';
      return video;
    }
    function playReel(fig) {
      var video = loadReel(fig);
      if (!video) return;
      var p = video.play();
      if (p && p.then) p.then(function () { fig.classList.add('is-playing'); }).catch(function () {});
      else fig.classList.add('is-playing');
    }
    function pauseReel(fig) {
      var video = fig.querySelector('video');
      if (video && !video.paused) video.pause();
      fig.classList.remove('is-playing');
    }
    function activateReel(fig) {
      if (fig === activeReel) return;
      if (activeReel) pauseReel(activeReel);
      activeReel = fig;
      if (fig) playReel(fig);
    }
    if (reels.length && 'IntersectionObserver' in window) {
      var reelIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { reelRatios[reels.indexOf(e.target)] = e.isIntersecting ? e.intersectionRatio : 0; });
        if (reduce) return;
        if (activeReel && (reelRatios[reels.indexOf(activeReel)] || 0) >= 0.6) return;
        var next = null;
        reels.forEach(function (r, i) { if (!next && (reelRatios[i] || 0) >= 0.6) next = r; });
        activateReel(next);
      }, { threshold: [0, 0.6, 1] });
      reels.forEach(function (r) { reelIo.observe(r); });
      cleanups.push(function () { reelIo.disconnect(); });
    }
    reels.forEach(function (fig) {
      fig.addEventListener('mouseenter', function () { if (!reduce) activateReel(fig); });
      fig.addEventListener('click', function (event) {
        var video = loadReel(fig);
        if (!video) return;
        var soundBtn = event.target.closest('[data-qb54-reel-sound]');
        if (video.paused) {
          if (activeReel === fig) activeReel = null;
          activateReel(fig);
          if (!soundBtn) return;
        }
        var unmute = video.muted;
        reels.forEach(function (other) {
          var ov = other.querySelector('video');
          if (ov) ov.muted = true;
          other.classList.remove('is-unmuted');
          var b = other.querySelector('[data-qb54-reel-sound]');
          if (b) b.setAttribute('aria-label', 'Turn sound on');
        });
        video.muted = !unmute;
        fig.classList.toggle('is-unmuted', unmute);
        var sb = fig.querySelector('[data-qb54-reel-sound]');
        if (sb) sb.setAttribute('aria-label', unmute ? 'Turn sound off' : 'Turn sound on');
      });
    });

    /* ---- Sticky bar ---- */
    var sticky = root.querySelector('[data-qb54-sticky]');
    var hero = root.querySelector('[data-qb54-hero]');
    var closing = root.querySelector('[data-qb54-close]');
    var heroVisible = true, closeVisible = false;
    function drawerOpen() { return !!document.querySelector('cart-drawer[open], .drawer[open]'); }
    function updateSticky() {
      if (!sticky) return;
      var show = state !== 'after' && !heroVisible && !closeVisible && !drawerOpen();
      sticky.classList.toggle('is-visible', show);
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
      $all('a', sticky).forEach(function (a) { a.tabIndex = show ? 0 : -1; });
      document.body.classList.toggle('qb54-pl-bar-on', show);
    }
    if (sticky && 'IntersectionObserver' in window) {
      var stickyIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.target === hero) heroVisible = e.isIntersecting; if (e.target === closing) closeVisible = e.isIntersecting; });
        updateSticky();
      });
      if (hero) stickyIo.observe(hero);
      if (closing) stickyIo.observe(closing);
      cleanups.push(function () { stickyIo.disconnect(); });
    }
    cleanups.push(function () { document.body.classList.remove('qb54-pl-bar-on'); });

    /* ---- Reveal ---- */
    var reveals = $all('[data-qb54-reveal]');
    if (!reduce && 'IntersectionObserver' in window) {
      var revealIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); revealIo.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      reveals.forEach(function (el) { revealIo.observe(el); });
      cleanups.push(function () { revealIo.disconnect(); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-in'); });
    }

    /* ---- Review rail dots ---- */
    var rail = root.querySelector('[data-qb54-rail]');
    var dotsWrap = root.querySelector('[data-qb54-dots]');
    if (rail && dotsWrap && 'IntersectionObserver' in window) {
      var cards = Array.prototype.slice.call(rail.children);
      var dots = cards.map(function (card, index) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', 'Show review ' + (index + 1));
        dot.addEventListener('click', function () { rail.scrollTo({ left: card.offsetLeft - rail.offsetLeft - parseFloat(getComputedStyle(rail).paddingLeft), behavior: reduce ? 'auto' : 'smooth' }); });
        dotsWrap.appendChild(dot);
        return dot;
      });
      var railIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && e.intersectionRatio > 0.6) {
            var idx = cards.indexOf(e.target);
            dots.forEach(function (d, i) { d.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
          }
        });
      }, { root: rail, threshold: [0.6] });
      cards.forEach(function (c) { railIo.observe(c); });
      if (dots[0]) dots[0].setAttribute('aria-current', 'true');
      cleanups.push(function () { railIo.disconnect(); });
    }

    tick();
    var interval = setInterval(tick, 1000);
    cleanups.push(function () { clearInterval(interval); });

    function onUnload(event) { if (event.detail && event.detail.sectionId === id) destroy(); }
    document.addEventListener('shopify:section:unload', onUnload);
    cleanups.push(function () { document.removeEventListener('shopify:section:unload', onUnload); });
    function destroy() {
      reels.forEach(pauseReel);
      while (cleanups.length) { try { cleanups.pop()(); } catch (e) {} }
      delete window.__qb54Pl[id];
    }
    window.__qb54Pl[id] = { destroy: destroy };
  })();
</script>

