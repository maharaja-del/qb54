{%- comment -%}
  Custom Logo Showcase
  --------------------
  A jaw-dropping, self-contained showcase: a square image that crossfades through
  the same product wearing different customer logos, alongside a heading,
  description and a call-to-action button that links to your customiser page.

  Everything (CSS + JS + preset) lives in this one file — no theme assets needed.
{%- endcomment -%}

{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', ''
  assign slides = section.blocks | where: 'type', 'slide'
  assign delay = section.settings.autoplay_speed | times: 1000 | round
  assign radius = section.settings.rounded
  assign img_class = 'clsx-' | append: uid | append: '__img'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --clsx-bg: {{ section.settings.color_background }};
    --clsx-bg2: {{ section.settings.color_background_2 }};
    --clsx-text: {{ section.settings.color_text }};
    --clsx-accent: {{ section.settings.color_accent }};
    --clsx-btn-text: {{ section.settings.color_button_text }};
    --clsx-card: {{ section.settings.color_card }};
    --clsx-radius: {{ radius }}px;
    --clsx-pt: {{ section.settings.padding_top }}px;
    --clsx-pb: {{ section.settings.padding_bottom }}px;
  }

  .clsx-{{ uid }} {
    position: relative;
    overflow: hidden;
    padding-block: var(--clsx-pt) var(--clsx-pb);
    background:
      radial-gradient(120% 120% at 85% 0%, color-mix(in srgb, var(--clsx-accent) 10%, transparent) 0%, transparent 55%),
      linear-gradient(160deg, var(--clsx-bg) 0%, var(--clsx-bg2) 100%);
    color: var(--clsx-text);
  }

  /* Ambient floating orbs */
  .clsx-{{ uid }}__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }
  .clsx-{{ uid }}__orb--a {
    width: 42vmax; height: 42vmax;
    top: -18vmax; right: -10vmax;
    background: color-mix(in srgb, var(--clsx-accent) 45%, transparent);
    animation: clsx-drift-{{ uid }} 18s ease-in-out infinite alternate;
  }
  .clsx-{{ uid }}__orb--b {
    width: 30vmax; height: 30vmax;
    bottom: -14vmax; left: -8vmax;
    background: color-mix(in srgb, var(--clsx-accent) 28%, transparent);
    animation: clsx-drift-{{ uid }} 22s ease-in-out infinite alternate-reverse;
  }

  .clsx-{{ uid }}__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  @media (min-width: 990px) {
    .clsx-{{ uid }}__inner { grid-template-columns: 1fr 1fr; }
    .clsx-{{ uid }}--right .clsx-{{ uid }}__stage { order: 2; }
    .clsx-{{ uid }}--right .clsx-{{ uid }}__text  { order: 1; }
    .clsx-{{ uid }}--left  .clsx-{{ uid }}__stage { order: 1; }
    .clsx-{{ uid }}--left  .clsx-{{ uid }}__text  { order: 2; }
  }

  /* ---------------- Text column ---------------- */
  .clsx-{{ uid }}__text { max-width: 34rem; }
  @media (min-width: 990px) {
    .clsx-{{ uid }}--right .clsx-{{ uid }}__text { margin-inline-start: auto; }
  }

  .clsx-{{ uid }}__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0 0 1rem;
    font-size: clamp(0.7rem, 1.4vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clsx-accent);
  }
  .clsx-{{ uid }}__eyebrow::before {
    content: "";
    width: 2rem; height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .clsx-{{ uid }}__heading {
    margin: 0;
    font-size: clamp(2.1rem, 5.2vw, 3.6rem);
    line-height: 1.03;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .clsx-{{ uid }}__heading strong,
  .clsx-{{ uid }}__heading .clsx-hl {
    color: var(--clsx-accent);
    -webkit-text-fill-color: var(--clsx-accent);
    font-weight: inherit;
  }

  .clsx-{{ uid }}__desc {
    margin: 1.15rem 0 0;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    color: color-mix(in srgb, var(--clsx-text) 72%, transparent);
  }
  .clsx-{{ uid }}__desc p { margin: 0 0 0.75em; }
  .clsx-{{ uid }}__desc p:last-child { margin-bottom: 0; }

  .clsx-{{ uid }}__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin-top: 1.9rem;
    padding: 0.95em 1.6em;
    border-radius: 999px;
    background: var(--clsx-accent);
    color: var(--clsx-btn-text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--clsx-accent) 80%, transparent);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }
  .clsx-{{ uid }}__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -10px color-mix(in srgb, var(--clsx-accent) 85%, transparent);
  }
  .clsx-{{ uid }}__cta svg { transition: transform 0.25s ease; }
  .clsx-{{ uid }}__cta:hover svg { transform: translateX(4px); }
  .clsx-{{ uid }}__cta:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--clsx-accent) 55%, transparent);
    outline-offset: 3px;
  }

  /* ---------------- Image stage ---------------- */
  .clsx-{{ uid }}__stage {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }
  .clsx-{{ uid }}--right .clsx-{{ uid }}__stage { margin-inline: auto; }
  @media (min-width: 990px) {
    .clsx-{{ uid }}--right .clsx-{{ uid }}__stage { margin-inline-end: 0; }
    .clsx-{{ uid }}--left  .clsx-{{ uid }}__stage { margin-inline-start: 0; }
  }

  /* Glow halo behind the card */
  .clsx-{{ uid }}__stage::before {
    content: "";
    position: absolute;
    inset: 8% 8% -6%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--clsx-accent) 40%, transparent);
    filter: blur(46px);
    opacity: 0.55;
    z-index: 0;
  }

  .clsx-{{ uid }}__card {
    position: relative;
    z-index: 1;
    border-radius: var(--clsx-radius);
    background: var(--clsx-card);
    padding: clamp(0.6rem, 1.5vw, 0.9rem);
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.06),
      0 30px 60px -25px rgb(0 0 0 / 0.35);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .clsx-{{ uid }}__media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: calc(var(--clsx-radius) - 6px);
    overflow: hidden;
    background: color-mix(in srgb, var(--clsx-text) 6%, var(--clsx-card));
  }

  .clsx-{{ uid }}__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    z-index: 0;
  }
  .clsx-{{ uid }}__slide.is-active { opacity: 1; z-index: 1; }

  .clsx-{{ uid }}__img,
  .clsx-{{ uid }}__slide svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform 6.5s ease-out;
  }
  .clsx-{{ uid }}__slide.is-active .clsx-{{ uid }}__img,
  .clsx-{{ uid }}__slide.is-active svg { transform: scale(1.07); }

  /* Brand badge */
  .clsx-{{ uid }}__badge {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    max-width: calc(100% - 1.8rem);
    padding: 0.5em 0.9em;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.5);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .clsx-{{ uid }}__slide.is-active .clsx-{{ uid }}__badge {
    opacity: 1;
    transform: translateY(0);
  }
  .clsx-{{ uid }}__badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--clsx-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--clsx-accent) 35%, transparent);
    flex: none;
  }

  /* Dots */
  .clsx-{{ uid }}__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .clsx-{{ uid }}__dot {
    appearance: none;
    border: none;
    padding: 0;
    width: 9px; height: 9px;
    border-radius: 999px;
    cursor: pointer;
    background: color-mix(in srgb, var(--clsx-text) 25%, transparent);
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .clsx-{{ uid }}__dot[aria-current="true"] {
    width: 26px;
    background: var(--clsx-accent);
  }
  .clsx-{{ uid }}__dot:focus-visible {
    outline: 2px solid var(--clsx-accent);
    outline-offset: 3px;
  }

  /* ---------------- Entrance animation ---------------- */
  .clsx-{{ uid }}__text > *,
  .clsx-{{ uid }}__stage {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .clsx-{{ uid }}.clsx--in .clsx-{{ uid }}__text > *,
  .clsx-{{ uid }}.clsx--in .clsx-{{ uid }}__stage {
    opacity: 1;
    transform: none;
  }
  .clsx-{{ uid }}.clsx--in .clsx-{{ uid }}__text > *:nth-child(1) { transition-delay: 0.05s; }
  .clsx-{{ uid }}.clsx--in .clsx-{{ uid }}__text > *:nth-child(2) { transition-delay: 0.13s; }
  .clsx-{{ uid }}.clsx--in .clsx-{{ uid }}__text > *:nth-child(3) { transition-delay: 0.21s; }
  .clsx-{{ uid }}.clsx--in .clsx-{{ uid }}__text > *:nth-child(4) { transition-delay: 0.29s; }
  .clsx-{{ uid }}.clsx--in .clsx-{{ uid }}__stage { transition-delay: 0.18s; }

  @keyframes clsx-drift-{{ uid }} {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(3%, 4%) scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .clsx-{{ uid }}__orb { animation: none; }
    .clsx-{{ uid }}__slide,
    .clsx-{{ uid }}__img,
    .clsx-{{ uid }}__slide svg,
    .clsx-{{ uid }}__badge,
    .clsx-{{ uid }}__card,
    .clsx-{{ uid }}__text > *,
    .clsx-{{ uid }}__stage { transition: none; }
    .clsx-{{ uid }}__slide.is-active .clsx-{{ uid }}__img,
    .clsx-{{ uid }}__slide.is-active svg { transform: none; }
    .clsx-{{ uid }}__text > *,
    .clsx-{{ uid }}__stage { opacity: 1; transform: none; }
  }
</style>

<div class="clsx-{{ uid }} clsx-{{ uid }}--{{ section.settings.image_position }}" data-clsx-root>
  <span class="clsx-{{ uid }}__orb clsx-{{ uid }}__orb--a" aria-hidden="true"></span>
  <span class="clsx-{{ uid }}__orb clsx-{{ uid }}__orb--b" aria-hidden="true"></span>

  <div class="clsx-{{ uid }}__inner page-width">
    <div class="clsx-{{ uid }}__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="clsx-{{ uid }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="clsx-{{ uid }}__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="clsx-{{ uid }}__desc rte">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="clsx-{{ uid }}__cta"
          href="{{ section.settings.button_link | default: '#' }}"
          {% if section.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.button_label | escape }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="clsx-{{ uid }}__stage" data-clsx-stage>
      <div class="clsx-{{ uid }}__card" data-clsx-card>
        <div class="clsx-{{ uid }}__media" data-clsx-media aria-roledescription="carousel" aria-label="{{ section.settings.heading | default: 'Custom logo examples' | escape }}">
          {%- if slides.size > 0 -%}
            {%- for block in slides -%}
              {%- liquid
                assign img_loading = 'lazy'
                if forloop.first
                  assign img_loading = 'eager'
                endif
              -%}
              <figure class="clsx-{{ uid }}__slide{% if forloop.first %} is-active{% endif %}" data-clsx-slide {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {%- assign alt = block.settings.caption | default: block.settings.image.alt | default: section.settings.heading | escape -%}
                  {{
                    block.settings.image
                    | image_url: width: 1400, height: 1400, crop: 'center'
                    | image_tag:
                        loading: img_loading,
                        widths: '400, 600, 800, 1000, 1200, 1400',
                        sizes: '(min-width: 990px) 40vw, 90vw',
                        class: img_class,
                        alt: alt
                  }}
                {%- else -%}
                  {%- assign ph_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                  {{ 'product-' | append: ph_index | placeholder_svg_tag: img_class }}
                {%- endif -%}

                {%- if block.settings.caption != blank -%}
                  <figcaption class="clsx-{{ uid }}__badge">
                    <span class="clsx-{{ uid }}__badge-dot" aria-hidden="true"></span>
                    {{ block.settings.caption | escape }}
                  </figcaption>
                {%- endif -%}
              </figure>
            {%- endfor -%}
          {%- else -%}
            <figure class="clsx-{{ uid }}__slide is-active" data-clsx-slide>
              {{ 'product-1' | placeholder_svg_tag: img_class }}
            </figure>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_dots and slides.size > 1 -%}
        <div class="clsx-{{ uid }}__dots" data-clsx-dots role="tablist" aria-label="Choose example">
          {%- for block in slides -%}
            <button
              type="button"
              class="clsx-{{ uid }}__dot"
              data-clsx-dot
              aria-label="Show example {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-clsx-root]');
    if (!root || root.dataset.clsxInit === '1') return;
    root.dataset.clsxInit = '1';

    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-clsx-slide]'));
    var dots   = Array.prototype.slice.call(root.querySelectorAll('[data-clsx-dot]'));
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var current = 0;
    var timer = null;
    var delay = {{ delay | default: 3500 }};
    var canAuto = {% if section.settings.autoplay %}true{% else %}false{% endif %} && slides.length > 1 && !reduce;

    function go(n) {
      n = (n + slides.length) % slides.length;
      if (n === current) return;
      slides[current].classList.remove('is-active');
      if (dots[current]) dots[current].setAttribute('aria-current', 'false');
      current = n;
      slides[current].classList.add('is-active');
      if (dots[current]) dots[current].setAttribute('aria-current', 'true');
    }
    function next() { go(current + 1); }
    function start() { if (canAuto && !timer) timer = setInterval(next, delay); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () { stop(); go(i); start(); });
    });

    // Pause when hovered/focused or tab hidden
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stop(); else start();
    });

    // Entrance reveal
    if ('IntersectionObserver' in window && !reduce) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { root.classList.add('clsx--in'); io.disconnect(); }
        });
      }, { threshold: 0.2 });
      io.observe(root);
    } else {
      root.classList.add('clsx--in');
    }

    // Subtle 3D tilt on fine pointers
    var card = root.querySelector('[data-clsx-card]');
    var stage = root.querySelector('[data-clsx-stage]');
    if (card && stage && !reduce && window.matchMedia('(pointer: fine)').matches) {
      stage.addEventListener('mousemove', function (ev) {
        var r = stage.getBoundingClientRect();
        var px = (ev.clientX - r.left) / r.width - 0.5;
        var py = (ev.clientY - r.top) / r.height - 0.5;
        card.style.transform = 'perspective(1000px) rotateY(' + (px * 6).toFixed(2) + 'deg) rotateX(' + (-py * 6).toFixed(2) + 'deg)';
      });
      stage.addEventListener('mouseleave', function () { card.style.transform = ''; });
    }

    start();
  })();
</script>

{% schema %}
{
  "name": "Custom logo showcase",
  "tag": "section",
  "class": "custom-logo-showcase-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Make it yours"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Bold the words you want shown in the accent color.",
      "default": "Your logo, on the <strong>game set</strong>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Upload any logo and we print it right onto the chairs. Teams, tailgates, brands and gifts — one set, endless designs.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Customize yours"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Link to your custom-set / logo upload product page."
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open button link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate images",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per image",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "unit": "s",
      "default": 3.5
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show navigation dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#f4f2e8"
    },
    {
      "type": "color",
      "id": "color_background_2",
      "label": "Background (gradient end)",
      "default": "#eae6d6"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent (button, glow, dots)",
      "default": "#363a66"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Image card",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "rounded",
      "label": "Image corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Logo example",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Square image",
          "info": "Product wearing one logo. Any shape works — it's cropped to a square."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption / brand name",
          "info": "Shown as a badge on the image (optional)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom logo showcase",
      "blocks": [
        { "type": "slide", "settings": { "caption": "Triple Whale" } },
        { "type": "slide", "settings": { "caption": "Your team logo" } },
        { "type": "slide", "settings": { "caption": "Corporate gift" } },
        { "type": "slide", "settings": { "caption": "Tailgate crew" } }
      ]
    }
  ]
}
{% endschema %}
