
<section class="product-list-section" id="ProductList-{{ section.id }}">

  <div class="product-list-container">

    {% if section.settings.heading != blank %}
      <h2 class="product-list-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.collection != blank %}

      <div class="product-list-grid">

        {% for product in section.settings.collection.products
          limit: section.settings.products_to_show
        %}

          {% assign current_variant = product.selected_or_first_available_variant %}

          <div class="product-list-card">

            <!-- PRODUCT IMAGE -->
            <div class="product-list-card__image">

              <a href="{{ product.url }}">

                {% if product.featured_image %}

                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(max-width: 749px) 100vw, 33vw',
                      alt: product.featured_image.alt | default: product.title
                  }}

                {% else %}

                  {{ 'product-1' | placeholder_svg_tag }}

                {% endif %}

              </a>

            </div>


            <!-- PRODUCT INFORMATION -->
            <div class="product-list-card__content">

              <!-- TITLE -->
              <h3 class="product-list-card__title">

                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>

              </h3>


              <!-- DESCRIPTION -->
              {% if section.settings.show_description and product.description != blank %}

                <div class="product-list-card__description">
                  {{ product.description | strip_html | truncate: 140 }}
                </div>

              {% endif %}


              <!-- PRICE -->
              <div class="product-list-card__price">

                {% if current_variant.compare_at_price > current_variant.price %}

                  <!-- DISCOUNTED PRICE -->
                  <span class="product-list-card__discounted-price">
                    {{ current_variant.price | money }}
                  </span>

                  <!-- ORIGINAL PRICE -->
                  <span class="product-list-card__original-price">
                    {{ current_variant.compare_at_price | money }}
                  </span>

                {% else %}

                  <!-- REGULAR PRICE -->
                  <span class="product-list-card__regular-price">
                    {{ current_variant.price | money }}
                  </span>

                {% endif %}

              </div>


              <!-- ADD TO CART -->
              {% form 'product', product, class: 'product-list-card__form' %}

                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                >

                <input
                  type="hidden"
                  name="quantity"
                  value="1"
                >

                <button
                  type="submit"
                  name="add"
                  class="product-list-card__add-to-cart"
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >

                  {% if current_variant.available %}
                    {{ section.settings.button_text }}
                  {% else %}
                    Sold Out
                  {% endif %}

                </button>

              {% endform %}

            </div>

          </div>

        {% endfor %}

      </div>

    {% else %}

      <div class="product-list-empty">
        <p>Please select a collection.</p>
      </div>

    {% endif %}

  </div>


  <style>

    #ProductList-{{ section.id }} {
      width: 100%;
      padding: 40px 20px;
      box-sizing: border-box;
    }


    #ProductList-{{ section.id }} .product-list-container {
      max-width: 1400px;
      margin: 0 auto;
    }


    /* HEADING */

    #ProductList-{{ section.id }} .product-list-heading {
      margin: 0 0 30px;
      text-align: center;
      font-size: 32px;
      line-height: 1.2;
    }


    /* GRID */

    #ProductList-{{ section.id }} .product-list-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24px;
}

#ProductList-{{ section.id }} .product-list-card {
  flex: 0 1 calc(25% - 18px);
  max-width: calc(25% - 18px);
}


    /* CARD */

    #ProductList-{{ section.id }} .product-list-card {
      overflow: hidden;
      background: #F58220;
      border: 1px solid #F58220;
      border-radius: 8px;
    }


    /* IMAGE */

    #ProductList-{{ section.id }} .product-list-card__image {
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #f5f5f5;
    }


    #ProductList-{{ section.id }} .product-list-card__image a {
      display: block;
      width: 100%;
      height: 100%;
    }


    #ProductList-{{ section.id }} .product-list-card__image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }


    #ProductList-{{ section.id }} .product-list-card:hover
    .product-list-card__image img {
      transform: scale(1.05);
    }


    /* CONTENT */

    #ProductList-{{ section.id }} .product-list-card__content {
      padding: 20px;
    }


    /* TITLE */

    #ProductList-{{ section.id }} .product-list-card__title {
      margin: 0 0 8px;
      font-size: 18px;
      line-height: 1.3;
    }


    #ProductList-{{ section.id }} .product-list-card__title a {
      color: #252D73;
      text-decoration: none;
    }


    #ProductList-{{ section.id }} .product-list-card__title a:hover {
      text-decoration: underline;
    }


    /* DESCRIPTION */

    #ProductList-{{ section.id }} .product-list-card__description {
      margin-bottom: 14px;
      color: #FFFFFF;
      font-size: 14px;
      line-height: 1.5;
    }


    /* PRICE */

    #ProductList-{{ section.id }} .product-list-card__price {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
    }


    #ProductList-{{ section.id }} .product-list-card__regular-price,
    #ProductList-{{ section.id }} .product-list-card__discounted-price {
      font-size: 18px;
      font-weight: 700;
    }


    #ProductList-{{ section.id }} .product-list-card__discounted-price {
      color: #d32f2f;
    }


    #ProductList-{{ section.id }} .product-list-card__original-price {
      color: #FFFFFF;
      font-size: 14px;
      text-decoration: line-through;
    }


    /* BUTTON */

    #ProductList-{{ section.id }} .product-list-card__add-to-cart {
      width: 100%;
      min-height: 46px;
      padding: 12px 18px;
      border: 0;
      border-radius: 5px;
      background: #252D73;
      color: #ffffffff;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }


    #ProductList-{{ section.id }} .product-list-card__add-to-cart:hover:not(:disabled) {
      opacity: 0.8;
    }


    #ProductList-{{ section.id }} .product-list-card__add-to-cart:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }


    /* TABLET */

    @media screen and (max-width: 990px) {

      #ProductList-{{ section.id }} .product-list-grid {
  gap: 18px;
}

#ProductList-{{ section.id }} .product-list-card {
  flex-basis: calc(33.333% - 12px);
  max-width: calc(33.333% - 12px);
}


    /* MOBILE */

    @media screen and (max-width: 749px) {

      #ProductList-{{ section.id }} {
        padding: 30px 15px;
      }

      #ProductList-{{ section.id }} .product-list-heading {
        margin-bottom: 20px;
        font-size: 26px;
      }

      #ProductList-{{ section.id }} .product-list-grid {
  gap: 12px;
}

#ProductList-{{ section.id }} .product-list-card {
  flex-basis: calc(50% - 6px);
  max-width: calc(50% - 6px);
}
      #ProductList-{{ section.id }} .product-list-card__content {
        padding: 14px;
      }

      #ProductList-{{ section.id }} .product-list-card__title {
        font-size: 16px;
      }

      #ProductList-{{ section.id }} .product-list-card__description {
        font-size: 13px;
      }

      #ProductList-{{ section.id }} .product-list-card__discounted-price,
      #ProductList-{{ section.id }} .product-list-card__regular-price {
        font-size: 16px;
      }

    }


    /* SMALL MOBILE */

    @media screen and (max-width: 480px) {

      #ProductList-{{ section.id }} .product-list-card {
  flex-basis: 100%;
  max-width: 100%;
}

    }

  </style>
</section>

  {% schema %}

  {
    "name": "Product List",
    "tag": "section",
    "class": "product-list-section",

    "settings": [

      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Featured Products"
      },

      {
        "type": "collection",
        "id": "collection",
        "label": "Product collection"
      },

      {
        "type": "range",
        "id": "products_to_show",
        "label": "Products to show",
        "min": 2,
        "max": 24,
        "step": 1,
        "default": 8
      },

      {
        "type": "checkbox",
        "id": "show_description",
        "label": "Show product description",
        "default": true
      },

      {
        "type": "text",
        "id": "button_text",
        "label": "Add to Cart button text",
        "default": "Add to Cart"
      }

    ],

    "presets": [
      {
        "name": "Product List"
      }
    ]

  }

  {% endschema %}


