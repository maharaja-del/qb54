<section class="product-list-section" id="ProductList-{{ section.id }}">

  <div class="product-list-container">

    {% if section.settings.heading != blank %}
      <h2 class="product-list-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.heading_description != blank %}
      <div class="product-list-description">
        {{ section.settings.heading_description }}
      </div>
    {% endif %}

    {% if section.settings.collection != blank %}

      <div class="product-list-grid">

        {% for product in section.settings.collection.products
          limit: section.settings.products_to_show
        %}

          {% assign current_variant = product.selected_or_first_available_variant %}

          <div class="product-list-card">

            <!-- PRODUCT IMAGE -->
            <div class="product-list-card__image">

              <a href="{{ product.url }}">

                {% if product.featured_image %}

                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(max-width: 749px) 100vw, 33vw',
                      alt: product.featured_image.alt | default: product.title
                  }}

                {% else %}

                  {{ 'product-1' | placeholder_svg_tag }}

                {% endif %}

              </a>

            </div>


            <!-- PRODUCT INFORMATION -->
            <div class="product-list-card__content">

              <!-- TITLE -->
              <h3 class="product-list-card__title">

                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>

              </h3>


              <!-- DESCRIPTION -->
              {% if section.settings.show_description and product.description != blank %}

                <div class="product-list-card__description">
                  {{ product.description | strip_html | truncate: 140 }}
                </div>

              {% endif %}


              <!-- PRICE -->
              <div class="product-list-card__price">

                {% if current_variant.compare_at_price > current_variant.price %}

                  <!-- DISCOUNTED PRICE -->
                  <span class="product-list-card__discounted-price">
                    {{ current_variant.price | money }}
                  </span>

                  <!-- ORIGINAL PRICE -->
                  <span class="product-list-card__original-price">
                    {{ current_variant.compare_at_price | money }}
                  </span>

                {% else %}

                  <!-- REGULAR PRICE -->
                  <span class="product-list-card__regular-price">
                    {{ current_variant.price | money }}
                  </span>

                {% endif %}

              </div>


              <!-- ADD TO CART -->
              {% form 'product', product, class: 'product-list-card__form' %}

                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                >

                <input
                  type="hidden"
                  name="quantity"
                  value="1"
                >

                <button
                  type="submit"
                  name="add"
                  class="product-list-card__add-to-cart"
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >

                  {% if current_variant.available %}
                    {{ section.settings.button_text }}
                  {% else %}
                    Sold Out
                  {% endif %}

                </button>

              {% endform %}

            </div>

          </div>

        {% endfor %}

      </div>

    {% else %}

      <div class="product-list-empty">
        <p>Please select a collection.</p>
      </div>

    {% endif %}

  </div>


  <style>

    #ProductList-{{ section.id }} {
      width: 100%;
      padding: 72px 20px;
      box-sizing: border-box;
      background: #0A0F0A;

    }


    #ProductList-{{ section.id }} .product-list-container {
      max-width: 1400px;
      margin: 0 auto;

    }


    /* HEADING */

    #ProductList-{{ section.id }} .product-list-heading {
      margin: 0 0 12px;
      text-align: center;
      font-size: 48px;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #ffffff;
      line-height: 1.2;
    }


    /* HEADING DESCRIPTION */

    #ProductList-{{ section.id }} .product-list-description {
      max-width: 700px;
      margin: 0 auto 34px;
      text-align: center;
      font-size: 20px;
      line-height: 1.6;
      color: #ffffff;
    }


    /* GRID */

    #ProductList-{{ section.id }} .product-list-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px;
    }

    #ProductList-{{ section.id }} .product-list-card {
      flex: 0 1 calc(25% - 18px);
      max-width: calc(25% - 18px);
    }


    /* CARD */

    #ProductList-{{ section.id }} .product-list-card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #0b0b0b;
      border: 1px solid #727272ff;
      border-radius: 6px;
      text-align: center;
      transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

    #ProductList-{{ section.id }} .product-list-card:hover {
box-shadow: 0 0 32px 8px #F58220;     transform: translateY(-8px);
    }


    /* IMAGE */

    #ProductList-{{ section.id }} .product-list-card__image {
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      padding: 10px;
      background: #0b0b0b;
      border-radius: 12px;
    }


    #ProductList-{{ section.id }} .product-list-card__image a {
      display: block;
      width: 100%;
      height: 100%;
    }

    #ProductList-{{ section.id }} .product-list-card__image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    #ProductList-{{ section.id }} .product-list-card:hover
    .product-list-card__image img {
      transform: scale(1.005);
    }


    /* CONTENT */

    #ProductList-{{ section.id }} .product-list-card__content {
      display: flex;
      flex-direction: column;
      flex: 1;
      padding: 18px 16px 22px;
    }


    /* TITLE */

    #ProductList-{{ section.id }} .product-list-card__title {
      margin: 0 0 10px;
      font-size: 15px;
      font-weight: 600;
      line-height: 1.4;
    }


    #ProductList-{{ section.id }} .product-list-card__title a {
      color: #ffffffff;
      text-decoration: none;
    }


    #ProductList-{{ section.id }} .product-list-card__title a:hover {
      color: #F58220;
    }


    /* DESCRIPTION */

    #ProductList-{{ section.id }} .product-list-card__description {
      margin-bottom: 12px;
      color: #767676;
      font-size: 13px;
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }


    /* PRICE */

    #ProductList-{{ section.id }} .product-list-card__price {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }


    #ProductList-{{ section.id }} .product-list-card__regular-price {
      font-size: 15px;
      font-weight: 700;
      color: #1a1a1a;
    }


    #ProductList-{{ section.id }} .product-list-card__discounted-price {
      font-size: 15px;
      font-weight: 700;
      color: #F58220;
    }


    #ProductList-{{ section.id }} .product-list-card__original-price {
      color: #a8a8a8;
      font-size: 13px;
      text-decoration: line-through;
    }


    /* BUTTON */

    #ProductList-{{ section.id }} .product-list-card__form {
      display: flex;
      justify-content: center;
      margin-top: auto;
    }

    #ProductList-{{ section.id }} .product-list-card__add-to-cart {
      display: inline-block;
      min-width: 140px;
      width: 100%;
      padding: 11px 22px;
      font-family: 'Sora', sans-serif;
      border: 0;
      border-radius: 20px;
      background: #F58220;
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s ease, opacity 0.2s ease;
    }


    #ProductList-{{ section.id }} .product-list-card:hover .product-list-card__add-to-cart:not(:disabled) {
      background: #252D73;
    }


    #ProductList-{{ section.id }} .product-list-card__add-to-cart:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }


    /* TABLET */

    @media screen and (max-width: 990px) {

      #ProductList-{{ section.id }} .product-list-grid {
        gap: 18px;
      }

      #ProductList-{{ section.id }} .product-list-card {
        flex-basis: calc(33.333% - 12px);
        max-width: calc(33.333% - 12px);
      }

    }


    /* MOBILE */

    @media screen and (max-width: 749px) {

      #ProductList-{{ section.id }} {
        padding: 30px 15px;
      }

      #ProductList-{{ section.id }} .product-list-heading {
        margin-bottom: 10px;
        font-size: 24px;
      }

      #ProductList-{{ section.id }} .product-list-description {
        margin-bottom: 20px;
        font-size: 14px;
      }

      #ProductList-{{ section.id }} .product-list-grid {
        gap: 12px;
      }

      #ProductList-{{ section.id }} .product-list-card {
        flex-basis: calc(50% - 6px);
        max-width: calc(50% - 6px);
      }

      #ProductList-{{ section.id }} .product-list-card__content {
        padding: 14px;
      }

      #ProductList-{{ section.id }} .product-list-card__title {
        font-size: 14px;
      }

      #ProductList-{{ section.id }} .product-list-card__description {
        font-size: 12px;
      }

      #ProductList-{{ section.id }} .product-list-card__discounted-price,
      #ProductList-{{ section.id }} .product-list-card__regular-price {
        font-size: 14px;
      }

      #ProductList-{{ section.id }} .product-list-card__add-to-cart {
        min-width: 0;
        width: 100%;
        padding: 10px 14px;
      }

    }


    /* SMALL MOBILE */

    @media screen and (max-width: 480px) {

      #ProductList-{{ section.id }} .product-list-card {
        flex-basis: 100%;
        max-width: 100%;
      }

    }

  </style>
</section>

{% schema %}

{
  "name": "Product List",
  "tag": "section",
  "class": "product-list-section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Products"
    },

    {
      "type": "richtext",
      "id": "heading_description",
      "label": "Heading description",
      "default": "<p>Pick your Halloween set from our latest collection.</p>"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },

    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Add to Cart button text",
      "default": "Add to Cart"
    }

  ],

  "presets": [
    {
      "name": "Product List"
    }
  ]

}

{% endschema %}