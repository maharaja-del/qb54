{%- style -%}
  .collections-grid, .collections-grid * { box-sizing: border-box; }
  
  .collections-grid {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    width: 100%;
    overflow-x: hidden;
  }
  
  .collections-grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
    width: 100%;
  }
  
  .collections-grid-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  
  .collections-grid-view-all {
    border: 1px solid {{ section.settings.view_all_border_color }};
    background: transparent;
    color: {{ section.settings.view_all_text_color }};
    padding: {{ section.settings.view_all_padding_vertical }}px {{ section.settings.view_all_padding_horizontal }}px;
    font-size: {{ section.settings.view_all_font_size }}px;
    font-weight: {{ section.settings.view_all_font_weight }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  
  .collections-grid-view-all:hover {
    background: {{ section.settings.view_all_hover_bg }};
    color: {{ section.settings.view_all_hover_text }};
  }
  
  .collections-grid-container {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
    width: 100%;
  }
  
  .collections-grid-item {
    position: relative;
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    background: {{ section.settings.card_background }};
    transition: transform 0.2s ease;
  }
  
  .collections-grid-item:hover {
    transform: translateY(-2px);
  }
  
  .collections-grid-image {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    position: relative;
    overflow: hidden;
  }
  
  .collections-grid-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .collections-grid-content {
    padding: {{ section.settings.content_padding }}px;
    position: relative;
    z-index: 2;
  }
  
  .collections-grid-name {
    font-size: {{ section.settings.collection_name_font_size }}px;
    font-weight: {{ section.settings.collection_name_font_weight }};
    color: {{ section.settings.collection_name_color }};
    margin: 0 0 {{ section.settings.name_margin_bottom }}px 0;
    line-height: 1.3;
  }
  
  .collections-grid-count {
    font-size: {{ section.settings.product_count_font_size }}px;
    font-weight: {{ section.settings.product_count_font_weight }};
    color: {{ section.settings.product_count_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .collections-grid-large {
    grid-column: span 2;
    grid-row: span 2;
  }
  
  .collections-grid-large .collections-grid-image {
    aspect-ratio: {{ section.settings.large_image_aspect_ratio }};
  }
  
  .collections-grid-large .collections-grid-name {
    font-size: {{ section.settings.large_collection_name_font_size }}px;
  }
  
  /* Mobile Slider */
  .collections-grid-mobile-slider {
    display: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: {{ section.settings.mobile_gap }}px;
    padding: 0 20px;
  }
  
  .collections-grid-mobile-slider::-webkit-scrollbar {
    display: none;
  }
  
  .collections-grid-mobile-slider {
    scrollbar-width: none;
  }
  
  .collections-grid-mobile-slide {
    flex: 0 0 {{ section.settings.mobile_slide_width }}%;
    scroll-snap-align: start;
  }
  
  @media (max-width: 768px) {
    .collections-grid {
      padding: {{ section.settings.mobile_section_padding_top }}px 0 {{ section.settings.mobile_section_padding_bottom }}px;
    }
    
    .collections-grid-header {
      padding: 0 20px;
      margin-bottom: {{ section.settings.mobile_header_margin_bottom }}px;
    }
    
    .collections-grid-title {
      font-size: {{ section.settings.mobile_title_font_size }}px;
    }
    
    .collections-grid-view-all {
      font-size: {{ section.settings.mobile_view_all_font_size }}px;
      padding: {{ section.settings.mobile_view_all_padding_vertical }}px {{ section.settings.mobile_view_all_padding_horizontal }}px;
    }
    
    .collections-grid-container {
      display: none;
    }
    
    .collections-grid-mobile-slider {
      display: flex;
    }
    
    .collections-grid-content {
      padding: {{ section.settings.mobile_content_padding }}px;
    }
    
    .collections-grid-name {
      font-size: {{ section.settings.mobile_collection_name_font_size }}px;
    }
    
    .collections-grid-count {
      font-size: {{ section.settings.mobile_product_count_font_size }}px;
    }
  }
  
  @media (max-width: 480px) {
    .collections-grid-title {
      font-size: {{ section.settings.small_mobile_title_font_size }}px;
    }
    
    .collections-grid-mobile-slide {
      flex: 0 0 {{ section.settings.small_mobile_slide_width }}%;
    }
  }
{%- endstyle -%}

<section class="collections-grid">
  <div class="page-width">
    <div class="collections-grid-header">
      {% if section.settings.title != blank %}
        <h2 class="collections-grid-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.view_all_text != blank %}
        <a href="{{ section.settings.view_all_link }}" class="collections-grid-view-all">
          {{ section.settings.view_all_text }}
        </a>
      {% endif %}
    </div>
    
    <!-- Desktop Grid -->
    <div class="collections-grid-container">
      {% for block in section.blocks %}
        <div class="collections-grid-item{% if block.settings.large_card %} collections-grid-large{% endif %}" {{ block.shopify_attributes }}>
          <div class="collections-grid-image">
            {% if block.settings.collection_image != blank %}
              {{ block.settings.collection_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
            {% endif %}
          </div>
          <div class="collections-grid-content">
            {% if block.settings.collection_name != blank %}
              <h3 class="collections-grid-name">{{ block.settings.collection_name }}</h3>
            {% endif %}
            {% if block.settings.product_count != blank %}
              <p class="collections-grid-count">{{ block.settings.product_count }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    
    <!-- Mobile Slider -->
    <div class="collections-grid-mobile-slider">
      {% for block in section.blocks %}
        <div class="collections-grid-mobile-slide" {{ block.shopify_attributes }}>
          <div class="collections-grid-item">
            <div class="collections-grid-image">
              {% if block.settings.collection_image != blank %}
                {{ block.settings.collection_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
              {% endif %}
            </div>
            <div class="collections-grid-content">
              {% if block.settings.collection_name != blank %}
                <h3 class="collections-grid-name">{{ block.settings.collection_name }}</h3>
              {% endif %}
              {% if block.settings.product_count != blank %}
                <p class="collections-grid-count">{{ block.settings.product_count }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

