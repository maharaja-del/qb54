{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign logo_blocks = section.blocks | where: 'type', 'logo'
  assign slide_blocks = section.blocks | where: 'type', 'bg_slide'
  assign anchor_product = section.settings.product
-%}

<style>
  #shopify-section-{{ section.id }} {
    --qhs-navy: {{ section.settings.background }};
    --qhs-navy-deep: color-mix(in srgb, {{ section.settings.background }} 72%, #000000);
    --qhs-gold: {{ section.settings.accent_color }};
    --qhs-ink: {{ section.settings.heading_color }};
    --qhs-sub: {{ section.settings.subheading_color }};
    --qhs-card-bg: #ffffff;
    --qhs-card-ink: #171717;
    --qhs-sale: {{ section.settings.sale_color }};
  }

  #shopify-section-{{ section.id }} .qhs {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(1100px 520px at 82% -10%, color-mix(in srgb, var(--qhs-gold) 17%, transparent), transparent 68%),
      radial-gradient(900px 600px at -12% 110%, color-mix(in srgb, var(--qhs-gold) 8%, transparent), transparent 60%),
      linear-gradient(168deg, var(--qhs-navy) 0%, var(--qhs-navy-deep) 100%);
    padding: {{ section.settings.padding_top_mobile }}px 0 0;
  }

  /* ---------- Background image + darkening overlay ---------- */
  #shopify-section-{{ section.id }} .qhs-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .qhs-bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.bg_position | default: 'center center' }};
  }

  /* Slides are stacked and crossfaded by opacity only — no movement. */
  #shopify-section-{{ section.id }} .qhs-bg-slides {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .qhs-bg-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  #shopify-section-{{ section.id }} .qhs-bg-slide.is-active {
    opacity: 1;
  }

  /* The black (or chosen) veil that sits above the photo but below the copy. */
  #shopify-section-{{ section.id }} .qhs-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.bg_overlay_color | default: '#000000' }};
    opacity: {{ section.settings.bg_overlay_opacity | default: 55 | divided_by: 100.0 }};
  }

  {%- if section.settings.bg_image_mobile != blank %}
  #shopify-section-{{ section.id }} .qhs-bg--desktop { display: none; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .qhs-bg--desktop { display: block; }
    #shopify-section-{{ section.id }} .qhs-bg--mobile { display: none; }
  }
  {%- endif %}

  #shopify-section-{{ section.id }} .qhs-shell {
    position: relative;
    z-index: 1;
    width: min(1280px, 100% - 40px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .qhs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  /* ---------- Left column ---------- */
  #shopify-section-{{ section.id }} .qhs-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }

  #shopify-section-{{ section.id }} .qhs-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--qhs-gold);
    color: var(--qhs-navy);
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .qhs-rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--qhs-sub);
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .qhs-stars {
    display: inline-flex;
    gap: 2px;
    color: var(--qhs-gold);
  }
  #shopify-section-{{ section.id }} .qhs-stars svg { width: 14px; height: 14px; }

  #shopify-section-{{ section.id }} .qhs-heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.96;
    letter-spacing: -0.01em;
    color: var(--qhs-ink);
    margin: 0 0 18px;
    font-size: {{ section.settings.heading_size_mobile }}px;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .qhs-heading em {
    font-style: normal;
    color: var(--qhs-gold);
  }

  #shopify-section-{{ section.id }} .qhs-sub {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.subheading_size_mobile }}px;
    line-height: 1.55;
    color: var(--qhs-sub);
    max-width: 52ch;
    margin: 0 0 28px;
  }

  #shopify-section-{{ section.id }} .qhs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .qhs-btn {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 17px 30px;
    min-height: 54px;
    border-radius: {{ section.settings.button_radius }}px;
    border: 1px solid transparent;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  #shopify-section-{{ section.id }} .qhs-btn:hover { transform: translateY(-2px); }

  #shopify-section-{{ section.id }} .qhs-btn-primary {
    background: var(--qhs-gold);
    color: var(--qhs-navy);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.25);
  }

  #shopify-section-{{ section.id }} .qhs-btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--qhs-ink);
    border-color: rgba(255, 255, 255, 0.35);
  }

  #shopify-section-{{ section.id }} .qhs-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    max-width: 540px;
  }

  #shopify-section-{{ section.id }} .qhs-stat strong {
    display: block;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(24px, 2.4vw, 30px);
    color: var(--qhs-gold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .qhs-stat span {
    display: block;
    font-family: var(--font-body-family);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--qhs-sub);
    margin-top: 6px;
  }

  /* ---------- Product anchor card ---------- */
  #shopify-section-{{ section.id }} .qhs-card {
    position: relative;
    background: var(--qhs-card-bg);
    color: var(--qhs-card-ink);
    border-radius: 18px;
    box-shadow: 0 30px 70px rgb(0 0 0 / 0.4);
    overflow: hidden;
    max-width: 420px;
    justify-self: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .qhs-card-media {
    position: relative;
    background: #f6f5f0;
  }
  #shopify-section-{{ section.id }} .qhs-card-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .qhs-card-flag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--qhs-navy);
    color: #ffffff;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 7px 12px;
    border-radius: 6px;
  }

  #shopify-section-{{ section.id }} .qhs-card-body {
    padding: 20px 22px 22px;
  }

  #shopify-section-{{ section.id }} .qhs-card-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body-family);
    font-size: 12.5px;
    font-weight: 500;
    color: #55534c;
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .qhs-card-rating .qhs-stars { color: {{ section.settings.star_color }}; }

  #shopify-section-{{ section.id }} .qhs-card-title {
    font-family: var(--font-heading-family);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 19px;
    line-height: 1.15;
    color: var(--qhs-navy);
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .qhs-card-title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .qhs-card-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .qhs-price-now {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 27px;
    color: var(--qhs-navy);
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .qhs-price-was {
    font-family: var(--font-body-family);
    font-size: 15px;
    color: #8f8d86;
    text-decoration: line-through;
  }
  #shopify-section-{{ section.id }} .qhs-price-save {
    background: var(--qhs-sale);
    color: #ffffff;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 5px;
  }

  #shopify-section-{{ section.id }} .qhs-card .product-form__error-message[hidden] { display: none; }
  #shopify-section-{{ section.id }} .qhs-card .product-form__error-message {
    color: #be123c;
    font-size: 13px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .qhs-card-atc {
    width: 100%;
    cursor: pointer;
    background: var(--qhs-gold);
    color: var(--qhs-navy);
    border: 0;
    border-radius: {{ section.settings.button_radius }}px;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 16px 20px;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    transition: transform 160ms ease, filter 160ms ease;
  }
  #shopify-section-{{ section.id }} .qhs-card-atc:hover { transform: translateY(-1px); filter: brightness(1.04); }
  #shopify-section-{{ section.id }} .qhs-card-atc[disabled] { opacity: 0.55; cursor: not-allowed; }

  #shopify-section-{{ section.id }} .qhs-card-stock {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-body-family);
    font-size: 12.5px;
    font-weight: 500;
    color: #3f6b47;
    margin-top: 12px;
  }
  #shopify-section-{{ section.id }} .qhs-card-stock::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4d7c0f;
    box-shadow: 0 0 0 3px rgba(77, 124, 15, 0.16);
  }

  #shopify-section-{{ section.id }} .qhs-card-micro {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 10px;
    padding-top: 12px;
    border-top: 1px solid #eceae2;
    font-family: var(--font-body-family);
    font-size: 12px;
    color: #6b695f;
  }

  /* ---------- Press strip ---------- */
  #shopify-section-{{ section.id }} .qhs-press {
    position: relative;
    z-index: 1;
    margin-top: {{ section.settings.padding_top_mobile | divided_by: 1 }}px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.18);
  }

  #shopify-section-{{ section.id }} .qhs-press-inner {
    width: min(1280px, 100% - 40px);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px 34px;
    padding: 18px 0;
  }

  #shopify-section-{{ section.id }} .qhs-press-label {
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .qhs-press img {
    display: block;
    height: {{ section.settings.logo_size_mobile }}px;
    width: auto;
    max-width: 110px;
    object-fit: contain;
    {%- if section.settings.logo_invert %}
    filter: brightness(0) invert(1);
    opacity: 0.7;
    {%- else %}
    /* Original artwork colours, full strength. */
    filter: none;
    opacity: 1;
    {%- endif %}
  }

  {%- if section.settings.logo_plate and section.settings.logo_invert == false %}
  /* Optional light plate so dark logo artwork stays legible on the dark hero. */
  #shopify-section-{{ section.id }} .qhs-press img {
    padding: 6px 10px;
    background: #ffffff;
    border-radius: 6px;
  }
  {%- endif %}

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .qhs {
      padding-top: {{ section.settings.padding_top_desktop }}px;
    }
    #shopify-section-{{ section.id }} .qhs-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(380px, 0.85fr);
      gap: clamp(48px, 5vw, 88px);
    }
    #shopify-section-{{ section.id }} .qhs-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .qhs-sub {
      font-size: {{ section.settings.subheading_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .qhs-card { justify-self: end; }
    #shopify-section-{{ section.id }} .qhs-press { margin-top: {{ section.settings.padding_bottom_desktop }}px; }
    #shopify-section-{{ section.id }} .qhs-press-inner { justify-content: space-between; gap: 20px 40px; padding: 20px 0; }
    #shopify-section-{{ section.id }} .qhs-press img { height: {{ section.settings.logo_size_desktop }}px; max-width: 150px; }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .qhs-press { margin-top: {{ section.settings.padding_bottom_mobile }}px; }
    }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .qhs-btn,
    #shopify-section-{{ section.id }} .qhs-card-atc { transition: none; }
  }
</style>

{%- capture star_row -%}
  <span class="qhs-stars" aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9z"/></svg>
    {%- endfor -%}
  </span>
{%- endcapture -%}

<div class="qhs">
  {%- if section.settings.bg_image != blank or section.settings.bg_image_mobile != blank or slide_blocks.size > 0 -%}
    <div class="qhs-bg" aria-hidden="true">
      <div class="qhs-bg-slides{% if section.settings.bg_image_mobile != blank %} qhs-bg--desktop{% endif %}" data-hero-bg-slider>
        {%- assign active_set = false -%}
        {%- if section.settings.bg_image != blank -%}
          {{- section.settings.bg_image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750,1100,1500,1900,2400',
              sizes: '100vw',
              alt: '',
              class: 'qhs-bg-slide is-active'
          -}}
          {%- assign active_set = true -%}
        {%- endif -%}
        {%- for block in slide_blocks -%}
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign slide_class = 'qhs-bg-slide'
              unless active_set
                assign slide_class = 'qhs-bg-slide is-active'
                assign active_set = true
              endunless
            -%}
            {{- block.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                widths: '750,1100,1500,1900,2400',
                sizes: '100vw',
                alt: '',
                class: slide_class
            -}}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.bg_image_mobile != blank -%}
        {{- section.settings.bg_image_mobile
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480,750,1000,1200',
            sizes: '100vw',
            alt: '',
            class: 'qhs-bg--mobile'
        -}}
      {%- endif -%}
    </div>
  {%- endif -%}


  <div class="qhs-shell qhs-grid">
    <div>
      <div class="qhs-badges">
        {%- if section.settings.badge_text != blank -%}
          <span class="qhs-badge">{{ section.settings.badge_text | escape }}</span>
        {%- endif -%}
        {%- if section.settings.rating_text != blank -%}
          <span class="qhs-rating">{{ star_row }} {{ section.settings.rating_text | escape }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.heading != blank -%}
        <h1 class="qhs-heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="qhs-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="qhs-actions">
        {%- if section.settings.primary_button_text != blank -%}
          <a class="qhs-btn qhs-btn-primary" href="{{ section.settings.primary_button_url | default: '#' }}">
            {{ section.settings.primary_button_text | escape }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_text != blank -%}
          <a class="qhs-btn qhs-btn-secondary" href="{{ section.settings.secondary_button_url | default: '#' }}">
            {{ section.settings.secondary_button_text | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if stat_blocks.size > 0 -%}
        <div class="qhs-stats">
          {%- for block in stat_blocks -%}
            <div class="qhs-stat" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.stat_value | escape }}</strong>
              <span>{{ block.settings.stat_label | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if anchor_product != blank -%}
      <div class="qhs-card">
        <div class="qhs-card-media">
          {%- if section.settings.card_flag_text != blank -%}
            <span class="qhs-card-flag">{{ section.settings.card_flag_text | escape }}</span>
          {%- endif -%}
          <a href="{{ anchor_product.url }}" tabindex="-1" aria-hidden="true">
            {{- anchor_product.featured_media
              | image_url: width: 840
              | image_tag: loading: 'eager', widths: '420,640,840', sizes: '(max-width: 989px) 92vw, 420px', alt: anchor_product.featured_media.alt | default: anchor_product.title
            -}}
          </a>
        </div>
        <div class="qhs-card-body">
          {%- liquid
            assign mf_rating = anchor_product.metafields.reviews.rating.value
            assign mf_count = anchor_product.metafields.reviews.rating_count.value
          -%}
          <div class="qhs-card-rating">
            {{ star_row }}
            {%- if mf_rating != blank and mf_count > 0 -%}
              <span>{{ mf_rating.rating | round: 1 }} · {{ mf_count }} reviews</span>
            {%- elsif section.settings.card_rating_text != blank -%}
              <span>{{ section.settings.card_rating_text | escape }}</span>
            {%- endif -%}
          </div>

          <h2 class="qhs-card-title"><a href="{{ anchor_product.url }}">{{ anchor_product.title }}</a></h2>

          <div class="qhs-card-price">
            <span class="qhs-price-now">{{ anchor_product.price | money }}</span>
            {%- if anchor_product.compare_at_price > anchor_product.price -%}
              <s class="qhs-price-was">{{ anchor_product.compare_at_price | money }}</s>
              {%- assign save_amount = anchor_product.compare_at_price | minus: anchor_product.price -%}
              <span class="qhs-price-save">Save {{ save_amount | money_without_trailing_zeros }}</span>
            {%- endif -%}
          </div>

          {%- if anchor_product.available == false -%}
            <button class="qhs-card-atc" type="button" disabled>{{ 'products.product.sold_out' | t }}</button>
          {%- elsif anchor_product.variants.size == 1 -%}
            {%- form 'product', anchor_product, is: 'product-form', id: 'HeroAnchorForm', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ anchor_product.selected_or_first_available_variant.id }}" />
              <div class="product-form__error-message" role="alert" hidden></div>
              <button type="submit" name="add" class="qhs-card-atc">
                {{ section.settings.card_button_text | default: 'Add to Cart' | escape }}
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1.6"/><circle cx="19" cy="21" r="1.6"/><path d="M2.5 3h3l2.6 12.6a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L22.5 8H6.1"/></svg>
              </button>
            {%- endform -%}
          {%- else -%}
            <a class="qhs-card-atc" href="{{ anchor_product.url }}">{{ 'products.product.choose_options' | t | default: 'Choose Options' }}</a>
          {%- endif -%}

          {%- if section.settings.card_stock_text != blank -%}
            <p class="qhs-card-stock">{{ section.settings.card_stock_text | escape }}</p>
          {%- endif -%}

          {%- if section.settings.card_micro_text != blank -%}
            <div class="qhs-card-micro">{{ section.settings.card_micro_text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if logo_blocks.size > 0 -%}
    <div class="qhs-press">
      <div class="qhs-press-inner">
        {%- if section.settings.press_label != blank -%}
          <span class="qhs-press-label">{{ section.settings.press_label | escape }}</span>
        {%- endif -%}
        {%- for block in logo_blocks -%}
          {%- if block.settings.logo != blank -%}
            <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.alt_text | default: 'Media logo' | escape }}" loading="lazy" width="150" height="{{ section.settings.logo_size_desktop }}" {{ block.shopify_attributes }}>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- if slide_blocks.size > 0 -%}
<script>
  (() => {
    const slider = document.querySelector('#shopify-section-{{ section.id }} [data-hero-bg-slider]');
    if (!slider) return;
    const slides = Array.from(slider.querySelectorAll('.qhs-bg-slide'));
    if (slides.length < 2) return;
    // Respect reduced-motion: hold the first image, no cycling.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let index = Math.max(0, slides.findIndex((s) => s.classList.contains('is-active')));
    setInterval(() => {
      slides[index].classList.remove('is-active');
      index = (index + 1) % slides.length;
      slides[index].classList.add('is-active');
    }, {{ section.settings.bg_slide_interval | default: 5 | times: 1000 }});
  })();
</script>
{%- endif -%}

