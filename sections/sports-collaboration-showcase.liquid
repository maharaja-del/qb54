{%- style -%}
  .instagram-collaboration, .instagram-collaboration * { box-sizing: border-box; }
  
  .instagram-collaboration {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.section_padding }}px 0;
    overflow-x: hidden;
    width: 100%;
  }
  
  .collaboration-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .collaboration-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_spacing }}px;
  }
  
  .collaboration-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    margin-bottom: {{ section.settings.title_spacing }}px;
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: 1.2;
  }
  
  .collaboration-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    color: {{ section.settings.subtitle_color }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .collaboration-content {
    display: grid;
    grid-template-columns: 1fr 0.8fr 1fr;
    gap: {{ section.settings.content_gap }}px;
    align-items: stretch;
  }
  
  .instagram-card {
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    color: white;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 500px;
  }
  
  .instagram-card--left {
    background: linear-gradient({{ section.settings.left_gradient_angle }}deg, {{ section.settings.left_gradient_start }}, {{ section.settings.left_gradient_end }});
  }
  
  .instagram-card--right {
    background: linear-gradient({{ section.settings.right_gradient_angle }}deg, {{ section.settings.right_gradient_start }}, {{ section.settings.right_gradient_end }});
  }
  
  .card-top-image {
    width: {{ section.settings.card_image_width }}px;
    height: {{ section.settings.card_image_width }}px;
    border-radius: {{ section.settings.card_image_radius }}px;
    object-fit: cover;
    margin: 0 auto {{ section.settings.image_spacing }}px;
    display: block;
  }
  
  .instagram-handle {
    font-size: {{ section.settings.handle_size }}px;
    font-weight: {{ section.settings.handle_weight }};
    margin-bottom: {{ section.settings.handle_spacing }}px;
    color: {{ section.settings.handle_color }};
    text-align: center;
  }
  
  .card-description {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    margin-bottom: {{ section.settings.description_spacing }}px;
    text-align: center;
    opacity: {{ section.settings.description_opacity | divided_by: 100.0 }};
  }
  
  .instagram-stats {
    display: flex;
    justify-content: space-around;
    margin: {{ section.settings.stats_spacing }}px 0;
    flex-grow: 1;
    align-items: center;
  }
  
  .stat-item {
    text-align: center;
  }
  
  .stat-number {
    font-size: {{ section.settings.stat_number_size }}px;
    font-weight: {{ section.settings.stat_number_weight }};
    display: block;
    color: {{ section.settings.stat_number_color }};
  }
  
  .stat-label {
    font-size: {{ section.settings.stat_label_size }}px;
    opacity: {{ section.settings.stat_label_opacity | divided_by: 100.0 }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: {{ section.settings.stat_label_color }};
  }
  
  .instagram-cta {
    background: rgba(255,255,255,{{ section.settings.cta_bg_opacity | divided_by: 100.0 }});
    border: 1px solid rgba(255,255,255,{{ section.settings.cta_border_opacity | divided_by: 100.0 }});
    color: {{ section.settings.cta_text_color }};
    padding: {{ section.settings.cta_padding }}px;
    border-radius: {{ section.settings.cta_radius }}px;
    text-decoration: none;
    font-weight: {{ section.settings.cta_font_weight }};
    font-size: {{ section.settings.cta_size }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.3s ease;
    margin-top: auto;
    width: 100%;
  }
  
  .instagram-cta:hover {
    background: rgba(255,255,255,{{ section.settings.cta_hover_opacity | divided_by: 100.0 }});
    transform: translateY(-2px);
  }
  
  .center-content {
    position: relative;
    border-radius: {{ section.settings.center_radius }}px;
    overflow: hidden;
    background: {{ section.settings.center_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .center-image {
    width: 100%;
    height: {{ section.settings.center_height }}px;
    object-fit: cover;
    display: block;
  }
  
  .video-container {
    position: relative;
    width: 100%;
    height: {{ section.settings.center_height }}px;
    background: {{ section.settings.center_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .video-element {
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }
  
  .video-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    z-index: 2;
  }
  
  .video-play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ section.settings.play_button_size }}px;
    height: {{ section.settings.play_button_size }}px;
    background: {{ section.settings.play_button_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    z-index: 3;
  }
  
  .video-play-button:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }
  
  .video-play-button svg {
    width: 40%;
    height: 40%;
    fill: {{ section.settings.play_button_icon_color }};
    margin-left: 4px;
  }
  
  @media (max-width: 768px) {
    .collaboration-content {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }
    
    .collaboration-title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }
    
    .collaboration-subtitle {
      font-size: {{ section.settings.mobile_subtitle_size }}px;
    }
    
    .instagram-card {
      padding: {{ section.settings.mobile_card_padding }}px;
      min-height: auto;
    }
    
    .instagram-card--left {
      order: {{ section.settings.left_mobile_order }};
    }
    
    .instagram-card--right {
      order: {{ section.settings.right_mobile_order }};
    }
    
    .center-content {
      order: {{ section.settings.center_mobile_order }};
    }
    
    .video-container {
      height: {{ section.settings.mobile_center_height }}px;
    }
    
    .center-image {
      height: {{ section.settings.mobile_center_height }}px;
    }
    
    .card-top-image {
      width: {{ section.settings.mobile_card_image_width }}px;
      height: {{ section.settings.mobile_card_image_width }}px;
    }
    
    .instagram-handle {
      font-size: {{ section.settings.mobile_handle_size }}px;
    }
    
    .card-description {
      font-size: {{ section.settings.mobile_description_size }}px;
    }
    
    .stat-number {
      font-size: {{ section.settings.mobile_stat_number_size }}px;
    }
    
    .stat-label {
      font-size: {{ section.settings.mobile_stat_label_size }}px;
    }
    
    .instagram-cta {
      font-size: {{ section.settings.mobile_cta_size }}px;
      padding: {{ section.settings.mobile_cta_padding }}px;
    }
    
    .video-play-button {
      width: {{ section.settings.mobile_play_button_size }}px;
      height: {{ section.settings.mobile_play_button_size }}px;
    }
  }
  
  @media (max-width: 480px) {
    .collaboration-title {
      font-size: {{ section.settings.mobile_title_size | minus: 4 }}px;
    }
    
    .collaboration-subtitle {
      font-size: {{ section.settings.mobile_subtitle_size | minus: 2 }}px;
    }
    
    .instagram-card {
      padding: {{ section.settings.mobile_card_padding | times: 3 | divided_by: 4 }}px;
    }
    
    .card-top-image {
      width: {{ section.settings.mobile_card_image_width | times: 3 | divided_by: 4 }}px;
      height: {{ section.settings.mobile_card_image_width | times: 3 | divided_by: 4 }}px;
    }
  }
{%- endstyle -%}

<section class="instagram-collaboration">
  <div class="collaboration-container">
    <div class="collaboration-header">
      <h2 class="collaboration-title">{{ section.settings.main_title }}</h2>
      <p class="collaboration-subtitle">{{ section.settings.main_subtitle }}</p>
    </div>
    
    <div class="collaboration-content">
      <!-- Left Instagram Card -->
      <div class="instagram-card instagram-card--left">
        {% if section.settings.left_image != blank %}
          {{ section.settings.left_image | image_url: width: 200 | image_tag: class: 'card-top-image', loading: 'lazy' }}
        {% endif %}
        
        <div class="instagram-handle">{{ section.settings.left_handle }}</div>
        
        {% if section.settings.left_description != blank %}
          <p class="card-description">{{ section.settings.left_description }}</p>
        {% endif %}
        
        <div class="instagram-stats">
          <div class="stat-item">
            <span class="stat-number">{{ section.settings.left_followers }}</span>
            <span class="stat-label">Followers</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{{ section.settings.left_posts }}</span>
            <span class="stat-label">Posts</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{{ section.settings.left_views }}</span>
            <span class="stat-label">Views</span>
          </div>
        </div>
        
        <a href="{{ section.settings.left_link }}" class="instagram-cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15,3 21,3 21,9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          {{ section.settings.left_cta_text }}
        </a>
      </div>
      
      <!-- Center Content -->
      <div class="center-content">
        {% if section.settings.content_type == 'image' and section.settings.center_image != blank %}
          {{ section.settings.center_image | image_url: width: 800 | image_tag: class: 'center-image', loading: 'lazy' }}
        {% elsif section.settings.content_type == 'video' %}
          <div class="video-container">
            {% if section.settings.video_file != blank %}
              <video class="video-element" id="mainVideo" preload="metadata" {% if section.settings.show_video_controls %}controls{% endif %} playsinline muted>
                {% for source in section.settings.video_file.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>
            {% else %}
              <div style="background: #333; height: 100%; width: 100%; display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px;">
                Select a video in the theme editor
              </div>
            {% endif %}
            
            {% if section.settings.video_cover != blank and section.settings.show_cover %}
              <img src="{{ section.settings.video_cover | image_url: width: 800 }}" alt="Video cover" class="video-cover" id="videoCover">
            {% endif %}
            
            {% if section.settings.show_cover %}
              <div class="video-play-button" id="playButton">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21"/>
                </svg>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
      
      <!-- Right Instagram Card -->
      <div class="instagram-card instagram-card--right">
        {% if section.settings.right_image != blank %}
          {{ section.settings.right_image | image_url: width: 200 | image_tag: class: 'card-top-image', loading: 'lazy' }}
        {% endif %}
        
        <div class="instagram-handle">{{ section.settings.right_handle }}</div>
        
        {% if section.settings.right_description != blank %}
          <p class="card-description">{{ section.settings.right_description }}</p>
        {% endif %}
        
        <div class="instagram-stats">
          <div class="stat-item">
            <span class="stat-number">{{ section.settings.right_followers }}</span>
            <span class="stat-label">Followers</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{{ section.settings.right_posts }}</span>
            <span class="stat-label">Posts</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{{ section.settings.right_views }}</span>
            <span class="stat-label">Views</span>
          </div>
        </div>
        
        <a href="{{ section.settings.right_link }}" class="instagram-cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15,3 21,3 21,9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          {{ section.settings.right_cta_text }}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const playButton = document.getElementById('playButton');
    const videoCover = document.getElementById('videoCover');
    const videoElement = document.getElementById('mainVideo');
    
    if (playButton && videoElement) {
      function playVideo() {
        // Hide cover and play button
        if (videoCover) {
          videoCover.style.display = 'none';
        }
        if (playButton) {
          playButton.style.display = 'none';
        }
        
        // Ensure video is visible and unmute for sound
        videoElement.style.display = 'block';
        videoElement.muted = false;
        videoElement.volume = 1.0;
        
        // Attempt to play with sound
        const playPromise = videoElement.play();
        
        if (playPromise !== undefined) {
          playPromise.then(() => {
            // Video started playing successfully with sound
          }).catch(error => {
            console.log('Autoplay with sound failed, trying muted:', error);
            // If autoplay with sound fails, try muted autoplay
            videoElement.muted = true;
            videoElement.play().catch(e => {
              console.log('Video play failed:', e);
            });
          });
        }
      }
      
      // Play button click handler
      playButton.addEventListener('click', function(e) {
        e.preventDefault();
        playVideo();
      });
      
      // Video cover click handler
      if (videoCover) {
        videoCover.addEventListener('click', function(e) {
          e.preventDefault();
          playVideo();
        });
      }
      
      // Handle video ended to show cover again if enabled
      videoElement.addEventListener('ended', function() {
        if (videoCover && playButton) {
          videoCover.style.display = 'block';
          playButton.style.display = 'flex';
        }
      });

      // Handle video pause to show cover again
      videoElement.addEventListener('pause', function() {
        if (videoCover && playButton && videoElement.currentTime < videoElement.duration) {
          videoCover.style.display = 'block';
          playButton.style.display = 'flex';
        }
      });
    }
  });
</script>

