{% comment %} QB54 × Moon Media — Collab Cards Section {% endcomment %}

<style>
  #qb-collab-{{ section.id }} {
    --qb: {{ section.settings.color_qb }};
    --moon: {{ section.settings.color_moon }};
    --gold: {{ section.settings.color_gold }};
    padding: 80px 0;
    background: {{ section.settings.color_bg }};
    border-top: 1px solid rgba(185,249,0,.1);
    font-family: 'Sora', sans-serif;
  }
  #qb-collab-{{ section.id }} .cc-inner {
    max-width: 1100px; margin: 0 auto; padding: 0 48px;
    display: flex; flex-direction: column; align-items: center; gap: 48px;
  }
  #qb-collab-{{ section.id }} .cc-head { text-align: center; }
  #qb-collab-{{ section.id }} .cc-eyebrow {
    font-size: .6rem; letter-spacing: .2em; text-transform: uppercase;
    color: rgba(255,255,255,.5); display: block; margin-bottom: 8px;
  }
  #qb-collab-{{ section.id }} .cc-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px,5vw,60px); line-height: .95; color: #fff; margin: 0;
  }
  #qb-collab-{{ section.id }} .cards-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px; width: 100%;
  }
  #qb-collab-{{ section.id }} .b-card {
    padding: 40px 36px; background: {{ section.settings.color_surface }};
    border: 1px solid rgba(185,249,0,.1); border-radius: 16px;
  }
  #qb-collab-{{ section.id }} .b-card .card-logo {
    height: 36px; object-fit: contain; margin-bottom: 24px; display: block;
  }
  #qb-collab-{{ section.id }} .b-card.mm .card-logo { filter: brightness(1.3) saturate(.6); }
  #qb-collab-{{ section.id }} .c-eyebrow {
    font-size: .55rem; letter-spacing: .2em; text-transform: uppercase;
    color: rgba(255,255,255,.5); margin-bottom: 6px; display: block;
  }
  #qb-collab-{{ section.id }} .c-role {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(22px,2.5vw,34px); line-height: 1; margin-bottom: 16px;
  }
  #qb-collab-{{ section.id }} .b-card.qb54 .c-role { color: var(--qb); }
  #qb-collab-{{ section.id }} .b-card.mm .c-role { color: var(--moon); }
  #qb-collab-{{ section.id }} .c-desc {
    font-size: .82rem; font-weight: 300; color: rgba(255,255,255,.75);
    line-height: 1.8; margin-bottom: 28px;
  }
  #qb-collab-{{ section.id }} .c-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  }
  #qb-collab-{{ section.id }} .cs {
    padding: 16px 18px; border: 1px solid rgba(185,249,0,.1);
    border-radius: 10px; background: {{ section.settings.color_surface2 }};
  }
  #qb-collab-{{ section.id }} .cs .n {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; line-height: 1; margin-bottom: 2px;
  }
  #qb-collab-{{ section.id }} .b-card.qb54 .cs:nth-child(odd) .n { color: var(--qb); }
  #qb-collab-{{ section.id }} .b-card.qb54 .cs:nth-child(even) .n { color: var(--gold); }
  #qb-collab-{{ section.id }} .b-card.mm .cs .n { color: var(--moon); }
  #qb-collab-{{ section.id }} .cs .l {
    font-size: .56rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.5);
  }

  @media(max-width:800px){
    #qb-collab-{{ section.id }} .cards-grid { grid-template-columns: 1fr; }
  }
  @media(max-width:640px){
    #qb-collab-{{ section.id }} { padding: 56px 0; }
    #qb-collab-{{ section.id }} .cc-inner { padding: 0 20px; gap: 36px; }
    #qb-collab-{{ section.id }} .b-card { padding: 28px 22px; }
  }
</style>

<section id="qb-collab-{{ section.id }}">
  <div class="cc-inner">

    <div class="cc-head">
      <span class="cc-eyebrow">{{ section.settings.section_label }}</span>
      <h2 class="cc-title">{{ section.settings.heading }}</h2>
    </div>

    <div class="cards-grid">

      {%- comment -%} QB54 Card {%- endcomment -%}
      <div class="b-card qb54">
        {%- if section.settings.qb_logo != blank -%}
          <img class="card-logo" src="{{ section.settings.qb_logo | image_url: width: 200 }}" alt="QB54">
        {%- else -%}
          <img class="card-logo" src="https://playqb54.com/cdn/shop/files/logo.png" alt="QB54">
        {%- endif -%}
        <span class="c-eyebrow">{{ section.settings.qb_eyebrow }}</span>
        <h3 class="c-role">{{ section.settings.qb_role }}</h3>
        <p class="c-desc">{{ section.settings.qb_desc }}</p>
        <div class="c-stats">
          {%- for i in (1..4) -%}
            {%- assign stat_n_key = 'qb_stat' | append: i | append: '_n' -%}
            {%- assign stat_l_key = 'qb_stat' | append: i | append: '_l' -%}
            {%- if section.settings[stat_n_key] != blank -%}
              <div class="cs">
                <div class="n">{{ section.settings[stat_n_key] }}</div>
                <div class="l">{{ section.settings[stat_l_key] }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Moon Media Card {%- endcomment -%}
      <div class="b-card mm">
        {%- if section.settings.mm_logo != blank -%}
          <img class="card-logo" src="{{ section.settings.mm_logo | image_url: width: 200 }}" alt="Moon Media">
        {%- else -%}
          <img class="card-logo" src="https://images.squarespace-cdn.com/content/v1/6111d9dc96344d4b722b4481/36343cc8-77de-44d0-a2a6-0d1123a10288/Moon-Media-Logo-Web.png" alt="Moon Media">
        {%- endif -%}
        <span class="c-eyebrow">{{ section.settings.mm_eyebrow }}</span>
        <h3 class="c-role">{{ section.settings.mm_role }}</h3>
        <p class="c-desc">{{ section.settings.mm_desc }}</p>
        <div class="c-stats">
          {%- for i in (1..4) -%}
            {%- assign stat_n_key = 'mm_stat' | append: i | append: '_n' -%}
            {%- assign stat_l_key = 'mm_stat' | append: i | append: '_l' -%}
            {%- if section.settings[stat_n_key] != blank -%}
              <div class="cs">
                <div class="n">{{ section.settings[stat_n_key] }}</div>
                <div class="l">{{ section.settings[stat_l_key] }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

