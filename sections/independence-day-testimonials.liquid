{% comment %}
  ID4-Testimonials — "From America's Backyards" patriotic review wall
  Star-rated review cards with flag accent + verified badge. Pairs with ID4 sections.
  Section: sections/independence-day-testimonials.liquid
  Brand: QB54 — navy + gold + patriotic red
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Anton&family=Sora:wght@300;400;600;700;800&display=swap" rel="stylesheet">

<style>
  #id4-tst-{{ section.id }} {
    --bg:    {{ section.settings.color_bg }};
    --card:  {{ section.settings.color_card }};
    --text:  {{ section.settings.color_text }};
    --red:   {{ section.settings.color_red }};
    --blue:  {{ section.settings.color_blue }};
    --spark: {{ section.settings.color_spark }};
    --gold:  #ffd23f;
    --muted: color-mix(in srgb, {{ section.settings.color_text }} 62%, transparent);
    --line:  color-mix(in srgb, {{ section.settings.color_text }} 12%, transparent);

    position: relative;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, color-mix(in srgb, var(--blue) 30%, var(--bg)) 0%, var(--bg) 55%),
      var(--bg);
    color: var(--text);
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'Sora', sans-serif;
    -webkit-font-smoothing: antialiased;
    isolation: isolate;
  }
  #id4-tst-{{ section.id }} .id4t-stars-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: .4;
    background-image:
      radial-gradient(1.4px 1.4px at 18% 18%, #fff, transparent),
      radial-gradient(1.4px 1.4px at 78% 24%, var(--spark), transparent),
      radial-gradient(1.4px 1.4px at 55% 72%, #fff, transparent),
      radial-gradient(1.4px 1.4px at 32% 84%, var(--red), transparent);
  }
  #id4-tst-{{ section.id }} .id4t-inner {
    position: relative; z-index: 2; max-width: 1240px; margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
  }
  #id4-tst-{{ section.id }} .id4t-head { text-align: center; margin-bottom: clamp(34px, 5vw, 52px); }
  #id4-tst-{{ section.id }} .id4t-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; font-weight: 800; letter-spacing: .26em; text-transform: uppercase;
    color: var(--spark); margin-bottom: 14px;
  }
  #id4-tst-{{ section.id }} .id4t-eyebrow svg { width: 13px; height: 13px; fill: var(--spark); }
  #id4-tst-{{ section.id }} .id4t-title {
    font-family: 'Anton', sans-serif;
    font-size: clamp(36px, 5.2vw, 62px); line-height: .94; letter-spacing: .01em; text-transform: uppercase; margin: 0 0 14px;
  }
  #id4-tst-{{ section.id }} .id4t-title .spark { color: var(--spark); }
  #id4-tst-{{ section.id }} .id4t-summary {
    display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center;
    font-size: 14px; color: var(--muted);
  }
  #id4-tst-{{ section.id }} .id4t-summary .id4t-bigstars { display: inline-flex; gap: 3px; }
  #id4-tst-{{ section.id }} .id4t-summary .id4t-bigstars svg { width: 18px; height: 18px; fill: var(--gold); }
  #id4-tst-{{ section.id }} .id4t-summary b { color: var(--text); font-weight: 700; }

  #id4-tst-{{ section.id }} .id4t-grid {
    display: grid; grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: clamp(16px, 2vw, 24px);
  }
  #id4-tst-{{ section.id }} .id4t-card {
    position: relative; background: var(--card); border: 1px solid var(--line);
    border-radius: 18px; padding: 26px 24px 24px; display: flex; flex-direction: column; gap: 14px;
    overflow: hidden;
  }
  #id4-tst-{{ section.id }} .id4t-card::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: repeating-linear-gradient(90deg, var(--red) 0 16%, #fff 16% 32%, var(--blue) 32% 48%, transparent 48% 64%);
    opacity: .85;
  }
  #id4-tst-{{ section.id }} .id4t-cardstars { display: inline-flex; gap: 3px; }
  #id4-tst-{{ section.id }} .id4t-cardstars svg { width: 16px; height: 16px; fill: var(--gold); }
  #id4-tst-{{ section.id }} .id4t-quote { font-size: 15.5px; line-height: 1.6; margin: 0; color: var(--text); flex: 1; }
  #id4-tst-{{ section.id }} .id4t-quote::before { content: "\201C"; color: var(--spark); font-weight: 800; }
  #id4-tst-{{ section.id }} .id4t-quote::after { content: "\201D"; color: var(--spark); font-weight: 800; }
  #id4-tst-{{ section.id }} .id4t-foot { display: flex; align-items: center; gap: 12px; padding-top: 4px; border-top: 1px solid var(--line); }
  #id4-tst-{{ section.id }} .id4t-ava {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center;
    font-family: 'Anton', sans-serif; font-size: 18px; color: #fff;
    background: linear-gradient(135deg, var(--red), var(--blue));
  }
  #id4-tst-{{ section.id }} .id4t-ava img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  #id4-tst-{{ section.id }} .id4t-name { font-weight: 700; font-size: 14px; }
  #id4-tst-{{ section.id }} .id4t-meta { font-size: 12px; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
  #id4-tst-{{ section.id }} .id4t-verified { display: inline-flex; align-items: center; gap: 4px; color: var(--spark); font-weight: 700; }
  #id4-tst-{{ section.id }} .id4t-verified svg { width: 12px; height: 12px; fill: var(--spark); }

  @media (max-width: 900px) { #id4-tst-{{ section.id }} .id4t-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { #id4-tst-{{ section.id }} .id4t-grid { grid-template-columns: 1fr; } }
</style>

{%- assign star = '<svg viewBox="0 0 24 24"><path d="M12 1.5l2.9 6.4 7 .7-5.2 4.7 1.5 6.9L12 17.8 5.8 20.9l1.5-6.9L2.1 8.6l7-.7z"/></svg>' -%}

<div id="id4-tst-{{ section.id }}">
  <div class="id4t-stars-bg"></div>
  <div class="id4t-inner">
    <div class="id4t-head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="id4t-eyebrow">{{ star }} {{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 class="id4t-title">{{ section.settings.title }}</h2>
      {%- if section.settings.show_summary -%}
        <div class="id4t-summary">
          <span class="id4t-bigstars">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span>
          <span><b>{{ section.settings.rating_value }}</b> from <b>{{ section.settings.rating_count }}</b> reviews</span>
        </div>
      {%- endif -%}
    </div>

    <div class="id4t-grid">
      {%- for block in section.blocks -%}
        {%- assign rating = block.settings.rating | default: 5 -%}
        <div class="id4t-card" {{ block.shopify_attributes }}>
          <span class="id4t-cardstars">{%- for i in (1..rating) -%}{{ star }}{%- endfor -%}</span>
          <p class="id4t-quote">{{ block.settings.quote }}</p>
          <div class="id4t-foot">
            <span class="id4t-ava">
              {%- if block.settings.avatar != blank -%}
                <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="40" height="40">
              {%- else -%}
                {{ block.settings.name | slice: 0 | upcase }}
              {%- endif -%}
            </span>
            <span>
              <span class="id4t-name">{{ block.settings.name }}</span><br>
              <span class="id4t-meta">
                {{ block.settings.location }}
                {%- if block.settings.verified -%}
                  <span class="id4t-verified"><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5L4 14.2 9 19l11-11-1.4-1.4z"/></svg>Verified</span>
                {%- endif -%}
              </span>
            </span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "4th of July Testimonials",
  "tag": "div",
  "class": "independence-day-testimonials-section",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From America's Backyards" },
    { "type": "text", "id": "title", "label": "Title", "default": "Loved Coast to Coast" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.9/5" },
    { "type": "text", "id": "rating_count", "label": "Rating count", "default": "12,400+" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 84 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#141c40" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#212c54" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "color_red", "label": "Red", "default": "#e11d2f" },
    { "type": "color", "id": "color_blue", "label": "Blue", "default": "#3454c6" },
    { "type": "color", "id": "color_spark", "label": "Gold accent (QB54 gold)", "default": "#f7b80d" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Hands down the hit of our 4th of July cookout. Even Grandpa couldn't stop playing!" },
        { "type": "text", "id": "name", "label": "Name", "default": "Jordan M." },
        { "type": "text", "id": "location", "label": "Location", "default": "Austin, TX" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer badge", "default": true }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "4th of July Testimonials",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "Hands down the hit of our 4th of July cookout. Even Grandpa couldn't stop playing!", "name": "Jordan M.", "location": "Austin, TX", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "quote": "Set it up on the driveway in under a minute. The whole block came over to play.", "name": "Brittany R.", "location": "Columbus, OH", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "quote": "Best money I've spent all summer. Arrived two days before the fireworks — total game changer.", "name": "Marcus D.", "location": "San Diego, CA", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
