            <p class="shop-by-team__results-count"><span data-results-count>0</span> products</p>
          </div>

          <div class="tailgate-product-grid" data-product-grid>
            {%- for block in section.blocks -%}
              {%- assign category_collection = block.settings.collection -%}
              {%- for product in category_collection.products limit: 50 -%}
                {%- render 'tailgate-hub-product-card', product: product, category_key: block.settings.category_key, category_label: block.settings.singular_label, section_id: section.id -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>

          <div class="shop-by-team__product-empty" data-product-empty hidden>
