{%- liquid
  assign available_teams = '|'
  assign initial_team = blank
  assign total_products = 0

  for block in section.blocks
    assign category_collection = block.settings.collection
    if category_collection != blank
      assign total_products = total_products | plus: category_collection.products_count

      for product in category_collection.products limit: 50
        capture team_key
          render 'tailgate-team-key', title: product.title
        endcapture
        assign team_key = team_key | strip

        assign team_token = team_key | append: '|' | prepend: '|'
        unless available_teams contains team_token
          assign available_teams = available_teams | append: team_key | append: '|'
          # 'all' is the key for team-agnostic products (e.g. the All 32 NFL
          # Teams ball). It has no logo button, so never open the section on it.
          if initial_team == blank and team_key != 'all'
            assign initial_team = team_key
          endif
        endunless
      endfor
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sbt-ink: {{ section.settings.color_text }};
    --sbt-paper: {{ section.settings.color_background }};
    --sbt-card: {{ section.settings.color_card_background }};
    --sbt-accent: {{ section.settings.color_accent }};
    --sbt-cta-bg: {{ section.settings.color_button_background }};
    --sbt-cta-text: {{ section.settings.color_button_text }};
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .shop-by-team {
    color: var(--sbt-ink);
    background: var(--sbt-paper);
  }

  #shopify-section-{{ section.id }} .shop-by-team__intro {
    max-width: 620px;
    margin: -8px auto 28px;
    color: rgb(var(--color-foreground) / 0.68);
    font-size: 15px;
    line-height: 1.6;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .shop-by-team__rail-wrap {
    position: relative;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} .shop-by-team__rail {
    display: flex;
    padding: 4px 4px 14px;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .shop-by-team__rail::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .tailgate-team {
    appearance: none;
    display: flex;
    width: 96px;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 6px 4px 0;
    color: var(--sbt-ink);
    background: transparent;
    border: 0;
    cursor: pointer;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .tailgate-team__logo-frame {
    position: relative;
    display: flex;
    width: 76px;
    height: 76px;
    align-items: center;
    justify-content: center;
    background: var(--sbt-card);
    border: 2px solid transparent;
    border-radius: 50%;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  #shopify-section-{{ section.id }} .tailgate-team:hover .tailgate-team__logo-frame {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgb(0 0 0 / 0.14);
  }

  #shopify-section-{{ section.id }} .tailgate-team.is-active .tailgate-team__logo-frame {
    border-color: var(--sbt-accent);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.16);
  }

  #shopify-section-{{ section.id }} .tailgate-team:focus-visible .tailgate-team__logo-frame {
    outline: 3px solid var(--sbt-accent);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .tailgate-team__monogram {
    position: absolute;
    display: flex;
    inset: 0;
    align-items: center;
    justify-content: center;
    color: var(--sbt-accent);
    font-size: 15px;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .tailgate-team__logo {
    position: relative;
    z-index: 1;
    width: 62px;
    height: 62px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .tailgate-team__name {
    display: -webkit-box;
    overflow: hidden;
    color: rgb(var(--color-foreground) / 0.75);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color 180ms ease;
  }

  #shopify-section-{{ section.id }} .tailgate-team.is-active .tailgate-team__name {
    color: var(--sbt-ink);
  }

  #shopify-section-{{ section.id }} .shop-by-team__results-header {
    display: flex;
    margin-bottom: 20px;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .shop-by-team__results-label {
    margin: 0 0 4px;
    color: rgb(var(--color-foreground) / 0.55);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .shop-by-team__results-title {
    margin: 0;
    font-size: clamp(22px, 3vw, 32px);
  }

  #shopify-section-{{ section.id }} .shop-by-team__results-count {
    flex: 0 0 auto;
    color: rgb(var(--color-foreground) / 0.55);
    font-size: 12px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .tailgate-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px 16px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card {
    min-width: 0;
    color: var(--sbt-ink);
    background: var(--sbt-card);
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card:hover {
    box-shadow: 0 10px 26px rgb(0 0 0 / 0.1);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__media {
    position: relative;
    display: flex;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    padding: 10px;
    background: #ffffff;
    overflow: hidden;
  }

  /* margin:auto centres the image even if a global `img{height:auto}` rule
     wins over the height below, which otherwise top-aligns landscape shots. */
  #shopify-section-{{ section.id }} .tailgate-hub-card__image,
  #shopify-section-{{ section.id }} .tailgate-hub-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
    margin: auto;
    object-fit: contain;
    object-position: center center;
    transition: transform 240ms ease;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card:hover .tailgate-hub-card__image {
    transform: scale(1.045);
  }

  /* The theme sets aria-busy on the button while /cart/add.js is in flight but
     never styled it, so the button looked dead for the whole round-trip. */
  #shopify-section-{{ section.id }} .tailgate-hub-card__add[aria-busy='true'] {
    cursor: progress;
    opacity: 0.75;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add[aria-busy='true'] svg {
    display: none;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add[aria-busy='true']::after {
    content: '';
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: tailgate-atc-spin 0.6s linear infinite;
  }

  @keyframes tailgate-atc-spin {
    to { transform: rotate(360deg); }
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__category,
  #shopify-section-{{ section.id }} .tailgate-hub-card__sale {
    position: absolute;
    top: 10px;
    display: inline-flex;
    min-height: 24px;
    padding: 5px 9px;
    align-items: center;
    background: var(--sbt-accent);
    border-radius: 999px;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__category {
    left: 10px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__sale {
    right: 10px;
    color: var(--sbt-ink);
    background: var(--sbt-cta-bg);
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__content {
    padding: 14px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__meta {
    display: none;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__title {
    min-height: 38px;
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__title a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__price {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__actions {
    display: grid;
    margin-top: 12px;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add,
  #shopify-section-{{ section.id }} .tailgate-hub-card__view {
    display: inline-flex;
    min-height: 44px;
    padding: 8px 10px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add {
    width: 100%;
    color: var(--sbt-cta-text);
    background: var(--sbt-cta-bg);
    border: 1px solid var(--sbt-cta-bg);
    transition: opacity 160ms ease;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__view {
    color: var(--sbt-ink);
    background: transparent;
    border: 1px solid rgb(var(--color-foreground) / 0.18);
  }

  #shopify-section-{{ section.id }} .shop-by-team__product-empty {
    padding: 48px 24px;
    color: rgb(var(--color-foreground) / 0.62);
    background: var(--sbt-card);
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    border-radius: 14px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .shop-by-team__product-empty[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .shop-by-team__footer {
    display: flex;
    margin-top: 36px;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .shop-by-team__view-all {
    display: inline-flex;
    min-height: 52px;
    padding: 14px 26px;
    align-items: center;
    gap: 10px;
    color: var(--sbt-ink);
    background: transparent;
    border: 1px solid rgb(var(--color-foreground) / 0.22);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  #shopify-section-{{ section.id }} .shop-by-team__view-all:hover {
    border-color: var(--sbt-accent);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .tailgate-product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .shop-by-team__rail {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .tailgate-team {
      width: 82px;
    }

    #shopify-section-{{ section.id }} .tailgate-team__logo-frame {
      width: 64px;
      height: 64px;
    }

    #shopify-section-{{ section.id }} .tailgate-team__logo {
      width: 52px;
      height: 52px;
    }

    #shopify-section-{{ section.id }} .shop-by-team__results-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .tailgate-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 10px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__content {
      padding: 10px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__title {
      min-height: 34px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__actions {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__view {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .tailgate-team,
    #shopify-section-{{ section.id }} .tailgate-team__logo-frame,
    #shopify-section-{{ section.id }} .tailgate-hub-card,
    #shopify-section-{{ section.id }} .tailgate-hub-card__image,
    #shopify-section-{{ section.id }} .tailgate-hub-card__add,
    #shopify-section-{{ section.id }} .shop-by-team__view-all {
      transition: none;
    }
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="shop-by-team page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- render 'section-heading', section: section -%}

    {%- if section.settings.subheading != blank -%}
      <p class="shop-by-team__intro">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if initial_team != blank -%}
      <shop-by-team data-initial-team="{{ initial_team | escape }}">
        <div class="shop-by-team__rail-wrap">
          <div class="shop-by-team__rail" role="tablist" aria-label="Choose your NFL team">
