            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'chiefs', team_name: 'Kansas City Chiefs', short_name: 'Chiefs', abbreviation: 'KC', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Kansas_City_Chiefs_Logo.png' -%}
