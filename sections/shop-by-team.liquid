            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'ravens', team_name: 'Baltimore Ravens', short_name: 'Ravens', abbreviation: 'BAL', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Baltimore_Ravens_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'bills', team_name: 'Buffalo Bills', short_name: 'Bills', abbreviation: 'BUF', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Buffalo_Bills_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'panthers', team_name: 'Carolina Panthers', short_name: 'Panthers', abbreviation: 'CAR', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Carolina_Panthers_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'bears', team_name: 'Chicago Bears', short_name: 'Bears', abbreviation: 'CHI', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Chicago_Bears_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'bengals', team_name: 'Cincinnati Bengals', short_name: 'Bengals', abbreviation: 'CIN', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Cinncinati_Bengals_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'browns', team_name: 'Cleveland Browns', short_name: 'Browns', abbreviation: 'CLE', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Cleveland_Browns_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'cowboys', team_name: 'Dallas Cowboys', short_name: 'Cowboys', abbreviation: 'DAL', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Dallas_Cowboys_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'broncos', team_name: 'Denver Broncos', short_name: 'Broncos', abbreviation: 'DEN', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Denver_Broncos_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'lions', team_name: 'Detroit Lions', short_name: 'Lions', abbreviation: 'DET', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Detroit_Lions_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'packers', team_name: 'Green Bay Packers', short_name: 'Packers', abbreviation: 'GB', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Green_Bay_Packers_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'texans', team_name: 'Houston Texans', short_name: 'Texans', abbreviation: 'HOU', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Houston_Texans_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'colts', team_name: 'Indianapolis Colts', short_name: 'Colts', abbreviation: 'IND', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Indianapolis_Colts_Logo.png' -%}
