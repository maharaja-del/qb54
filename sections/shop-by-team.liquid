            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'seahawks', team_name: 'Seattle Seahawks', short_name: 'Seahawks', abbreviation: 'SEA', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Seattle_Seahawks_Logo.png' -%}
