            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'patriots', team_name: 'New England Patriots', short_name: 'Patriots', abbreviation: 'NE', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/New_England_Patriots_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'saints', team_name: 'New Orleans Saints', short_name: 'Saints', abbreviation: 'NO', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/New_Orleans_Saints.jpg?v=1785794140' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'giants', team_name: 'New York Giants', short_name: 'Giants', abbreviation: 'NYG', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/New_York_Giants.jpg?v=1785794141' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'jets', team_name: 'New York Jets', short_name: 'Jets', abbreviation: 'NYJ', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/New_York_jets.jpg?v=1785794141' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'eagles', team_name: 'Philadelphia Eagles', short_name: 'Eagles', abbreviation: 'PHI', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Philadelphia_Eagles_Logo.png' -%}
            {%- render 'tailgate-hub-team-button', available_teams: available_teams, initial_team: initial_team, section_id: section.id, team_key: 'steelers', team_name: 'Pittsburgh Steelers', short_name: 'Steelers', abbreviation: 'PIT', logo_url: 'https://cdn.shopify.com/s/files/1/1444/0224/files/Pittsburgh_Steelers_Logo.png' -%}
