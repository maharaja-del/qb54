<script>
  if (!customElements.get('shop-by-team')) {
    customElements.define(
      'shop-by-team',
      class ShopByTeam extends HTMLElement {
        connectedCallback() {
          this.teamButtons = Array.from(this.querySelectorAll('[data-tailgate-team]'));
          this.productCards = Array.from(this.querySelectorAll('[data-tailgate-product]'));
          this.selectedTeamLabel = this.querySelector('[data-selected-team]');
          this.resultsCount = this.querySelector('[data-results-count]');
          this.emptyState = this.querySelector('[data-product-empty]');
          this.resultsSection = this.querySelector('[role="tabpanel"]');

          this.querySelectorAll('[data-tailgate-team-logo]').forEach((logo) => {
            const hideBrokenLogo = () => { logo.hidden = true; };
            logo.addEventListener('error', hideBrokenLogo, { once: true });
            if (logo.complete && logo.naturalWidth === 0) hideBrokenLogo();
          });

          this.teamButtons.forEach((button, index) => {
            button.addEventListener('click', () => {
              this.selectTeam(button.dataset.team, button.dataset.teamName);
              button.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            });
            button.addEventListener('keydown', (event) => this.onKeydown(event, index));
          });

          const initialButton = this.teamButtons.find((button) => button.dataset.team === this.dataset.initialTeam) || this.teamButtons[0];
          if (initialButton) this.selectTeam(initialButton.dataset.team, initialButton.dataset.teamName);
        }

        selectTeam(team, teamName) {
          this.activeTeam = team;

          this.teamButtons.forEach((button) => {
            const active = button.dataset.team === team;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-selected', active ? 'true' : 'false');
            button.setAttribute('tabindex', active ? '0' : '-1');
          });

          if (this.selectedTeamLabel) this.selectedTeamLabel.textContent = teamName;
          this.renderProducts();
        }

        renderProducts() {
          let visibleCount = 0;

          this.productCards.forEach((card) => {
            // 'all' marks a team-agnostic product (the All 32 NFL Teams ball),
            // so it stays visible whichever team is selected.
            const visible = card.dataset.team === this.activeTeam || card.dataset.team === 'all';
            card.hidden = !visible;
            card.setAttribute('aria-hidden', visible ? 'false' : 'true');
            if (visible) visibleCount += 1;
          });

          if (this.resultsCount) this.resultsCount.textContent = visibleCount;
          if (this.emptyState) this.emptyState.hidden = visibleCount !== 0;
        }

        onKeydown(event, index) {
          let nextIndex = index;

          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            nextIndex = (index + 1) % this.teamButtons.length;
          } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            nextIndex = (index - 1 + this.teamButtons.length) % this.teamButtons.length;
          } else if (event.key === 'Home') {
            nextIndex = 0;
          } else if (event.key === 'End') {
            nextIndex = this.teamButtons.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          const nextButton = this.teamButtons[nextIndex];
          this.selectTeam(nextButton.dataset.team, nextButton.dataset.teamName);
          nextButton.focus();
        }
      }
    );
  }
</script>

