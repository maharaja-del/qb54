{% liquid
  assign id = section.id
%}

<section class="occasions-{{ id }}">
  <div class="page-width">
    <div class="header">
      <h2 class="heading">{{ section.settings.heading }}</h2>
      <p class="subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="cards">
      {% for block in section.blocks %}
        <div class="card" {{ block.shopify_attributes }}>
          <div class="icon">
            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | image_url: width: 80 }}"
                alt=""
                width="40"
                height="40"
                loading="lazy">
            {% endif %}
          </div>
          <h3 class="title">{{ block.settings.title }}</h3>
          <p class="text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>

  <style>
    .occasions-{{ id }} {
      background: {{ section.settings.background }};
      padding: {{ section.settings.padding_mobile }}px 0;
      text-align: center;
    }

    .occasions-{{ id }} .header {
      max-width: 760px;
      margin: 0 auto 56px;
    }

    .occasions-{{ id }} .heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      margin-bottom: 12px;
    }

    .occasions-{{ id }} .subheading {
      font-size: {{ section.settings.subheading_size_mobile }}px;
      color: {{ section.settings.subheading_color }};
    }

    .occasions-{{ id }} .cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .occasions-{{ id }} .card {
      background: {{ section.settings.card_bg }};
      border-radius: {{ section.settings.card_radius }}px;
      padding: 32px 24px;
      text-align: left;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .occasions-{{ id }} .icon {
      background: {{ section.settings.icon_bg }};
      width: 56px;
      height: 56px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }

    .occasions-{{ id }} .title {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .occasions-{{ id }} .text {
      font-size: 15px;
      color: {{ section.settings.text_color }};
      line-height: 1.6;
    }

    @media (min-width: 750px) {
      .occasions-{{ id }} {
        padding: {{ section.settings.padding_desktop }}px 0;
      }

      .occasions-{{ id }} .heading {
        font-size: {{ section.settings.heading_size_desktop }}px;
      }

      .occasions-{{ id }} .subheading {
        font-size: {{ section.settings.subheading_size_desktop }}px;
      }

      .occasions-{{ id }} .cards {
        grid-template-columns: repeat(4, 1fr);
        gap: 32px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Perfect Occasions",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perfect for Every Occasion"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From your backyard to the beach, QB54 turns any gathering into an unforgettable experience."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#faf9f5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon background",
      "default": "#e7ede6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6b7f72"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 24,
      "max": 44,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 32,
      "max": 64,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size mobile",
      "min": 14,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading size desktop",
      "min": 16,
      "max": 26,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Section padding mobile",
      "min": 40,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Section padding desktop",
      "min": 80,
      "max": 200,
      "step": 4,
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tailgate Parties"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Bring QB54 to your next tailgate. Unfold, play, and fold back into chairs when the game starts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perfect Occasions",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
