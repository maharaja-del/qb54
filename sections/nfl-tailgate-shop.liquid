<script>
  if (!customElements.get('nfl-tailgate-shop')) {
    customElements.define(
      'nfl-tailgate-shop',
      class NflTailgateShop extends HTMLElement {
        connectedCallback() {
          this.teamButtons = Array.from(this.querySelectorAll('[data-tailgate-team]'));
          this.categoryButtons = Array.from(this.querySelectorAll('[data-category-filter]'));
          this.categoryIntents = Array.from(this.querySelectorAll('[data-category-intent]'));
          this.productCards = Array.from(this.querySelectorAll('[data-tailgate-product]'));
          this.selectedTeamLabel = this.querySelector('[data-selected-team]');
          this.resultsCount = this.querySelector('[data-results-count]');
          this.emptyState = this.querySelector('[data-product-empty]');
          this.teamSection = this.querySelector('#choose-your-team');
          this.resultsSection = this.querySelector('.tailgate-team-locker');
          this.activeCategory = 'all';

          this.querySelectorAll('[data-tailgate-team-logo]').forEach((logo) => {
            const hideBrokenLogo = () => { logo.hidden = true; };
            logo.addEventListener('error', hideBrokenLogo, { once: true });
            if (logo.complete && logo.naturalWidth === 0) hideBrokenLogo();
          });

          this.teamButtons.forEach((button, index) => {
            button.addEventListener('click', () => {
              this.selectTeam(button.dataset.team, button.dataset.teamName);
              this.resultsSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
            button.addEventListener('keydown', (event) => this.onTeamKeydown(event, index));
          });

          this.categoryButtons.forEach((button) => {
            button.addEventListener('click', () => {
              if (!button.disabled) this.selectCategory(button.dataset.categoryFilter);
            });
          });

          this.categoryIntents.forEach((link) => {
            link.addEventListener('click', (event) => {
              event.preventDefault();
              const category = link.dataset.categoryIntent;
              const currentHasCategory = this.productCards.some(
                (card) => card.dataset.team === this.activeTeam && card.dataset.category === category
              );

              if (!currentHasCategory) {
                const firstMatch = this.productCards.find((card) => card.dataset.category === category);
                if (firstMatch) {
                  const matchingButton = this.teamButtons.find((button) => button.dataset.team === firstMatch.dataset.team);
                  if (matchingButton) this.selectTeam(matchingButton.dataset.team, matchingButton.dataset.teamName);
                }
              }

              this.selectCategory(category);
              this.teamSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          });

          const initialButton = this.teamButtons.find((button) => button.dataset.team === this.dataset.initialTeam) || this.teamButtons[0];
          if (initialButton) this.selectTeam(initialButton.dataset.team, initialButton.dataset.teamName);
        }

        selectTeam(team, teamName) {
          this.activeTeam = team;

          this.teamButtons.forEach((button) => {
            const active = button.dataset.team === team;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-selected', active ? 'true' : 'false');
            button.setAttribute('tabindex', active ? '0' : '-1');
          });

          if (this.selectedTeamLabel) this.selectedTeamLabel.textContent = teamName;
          this.updateCategoryAvailability();
          this.renderProducts();
        }

        selectCategory(category) {
          const targetButton = this.categoryButtons.find((button) => button.dataset.categoryFilter === category);
          if (!targetButton || targetButton.disabled) category = 'all';
          this.activeCategory = category;

          this.categoryButtons.forEach((button) => {
            const active = button.dataset.categoryFilter === category;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
          });

          this.renderProducts();
        }

        updateCategoryAvailability() {
          const teamCards = this.productCards.filter((card) => card.dataset.team === this.activeTeam);

          this.categoryButtons.forEach((button) => {
            const category = button.dataset.categoryFilter;
            const count = category === 'all'
              ? teamCards.length
              : teamCards.filter((card) => card.dataset.category === category).length;
            const counter = button.querySelector('[data-category-count]');
            if (counter) counter.textContent = count;
            button.disabled = count === 0;
          });

          const activeButton = this.categoryButtons.find((button) => button.dataset.categoryFilter === this.activeCategory);
          if (!activeButton || activeButton.disabled) this.activeCategory = 'all';

          this.categoryButtons.forEach((button) => {
            const active = button.dataset.categoryFilter === this.activeCategory;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        }

        renderProducts() {
          let visibleCount = 0;

          this.productCards.forEach((card) => {
            const teamMatch = card.dataset.team === this.activeTeam;
            const categoryMatch = this.activeCategory === 'all' || card.dataset.category === this.activeCategory;
            const visible = teamMatch && categoryMatch;
            card.hidden = !visible;
            card.setAttribute('aria-hidden', visible ? 'false' : 'true');
            if (visible) visibleCount += 1;
          });

          if (this.resultsCount) this.resultsCount.textContent = visibleCount;
          if (this.emptyState) this.emptyState.hidden = visibleCount !== 0;
        }

        onTeamKeydown(event, index) {
          let nextIndex = index;

          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            nextIndex = (index + 1) % this.teamButtons.length;
          } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            nextIndex = (index - 1 + this.teamButtons.length) % this.teamButtons.length;
          } else if (event.key === 'Home') {
            nextIndex = 0;
          } else if (event.key === 'End') {
            nextIndex = this.teamButtons.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          const nextButton = this.teamButtons[nextIndex];
          this.selectTeam(nextButton.dataset.team, nextButton.dataset.teamName);
          nextButton.focus();
        }
      }
    );
  }
</script>

