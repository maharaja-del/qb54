    display: none;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--hub-cream);
    border-bottom: 1px solid var(--hub-line);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 240ms ease;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card:hover .tailgate-hub-card__image {
    transform: scale(1.045);
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__category,
  #shopify-section-{{ section.id }} .tailgate-hub-card__sale {
    position: absolute;
    top: 12px;
    display: inline-flex;
    min-height: 28px;
    padding: 7px 9px;
    align-items: center;
    color: var(--hub-white);
    background: var(--hub-ink);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__category {
    left: 12px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__sale {
    right: 12px;
    color: var(--hub-ink);
    background: var(--hub-accent);
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__content {
    padding: 18px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__meta {
    display: flex;
    color: rgb(15 20 36/0.48);
    gap: 7px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__title {
    min-height: 48px;
    margin: 9px 0 0;
    font-family: var(--font-heading-family, inherit);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__title a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__price {
    margin-top: 12px;
    font-size: 16px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__actions {
    display: grid;
    margin-top: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add,
  #shopify-section-{{ section.id }} .tailgate-hub-card__view {
    display: inline-flex;
    min-height: 46px;
    padding: 10px 14px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add {
    width: 100%;
    color: var(--hub-white);
    background: var(--hub-ink);
    border: 1px solid var(--hub-ink);
    transition: color 160ms ease, background 160ms ease;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add:hover {
    color: var(--hub-ink);
    background: var(--hub-accent);
    border-color: var(--hub-accent);
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__add svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .tailgate-hub-card__view {
    color: var(--hub-ink);
    background: transparent;
    border: 1px solid var(--hub-line);
  }

  #shopify-section-{{ section.id }} .tailgate-product-empty {
    padding: 56px 24px;
    color: rgb(15 20 36/0.62);
    background: var(--hub-cream);
    border: 1px solid var(--hub-line);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .tailgate-product-empty[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .tailgate-proof-strip {
    color: var(--hub-white);
    background: var(--hub-ink);
    border-top: 1px solid rgb(255 255 255/0.16);
  }

  #shopify-section-{{ section.id }} .tailgate-proof-strip__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  #shopify-section-{{ section.id }} .tailgate-proof {
    display: grid;
    min-height: 160px;
    padding: 34px;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .tailgate-proof + .tailgate-proof {
    border-left: 1px solid rgb(255 255 255/0.16);
  }

  #shopify-section-{{ section.id }} .tailgate-proof__icon {
    display: flex;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    color: var(--hub-accent);
    background: rgb(255 255 255/0.08);
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .tailgate-proof__icon svg {
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .tailgate-proof h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tailgate-proof p {
    margin: 9px 0 0;
    color: rgb(255 255 255/0.62);
    font-size: 13px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .tailgate-final-cta {
    position: relative;
    color: var(--hub-ink);
    background: var(--hub-accent);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .tailgate-final-cta::after {
    position: absolute;
    right: -60px;
    bottom: -120px;
    color: rgb(15 20 36/0.08);
    content: '54';
    font-size: clamp(240px, 38vw, 560px);
    font-weight: 900;
    letter-spacing: -0.12em;
    line-height: 0.7;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tailgate-final-cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 360px;
    padding-block: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  #shopify-section-{{ section.id }} .tailgate-final-cta__title {
    max-width: 900px;
    margin: 0;
    font-size: clamp(48px, 7vw, 100px);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.86;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .tailgate-final-cta .tailgate-hub-button {
    flex: 0 0 auto;
    color: var(--hub-white);
    background: var(--hub-ink);
    border-color: var(--hub-ink);
  }

  #shopify-section-{{ section.id }} .tailgate-final-cta .tailgate-hub-button:hover {
    color: var(--hub-ink);
    background: var(--hub-white);
    border-color: var(--hub-white);
  }

  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .tailgate-hub-hero__inner {
      min-height: 700px;
      grid-template-columns: minmax(0, 1fr) minmax(420px, 0.8fr);
    }

    #shopify-section-{{ section.id }} .tailgate-category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .tailgate-team-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .tailgate-product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .tailgate-hub-hero__inner {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-hero__copy {
      max-width: 760px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-hero__visual {
      width: min(100%, 640px);
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .tailgate-team-shop__intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .tailgate-team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .tailgate-proof-strip__inner {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .tailgate-proof + .tailgate-proof {
      border-top: 1px solid rgb(255 255 255/0.16);
      border-left: 0;
    }

    #shopify-section-{{ section.id }} .tailgate-final-cta__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .tailgate-shell {
      width: min(100% - 28px, 1440px);
    }

    #shopify-section-{{ section.id }} .tailgate-showcase-card {
      width: 156px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-hero__inner {
      min-height: 0;
      padding-block: 64px 48px;
      gap: 42px;
    }

    #shopify-section-{{ section.id }} .tailgate-display {
      font-size: clamp(48px, 15vw, 72px);
    }

    #shopify-section-{{ section.id }} .tailgate-hub-hero__intro {
      margin-top: 22px;
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-button {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-hero__meta {
      margin-top: 34px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-stat {
      padding-right: 12px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-stat + .tailgate-hub-stat {
      padding-left: 12px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-stat strong {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-stat span {
      font-size: 8px;
    }

    #shopify-section-{{ section.id }} .tailgate-hero-stack {
      height: 430px;
    }

    #shopify-section-{{ section.id }} .tailgate-hero-card {
      padding: 9px;
    }

    #shopify-section-{{ section.id }} .tailgate-hero-card__label {
      padding-top: 8px;
      font-size: 8px;
    }

    #shopify-section-{{ section.id }} .tailgate-category-ticker__inner {
      min-height: 54px;
      padding-block: 10px;
      gap: 8px 16px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .tailgate-category-ticker__item {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .tailgate-section-head {
      margin-bottom: 30px;
      align-items: flex-start;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .tailgate-category-grid {
      grid-template-columns: 1fr 1fr;
    }

    #shopify-section-{{ section.id }} .tailgate-category-card {
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .tailgate-category-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    #shopify-section-{{ section.id }} .tailgate-category-card__title {
      font-size: 21px;
    }

    #shopify-section-{{ section.id }} .tailgate-category-card__kicker {
      min-height: 0;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .tailgate-team-shop__intro {
      margin-bottom: 32px;
    }

    #shopify-section-{{ section.id }} .tailgate-team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .tailgate-team {
      min-height: 116px;
      padding: 12px 6px 10px;
    }

    #shopify-section-{{ section.id }} .tailgate-team__logo-frame {
      width: 58px;
      height: 58px;
    }

    #shopify-section-{{ section.id }} .tailgate-team-locker {
      margin-top: 46px;
      padding-top: 30px;
    }

    #shopify-section-{{ section.id }} .tailgate-team-locker__head {
      margin-bottom: 24px;
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .tailgate-team-locker__title {
      font-size: 40px;
    }

    #shopify-section-{{ section.id }} .tailgate-category-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .tailgate-category-filters::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .tailgate-category-filter {
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .tailgate-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 10px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__content {
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__meta {
      display: none;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__title {
      min-height: 42px;
      margin-top: 0;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__price {
      margin-top: 8px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__actions {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__view {
      display: none;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__add {
      min-height: 42px;
      padding-inline: 8px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .tailgate-hub-card__add svg {
      display: none;
    }

    #shopify-section-{{ section.id }} .tailgate-proof {
      min-height: 0;
      padding: 28px 0;
    }

    #shopify-section-{{ section.id }} .tailgate-final-cta__inner {
      min-height: 340px;
      padding-block: 60px;
    }

    #shopify-section-{{ section.id }} .tailgate-final-cta__title {
      font-size: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .tailgate-hub-button,
    #shopify-section-{{ section.id }} .tailgate-hero-card__image,
    #shopify-section-{{ section.id }} .tailgate-category-card,
    #shopify-section-{{ section.id }} .tailgate-category-card__image,
    #shopify-section-{{ section.id }} .tailgate-team,
    #shopify-section-{{ section.id }} .tailgate-hub-card__image,
    #shopify-section-{{ section.id }} .tailgate-hub-card__add {
      transition: none;
    }
  }
</style>

<nfl-tailgate-shop class="nfl-tailgate-shop" data-initial-team="{{ initial_team | escape }}">
  <section class="tailgate-hub-hero">
    <div class="tailgate-shell tailgate-hub-hero__inner">
      <div class="tailgate-hub-hero__copy">
        <p class="tailgate-kicker">{{ section.settings.eyebrow | escape }}</p>
        <h1 class="tailgate-display">
          {{ section.settings.heading_line_1 | escape }}
          <em>{{ section.settings.heading_line_2 | escape }}</em>
        </h1>
        <div class="tailgate-hub-hero__intro rte">{{ section.settings.intro }}</div>

        <div class="tailgate-hub-hero__actions">
          <a class="tailgate-hub-button" href="#choose-your-team">
            Choose Your Team
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 3v13M5 11l5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
            </svg>
          </a>
        </div>

        <div class="tailgate-hub-hero__meta" aria-label="Collection highlights">
          <div class="tailgate-hub-stat">
            <strong>{{ section.blocks.size }}</strong>
            <span>Product categories</span>
          </div>
          <div class="tailgate-hub-stat">
            <strong>{{ total_products }}</strong>
            <span>Team products</span>
          </div>
          <div class="tailgate-hub-stat">
            <strong>1</strong>
            <span>Complete game-day shop</span>
          </div>
        </div>
      </div>

      <div class="tailgate-hub-hero__visual" aria-label="Tailgate product categories">
        <div class="tailgate-hero-stack">
          {%- for block in section.blocks limit: 5 -%}
            {%- assign sample_product = block.settings.collection.products.first -%}
            <a class="tailgate-hero-card" href="#choose-your-team" data-category-intent="{{ block.settings.category_key | escape }}">
              <span class="tailgate-hero-card__media">
                {%- if sample_product.featured_image != blank -%}
                  {{- sample_product.featured_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'eager',
                      widths: '240,360,480,600,700',
                      sizes: '(max-width: 749px) 42vw, 24vw',
                      alt: sample_product.featured_image.alt | default: sample_product.title,
                      class: 'tailgate-hero-card__image'
                  -}}
                {%- else -%}
                  {{- 'product-1' | placeholder_svg_tag: 'tailgate-hero-card__image placeholder' -}}
                {%- endif -%}
              </span>
              <span class="tailgate-hero-card__label">
                <span>{{ block.settings.label | escape }}</span>
                <span>Shop by team</span>
              </span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <div class="tailgate-category-ticker" aria-label="Available categories">
    <div class="tailgate-shell tailgate-category-ticker__inner">
      {%- for block in section.blocks -%}
        <span class="tailgate-category-ticker__item">{{ block.settings.label | escape }}</span>
      {%- endfor -%}
    </div>
  </div>

  {%- liquid
    assign category_count = section.blocks.size
    case category_count
      when 1
        assign category_count_word = 'One'
      when 2
        assign category_count_word = 'Two'
      when 3
        assign category_count_word = 'Three'
      when 4
        assign category_count_word = 'Four'
      when 5
        assign category_count_word = 'Five'
      when 6
        assign category_count_word = 'Six'
      else
        assign category_count_word = category_count
    endcase
  -%}
  <section class="tailgate-category-showcase" aria-labelledby="TailgateCategories-{{ section.id }}">
    <div class="tailgate-shell">
      <header class="tailgate-section-head">
        <div class="tailgate-section-head__copy">
          <p class="tailgate-kicker">The complete setup</p>
          <h2 id="TailgateCategories-{{ section.id }}" class="tailgate-section-title">{{ category_count_word }} ways to show up.</h2>
          <p class="tailgate-section-copy">Start with a category or go straight to your team. Every product below stays connected to the collection you manage in Shopify.</p>
        </div>
      </header>

      <div class="tailgate-category-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign category_collection = block.settings.collection
            assign sample_product = category_collection.products.first
          -%}
          <a
            class="tailgate-category-card"
            href="#choose-your-team"
            data-category-intent="{{ block.settings.category_key | escape }}"
            {{ block.shopify_attributes }}
          >
            <span class="tailgate-category-card__media">
              {%- if sample_product.featured_image != blank -%}
                {{- sample_product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    widths: '240,360,480,600,700',
                    sizes: '(max-width: 749px) 50vw, 20vw',
                    alt: sample_product.featured_image.alt | default: sample_product.title,
                    class: 'tailgate-category-card__image'
                -}}
              {%- else -%}
                {{- 'product-1' | placeholder_svg_tag: 'tailgate-category-card__image placeholder' -}}
              {%- endif -%}
            </span>
            <span class="tailgate-category-card__content">
              <span class="tailgate-category-card__count">{{ category_collection.products_count }} products</span>
              <span class="tailgate-category-card__title">{{ block.settings.label | escape }}</span>
              <span class="tailgate-category-card__kicker">{{ block.settings.kicker | escape }}</span>
              <span class="tailgate-category-card__action">
                Choose a team
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                </svg>
              </span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="tailgate-showcase" aria-labelledby="TailgateShowcase-{{ section.id }}">
    <div class="tailgate-shell">
      <header class="tailgate-section-head">
        <div class="tailgate-section-head__copy">
          <p class="tailgate-kicker">Shop the full lineup</p>
          <h2 id="TailgateShowcase-{{ section.id }}" class="tailgate-section-title">A closer look at every category.</h2>
          <p class="tailgate-section-copy">Real products, straight from your collections. Browse by category now, or jump to your team below.</p>
        </div>
      </header>

      {%- for block in section.blocks -%}
        {%- assign category_collection = block.settings.collection -%}
        {%- if category_collection.products_count > 0 -%}
          <div class="tailgate-showcase-row">
            <div class="tailgate-showcase-row__head">
              <h3 class="tailgate-showcase-row__title">{{ block.settings.label | escape }}</h3>
              <a class="tailgate-showcase-row__link" href="{{ category_collection.url }}">
                View all
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                </svg>
              </a>
            </div>
            <div class="tailgate-showcase-rail">
              {%- for product in category_collection.products limit: 8 -%}
                <a class="tailgate-showcase-card" href="{{ product.url }}">
                  <span class="tailgate-showcase-card__media">
                    {%- if product.featured_image != blank -%}
                      {{- product.featured_image
                        | image_url: width: 500
                        | image_tag:
                          loading: 'lazy',
                          widths: '240,320,400,500',
                          sizes: '(max-width: 749px) 46vw, 220px',
                          alt: product.featured_image.alt | default: product.title,
                          class: 'tailgate-showcase-card__image'
                      -}}
                    {%- else -%}
                      {{- 'product-1' | placeholder_svg_tag: 'tailgate-showcase-card__image placeholder' -}}
                    {%- endif -%}
                  </span>
                  <span class="tailgate-showcase-card__title">{{ product.title | escape }}</span>
                  <span class="tailgate-showcase-card__price">{%- render 'product-price', product: product -%}</span>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section id="choose-your-team" class="tailgate-team-shop" aria-labelledby="TailgateTeamHeading-{{ section.id }}">
    <div class="tailgate-shell">
