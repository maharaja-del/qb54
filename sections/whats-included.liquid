{% assign sid = section.id %}

<section class="whats-included-{{ sid }}">
  <div class="whats-included__inner">
    {% if section.settings.heading != blank %}
      <h2 class="whats-included__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="whats-included__grid">
      {% for block in section.blocks %}
        <div class="whats-included__item" {{ block.shopify_attributes }}>
          <div
            class="whats-included__icon"
            style="background-color: {{ section.settings.icon_bg }};"
          >
            {% if block.settings.icon_image != blank %}
              <img
                src="{{ block.settings.icon_image | image_url: width: 120 }}"
                alt="{{ block.settings.icon_alt | escape }}"
                loading="lazy"
                width="56"
                height="56"
              >
            {% endif %}
          </div>

          <h3 class="whats-included__title">{{ block.settings.title }}</h3>
          <p class="whats-included__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.whats-included-{{ sid }} {
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
}

.whats-included-{{ sid }} .whats-included__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  text-align: center;
}

.whats-included-{{ sid }} .whats-included__heading {
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size_mobile }}px;
  margin-bottom: 40px;
}

.whats-included-{{ sid }} .whats-included__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}

.whats-included-{{ sid }} .whats-included__item {
  color: {{ section.settings.text_color }};
}

.whats-included-{{ sid }} .whats-included__icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: {{ section.settings.icon_radius }}px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.whats-included-{{ sid }} .whats-included__icon img {
  max-width: 56%;
  max-height: 56%;
  display: block;
}

.whats-included-{{ sid }} .whats-included__title {
  font-size: {{ section.settings.title_size_mobile }}px;
  color: {{ section.settings.title_color }};
  margin-bottom: 6px;
}

.whats-included-{{ sid }} .whats-included__text {
  font-size: {{ section.settings.text_size_mobile }}px;
}

@media (min-width: 768px) {
  .whats-included-{{ sid }} .whats-included__heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
  }

  .whats-included-{{ sid }} .whats-included__grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .whats-included-{{ sid }} .whats-included__title {
    font-size: {{ section.settings.title_size_desktop }}px;
  }

  .whats-included-{{ sid }} .whats-included__text {
    font-size: {{ section.settings.text_size_desktop }}px;
  }
}
</style>

{% schema %}
{
  "name": "What's included",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Included"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#4F7A57"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#D7E3DA"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon background",
      "default": "#6F9477"
    },
    {
      "type": "range",
      "id": "icon_radius",
      "label": "Icon radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 18,
      "max": 36,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 28,
      "max": 56,
      "step": 1,
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size mobile",
      "min": 14,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Title size desktop",
      "min": 16,
      "max": 26,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size desktop",
      "min": 14,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_alt",
          "label": "Icon alt text",
          "default": "Included item icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "2 Chairs With Uprights"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Steel-framed chairs with built-in uprights"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "What's included",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
