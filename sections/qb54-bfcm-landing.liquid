    transition: transform 320ms var(--ease-emph);
  }
  {{ scope }} .qb54-bf-sticky.is-visible { transform: translateY(0); }
  {{ scope }} .qb54-bf-sticky__t { display: grid; gap: 2px; min-width: 0; }
  {{ scope }} .qb54-bf-sticky__t strong { font-family: var(--fh); font-weight: 700; font-size: 18px; line-height: 1; text-transform: uppercase; letter-spacing: 0.02em; }
  {{ scope }} .qb54-bf-sticky__t span { font-size: 12px; font-weight: 500; font-variant-numeric: tabular-nums; }
  {{ scope }} .qb54-bf-sticky .qb54-bf-btn { min-height: 46px; padding: 0 20px; font-size: 13px; flex: none; }

  /* ---------- Reveal ---------- */
  {{ scope }}.qb54-bf--js [data-qb54-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 480ms var(--ease-out), transform 480ms var(--ease-out); }
  {{ scope }}.qb54-bf--js [data-qb54-reveal].is-in { opacity: 1; transform: none; }

  /* ---------- Breakpoints ---------- */
  @media screen and (min-width: 600px) {
    {{ scope }} .qb54-bf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    {{ scope }} .qb54-bf-grid > .qb54-bf-card:last-child:nth-child(odd) { grid-column: 1 / -1; flex-direction: row; }
    {{ scope }} .qb54-bf-grid > .qb54-bf-card:last-child:nth-child(odd) .qb54-bf-card__media { flex: 0 0 50%; aspect-ratio: auto; min-height: 280px; }
    {{ scope }} .qb54-bf-grid > .qb54-bf-card:last-child:nth-child(odd) .qb54-bf-card__body { border-top: 0; border-left: 1px solid var(--line); justify-content: center; }
    {{ scope }} .qb54-bf-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    {{ scope }} .qb54-bf-steps__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    {{ scope }} .qb54-bf-rail { grid-auto-columns: 46%; }
  }

  @media screen and (min-width: 750px) {
    {{ scope }} .qb54-bf-sticky { display: none; }
  }

  @media screen and (min-width: 990px) {
    {{ scope }} .qb54-bf-bar__mid { display: inline-flex; }
    {{ scope }} .qb54-bf-hero__grid { grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr); }
    {{ scope }} .qb54-bf-stage { justify-self: end; }
    {{ scope }} .qb54-bf-head--split { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    {{ scope }} .qb54-bf-head--split .qb54-bf-timer-pill { justify-self: end; }
    {{ scope }} .qb54-bf-grid[data-count='3'],
    {{ scope }} .qb54-bf-grid[data-count='6'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    {{ scope }} .qb54-bf-grid[data-count='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    {{ scope }} .qb54-bf-grid[data-count='3'] > .qb54-bf-card:last-child:nth-child(odd),
    {{ scope }} .qb54-bf-grid[data-count='4'] > .qb54-bf-card:last-child:nth-child(odd) { grid-column: auto; flex-direction: column; }
    {{ scope }} .qb54-bf-grid[data-count='3'] > .qb54-bf-card:last-child:nth-child(odd) .qb54-bf-card__media { flex: none; aspect-ratio: 4 / 3; min-height: 0; }
    {{ scope }} .qb54-bf-grid[data-count='3'] > .qb54-bf-card:last-child:nth-child(odd) .qb54-bf-card__body { border-left: 0; border-top: 1px solid var(--line); justify-content: flex-start; }
    {{ scope }} .qb54-bf-why__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
    {{ scope }} .qb54-bf-why__hero { min-height: 560px; }
    {{ scope }} .qb54-bf-rail { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding-inline: 0; }
    {{ scope }} .qb54-bf-dots { display: none; }
    {{ scope }} .qb54-bf-faq__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 64px; align-items: start; }
    {{ scope }} .qb54-bf-faq__aside { position: sticky; top: 32px; }
  }

  @media screen and (max-width: 599px) {
    {{ scope }} .qb54-bf-offer { display: grid; grid-template-columns: 1fr; }
    {{ scope }} .qb54-bf-timer-card { justify-items: center; }
    {{ scope }} .qb54-bf-ticket { justify-content: space-between; }
    {{ scope }} .qb54-bf-ctas .qb54-bf-btn { width: 100%; }
    {{ scope }} .qb54-bf-cd__unit { min-width: 0; flex: 1; }
    {{ scope }} .qb54-bf-cd--white .qb54-bf-cd__unit { min-width: 0; padding: 10px 4px 9px; }
    {{ scope }} .qb54-bf-cd--white .qb54-bf-cd__num { font-size: 32px; }
    {{ scope }} .qb54-bf-close .qb54-bf-cd { width: 100%; }
    {{ scope }} .qb54-bf-close .qb54-bf-btn { width: 100%; }
    {{ scope }} .qb54-bf-bar .qb54-bf-btn { padding: 0 14px; }
    {{ scope }} .qb54-bf-stage { width: min(100%, 440px); }
  }

  @media (prefers-reduced-motion: reduce) {
    {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { animation: none !important; transition: none !important; }
    {{ scope }}.qb54-bf--js [data-qb54-reveal] { opacity: 1; transform: none; }
  }

  body.qb54-bf-bar-on { padding-bottom: calc(68px + env(safe-area-inset-bottom)); }
  @media screen and (min-width: 750px) { body.qb54-bf-bar-on { padding-bottom: 0; } }
</style>

{%- capture icon_bolt -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.4 2 4.6 13.4h6.1L9.8 22l8.6-11.4h-6.1L13.4 2z"/></svg>{%- endcapture -%}
{%- capture icon_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture icon_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture icon_star -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}
{%- capture icon_copy -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>{%- endcapture -%}
{%- capture icon_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{%- endcapture -%}
{%- capture icon_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v12H1zM15 9h4l4 4v3h-8z"/><circle cx="6" cy="18.5" r="2"/><circle cx="18" cy="18.5" r="2"/></svg>{%- endcapture -%}
{%- capture icon_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture icon_cart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h3l2.4 12h11l2.1-8H6.4"/></svg>{%- endcapture -%}
{%- capture icon_tag -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>{%- endcapture -%}

{%- capture countdown_units -%}
  <div class="qb54-bf-cd__unit"><span class="qb54-bf-cd__num" data-u="d">00</span><span class="qb54-bf-cd__lbl">Days</span></div>
  <span class="qb54-bf-cd__sep" aria-hidden="true">:</span>
  <div class="qb54-bf-cd__unit"><span class="qb54-bf-cd__num" data-u="h">00</span><span class="qb54-bf-cd__lbl">Hrs</span></div>
  <span class="qb54-bf-cd__sep" aria-hidden="true">:</span>
  <div class="qb54-bf-cd__unit"><span class="qb54-bf-cd__num" data-u="m">00</span><span class="qb54-bf-cd__lbl">Min</span></div>
  <span class="qb54-bf-cd__sep" aria-hidden="true">:</span>
  <div class="qb54-bf-cd__unit"><span class="qb54-bf-cd__num" data-u="s">00</span><span class="qb54-bf-cd__lbl">Sec</span></div>
{%- endcapture -%}

<div
  id="qb54-bf-{{ section.id }}"
  class="qb54-bf"
  data-state="live"
  data-start="{{ start_iso | escape }}"
  data-end="{{ end_iso | escape }}"
  data-code="{{ code | escape }}"
  data-auto-apply="{{ section.settings.auto_apply_code }}"
>
  <header class="qb54-bf-bar">
    <div class="qb54-bf-wrap qb54-bf-bar__in">
      <a class="qb54-bf-bar__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{- section.settings.logo | image_url: width: 240 | image_tag: loading: 'eager', alt: shop.name, widths: '120,240', sizes: '120px' -}}
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <p class="qb54-bf-bar__mid" data-qb54-when="before live">
        <span data-qb54-when="live">Sale ends in</span><span data-qb54-when="before" hidden>Sale starts in</span>
        <strong data-qb54-cd-compact>0d 00:00:00</strong>
        <span class="qb54-bf-bar__code">{{ code }}</span>
      </p>
      <div class="qb54-bf-bar__end">
        <a class="qb54-bf-cartlink" href="{{ routes.cart_url }}" aria-label="Cart">
          {{ icon_cart }}<span class="qb54-bf-cartlink__count" data-qb54-cart-count hidden>0</span>
        </a>
        <a class="qb54-bf-btn qb54-bf-btn--primary" href="#qb54-bf-deals-{{ section.id }}">{{ section.settings.bar_cta | escape }}</a>
      </div>
    </div>
  </header>

  <section class="qb54-bf-hero" data-qb54-hero aria-labelledby="qb54-bf-h1-{{ section.id }}">
    <div class="qb54-bf-wrap qb54-bf-hero__grid">
      <div class="qb54-bf-hero__copy">
        <p class="qb54-bf-glass-pill">{{ icon_bolt }}{{ section.settings.hero_eyebrow | escape }}</p>

        <div data-qb54-when="before live">
          <h1 class="qb54-bf-lockup" id="qb54-bf-h1-{{ section.id }}">
            <span class="qb54-bf-lockup__num">{{ pct }}<span class="qb54-bf-lockup__pct">%</span></span>
            <span class="qb54-bf-lockup__stack">
              <span class="qb54-bf-lockup__off">Off</span>
              <span class="qb54-bf-lockup__label">{{ section.settings.hero_label | escape }}</span>
            </span>
            <span class="qb54-bf-sr"> — {{ section.settings.hero_eyebrow | escape }}</span>
          </h1>
          <p class="qb54-bf-lede">{{ section.settings.hero_text | escape }}</p>

          <div class="qb54-bf-offer">
            <div class="qb54-bf-timer-card">
              <span class="qb54-bf-timer-card__label"><span data-qb54-when="live">Sale ends in</span><span data-qb54-when="before" hidden>Sale starts in</span></span>
              <div class="qb54-bf-cd qb54-bf-cd--glass" data-qb54-cd role="timer" aria-label="Time remaining in the sale">{{ countdown_units }}</div>
            </div>
            {%- if code != blank -%}
              <div class="qb54-bf-ticket">
                <div class="qb54-bf-ticket__main">
                  <span class="qb54-bf-ticket__label">Use code</span>
                  <span class="qb54-bf-ticket__code">{{ code }}</span>
                </div>
                <span class="qb54-bf-ticket__perf" aria-hidden="true"></span>
                <button type="button" class="qb54-bf-ticket__copy" data-qb54-copy="{{ code | escape }}">
                  {{ icon_copy }}<span data-qb54-copy-label aria-live="polite">Copy</span>
                </button>
              </div>
            {%- endif -%}
          </div>

          <p class="qb54-bf-before-note" data-qb54-when="before" hidden>
            Code <strong>{{ code }}</strong> unlocks {{ start_label }} — bookmark this page so you're first in line.
          </p>

          <div class="qb54-bf-ctas">
            <a class="qb54-bf-btn qb54-bf-btn--primary qb54-bf-btn--shine" href="{{ shop_url }}">{{ section.settings.hero_cta | escape }}{{ icon_arrow }}</a>
            <a class="qb54-bf-btn qb54-bf-btn--ghost" href="#qb54-bf-deals-{{ section.id }}">{{ section.settings.hero_cta_secondary | escape }}</a>
          </div>
        </div>

        <div class="qb54-bf-ended" data-qb54-when="after" hidden>
          <p class="qb54-bf-ended__title">{{ section.settings.after_heading | escape }}</p>
          <p>{{ section.settings.after_text | escape }}</p>
          <a class="qb54-bf-btn qb54-bf-btn--primary" href="{{ shop_url }}">{{ section.settings.after_cta | escape }}{{ icon_arrow }}</a>
        </div>

        <ul class="qb54-bf-trust">
          <li><span class="qb54-bf-stars">{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}</span>{{ section.settings.trust_1 | escape }}</li>
          {%- if section.settings.trust_2 != blank -%}<li>{{ icon_check }}{{ section.settings.trust_2 | escape }}</li>{%- endif -%}
          {%- if section.settings.trust_3 != blank -%}<li>{{ icon_shield }}{{ section.settings.trust_3 | escape }}</li>{%- endif -%}
        </ul>
      </div>

      <div class="qb54-bf-stage" data-qb54-stage aria-hidden="true">
        <div class="qb54-bf-tilt" data-qb54-tilt>
          {%- assign fan_i = 0 -%}
          {%- for block in product_blocks -%}
            {%- if block.settings.product != blank and fan_i < 3 -%}
              {%- assign fan_i = fan_i | plus: 1 -%}
              {%- assign fp = block.settings.product -%}
              {%- assign fan_img = fp.featured_media.preview_image -%}
              {%- if fan_i == 1 and section.settings.hero_image != blank -%}
                {%- assign fan_img = section.settings.hero_image -%}
              {%- endif -%}
              <div class="qb54-bf-fan qb54-bf-fan--{{ fan_i }}">
                {%- if fan_img != blank -%}
                  {%- if fan_i == 1 -%}
                    {{- fan_img | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500,800,1100', sizes: '(min-width: 990px) 380px, 70vw', alt: '' -}}
                  {%- else -%}
                    {{- fan_img | image_url: width: 700 | image_tag: loading: 'eager', widths: '400,700', sizes: '(min-width: 990px) 320px, 60vw', alt: '' -}}
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="qb54-bf-sticker" data-qb54-when="before live">
          <svg viewBox="0 0 120 120">
            <defs><path id="qb54-bf-ring-{{ section.id }}" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0"/></defs>
            <text><textPath href="#qb54-bf-ring-{{ section.id }}" textLength="290" lengthAdjust="spacing">{{ pct }}% off ✦ code {{ code }} ✦ {{ pct }}% off ✦ code {{ code }} ✦</textPath></text>
          </svg>
          <span class="qb54-bf-sticker__core">{{ pct }}%<small>Off</small></span>
        </div>

        {%- if lead_product != blank -%}
          <div class="qb54-bf-mini" data-qb54-when="before live">
            <span class="qb54-bf-mini__thumb">
              {{- lead_product.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'eager', alt: '' -}}
            </span>
            <span>
              <span class="qb54-bf-mini__t">{{ section.settings.mini_label | escape }}</span>
              <span class="qb54-bf-mini__p"><strong>{{ lead_sale | money }}</strong><s>{{ lead_price | money }}</s></span>
            </span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- assign marquee_items = section.settings.marquee_items | split: '|' -%}
  {%- if marquee_items.size > 0 -%}
    <div class="qb54-bf-marquee" aria-label="Sale highlights">
      <div class="qb54-bf-marquee__track">
        {%- for pass in (1..2) -%}
          <div class="qb54-bf-marquee__group"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- for rep in (1..2) -%}
              {%- for item in marquee_items -%}
                <span class="qb54-bf-marquee__item">{{ item | strip | escape }}{{ icon_bolt }}</span>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <section class="qb54-bf-deals" id="qb54-bf-deals-{{ section.id }}" aria-labelledby="qb54-bf-deals-h-{{ section.id }}">
    <div class="qb54-bf-wrap">
      <header class="qb54-bf-head qb54-bf-head--split" data-qb54-reveal>
        <div>
          <p class="qb54-bf-eyebrow qb54-bf-eyebrow--pill">{{ section.settings.deals_eyebrow | escape }}</p>
          <h2 class="qb54-bf-h2" id="qb54-bf-deals-h-{{ section.id }}">{{ section.settings.deals_heading }}</h2>
          {%- if section.settings.deals_text != blank -%}<p class="qb54-bf-lede">{{ section.settings.deals_text | escape }}</p>{%- endif -%}
        </div>
        <p class="qb54-bf-timer-pill" data-qb54-when="before live">
          {{ icon_clock }}
          <span><span data-qb54-when="live">Ends in</span><span data-qb54-when="before" hidden>Starts in</span> <strong data-qb54-cd-compact>0d 00:00:00</strong></span>
        </p>
      </header>

      <div class="qb54-bf-grid" data-count="{{ deal_count }}">
        {%- for block in product_blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign v = p.selected_or_first_available_variant
            assign price = v.price
            assign sale = price | times: keep | divided_by: 100
            assign save = price | minus: sale
            assign needs_options = false
            if block.settings.needs_customization or p.has_only_default_variant == false
              assign needs_options = true
            endif
          -%}
          <article class="qb54-bf-card" data-qb54-reveal {{ block.shopify_attributes }}>
            <a class="qb54-bf-card__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              <span class="qb54-bf-badge" data-qb54-when="before live">{{ pct }}% Off</span>
              {%- if block.settings.flag != blank -%}<span class="qb54-bf-flag">{{ block.settings.flag | escape }}</span>{%- endif -%}
              {%- if p.featured_media != blank -%}
                {{- p.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 990px) 400px, (min-width: 600px) 46vw, 92vw', alt: p.featured_media.alt | default: p.title -}}
              {%- endif -%}
            </a>
            <div class="qb54-bf-card__body">
              <h3 class="qb54-bf-card__title"><a href="{{ p.url }}">{{ block.settings.title_override | default: p.title | escape }}</a></h3>
              {%- if block.settings.subtitle != blank -%}<p class="qb54-bf-card__sub">{{ block.settings.subtitle | escape }}</p>{%- endif -%}

              <div data-qb54-when="before live">
                <div class="qb54-bf-price">
                  <span class="qb54-bf-price__now">{{ sale | money }}</span>
                  <s class="qb54-bf-price__was"><span class="qb54-bf-sr">Regular price </span>{{ price | money }}</s>
                  <span class="qb54-bf-save">Save {{ save | money }}</span>
                </div>
                <p class="qb54-bf-price__note">
                  <span data-qb54-when="live">With code <strong>{{ code }}</strong> at checkout</span>
                  <span data-qb54-when="before" hidden>With code <strong>{{ code }}</strong> · starts {{ start_label }}</span>
                </p>
              </div>
              <div class="qb54-bf-price" data-qb54-when="after" hidden>
                <span class="qb54-bf-price__now">{{ price | money }}</span>
              </div>

              <div class="qb54-bf-card__cta">
                {%- if p.available == false -%}
                  <button type="button" class="qb54-bf-btn" disabled>{{ 'products.product.sold_out' | t }}</button>
                {%- elsif needs_options -%}
                  <a class="qb54-bf-btn qb54-bf-btn--primary" href="{{ p.url }}">{{ block.settings.options_label | default: 'Choose Options' | escape }}{{ icon_arrow }}</a>
                {%- else -%}
                  <button type="button" class="qb54-bf-btn qb54-bf-btn--primary" data-qb54-add data-variant-id="{{ v.id }}">
                    <span class="qb54-bf-btn__icon" data-qb54-btn-icon>{{ icon_cart }}</span>
                    <span data-qb54-btn-label>Add to Cart</span>
                  </button>
                  <p class="qb54-bf-card__err" data-qb54-err role="alert" hidden></p>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <p class="qb54-bf-deals__note">
        <span>{{ icon_tag }}{{ section.settings.deals_note_1 | escape }}</span>
        {%- if section.settings.deals_note_2 != blank -%}<span>{{ icon_truck }}{{ section.settings.deals_note_2 | escape }}</span>{%- endif -%}
        {%- if section.settings.deals_note_3 != blank -%}<span>{{ icon_shield }}{{ section.settings.deals_note_3 | escape }}</span>{%- endif -%}
      </p>
    </div>
  </section>

  {%- if feature_blocks.size > 0 -%}
    <section class="qb54-bf-why" aria-labelledby="qb54-bf-why-h-{{ section.id }}">
      <div class="qb54-bf-wrap qb54-bf-why__grid">
        <div class="qb54-bf-why__hero" data-qb54-reveal>
          {%- if section.settings.why_image != blank -%}
            {{- section.settings.why_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: section.settings.why_image.alt | default: '' -}}
          {%- endif -%}
          <p class="qb54-bf-eyebrow qb54-bf-eyebrow--pill">{{ section.settings.why_eyebrow | escape }}</p>
          <h2 class="qb54-bf-h2" id="qb54-bf-why-h-{{ section.id }}">{{ section.settings.why_heading }}</h2>
          {%- if section.settings.why_text != blank -%}<p class="qb54-bf-lede">{{ section.settings.why_text | escape }}</p>{%- endif -%}
          <div class="qb54-bf-why__links">
            <a class="qb54-bf-btn qb54-bf-btn--primary" href="{{ shop_url }}">{{ section.settings.why_cta | escape }}{{ icon_arrow }}</a>
            {%- if section.settings.rules_url != blank -%}
              <a class="qb54-bf-btn qb54-bf-btn--ghost" href="{{ section.settings.rules_url }}">{{ section.settings.rules_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
        <div class="qb54-bf-tiles">
          {%- for block in feature_blocks -%}
            <div class="qb54-bf-tile" data-qb54-reveal {{ block.shopify_attributes }}>
              <span class="qb54-bf-tile__icon">
                {%- case block.settings.icon -%}
                  {%- when 'chair' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3v9h12V3M4 12h16v3H4zM6 15l-2 6M18 15l2 6M8 15v6M16 15v6"/></svg>
                  {%- when 'clock' -%}{{ icon_clock }}
                  {%- when 'users' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.3a3.5 3.5 0 0 1 0 7.4M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/></svg>
                  {%- when 'bag' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8zM9 8V6a3 3 0 0 1 6 0v2"/></svg>
                  {%- when 'ball' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="12" rx="10" ry="6" transform="rotate(-35 12 12)"/><path d="M9 15l6-6M10.5 10.5l1.5 1.5M12 9l1.5 1.5M9 12l1.5 1.5"/></svg>
                  {%- else -%}{{ icon_shield }}
                {%- endcase -%}
              </span>
              <div>
                <h3 class="qb54-bf-tile__title">{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if step_blocks.size > 0 -%}
    <section class="qb54-bf-steps" aria-labelledby="qb54-bf-steps-h-{{ section.id }}" data-qb54-when="before live">
      <div class="qb54-bf-wrap">
        <div data-qb54-reveal>
          <p class="qb54-bf-eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
          <h2 class="qb54-bf-h2" id="qb54-bf-steps-h-{{ section.id }}">{{ section.settings.steps_heading | escape }}</h2>
        </div>
        <ol class="qb54-bf-steps__list">
          {%- for block in step_blocks -%}
            <li class="qb54-bf-step" data-qb54-reveal {{ block.shopify_attributes }}>
              <span class="qb54-bf-step__n" aria-hidden="true">{{ forloop.index }}</span>
              <h3 class="qb54-bf-step__title">{{ block.settings.title | escape }}</h3>
              {%- assign step_text = block.settings.text | escape -%}
              {%- if code != blank -%}
                {%- assign marked_code = '<mark>' | append: code | append: '</mark>' -%}
                {%- assign step_text = step_text | replace: code, marked_code -%}
              {%- endif -%}
              <p>{{ step_text }}</p>
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.auto_apply_code -%}
          <p class="qb54-bf-steps__note" data-qb54-when="live">{{ section.settings.auto_apply_note | escape }}</p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if review_blocks.size > 0 -%}
    <section class="qb54-bf-reviews" aria-labelledby="qb54-bf-rev-h-{{ section.id }}">
      <div class="qb54-bf-wrap">
        <header class="qb54-bf-head" data-qb54-reveal>
          <p class="qb54-bf-rating"><span class="qb54-bf-stars">{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}</span>{{ section.settings.reviews_kicker | escape }}</p>
          <h2 class="qb54-bf-h2" id="qb54-bf-rev-h-{{ section.id }}">{{ section.settings.reviews_heading }}</h2>
        </header>
        <div class="qb54-bf-rail" data-qb54-rail tabindex="0" aria-label="Customer reviews">
          {%- for block in review_blocks -%}
            <figure class="qb54-bf-review" {{ block.shopify_attributes }}>
              <span class="qb54-bf-stars">{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}</span>
              <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
              <footer>
                <span class="qb54-bf-avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
                <span>
                  <cite>{{ block.settings.name | escape }}</cite>
                  <span class="qb54-bf-verified">{{ icon_check }}Verified Buyer</span>
                </span>
              </footer>
            </figure>
          {%- endfor -%}
        </div>
        <div class="qb54-bf-dots" data-qb54-dots></div>
      </div>
    </section>
  {%- endif -%}

  {%- if faq_blocks.size > 0 -%}
    <section class="qb54-bf-faq" aria-labelledby="qb54-bf-faq-h-{{ section.id }}">
      <div class="qb54-bf-wrap qb54-bf-faq__grid">
        <div class="qb54-bf-faq__aside" data-qb54-reveal>
          <p class="qb54-bf-eyebrow qb54-bf-eyebrow--pill">{{ section.settings.faq_eyebrow | escape }}</p>
          <h2 class="qb54-bf-h2" id="qb54-bf-faq-h-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2>
          {%- if section.settings.faq_text != blank -%}
            <p class="qb54-bf-lede">
              {{ section.settings.faq_text | escape }}
              {%- if section.settings.contact_url != blank %} <a href="{{ section.settings.contact_url }}">{{ section.settings.contact_label | escape }}</a>{%- endif -%}
            </p>
          {%- endif -%}
        </div>
        <div>
          {%- for block in faq_blocks -%}
            <details class="qb54-bf-qa"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}<span class="qb54-bf-plus" aria-hidden="true"></span></summary>
              <div class="qb54-bf-qa__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="qb54-bf-close" data-qb54-close aria-labelledby="qb54-bf-close-h-{{ section.id }}">
    <div class="qb54-bf-wrap">
      <div data-qb54-when="before live">
        <p class="qb54-bf-close__big" aria-hidden="true">{{ pct }}% Off</p>
        <h2 class="qb54-bf-h2" id="qb54-bf-close-h-{{ section.id }}">{{ section.settings.close_heading | escape }}</h2>
        {%- if section.settings.close_text != blank -%}<p class="qb54-bf-lede">{{ section.settings.close_text | escape }}</p>{%- endif -%}
        <p class="qb54-bf-close__label"><span data-qb54-when="live">Sale ends in</span><span data-qb54-when="before" hidden>Sale starts in</span></p>
        <div class="qb54-bf-cd qb54-bf-cd--white" data-qb54-cd role="timer" aria-label="Time remaining in the sale">{{ countdown_units }}</div>
        <ul class="qb54-bf-chips">
          <li>{{ icon_tag }}Code {{ code }}</li>
          {%- if section.settings.close_chip_2 != blank -%}<li>{{ icon_truck }}{{ section.settings.close_chip_2 | escape }}</li>{%- endif -%}
          {%- if section.settings.close_chip_3 != blank -%}<li>{{ icon_shield }}{{ section.settings.close_chip_3 | escape }}</li>{%- endif -%}
        </ul>
        <a class="qb54-bf-btn qb54-bf-btn--white" href="{{ shop_url }}">{{ section.settings.close_cta | escape }}{{ icon_arrow }}</a>
      </div>
      <div data-qb54-when="after" hidden>
        <h2 class="qb54-bf-h2">{{ section.settings.after_heading | escape }}</h2>
        <p class="qb54-bf-lede">{{ section.settings.after_text | escape }}</p>
        <a class="qb54-bf-btn qb54-bf-btn--white" href="{{ shop_url }}">{{ section.settings.after_cta | escape }}{{ icon_arrow }}</a>
      </div>
    </div>
  </section>

  {%- if section.settings.show_sticky_bar -%}
    <div class="qb54-bf-sticky" data-qb54-sticky data-qb54-when="before live" aria-hidden="true">
      <div class="qb54-bf-sticky__t">
        <strong>{{ pct }}% off · {{ code }}</strong>
        <span><span data-qb54-when="live">Ends in</span><span data-qb54-when="before" hidden>Starts in</span> <span data-qb54-cd-compact>0d 00:00:00</span></span>
      </div>
      <a class="qb54-bf-btn qb54-bf-btn--white" href="#qb54-bf-deals-{{ section.id }}" tabindex="-1" data-qb54-sticky-shop>{{ section.settings.sticky_cta | escape }}</a>
      <a class="qb54-bf-btn qb54-bf-btn--white" href="{{ routes.root_url | append: '/checkout' | replace: '//', '/' }}" tabindex="-1" data-qb54-checkout data-qb54-sticky-checkout hidden>Checkout <span data-qb54-cart-count>0</span></a>
    </div>
  {%- endif -%}

  <div class="qb54-bf-toast" data-qb54-toast role="status" aria-live="polite" hidden>
    <span class="qb54-bf-toast__ok" aria-hidden="true">{{ icon_check }}</span>
    <div class="qb54-bf-toast__t">
      <strong>Added to cart</strong>
      <span data-qb54-toast-meta></span>
    </div>
    <div class="qb54-bf-toast__a">
      <a class="qb54-bf-btn qb54-bf-btn--primary" href="{{ routes.root_url | append: '/checkout' | replace: '//', '/' }}" data-qb54-checkout>Checkout</a>
      <a class="qb54-bf-toast__cart" href="{{ routes.cart_url }}">View cart</a>
    </div>
    <button type="button" class="qb54-bf-toast__x" data-qb54-toast-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
</div>

<script>
  (function () {
    var id = '{{ section.id }}';
    var root = document.getElementById('qb54-bf-' + id);
    if (!root) return;

    window.__qb54Bf = window.__qb54Bf || {};
    if (window.__qb54Bf[id]) window.__qb54Bf[id].destroy();

    var cleanups = [];
    var shopifyRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var start = Date.parse(root.getAttribute('data-start'));
    var end = Date.parse(root.getAttribute('data-end'));
    var code = root.getAttribute('data-code');
    var state = null;

    root.classList.add('qb54-bf--js');

    function stateAt(now) {
      if (!isNaN(start) && now < start) return 'before';
      if (!isNaN(end) && now >= end) return 'after';
      return 'live';
    }

    var checkoutLinks = root.querySelectorAll('[data-qb54-checkout]');

    function applyState(next) {
      root.setAttribute('data-state', next);
      var els = root.querySelectorAll('[data-qb54-when]');
      for (var i = 0; i < els.length; i++) {
        var when = ' ' + els[i].getAttribute('data-qb54-when') + ' ';
        els[i].hidden = when.indexOf(' ' + next + ' ') === -1;
      }
      var checkoutHref = shopifyRoot + 'checkout' + (next === 'live' && code ? '?discount=' + encodeURIComponent(code) : '');
      for (var c = 0; c < checkoutLinks.length; c++) checkoutLinks[c].setAttribute('href', checkoutHref);
      if (next === 'live') maybeApplyCode();
      updateSticky();
    }

    /* Cart count + checkout path (this page has no header or cart drawer) */
    var countEls = root.querySelectorAll('[data-qb54-cart-count]');
    var stickyShop = root.querySelector('[data-qb54-sticky-shop]');
    var stickyCheckout = root.querySelector('[data-qb54-sticky-checkout]');
    var toast = root.querySelector('[data-qb54-toast]');
    var toastMeta = root.querySelector('[data-qb54-toast-meta]');
    var toastTimer = 0;

    function updateCartUi(cart, bump) {
      var count = (cart && cart.item_count) || 0;
      for (var i = 0; i < countEls.length; i++) {
        var el = countEls[i];
        el.textContent = count;
        if (el.classList.contains('qb54-bf-cartlink__count')) {
          el.hidden = count === 0;
          if (bump && !reduceMotion) {
            el.classList.remove('is-bump');
            void el.offsetWidth;
            el.classList.add('is-bump');
          }
        }
      }
      if (stickyShop && stickyCheckout) {
        stickyCheckout.hidden = count === 0;
        stickyShop.hidden = count > 0;
      }
    }

    function hideToast() {
      clearTimeout(toastTimer);
      if (toast) toast.hidden = true;
    }

    function showToast(btn, cart) {
      if (!toast) return;
      var card = btn.closest('.qb54-bf-card');
      var titleEl = card && card.querySelector('.qb54-bf-card__title');
      var count = (cart && cart.item_count) || 0;
      if (toastMeta) {
        toastMeta.textContent = (titleEl ? titleEl.textContent.trim() + ' · ' : '') + count + (count === 1 ? ' item' : ' items') + ' in your cart';
      }
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(hideToast, 9000);
    }
    cleanups.push(function () { clearTimeout(toastTimer); });

    fetch(shopifyRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (response) { return response.json(); })
      .then(function (cart) { updateCartUi(cart, false); })
      .catch(function () {});

    function pad(n) { return n < 10 ? '0' + n : String(n); }

    function setNum(el, value) {
      if (el.textContent === value) return;
      el.textContent = value;
      if (!reduceMotion) {
        el.classList.remove('is-tick');
        void el.offsetWidth;
        el.classList.add('is-tick');
      }
    }

    var groups = root.querySelectorAll('[data-qb54-cd]');
    var compacts = root.querySelectorAll('[data-qb54-cd-compact]');

    function tick() {
      var now = Date.now();
      var next = stateAt(now);
      if (next !== state) { state = next; applyState(next); }
      if (state === 'after') return;
      var target = state === 'before' ? start : end;
      var diff = Math.max(0, target - now);
      var d = Math.floor(diff / 86400000);
      var h = Math.floor(diff % 86400000 / 3600000);
      var m = Math.floor(diff % 3600000 / 60000);
      var s = Math.floor(diff % 60000 / 1000);
      var parts = { d: pad(d), h: pad(h), m: pad(m), s: pad(s) };
      for (var g = 0; g < groups.length; g++) {
        var nums = groups[g].querySelectorAll('[data-u]');
        for (var n = 0; n < nums.length; n++) setNum(nums[n], parts[nums[n].getAttribute('data-u')]);
      }
      var compact = d + 'd ' + pad(h) + ':' + pad(m) + ':' + pad(s);
      for (var c = 0; c < compacts.length; c++) compacts[c].textContent = compact;
    }

    var applied = false;
    function maybeApplyCode() {
      if (applied || !code || root.getAttribute('data-auto-apply') !== 'true') return;
      if (window.Shopify && window.Shopify.designMode) return;
      applied = true;
      var key = 'qb54_bf_code_' + code;
      try { if (sessionStorage.getItem(key)) return; } catch (e) {}
      fetch(shopifyRoot + 'discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(shopifyRoot + 'cart.js'), { credentials: 'same-origin' })
        .then(function () { try { sessionStorage.setItem(key, '1'); } catch (e) {} })
        .catch(function () {});
    }

    /* Copy code */
    function onCopy(event) {
      var btn = event.target.closest('[data-qb54-copy]');
      if (!btn || !root.contains(btn)) return;
      var value = btn.getAttribute('data-qb54-copy');
      var label = btn.querySelector('[data-qb54-copy-label]');
      var done = function () {
        if (!label) return;
        label.textContent = 'Copied!';
        setTimeout(function () { label.textContent = 'Copy'; }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(value).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = value;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        done();
      }
    }

    /* Add to cart — mirrors the theme's product-form flow */
    var iconCart = root.querySelector('[data-qb54-btn-icon]');
    var iconCartHtml = iconCart ? iconCart.innerHTML : '';

    function setButton(btn, mode, message) {
      var label = btn.querySelector('[data-qb54-btn-label]');
      var icon = btn.querySelector('[data-qb54-btn-icon]');
      var err = btn.parentNode.querySelector('[data-qb54-err]');
      btn.classList.remove('is-added', 'is-error');
      btn.removeAttribute('aria-busy');
      if (err) { err.hidden = true; err.textContent = ''; }
      if (mode === 'loading') {
        btn.setAttribute('aria-busy', 'true');
        if (icon) icon.innerHTML = '<span class="qb54-bf-spin"></span>';
        if (label) label.textContent = 'Adding…';
      } else if (mode === 'added') {
        btn.classList.add('is-added');
        if (icon) icon.innerHTML = '{{ icon_check | strip_newlines | replace: "'", "\'" }}';
        if (label) label.textContent = 'Added';
        setTimeout(function () { setButton(btn, 'idle'); }, 2200);
      } else if (mode === 'error') {
        btn.classList.add('is-error');
        if (label) label.textContent = 'Try Again';
        if (icon) icon.innerHTML = iconCartHtml;
        if (err && message) { err.textContent = message; err.hidden = false; }
      } else {
        if (label) label.textContent = 'Add to Cart';
        if (icon) icon.innerHTML = iconCartHtml;
      }
    }

    function onAdd(event) {
      var btn = event.target.closest('[data-qb54-add]');
      if (!btn || !root.contains(btn)) return;
      event.preventDefault();
      if (btn.getAttribute('aria-busy') === 'true') return;
      var variantId = btn.getAttribute('data-variant-id');
      if (!variantId) return;

      setButton(btn, 'loading');

      var sectionsToBundle = [];
      document.documentElement.dispatchEvent(new CustomEvent('cart:bundled-sections', { bubbles: true, detail: { sections: sectionsToBundle } }));

      var body = { items: [{ id: Number(variantId), quantity: 1 }] };
      if (sectionsToBundle.length) {
        body.sections = sectionsToBundle.join(',');
        body.sections_url = window.location.pathname;
      }

      fetch(shopifyRoot + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(body)
      })
        .then(function (response) {
          return response.json().then(function (json) { return { ok: response.ok, json: json }; });
        })
        .then(function (result) {
          if (!result.ok || result.json.status) throw result.json;

          if (window.theme && theme.settings && theme.settings.cartType === 'page') {
            window.location.href = shopifyRoot + 'cart';
            return;
          }

          var drawer = document.querySelector('cart-drawer');
          var hasDrawer = !!(drawer && typeof drawer.show === 'function');
          if (hasDrawer) drawer.show(btn);

          return fetch(shopifyRoot + 'cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function (response) { return response.json(); })
            .then(function (cart) {
              cart.sections = result.json.sections;
              if (window.theme && theme.pubsub && theme.pubsub.publish) {
                theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, { source: 'qb54-bfcm', productVariantId: variantId, cart: cart });
              }
              updateCartUi(cart, true);
              if (!hasDrawer) showToast(btn, cart);
              setButton(btn, 'added');
            });
        })
        .catch(function (error) {
          var message = error && (error.description || error.message);
          setButton(btn, 'error', typeof message === 'string' ? message : 'Something went wrong. Please try again.');
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: false } }));
        });
    }

    function onClick(event) {
      if (event.target.closest('[data-qb54-toast-close]')) { hideToast(); return; }
      onCopy(event);
      onAdd(event);
    }
    root.addEventListener('click', onClick);
    cleanups.push(function () { root.removeEventListener('click', onClick); });

    /* Sticky bar: show after hero, hide near the closing CTA or while a drawer is open */
    var sticky = root.querySelector('[data-qb54-sticky]');
    var hero = root.querySelector('[data-qb54-hero]');
    var closing = root.querySelector('[data-qb54-close]');
    var heroVisible = true;
    var closeVisible = false;

    function drawerOpen() {
      return !!document.querySelector('cart-drawer[open], .drawer[open]');
    }

    function updateSticky() {
      if (!sticky) return;
      var show = state !== 'after' && !heroVisible && !closeVisible && !drawerOpen();
      sticky.classList.toggle('is-visible', show);
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
      var links = sticky.querySelectorAll('a');
      for (var i = 0; i < links.length; i++) links[i].tabIndex = show ? 0 : -1;
      document.body.classList.toggle('qb54-bf-bar-on', show);
    }

    if (sticky && 'IntersectionObserver' in window) {
      var stickyIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.target === hero) heroVisible = entry.isIntersecting;
          if (entry.target === closing) closeVisible = entry.isIntersecting;
        });
        updateSticky();
      });
      if (hero) stickyIo.observe(hero);
      if (closing) stickyIo.observe(closing);
      cleanups.push(function () { stickyIo.disconnect(); });

      var drawerEl = document.querySelector('cart-drawer');
      if (drawerEl && 'MutationObserver' in window) {
        var drawerMo = new MutationObserver(updateSticky);
        drawerMo.observe(drawerEl, { attributes: true, attributeFilter: ['open', 'class'] });
        cleanups.push(function () { drawerMo.disconnect(); });
      }
    }
    cleanups.push(function () { document.body.classList.remove('qb54-bf-bar-on'); });

    /* Reveal on scroll */
    var reveals = root.querySelectorAll('[data-qb54-reveal]');
    if (!reduceMotion && 'IntersectionObserver' in window) {
      var revealIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            revealIo.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px' });
      for (var r = 0; r < reveals.length; r++) revealIo.observe(reveals[r]);
      cleanups.push(function () { revealIo.disconnect(); });
    } else {
      for (var rr = 0; rr < reveals.length; rr++) reveals[rr].classList.add('is-in');
    }

    /* Pointer tilt on the hero stage (desktop pointers only) */
    var stage = root.querySelector('[data-qb54-stage]');
    var tilt = root.querySelector('[data-qb54-tilt]');
    if (stage && tilt && !reduceMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      var raf = 0;
      var onMove = function (event) {
        var rect = stage.getBoundingClientRect();
        var x = (event.clientX - rect.left) / rect.width - 0.5;
        var y = (event.clientY - rect.top) / rect.height - 0.5;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(function () {
          tilt.style.transform = 'perspective(1100px) rotateY(' + (x * 10).toFixed(2) + 'deg) rotateX(' + (-y * 8).toFixed(2) + 'deg)';
        });
      };
      var onLeave = function () { cancelAnimationFrame(raf); tilt.style.transform = ''; };
      stage.addEventListener('pointermove', onMove);
      stage.addEventListener('pointerleave', onLeave);
      cleanups.push(function () {
        stage.removeEventListener('pointermove', onMove);
        stage.removeEventListener('pointerleave', onLeave);
        cancelAnimationFrame(raf);
      });
    }

    /* Review rail dots (mobile / tablet) */
    var rail = root.querySelector('[data-qb54-rail]');
    var dotsWrap = root.querySelector('[data-qb54-dots]');
    if (rail && dotsWrap && 'IntersectionObserver' in window) {
      var cards = rail.children;
      var dots = [];
      for (var k = 0; k < cards.length; k++) {
        (function (index) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('aria-label', 'Show review ' + (index + 1));
          dot.addEventListener('click', function () {
            rail.scrollTo({ left: cards[index].offsetLeft - rail.offsetLeft - parseFloat(getComputedStyle(rail).paddingLeft), behavior: reduceMotion ? 'auto' : 'smooth' });
          });
          dotsWrap.appendChild(dot);
          dots.push(dot);
        })(k);
      }
      var railIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            var idx = Array.prototype.indexOf.call(cards, entry.target);
            dots.forEach(function (dot, i) { dot.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
          }
        });
      }, { root: rail, threshold: [0.6] });
      for (var q = 0; q < cards.length; q++) railIo.observe(cards[q]);
      if (dots[0]) dots[0].setAttribute('aria-current', 'true');
      cleanups.push(function () { railIo.disconnect(); });
    }

    tick();
    var interval = setInterval(tick, 1000);
    cleanups.push(function () { clearInterval(interval); });

    function onUnload(event) {
      if (event.detail && event.detail.sectionId === id) destroy();
    }
    document.addEventListener('shopify:section:unload', onUnload);
    cleanups.push(function () { document.removeEventListener('shopify:section:unload', onUnload); });

    function destroy() {
      while (cleanups.length) { try { cleanups.pop()(); } catch (e) {} }
      delete window.__qb54Bf[id];
    }
    window.__qb54Bf[id] = { destroy: destroy };
  })();
</script>

