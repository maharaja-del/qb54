{%- liquid
  assign scope = '#qb54-bf-' | append: section.id
  assign code = section.settings.discount_code | strip | upcase
  assign pct = section.settings.discount_percent
  assign keep = 100 | minus: pct
  assign tz = section.settings.timezone
  assign start_raw = section.settings.start_datetime | strip
  assign end_raw = section.settings.end_datetime | strip
  assign start_iso = start_raw | append: tz
  assign end_iso = end_raw | append: tz
  assign start_label = start_raw | date: '%b %-d'
  assign shop_url = section.settings.shop_url | default: routes.all_products_collection_url

  assign product_blocks = section.blocks | where: 'type', 'product'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks = section.blocks | where: 'type', 'faq'

  assign lead_product = blank
  for block in product_blocks
    if block.settings.product != blank
      assign lead_product = block.settings.product
      break
    endif
  endfor
  if lead_product != blank
    assign lead_variant = lead_product.selected_or_first_available_variant
    assign lead_price = lead_variant.price
    assign lead_sale = lead_price | times: keep | divided_by: 100
  endif

  assign deal_count = 0
  for block in product_blocks
    if block.settings.product != blank
      assign deal_count = deal_count | plus: 1
    endif
  endfor
-%}

<style>
  {{ scope }} {
    --p: {{ section.settings.primary_color }};
    --p-deep: color-mix(in srgb, var(--p) 84%, #000000);
    --p-ink: #3f6b00;
    --p-tint: color-mix(in srgb, var(--p) 14%, transparent);
    --p-glow: color-mix(in srgb, var(--p) 45%, transparent);
    --p-grad: linear-gradient(135deg, color-mix(in srgb, var(--p) 55%, #ffffff) 0%, var(--p) 45%, var(--p-deep) 100%);
    --on-p: #0b1200;
    --night: {{ section.settings.night_color }};
    --night-2: color-mix(in srgb, var(--night) 88%, #ffffff);
    --night-line: rgba(255, 255, 255, 0.1);
    --ink: #14171b;
    --ink-2: #454b54;
    --muted: #626975;
    --paper: #ffffff;
    --mist: #f4f5f2;
    --line: #e3e6e1;
    --ok: #15803d;
    --ok-tint: #dcfce7;
    --ok-dark: #4ade80;
    --ok-dark-tint: rgba(74, 222, 128, 0.14);
    --fh: var(--font-heading-family);
    --fb: var(--font-body-family);
    --pad-y: clamp(56px, 7vw, 96px);
    --max: 1300px;
    --gutter: clamp(16px, 4vw, 32px);
    --r-btn: 6px;
    --r-card: 16px;
    --r-panel: 22px;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 10px 30px -18px rgba(0, 0, 0, 0.28);
    --shadow-lg: 0 2px 4px rgba(0, 0, 0, 0.06), 0 24px 54px -24px rgba(0, 0, 0, 0.4);
    --ease-out: cubic-bezier(0.2, 0, 0, 1);
    --ease-emph: cubic-bezier(0.05, 0.7, 0.1, 1);
    background: var(--night);
    color: #ffffff;
    font-family: var(--fb);
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  {{ scope }} *, {{ scope }} *::before, {{ scope }} *::after { box-sizing: border-box; }
  {{ scope }} a { text-decoration: none; }
  {{ scope }} .qb54-bf-wrap { width: min(var(--max), 100% - var(--gutter) * 2); margin-inline: auto; }
  {{ scope }} .qb54-bf-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  {{ scope }} [hidden] { display: none !important; }
  {{ scope }} :focus-visible { outline: 3px solid var(--p); outline-offset: 3px; border-radius: 4px; }

  /* ---------- Shared type ---------- */
  {{ scope }} .qb54-bf-h2 {
    font-family: var(--fh);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
    color: inherit;
    margin: 0;
  }
  {{ scope }} .qb54-bf-h2 em { font-style: normal; color: var(--p); }
  {{ scope }} .qb54-bf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--fb);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p);
    margin: 0 0 14px;
  }
  {{ scope }} .qb54-bf-eyebrow--pill {
    align-self: flex-start;
    justify-self: start;
    width: max-content;
    max-width: 100%;
    background: var(--p);
    color: var(--on-p);
    padding: 7px 12px;
    border-radius: 999px;
  }
  {{ scope }} .qb54-bf-lede {
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    max-width: 58ch;
    margin: 16px 0 0;
  }

  /* ---------- Buttons ---------- */
  {{ scope }} .qb54-bf-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 28px;
    border-radius: var(--r-btn);
    font-family: var(--fb);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out), background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  {{ scope }} .qb54-bf-btn svg { width: 17px; height: 17px; flex: none; }
  {{ scope }} .qb54-bf-btn--primary { background: var(--p); color: var(--on-p); box-shadow: 0 12px 30px -10px var(--p-glow); }
  {{ scope }} .qb54-bf-btn--primary:hover { background: var(--p-deep); transform: translateY(-2px); box-shadow: 0 18px 36px -12px var(--p-glow); }
  {{ scope }} .qb54-bf-btn--shine::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.65) 48%, transparent 66%);
    transform: translateX(-120%);
    animation: qb54-bf-shine 3.8s var(--ease-out) infinite 1.2s;
  }
  {{ scope }} .qb54-bf-btn--ghost { color: #ffffff; background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28); }
  {{ scope }} .qb54-bf-btn--ghost:hover { background: rgba(255, 255, 255, 0.12); transform: translateY(-2px); }
  {{ scope }} .qb54-bf-btn--white { background: #ffffff; color: var(--ink); box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.45); }
  {{ scope }} .qb54-bf-btn--white:hover { background: #f1ffd9; transform: translateY(-2px); }
  {{ scope }} .qb54-bf-btn--block { width: 100%; }

  @keyframes qb54-bf-shine { 0% { transform: translateX(-120%); } 55%, 100% { transform: translateX(120%); } }

  /* ---------- Top bar ---------- */
  {{ scope }} .qb54-bf-bar {
    position: relative;
    z-index: 3;
    border-bottom: 1px solid var(--night-line);
    background: color-mix(in srgb, var(--night) 82%, transparent);
  }
  {{ scope }} .qb54-bf-bar__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  {{ scope }} .qb54-bf-bar__logo img { width: auto; height: 38px; }
  {{ scope }} .qb54-bf-bar__logo span { font-family: var(--fh); font-weight: 700; font-size: 24px; letter-spacing: 0.02em; color: #ffffff; }
  {{ scope }} .qb54-bf-bar__mid { display: none; align-items: center; gap: 10px; font-size: 13px; color: rgba(255, 255, 255, 0.7); }
  {{ scope }} .qb54-bf-bar__mid strong { font-weight: 700; color: #ffffff; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  {{ scope }} .qb54-bf-bar__code { padding: 4px 9px; border-radius: 5px; background: var(--p-tint); color: var(--p); font-weight: 700; letter-spacing: 0.08em; }
  {{ scope }} .qb54-bf-bar .qb54-bf-btn { min-height: 42px; padding: 0 18px; font-size: 12px; }
  {{ scope }} .qb54-bf-bar__end { display: flex; align-items: center; gap: 10px; }
  {{ scope }} .qb54-bf-cartlink {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #ffffff;
    box-shadow: inset 0 0 0 1px var(--night-line);
    transition: background-color 160ms var(--ease-out);
  }
  {{ scope }} .qb54-bf-cartlink:hover { background: rgba(255, 255, 255, 0.08); }
  {{ scope }} .qb54-bf-cartlink svg { width: 20px; height: 20px; }
  {{ scope }} .qb54-bf-cartlink__count {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--p);
    color: var(--on-p);
    font-size: 11px;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  {{ scope }} .qb54-bf-cartlink__count.is-bump { animation: qb54-bf-bump 420ms var(--ease-emph); }
  @keyframes qb54-bf-bump { 0% { transform: scale(0.4); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }

  /* ---------- Added-to-cart toast ---------- */
  {{ scope }} .qb54-bf-toast {
    position: fixed;
    z-index: 40;
    left: 12px;
    right: 12px;
    bottom: calc(84px + env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px 14px;
    padding: 14px 14px 14px 16px;
    border-radius: 16px;
    background: #ffffff;
    color: var(--ink);
    box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.06);
    animation: qb54-bf-toast-in 360ms var(--ease-emph);
  }
  @keyframes qb54-bf-toast-in { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  {{ scope }} .qb54-bf-toast__ok { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--ok-tint); color: var(--ok); }
  {{ scope }} .qb54-bf-toast__ok svg { width: 20px; height: 20px; }
  {{ scope }} .qb54-bf-toast__t { display: grid; gap: 2px; min-width: 0; padding-right: 30px; }
  {{ scope }} .qb54-bf-toast__t strong { font-size: 15px; font-weight: 700; }
  {{ scope }} .qb54-bf-toast__t span { font-size: 13px; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  {{ scope }} .qb54-bf-toast__a { grid-column: 1 / -1; display: flex; align-items: center; gap: 16px; }
  {{ scope }} .qb54-bf-toast__a .qb54-bf-btn { flex: 1; min-height: 48px; }
  {{ scope }} .qb54-bf-toast__cart { font-size: 14px; font-weight: 700; color: var(--ink); text-decoration: underline; text-decoration-color: var(--p); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  {{ scope }} .qb54-bf-toast__x { position: absolute; top: 10px; right: 10px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; color: var(--muted); }
  {{ scope }} .qb54-bf-toast__x:hover { background: var(--mist); color: var(--ink); }
  {{ scope }} .qb54-bf-toast__x svg { width: 16px; height: 16px; }
  @media screen and (min-width: 750px) {
    {{ scope }} .qb54-bf-toast { left: auto; right: 24px; bottom: 24px; width: 380px; }
  }

  /* ---------- Hero ---------- */
  {{ scope }} .qb54-bf-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 88px) clamp(64px, 8vw, 112px);
  }
  {{ scope }} .qb54-bf-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(700px 520px at 78% 30%, color-mix(in srgb, var(--p) 26%, transparent), transparent 70%),
      radial-gradient(520px 420px at 6% 0%, color-mix(in srgb, var(--p) 12%, transparent), transparent 70%);
  }
  {{ scope }} .qb54-bf-hero::after {
    content: '';
    position: absolute;
    left: -25%;
    right: -25%;
    bottom: -2px;
    height: 46%;
    z-index: -1;
    background-image:
      linear-gradient(color-mix(in srgb, var(--p) 22%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--p) 22%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(520px) rotateX(62deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 85%);
    mask-image: linear-gradient(to top, #000 0%, transparent 85%);
    pointer-events: none;
  }
  {{ scope }} .qb54-bf-hero__grid { display: grid; gap: clamp(36px, 5vw, 64px); align-items: center; }
  {{ scope }} .qb54-bf-glass-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
  }
  {{ scope }} .qb54-bf-glass-pill svg { width: 16px; height: 16px; color: var(--p); }

  {{ scope }} .qb54-bf-lockup {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.6vw, 22px);
    margin: 22px 0 0;
    font-family: var(--fh);
    font-weight: 700;
    text-transform: uppercase;
    color: #ffffff;
    letter-spacing: 0;
    line-height: 1;
  }
  {{ scope }} .qb54-bf-lockup__num {
    display: inline-flex;
    align-items: flex-start;
    font-size: clamp(132px, 17vw, 236px);
    line-height: 0.9;
    padding-bottom: 0.05em;
    margin-bottom: -0.05em;
    letter-spacing: -0.045em;
    background: linear-gradient(180deg, #ffffff 8%, color-mix(in srgb, var(--p) 40%, #ffffff) 46%, var(--p) 72%, var(--p-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 14px 44px color-mix(in srgb, var(--p) 32%, transparent));
    font-variant-numeric: tabular-nums;
  }
  {{ scope }} .qb54-bf-lockup__pct { font-size: 0.42em; line-height: 1; margin: 0.12em 0 0 0.04em; letter-spacing: 0; }
  {{ scope }} .qb54-bf-lockup__stack { display: grid; gap: 6px; }
  {{ scope }} .qb54-bf-lockup__off { font-size: clamp(54px, 7vw, 98px); line-height: 0.82; color: #ffffff; }
  {{ scope }} .qb54-bf-lockup__label {
    display: inline-block;
    justify-self: start;
    padding: 6px 10px 7px;
    border-radius: 6px;
    background: var(--p);
    color: var(--on-p);
    font-size: clamp(17px, 1.9vw, 25px);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  {{ scope }} .qb54-bf-hero .qb54-bf-lede { color: rgba(255, 255, 255, 0.78); }

  {{ scope }} .qb54-bf-offer {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
    margin-top: 28px;
  }
  {{ scope }} .qb54-bf-timer-card {
    display: grid;
    gap: 8px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  {{ scope }} .qb54-bf-timer-card__label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.62); }

  /* Countdown tiles */
  {{ scope }} .qb54-bf-cd { display: flex; align-items: center; gap: 6px; }
  {{ scope }} .qb54-bf-cd__unit { display: grid; justify-items: center; min-width: 56px; padding: 8px 6px 7px; border-radius: 10px; }
  {{ scope }} .qb54-bf-cd__num { font-family: var(--fh); font-weight: 700; font-size: 28px; line-height: 1; font-variant-numeric: tabular-nums; }
  {{ scope }} .qb54-bf-cd__num.is-tick { animation: qb54-bf-tick 360ms var(--ease-emph); }
  {{ scope }} .qb54-bf-cd__lbl { margin-top: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
  {{ scope }} .qb54-bf-cd__sep { font-family: var(--fh); font-weight: 700; font-size: 22px; opacity: 0.4; margin-top: -14px; }
  {{ scope }} .qb54-bf-cd--glass .qb54-bf-cd__unit { background: rgba(255, 255, 255, 0.07); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); color: #ffffff; }
  {{ scope }} .qb54-bf-cd--white .qb54-bf-cd__unit { background: #ffffff; color: var(--ink); box-shadow: 0 10px 22px -14px rgba(0, 0, 0, 0.5); min-width: 74px; padding: 12px 8px 10px; }
  {{ scope }} .qb54-bf-cd--white .qb54-bf-cd__num { font-size: 40px; }
  {{ scope }} .qb54-bf-cd--white .qb54-bf-cd__sep { color: var(--on-p); }
  @keyframes qb54-bf-tick { 0% { transform: translateY(-35%); opacity: 0; } 100% { transform: none; opacity: 1; } }

  /* Code ticket */
  {{ scope }} .qb54-bf-ticket {
    position: relative;
    display: flex;
    align-items: center;
    border-radius: 14px;
    background: var(--p);
    color: var(--on-p);
    overflow: hidden;
  }
  {{ scope }} .qb54-bf-ticket__main { display: grid; gap: 4px; padding: 12px 18px 12px 18px; }
  {{ scope }} .qb54-bf-ticket__label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.75; }
  {{ scope }} .qb54-bf-ticket__code { font-family: var(--fh); font-weight: 700; font-size: 34px; line-height: 0.95; letter-spacing: 0.06em; }
  {{ scope }} .qb54-bf-ticket__perf {
    align-self: stretch;
    position: relative;
    width: 0;
    border-left: 2px dashed color-mix(in srgb, var(--on-p) 35%, transparent);
    margin-block: 10px;
  }
  {{ scope }} .qb54-bf-ticket__perf::before,
  {{ scope }} .qb54-bf-ticket__perf::after {
    content: '';
    position: absolute;
    left: -9px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--night);
  }
  {{ scope }} .qb54-bf-ticket__perf::before { top: -19px; }
  {{ scope }} .qb54-bf-ticket__perf::after { bottom: -19px; }
  {{ scope }} .qb54-bf-ticket__copy {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: stretch;
    padding: 0 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-p);
    cursor: pointer;
  }
  {{ scope }} .qb54-bf-ticket__copy svg { width: 16px; height: 16px; }
  {{ scope }} .qb54-bf-ticket__copy:hover { background: rgba(0, 0, 0, 0.07); }

  {{ scope }} .qb54-bf-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  {{ scope }} .qb54-bf-hero .qb54-bf-btn { min-height: 58px; padding: 0 32px; font-size: 15px; }

  {{ scope }} .qb54-bf-trust { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--night-line); }
  {{ scope }} .qb54-bf-trust li { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; color: rgba(255, 255, 255, 0.78); }
  {{ scope }} .qb54-bf-trust svg { width: 16px; height: 16px; color: var(--p); }
  {{ scope }} .qb54-bf-stars { display: inline-flex; gap: 2px; color: var(--p); }
  {{ scope }} .qb54-bf-stars svg { width: 15px; height: 15px; }

  {{ scope }} .qb54-bf-ended {
    margin-top: 26px;
    padding: 22px 24px;
    border-radius: var(--r-card);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px var(--night-line);
  }
  {{ scope }} .qb54-bf-ended__title { font-family: var(--fh); font-weight: 700; font-size: 28px; line-height: 1.05; text-transform: uppercase; color: #ffffff; margin: 0 0 8px; }
  {{ scope }} .qb54-bf-ended p { color: rgba(255, 255, 255, 0.72); line-height: 1.55; margin: 0 0 18px; }

  {{ scope }} .qb54-bf-before-note { margin-top: 14px; font-size: 13px; color: rgba(255, 255, 255, 0.7); }
  {{ scope }} .qb54-bf-before-note strong { color: var(--p); }

  /* Hero stage */
  {{ scope }} .qb54-bf-stage { position: relative; width: min(100%, 560px); justify-self: center; aspect-ratio: 1 / 0.92; }
  {{ scope }} .qb54-bf-fan {
    position: absolute;
    width: 68%;
    aspect-ratio: 1;
    border-radius: var(--r-panel);
    background: #ffffff;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  {{ scope }} .qb54-bf-fan img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 6%; }
  {{ scope }} .qb54-bf-fan--1 { z-index: 3; left: 17%; top: 6%; width: 66%; }
  {{ scope }} .qb54-bf-fan--2,
  {{ scope }} .qb54-bf-fan--3 { top: 16%; width: 54%; }
  {{ scope }} .qb54-bf-fan--2 { z-index: 1; left: -2%; transform: rotate(-12deg); transform-origin: 100% 100%; }
  {{ scope }} .qb54-bf-fan--3 { z-index: 2; right: -2%; transform: rotate(12deg); transform-origin: 0% 100%; }
  {{ scope }} .qb54-bf-fan--2::before,
